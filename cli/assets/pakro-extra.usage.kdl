source_code_link_template #"""
{%- set path = path | replace(from='-', to='_') -%}
{%- if path == "daemons" or path is starting_with(pat="daemons/") -%}
{%- set path = "daemons.rs" -%}
{%- elif path == "dotfiles/history" -%}
{%- set path = "dotfiles/history/mod.rs" -%}
{%- elif path == "dotfiles/include" -%}
{%- set path = "dotfiles/exclude.rs" -%}
{%- elif path == "dotfiles/origin" or path == "dotfiles/origin/set" -%}
{%- set path = "dotfiles/origin.rs" -%}
{%- elif path == "bootstrap/packages/apply" -%}
{%- set path = "system/install.rs" -%}
{%- elif path == "bootstrap/packages/import" -%}
{%- set path = "system/import.rs" -%}
{%- elif path == "bootstrap/packages/prune" -%}
{%- set path = "system/prune.rs" -%}
{%- elif path == "bootstrap/packages/status" -%}
{%- set path = "system/status.rs" -%}
{%- elif path == "bootstrap/packages/upgrade" -%}
{%- set path = "system/upgrade.rs" -%}
{%- elif path == "bootstrap/packages/use" -%}
{%- set path = "system/use.rs" -%}
{%- elif path == "bootstrap/packages/where" -%}
{%- set path = "system/where.rs" -%}
{%- elif path is starting_with(pat="bootstrap/packages/brew") -%}
{%- set path = "system/brew/mod.rs" -%}
{%- elif path == "bootstrap/dotfiles/add" -%}
{%- set path = "dotfiles/add.rs" -%}
{%- elif path == "bootstrap/dotfiles/apply" -%}
{%- set path = "dotfiles/apply.rs" -%}
{%- elif path == "bootstrap/dotfiles/edit" -%}
{%- set path = "dotfiles/edit.rs" -%}
{%- elif path == "bootstrap/dotfiles/status" -%}
{%- set path = "dotfiles/status.rs" -%}
{%- elif path == "bootstrap/dotfiles/unapply" -%}
{%- set path = "dotfiles/unapply.rs" -%}
{%- elif path == "bootstrap/dotfiles/history" -%}
{%- set path = "dotfiles/history/mod.rs" -%}
{%- elif path is starting_with(pat="bootstrap/dotfiles/history/") -%}
{%- set path = path | replace(from="bootstrap/dotfiles/history/", to="dotfiles/history/") ~ ".rs" -%}
{%- elif path == "bootstrap/dotfiles/paths" -%}
{%- set path = "dotfiles/paths.rs" -%}
{%- elif path == "bootstrap/dotfiles/save" -%}
{%- set path = "dotfiles/save.rs" -%}
{%- elif path == "bootstrap/dotfiles/capture" -%}
{%- set path = "dotfiles/capture.rs" -%}
{%- elif path == "bootstrap/dotfiles/conflicts" -%}
{%- set path = "dotfiles/conflicts.rs" -%}
{%- elif path == "bootstrap/dotfiles/track" -%}
{%- set path = "dotfiles/track.rs" -%}
{%- elif path == "bootstrap/dotfiles/untrack" -%}
{%- set path = "dotfiles/untrack.rs" -%}
{%- elif path == "bootstrap/dotfiles/rollback" -%}
{%- set path = "dotfiles/rollback.rs" -%}
{%- elif path == "bootstrap/dotfiles/undo" -%}
{%- set path = "dotfiles/undo.rs" -%}
{%- elif path == "bootstrap/dotfiles/watch" -%}
{%- set path = "dotfiles/watch.rs" -%}
{%- elif path == "bootstrap/dotfiles/exclude" or path == "bootstrap/dotfiles/include" -%}
{%- set path = "dotfiles/exclude.rs" -%}
{%- elif path == "bootstrap/dotfiles/origin" or path == "bootstrap/dotfiles/origin/set" -%}
{%- set path = "dotfiles/origin.rs" -%}
{%- elif path == "bootstrap/dotfiles/sync" -%}
{%- set path = "dotfiles/sync.rs" -%}
{%- elif path == "bootstrap/dotfiles/pull" -%}
{%- set path = "dotfiles/pull.rs" -%}
{%- elif path == "bootstrap/dotfiles/recover" -%}
{%- set path = "dotfiles/recover.rs" -%}
{%- elif path is starting_with(pat="bootstrap") -%}
{%- set path = "bootstrap.rs" -%}
{%- elif path == "tasks/run" -%}
{%- set path = "run.rs" -%}
{%- elif cmd.subcommands | length > 0 -%}
{%- set parts = path | split(pat="/") -%}
{%- set path = parts[0] ~ "/mod.rs" -%}
{%- else -%}
{%- set path = path ~ ".rs" -%}
{%- endif -%}
cli/src/commands/{{path}}
"""#

complete "alias" run="pakro alias ls {{words[PREV]}} | awk '{print $2}'"
complete "config_file" type="file"
complete "new_plugin" run="pakro plugins --all"
complete "installed_tool" run="pakro ls -i | awk '{print $1}' | uniq"
complete "plugin" run="pakro plugins --core --user"
complete "prefix" run="pakro ls-remote {{words[PREV]}}"
complete "setting" run="pakro settings --complete" descriptions=#true
complete "task" run="pakro tasks ls --complete" descriptions=#true
complete "tool" run="pakro search --complete {{words[CURRENT]}}" descriptions=#true
complete "env_var" run=#"pakro set --complete | awk '{print $1"="}'"#
complete "env_key" run="pakro set --complete"
complete "backend" run="pakro backends"
complete "bin_name" run="pakro which --complete"

complete "tool@version" run=#"""
cur="{{words[CURRENT]}}"
case $cur in
  *@*)
    tool="$(echo "$cur" | cut -d'@' -f1)"
    prefix="$(echo "$cur" | cut -d'@' -f2)"

    versions=$(pakro ls-remote $tool $prefix | sed '1!G;h;$!d')

    for version in $versions; do
      echo "$tool@$version"
    done
    ;;
  *)
    plugins=$(pakro search --complete-ids "$cur")
    for plugin in $plugins; do
      echo "$plugin@"
    done
    ;;
esac
"""#

complete "installed_tool@version" run=#"""
cur="{{words[CURRENT]}}"
case $cur in
  *@*)
    tool="$(echo "$cur" | cut -d'@' -f1)"
    prefix="$(echo "$cur" | cut -d'@' -f2)"

    if [ ! -z "$prefix" ]; then
      prefix="--prefix $prefix"
    fi
    versions=$(pakro ls --installed $tool $prefix | awk '{print $2}' | sed '1!G;h;$!d')

    for version in $versions; do
      echo "$tool@$version"
    done
    ;;
  *)
    plugins=$(pakro ls --installed | awk '{print $1}' | uniq | sed '1!G;h;$!d')
    for plugin in $plugins; do
      echo "$plugin@"
    done
    ;;
esac
"""#
