---
source: src/../cli/src/shell/fish.rs
assertion_line: 286
expression: fish.activate(opts)
---
set -gx PAKRO_SHELL fish
if not set -q __PAKRO_ORIG_PATH
    set -gx __PAKRO_ORIG_PATH $PATH
end

function pakro
  if test (count $argv) -eq 0
    command /some/dir/pakro
    return
  end

  set command $argv[1]
  set -e argv[1]

  if contains -- --help $argv
    command /some/dir/pakro "$command" $argv
    return $status
  end

  switch "$command"
  case deactivate
    # if help is requested, don't eval
    if contains -- -h $argv
      command /some/dir/pakro "$command" $argv
    else if contains -- --help $argv
      command /some/dir/pakro "$command" $argv
    else
      source (command /some/dir/pakro "$command" $argv |psub)
    end
  case '*'
    command /some/dir/pakro "$command" $argv
  end
end

function __pakro_env_eval --description 'Update pakro environment when changing directories';
    /some/dir/pakro hook-env --status --shell-pid $fish_pid -s fish $argv | source;

    if test "$pakro_fish_mode" != "disable_arrow";
        function __pakro_cd_hook --on-variable PWD --description 'Update pakro environment when changing directories';
            if test "$pakro_fish_mode" = "eval_after_arrow";
                set -g __pakro_env_again 0;
            else;
                /some/dir/pakro hook-env --status --shell-pid $fish_pid -s fish | source;
            end;
        end;
    end;
end;

function __pakro_env_eval_on_prompt --on-event fish_prompt --description 'Update pakro environment when changing directories';
    if set -q __pakro_skip_first_prompt_pwd;
        set -l activate_pwd "$__pakro_skip_first_prompt_pwd";
        set -e __pakro_skip_first_prompt_pwd;
        if test "$PWD" = "$activate_pwd";
            return;
        end;
    end;

    __pakro_env_eval;
end;

function __pakro_env_eval_2 --on-event fish_preexec --description 'Update pakro environment when changing directories';
    if set -q __pakro_env_again;
        set -e __pakro_env_again;
        /some/dir/pakro hook-env --status --shell-pid $fish_pid -s fish | source;
        echo;
    end;

    if test "$pakro_fish_mode" = "eval_after_arrow";
        functions --erase __pakro_cd_hook;
    end;
end;

__pakro_env_eval --force
set -g __pakro_skip_first_prompt_pwd "$PWD"
if functions -q fish_command_not_found; and not functions -q __pakro_fish_command_not_found
    functions -e __pakro_fish_command_not_found
    functions -c fish_command_not_found __pakro_fish_command_not_found
end

function fish_command_not_found
    if string match -qrv -- '^(?:pakro$|pakro-)' $argv[1] &&
        /some/dir/pakro hook-not-found -s fish -- $argv[1]
        /some/dir/pakro hook-env --status --shell-pid $fish_pid -s fish | source
    else if functions -q __pakro_fish_command_not_found
        __pakro_fish_command_not_found $argv
    else
        __fish_default_command_not_found_handler $argv
    end
end
