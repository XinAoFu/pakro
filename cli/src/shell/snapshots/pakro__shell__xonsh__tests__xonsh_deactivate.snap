---
source: src/shell/xonsh.rs
expression: replace_path(&deactivate)
---
import os
from xonsh.built_ins import XSH

hooks = {
  'on_pre_prompt' : ['pakro_hook'],
  'on_chdir': ['pakro_hook'],
}
for hook_type, hook_fns in hooks.items():
  for hook_fn in hook_fns:
    hndl = getattr(XSH.builtins.events, hook_type)
    for fn in hndl:
      if fn.__name__ == hook_fn:
        hndl.remove(fn)
        break

XSH.aliases.pop('pakro', None)
XSH.env.pop('PAKRO_SHELL', None)
XSH.env.pop('__PAKRO_DIFF', None)
XSH.env.pop('__PAKRO_SESSION', None)
