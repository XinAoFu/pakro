#!/usr/bin/env bash
#PAKRO description="Build the performance test workspace"
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
workspace="$repo_root/tests/benchmarks/.work/perf-workspace"
mkdir -p "$workspace"
cd "$workspace"
PAKRO_DATA_DIR="${PAKRO_DATA_DIR:-$HOME/.local/share/pakro}"
mkdir -p .pakro-tasks "$PAKRO_DATA_DIR/plugins"

num_tasks=${NUM_TASKS:-1000}
num_tools=${NUM_TOOLS:-100}

create_tasks() {
	cat <<EOF >.pakro-tasks/perf-0
#!/bin/sh
#PAKRO description="task description"
echo running task
EOF
	chmod +x .pakro-tasks/perf-0
	for i in $(seq 1 "$num_tasks"); do
		ln -sf ./perf-0 ".pakro-tasks/perf-$i"
	done
}

create_tools() {
	# shellcheck disable=SC2207
	tools=($(seq 0 "$num_tools"))
	if [ ! -d "$PAKRO_DATA_DIR/plugins/tiny" ]; then
		git clone https://github.com/jdx/mise-tiny.git "$PAKRO_DATA_DIR/plugins/tiny"
	fi
	{
		echo "[tools]"
		for i in "${tools[@]}"; do
			echo "\"perf-$i\" = \"$i\""
		done
		echo "[alias]"
		for i in "${tools[@]}"; do
			echo "\"perf-$i\" = \"asdf:jdx/mise-tiny\""
		done
	} >pakro.toml

	for i in "${tools[@]}"; do
		ln -sf ./tiny "$PAKRO_DATA_DIR/plugins/perf-$i"
	done
}

create_tasks
create_tools
