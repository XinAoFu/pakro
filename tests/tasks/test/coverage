#!/usr/bin/env bash
#PAKRO description="Run all tests with coverage report"

echo "::group::Setup"
set -euxo pipefail
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$PWD/target}"
export PATH="${CARGO_TARGET_DIR}/debug:$PATH"

echo "::endgroup::"
echo "::group::pakro install"
pakro install
echo "::endgroup::"
pakro x -- ./tests/e2e/run_all_tests
