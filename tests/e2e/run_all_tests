#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# shellcheck source-path=SCRIPTDIR
source "$SCRIPT_DIR/style.sh"

# Tests named as arguments (paths relative to tests/e2e/) run in the given order,
# including slow ones; `pakro run test:e2e` passes them when E2E_JOBS is set.
# Without arguments, every test is discovered.
EXPLICIT_FILES=0
RELEASE_SKIP=0
if (($# > 0)); then
  EXPLICIT_FILES=1
  FILES=("$@")
else
  # Check for .release-skip-e2e and skip all tests if version matches
  RELEASE_SKIP_FILE="$ROOT/.release-skip-e2e"
  VERSION="$(cd "$ROOT" && . "$ROOT/packaging/scripts/get-version.sh" | tr -d '\n')"
  if [[ -f $RELEASE_SKIP_FILE ]]; then
    if grep -Fxq "$VERSION" "$RELEASE_SKIP_FILE"; then
      echo "[e2e] Skipping all e2e tests: .release-skip-e2e contains $VERSION" >&2
      RELEASE_SKIP=1
    fi
  fi

  pushd "$SCRIPT_DIR" >/dev/null
  list_test_files() {
    local pattern="$1"
    find . -type f -name "$pattern" | sed 's#^\./##' | sort
  }

  # Avoid mapfile that is not available on bash 3.2 for compatibility with macOS
  SLOW_FILES=()
  while IFS= read -r line; do
    SLOW_FILES+=("$line")
  done < <(list_test_files "test_*_slow")
  FAST_FILES=()
  while IFS= read -r line; do
    FAST_FILES+=("$line")
  done < <(list_test_files "test_*" | grep -v "_slow$")
  popd >/dev/null
  # Bash 3.2 treats an empty array expansion as unset with nounset enabled.
  FILES=(${FAST_FILES[@]+"${FAST_FILES[@]}"} ${SLOW_FILES[@]+"${SLOW_FILES[@]}"})
fi
test_count=0
skipped_count=0
status=0
RUN_FILES=()
SUMMARY_ENTRY_TYPES=()
SUMMARY_ENTRY_VALUES=()
SUMMARY_FILES=()
ORIGINAL_GITHUB_STEP_SUMMARY="${GITHUB_STEP_SUMMARY:-}"

report_results() {
  local entry_index entry_type entry_value
  if ((${#SUMMARY_ENTRY_TYPES[@]} > 0)); then
    for entry_index in "${!SUMMARY_ENTRY_TYPES[@]}"; do
      entry_type="${SUMMARY_ENTRY_TYPES[$entry_index]}"
      entry_value="${SUMMARY_ENTRY_VALUES[$entry_index]}"
      if [[ $entry_type == run ]]; then
        if [[ -n $ORIGINAL_GITHUB_STEP_SUMMARY && -f ${SUMMARY_FILES[$entry_value]} ]]; then
          cat "${SUMMARY_FILES[$entry_value]}" >>"$ORIGINAL_GITHUB_STEP_SUMMARY"
        fi
      else
        echo "SKIP: $entry_value ($entry_type)" >&2
        summary "$entry_value" "-" ":zap: ($entry_type)"
      fi
    done
  fi
  echo "E2E: ran $test_count tests, skipped $skipped_count tests" >&2
}

summary "Test" "Duration" "Result"
summary "---" "---" "---"

if ((${#FILES[@]} > 0)); then
  for index in "${!FILES[@]}"; do
    TEST_NAME="${FILES[$index]}"
    skip_reason=""
    if [[ $RELEASE_SKIP == 1 ]]; then
      skip_reason="release-skip"
    elif [[ -n ${TEST_TRANCHE_COUNT:-} ]] && [[ $((index % TEST_TRANCHE_COUNT)) -ne $TEST_TRANCHE ]]; then
      skip_reason="tranche"
    elif [[ $EXPLICIT_FILES == 0 && ${TEST_ALL:-0} != 1 && $TEST_NAME == *_slow ]]; then
      skip_reason="slow"
    fi

    if [[ -n $skip_reason ]]; then
      skipped_count=$((skipped_count + 1))
      SUMMARY_ENTRY_TYPES+=("$skip_reason")
      SUMMARY_ENTRY_VALUES+=("$TEST_NAME")
      continue
    fi

    SUMMARY_ENTRY_TYPES+=("run")
    SUMMARY_ENTRY_VALUES+=("${#RUN_FILES[@]}")
    RUN_FILES+=("$TEST_NAME")
  done
fi

total=${#RUN_FILES[@]}
if ((total == 0)); then
  report_results
  if [[ $RELEASE_SKIP == 1 ]]; then
    exit 0
  fi
  err "No e2e tests selected to run"
  exit 1
fi

cpu_count() {
  if command -v getconf >/dev/null 2>&1; then
    getconf _NPROCESSORS_ONLN 2>/dev/null && return
  fi
  if command -v sysctl >/dev/null 2>&1; then
    sysctl -n hw.ncpu 2>/dev/null && return
  fi
  echo 4
}

default_jobs="$(cpu_count)"
if [[ ! $default_jobs =~ ^[0-9]+$ || $default_jobs -lt 1 ]]; then
  default_jobs=4
fi
if [[ $default_jobs -gt 4 ]]; then
  default_jobs=4
fi
E2E_JOBS="${E2E_JOBS:-$default_jobs}"
if [[ ! $E2E_JOBS =~ ^[0-9]+$ || $E2E_JOBS -lt 1 ]]; then
  err "E2E_JOBS must be a positive integer"
  exit 1
fi

# CI opts into retries; local runs fail on the first attempt by default.
E2E_MAX_ATTEMPTS="${E2E_MAX_ATTEMPTS:-1}"
E2E_RETRY_WAIT_SECONDS="${E2E_RETRY_WAIT_SECONDS:-30}"
if [[ ! $E2E_MAX_ATTEMPTS =~ ^[1-9][0-9]*$ ]]; then
  err "E2E_MAX_ATTEMPTS must be a positive integer"
  exit 1
fi
if [[ ! $E2E_RETRY_WAIT_SECONDS =~ ^(0|[1-9][0-9]*)$ ]]; then
  err "E2E_RETRY_WAIT_SECONDS must be a non-negative integer"
  exit 1
fi

PIDS=()
LOG_FILES=()
STATUS_FILES=()
FINISHED=()
FAILED_TESTS=()

SHOW_PASSING_LOGS="${E2E_SHOW_PASSING_LOGS:-}"
if [[ -z $SHOW_PASSING_LOGS ]]; then
  if [[ -n ${GITHUB_ACTIONS:-} ]]; then
    SHOW_PASSING_LOGS=0
  else
    SHOW_PASSING_LOGS=1
  fi
fi

LOG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/pakro-e2e-logs.XXXXXX")"
# shellcheck disable=SC2329
cleanup() {
  if ((${#PIDS[@]} > 0)); then
    kill "${PIDS[@]}" 2>/dev/null || true
  fi
  rm -rf "$LOG_DIR"
}
trap 'cleanup' EXIT
trap 'cleanup; exit 130' INT TERM

next=0
active=0
completed=0
printed=0

start_test() {
  local index="$1"
  local test_name="${RUN_FILES[$index]}"
  local log_file="$LOG_DIR/$index.log"
  local summary_file="$LOG_DIR/$index.summary"
  local status_file="$LOG_DIR/$index.status"

  LOG_FILES[index]="$log_file"
  SUMMARY_FILES[index]="$summary_file"
  STATUS_FILES[index]="$status_file"

  (
    if [[ -n $ORIGINAL_GITHUB_STEP_SUMMARY ]]; then
      export GITHUB_STEP_SUMMARY="$summary_file"
    else
      unset GITHUB_STEP_SUMMARY
    fi
    for ((attempt = 1; attempt <= E2E_MAX_ATTEMPTS; attempt++)); do
      # The step summary reports the final attempt; logs retain every attempt.
      if [[ -n ${GITHUB_STEP_SUMMARY:-} ]]; then
        : >"$GITHUB_STEP_SUMMARY"
      fi
      test_status=0
      "$ROOT/tests/e2e/run_test" "$test_name" || test_status=$?
      # Setup failures and Docker runs may not produce their own summary row.
      if [[ -n ${GITHUB_STEP_SUMMARY:-} && ! -s $GITHUB_STEP_SUMMARY ]]; then
        if [[ $test_status == 0 ]]; then
          summary "$test_name" "-" ":white_check_mark:"
        else
          summary "$test_name" "-" ":x:"
        fi
      fi
      if [[ $test_status == 0 || $attempt == "$E2E_MAX_ATTEMPTS" ]]; then
        break
      fi
      echo "Retrying $test_name (attempt $((attempt + 1))/$E2E_MAX_ATTEMPTS) after ${E2E_RETRY_WAIT_SECONDS}s" >&2
      touch "$LOG_DIR/$index.retried"
      sleep "$E2E_RETRY_WAIT_SECONDS"
    done
    echo "$test_status" >"$status_file.tmp" && mv "$status_file.tmp" "$status_file"
  ) >"$log_file" 2>&1 &

  PIDS[index]=$!
}

while [[ $completed -lt $total ]]; do
  while [[ $active -lt $E2E_JOBS && $next -lt $total ]]; do
    start_test "$next"
    next=$((next + 1))
    active=$((active + 1))
  done

  for ((index = 0; index < next; index++)); do
    status_file="${STATUS_FILES[$index]:-}"
    if [[ ${FINISHED[$index]:-0} == 0 && -n $status_file ]]; then
      if [[ -f $status_file ]]; then
        FINISHED[index]=1
        active=$((active - 1))
        completed=$((completed + 1))
      elif ! kill -0 "${PIDS[$index]}" 2>/dev/null; then
        if [[ ! -f $status_file ]]; then
          echo "test process exited without writing status: ${RUN_FILES[$index]}" >>"${LOG_FILES[$index]}"
          echo "1" >"$status_file.tmp" && mv "$status_file.tmp" "$status_file"
        fi
        FINISHED[index]=1
        active=$((active - 1))
        completed=$((completed + 1))
      fi
    fi
  done

  while [[ $printed -lt $total && ${FINISHED[$printed]:-0} == 1 ]]; do
    test_status="$(cat "${STATUS_FILES[$printed]}")"
    test_status="${test_status:-1}"
    if [[ $test_status != 0 ]]; then
      status=1
      FAILED_TESTS+=("${RUN_FILES[$printed]}")
      cat "${LOG_FILES[$printed]}"
    elif [[ $SHOW_PASSING_LOGS == 1 || -f $LOG_DIR/$printed.retried ]]; then
      cat "${LOG_FILES[$printed]}"
    else
      echo "PASS: ${RUN_FILES[$printed]}" >&2
    fi
    test_count=$((test_count + 1))
    printed=$((printed + 1))
  done

  if [[ $completed -lt $total ]]; then
    sleep 0.2
  fi
done

if ((${#PIDS[@]} > 0)); then
  for pid in "${PIDS[@]}"; do
    wait "$pid" || true
  done
fi

report_results

if ((${#FAILED_TESTS[@]} > 0)); then
  echo >&2
  echo "Failed e2e tests (${#FAILED_TESTS[@]}):" >&2
  for failed in "${FAILED_TESTS[@]}"; do
    echo "  - $failed" >&2
  done
  if [[ -n ${GITHUB_ACTIONS:-} ]]; then
    failed_joined="$(
      IFS=,
      echo "${FAILED_TESTS[*]}"
    )"
    echo "::error title=E2E failures (${#FAILED_TESTS[@]})::${failed_joined}" >&2
    if [[ -n $ORIGINAL_GITHUB_STEP_SUMMARY ]]; then
      {
        echo
        echo "### :x: Failed e2e tests (${#FAILED_TESTS[@]})"
        for failed in "${FAILED_TESTS[@]}"; do
          echo "- \`$failed\`"
        done
        echo
      } >>"$ORIGINAL_GITHUB_STEP_SUMMARY"
    fi
  fi
fi

exit "$status"
