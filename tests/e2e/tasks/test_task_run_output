#!/usr/bin/env bash

cat <<EOF >pakro.toml
[tasks.a]
run = 'echo running a'
[tasks.b]
depends = 'a'
run = 'echo running b'
[tasks.c]
depends = ['b']
run = 'echo running c'
[tasks.all]
depends = ['a', 'b', 'c']
depends_post = 'z'
run = 'echo running all'
[tasks.d]
run = 'echo running d'
[tasks.z]
run = 'echo running z'
EOF

PAKRO_TASK_OUTPUT=silent assert_empty "pakro run all" ""
PAKRO_TASK_OUTPUT=quiet assert "pakro run all" "running a
running b
running c
running all
running z"
# test that task.output config setting works the same as PAKRO_TASK_OUTPUT env var
cat <<EOF >pakro.toml
[settings]
task.output = "silent"
[tasks.a]
run = 'echo running a'
[tasks.b]
depends = 'a'
run = 'echo running b'
[tasks.c]
depends = ['b']
run = 'echo running c'
[tasks.all]
depends = ['a', 'b', 'c']
depends_post = 'z'
run = 'echo running all'
[tasks.d]
run = 'echo running d'
[tasks.z]
run = 'echo running z'
EOF
assert_empty "pakro run all" ""
cat <<EOF >pakro.toml
[settings]
task.output = "quiet"
[tasks.a]
run = 'echo running a'
[tasks.b]
depends = 'a'
run = 'echo running b'
[tasks.c]
depends = ['b']
run = 'echo running c'
[tasks.all]
depends = ['a', 'b', 'c']
depends_post = 'z'
run = 'echo running all'
[tasks.d]
run = 'echo running d'
[tasks.z]
run = 'echo running z'
EOF
assert "pakro run all" "running a
running b
running c
running all
running z"
cat <<EOF >pakro.toml
[tasks.a]
run = 'echo running a'
[tasks.b]
depends = 'a'
run = 'echo running b'
[tasks.c]
depends = ['b']
run = 'echo running c'
[tasks.all]
depends = ['a', 'b', 'c']
depends_post = 'z'
run = 'echo running all'
[tasks.d]
run = 'echo running d'
[tasks.z]
run = 'echo running z'
EOF
PAKRO_TASK_OUTPUT=interleave assert "pakro run all" "running a
running b
running c
running all
running z"
PAKRO_TASK_OUTPUT=prefix assert "pakro run all" "[a] running a
[b] running b
[c] running c
[all] running all
[z] running z"
# defaults to interleave if linear dependency graph
assert "pakro run all" "running a
running b
running c
running all
running z"
# now the graph isn't linear so it uses prefix
assert_contains "pakro run a ::: d" "[a] running a"
assert_contains "pakro run a ::: d" "[d] running d"
assert "pakro tasks deps" "a
all
├── c
│   └── b
│       └── a
├── b
│   └── a
└── a
b
└── a
c
└── b
    └── a
d
z
z (post)
└── all
    ├── c
    │   └── b
    │       └── a
    ├── b
    │   └── a
    └── a"
