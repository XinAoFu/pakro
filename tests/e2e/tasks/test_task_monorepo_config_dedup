#!/usr/bin/env bash

export PAKRO_EXPERIMENTAL=1

marker="$PAKRO_TMP_DIR/monorepo-config-render-count"
mkdir -p apps/example

cat <<'EOF' >pakro.toml
monorepo_root = true

[monorepo]
config_roots = ["apps/*"]
EOF

cat >apps/example/pakro.toml <<EOF
[tasks.render-once]
description = "{{ exec(command='echo rendered >> $marker') }}"
run = "echo render-once"
EOF
ln -s pakro.toml apps/example/pakro.local.toml

pakro tasks --all >/dev/null
assert "wc -l < '$marker' | tr -d ' '" "1"
