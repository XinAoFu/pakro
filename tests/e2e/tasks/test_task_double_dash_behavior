#!/usr/bin/env bash

# Test flag routing: pakro flags ONLY work BEFORE task name, flags after task go to task

cat <<'EOF' >pakro.toml
[tasks.echo_args]
run = 'echo "args:$@"'
EOF

# Test 1: Pakro flags work ONLY before task name
# -q before task = pakro flag, -q after task = task arg
assert "pakro run -q echo_args arg1 2>&1" "args: arg1"
assert_contains "pakro run echo_args -q arg1 2>&1" "args: -q arg1"
assert "pakro -q run echo_args arg1 2>&1" "args: arg1"

# Test 2: Naked runs - pakro flags only before task name
assert "pakro -q echo_args arg1 2>&1" "args: arg1"
assert_contains "pakro echo_args -q arg1 2>&1" "args: -q arg1"

# Test 3: Unknown flags go to task
cat <<'EOF' >pakro.toml
[tasks.echo_args]
run = 'echo "args:$@"'
EOF

assert "pakro run echo_args -x" "args: -x"
assert "pakro run echo_args --custom" "args: --custom"
assert "pakro echo_args -x" "args: -x"
assert "pakro echo_args --custom" "args: --custom"

# Test 4: Explicit -- separator passes args to task (no prefix!)
assert "pakro run echo_args -- -q" "args: -q"
assert "pakro run echo_args -- --help" "args: --help"
assert "pakro echo_args -- -q" "args: -q"
assert "pakro echo_args -- --help" "args: --help"

# Test 5: Multiple args after --
assert "pakro run echo_args -- arg1 arg2 arg3" "args: arg1 arg2 arg3"
assert "pakro echo_args -- arg1 arg2 arg3" "args: arg1 arg2 arg3"

# Test 6: Mixed flags and args work correctly
assert "pakro run -q echo_args -x arg1" "args: -x arg1"
assert "pakro -q echo_args --custom arg1" "args: --custom arg1"

# Test 7: Task with usage spec
cat <<'EOF' >pakro.toml
[tasks.with_usage]
run = 'echo "custom=$usage_custom file=$usage_file args=$@"'
usage = """
flag "-x --custom" help="Custom flag"
arg "<file>" help="File to process"
"""
EOF

# Usage spec handles its own flags (parsed by usage spec, not passed as $@)
# shellcheck disable=SC2016
assert "pakro run with_usage -x myfile 2>&1" '[with_usage] $ echo "custom=$usage_custom file=$usage_file args=$@"
custom=true file=myfile args='

# But pakro flags still go to pakro (myfile is consumed by usage spec, not passed to $@)
assert "pakro run -q with_usage myfile" "custom= file=myfile args="

# Test 8: --help shows usage spec help
assert "pakro run with_usage --help 2>&1 || true" "Usage: with_usage [-x --custom] <file>

Arguments:
  <file>  File to process

Flags:
  -x, --custom  Custom flag
  -h, --help    Print help"

# Test 9: Help passed as explicit argument with -- (recreate echo_args task)
cat <<'EOF' >pakro.toml
[tasks.echo_args]
run = 'echo "args:$@"'
EOF

assert "pakro run echo_args -- --help" "args: --help"

# Test 10: Tasks can use pakro flags explicitly with --
cat <<'EOF' >pakro.toml
[tasks.custom_quiet]
run = '''
#!/usr/bin/env bash
while getopts "q" opt; do
  case $opt in
    q) echo "custom quiet flag received" ;;
  esac
done
'''
EOF

# Task can receive -q via --
assert "pakro run custom_quiet -- -q" "custom quiet flag received"
assert "pakro custom_quiet -- -q" "custom quiet flag received"

# With new behavior, -q after task name also goes to task
assert "pakro run custom_quiet -q" "custom quiet flag received"
assert "pakro custom_quiet -q" "custom quiet flag received"

# Test 11: Complex scenarios
cat <<'EOF' >pakro.toml
[tasks.complex]
run = 'echo "received: $@"'
EOF

# Multiple pakro flags + task args
assert "pakro run -q complex arg1 arg2" "received:  arg1 arg2"

# Mix of pakro flags and unknown flags
assert "pakro run -q complex -x -y" "received:  -x -y"

# Explicit -- overrides everything
assert "pakro run complex -- -q -v arg1" "received:  -q -v arg1"
