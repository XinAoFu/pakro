#!/usr/bin/env bash

# Test that non-executable files in pakro-tasks/ give a helpful error message
# Issue: https://github.com/jdx/mise/discussions/8614

# Create a pakro-tasks directory with non-executable files
mkdir -p pakro-tasks
cat <<'EOF' >pakro-tasks/build
#!/usr/bin/env bash
echo "building"
EOF
cat <<'EOF' >pakro-tasks/test
#!/usr/bin/env bash
echo "testing"
EOF

# Ensure files are NOT executable
chmod -x pakro-tasks/build pakro-tasks/test

# Create a minimal pakro.toml so the directory is recognized as a project
cat <<EOF >pakro.toml
EOF

# Running a task should give a helpful error mentioning non-executable files
assert_fail_contains "PAKRO_YES=0 pakro run build" "non-executable"
assert_fail_contains "PAKRO_YES=0 pakro run build" "chmod +x"

# pakro tasks ls should warn about non-executable files
assert_contains "pakro tasks 2>&1" "non-executable"
assert_contains "pakro tasks 2>&1" "chmod +x"

# Auto-confirm should make the requested file executable and run it immediately
assert "PAKRO_YES=1 pakro run build" "building"
[[ -x pakro-tasks/build ]] || fail "PAKRO_YES did not make the task executable"

assert "PAKRO_YES=0 pakro --yes run test" "testing"
[[ -x pakro-tasks/test ]] || fail "--yes did not make the task executable"

# The yes setting should behave the same way
chmod 0644 pakro-tasks/build
cat <<EOF >pakro.toml
[tasks.existing]
run = "true"
EOF
cat <<EOF >"$PAKRO_CONFIG_DIR/config.toml"
[settings]
yes = true
EOF
assert "env -u PAKRO_YES pakro run build" "building"
[[ -x pakro-tasks/build ]] || fail "yes setting did not make the task executable"

# After making files executable, tasks should work
chmod +x pakro-tasks/build pakro-tasks/test
assert_contains "pakro tasks" "build"
assert_contains "pakro tasks" "test"
assert "pakro run build" "building"

# Monorepo-qualified task names should resolve to the scoped task include directory
mkdir -p monorepo/projects/frontend/pakro-tasks
cat <<EOF >monorepo/pakro.toml
monorepo_root = true

[monorepo]
config_roots = ["projects/*"]
EOF
cat <<'EOF' >monorepo/projects/frontend/pakro-tasks/build
#!/usr/bin/env bash
echo "frontend building"
EOF
chmod 0644 monorepo/projects/frontend/pakro-tasks/build

cd monorepo
assert "PAKRO_EXPERIMENTAL=1 PAKRO_YES=1 pakro run '//projects/frontend:build'" "frontend building"
[[ -x projects/frontend/pakro-tasks/build ]] ||
  fail "//projects/frontend:build did not make the task executable"

chmod 0644 projects/frontend/pakro-tasks/build
cd projects/frontend
assert "PAKRO_EXPERIMENTAL=1 PAKRO_YES=1 pakro run ':build'" "frontend building"
[[ -x pakro-tasks/build ]] || fail ":build did not make the task executable"
