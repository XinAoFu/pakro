#!/usr/bin/env bash

# Test the `pakro tasks ls --usage` functionality (display_usage)

# Test 1: Basic usage output with simple tasks
cat <<EOF >pakro.toml
[tasks.simple]
run = 'echo "simple task"'
description = "A simple task with no arguments"

[tasks.with-args]
run = 'echo "arg={{arg(name="myarg")}}"'
description = "Task with arguments"

[tasks.with-flags]
run = 'echo "verbose={{flag(name="verbose")}}"'
description = "Task with flags"
EOF

# Test basic usage output format contains expected tasks
assert_contains "pakro tasks ls --usage" 'cmd simple help="A simple task with no arguments"'
assert_contains "pakro tasks ls --usage" 'cmd with-args help="Task with arguments"'
assert_contains "pakro tasks ls --usage" 'cmd with-flags help="Task with flags"'

# Test 2: Tasks with aliases and dependencies
cat <<EOF >pakro.toml
[tasks.parent]
run = 'echo "parent"'
description = "Parent task"

[tasks.child]
run = 'echo "child"'
description = "Child task"
alias = "c"
depends = ["parent"]
EOF

assert_contains "pakro tasks ls --usage" 'cmd parent help="Parent task"'
assert_contains "pakro tasks ls --usage" 'cmd child help="Child task"'
assert_contains "pakro tasks ls --usage" 'alias c'

# Test 3: File-based tasks
mkdir -p pakro-tasks
cat <<'EOF' >pakro-tasks/file-task
#!/usr/bin/env bash
#PAKRO description="A file-based task"
echo "file task"
EOF
chmod +x pakro-tasks/file-task

assert_contains "pakro tasks ls --usage" 'cmd file-task help="A file-based task"'

# Test 3b: File-based tasks can mount generated usage specs
cat <<'EOF' >pakro-tasks/mounted-task
#!/usr/bin/env bash
#USAGE mount "mounted --usage-spec"
exec mounted "$@"
EOF
chmod +x pakro-tasks/mounted-task

assert_contains "pakro tasks ls --usage" 'cmd mounted-task'
assert_contains "pakro tasks ls --usage" 'mount run="mounted --usage-spec"'

cat <<'EOF' >pakro-tasks/pakro-mounted-task
#!/usr/bin/env bash
#PAKRO mount "pakro-mounted --usage-spec"
exec pakro-mounted "$@"
EOF
chmod +x pakro-tasks/pakro-mounted-task

assert_contains "pakro tasks ls --usage" 'cmd pakro-mounted-task'
assert_contains "pakro tasks ls --usage" 'mount run="pakro-mounted --usage-spec"'

# Test 4: Hidden tasks should not appear
cat <<EOF >pakro.toml
[tasks.visible]
run = 'echo "visible"'
description = "Visible task"

[tasks.hidden]
run = 'echo "hidden"'
description = "Hidden task"
hide = true
EOF

assert_contains "pakro tasks ls --usage" 'cmd visible help="Visible task"'
assert_not_contains "pakro tasks ls --usage" 'cmd hidden help="Hidden task"'

# Test 5: Task with no description
cat <<EOF >pakro.toml
[tasks.no-desc]
run = 'echo "no description"'
EOF

assert_contains "pakro tasks ls --usage" 'cmd no-desc'

# Test 6: Performance test - should be fast even with complex environment
cat <<EOF >pakro.toml
[tasks.complex-env]
run = 'echo "arg={{arg(name="test_arg")}}"'
description = "Task with complex environment"

[tasks.complex-env.env]
TEST_VAR = "test_value"

[tasks.complex-env.tools]
node = "latest"
EOF

# This should complete quickly (within 5 seconds)
timeout 5 pakro tasks ls --usage >/dev/null || fail "Usage generation took too long"

echo "All usage display tests passed!"
