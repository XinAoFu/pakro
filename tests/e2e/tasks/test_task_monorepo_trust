#!/usr/bin/env bash

# Test that trusting a monorepo root implicitly trusts all descendant configs
export PAKRO_EXPERIMENTAL=1

# Create monorepo root config
cat <<EOF >pakro.toml
monorepo_root = true

[monorepo]
config_roots = ["projects/*", "projects/frontend/*"]

[tasks.root-task]
run = 'echo "root task"'
EOF

# Create nested project structure
mkdir -p projects/frontend/components
cat <<EOF >projects/frontend/pakro.toml
[tasks.build]
run = 'echo "frontend build"'
EOF

cat <<EOF >projects/frontend/components/pakro.toml
[tasks.test]
run = 'echo "component test"'
EOF

# Trust the root config
pakro trust

# Verify that all tasks are accessible without additional trust prompts
# The lack of "not trusted" warnings in stderr indicates implicit trust is working
assert_contains "pakro tasks ls --all 2>&1" "//:root-task"
assert_contains "pakro tasks ls --all 2>&1" "//projects/frontend:build"
assert_contains "pakro tasks ls --all 2>&1" "//projects/frontend/components:test"

# Verify no trust warnings appear
assert_not_contains "pakro tasks ls --all 2>&1" "not trusted"
assert_not_contains "pakro tasks ls --all 2>&1" "Trust them"

# Verify we can run tasks from nested configs
assert_contains "pakro run '//projects/frontend:build'" "frontend build"
assert_contains "pakro run '//projects/frontend/components:test'" "component test"

# A higher-precedence false overlay disables both monorepo behavior and the
# derived trust marker. A marker created by the earlier commands must not keep
# authorizing descendant configs.
cat <<EOF >pakro.disabled.toml
monorepo_root = false
EOF
mkdir -p disabled-child
cat <<EOF >disabled-child/pakro.toml
[env]
UNTRUSTED_CHILD = "must prompt"
EOF
export PAKRO_TRUSTED_CONFIG_PATHS=""
assert_contains "PAKRO_ENV=disabled PAKRO_YES=0 pakro -C disabled-child env 2>&1 || true" "are not trusted"

# Test that trust warnings DO appear for unsafe configs outside monorepo
# (tasks-only configs are safe and load without trust, so use [env] to make
# this one require trust)
mkdir -p ../parent-dir
cat <<EOF >../parent-dir/pakro.toml
[env]
FOO = "bar"

[tasks.parent-task]
run = 'echo "parent task"'
EOF

# Clear trust to simulate untrusted state
# Verify trust error appears for the parent config (command should fail)
assert_contains "PAKRO_YES=0 pakro -C ../parent-dir tasks ls 2>&1 || true" "are not trusted"
