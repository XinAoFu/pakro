#!/usr/bin/env bash

# Test that :task syntax only works in monorepos

# Test 1: Outside monorepo, :build should NOT work
cat <<'EOF' >pakro.toml
[tasks.build]
run = 'echo "build task"'

[tasks."project:build"]
run = 'echo "project:build task"'
EOF

# Should fail with helpful error about monorepo setup
assert_fail "pakro run ':build'" "require a monorepo root configuration"

# Test 2: In monorepo with experimental mode, :build SHOULD work
export PAKRO_EXPERIMENTAL=1

cat <<'EOF' >pakro.toml
monorepo_root = true

[monorepo]
config_roots = ["project", "app"]

[tasks.build]
run = 'echo "root build task"'
EOF

mkdir -p project
cat <<'EOF' >project/pakro.toml
[tasks.build]
run = 'echo "project build task"'
EOF

mkdir -p app
cat <<'EOF' >app/pakro.toml
[tasks.build]
run = 'echo "app build task"'
EOF

# Running ':build' from root should match root-level build task (not monorepo tasks)
assert_contains "pakro run ':build'" "root build task"

# Should NOT run project:build or app:build from root
OUTPUT_ROOT=$(pakro run ':build')
if echo "$OUTPUT_ROOT" | grep -E "project build task|app build task"; then
  echo "ERROR: 'pakro run :build' from root incorrectly matched child tasks"
  exit 1
fi

# Running ':build' from project dir should only match //project:build
(
  cd project
  assert_contains "pakro run ':build'" "project build task"

  # Should NOT run app:build when we're in project directory
  OUTPUT=$(pakro run ':build')
  if echo "$OUTPUT" | grep -q "app build task"; then
    echo "ERROR: 'pakro run :build' from project dir incorrectly matched //app:build"
    exit 1
  fi
)

# Running ':build' from app dir should only match //app:build
(
  cd app
  assert_contains "pakro run ':build'" "app build task"

  # Should NOT run project:build when we're in app directory
  OUTPUT2=$(pakro run ':build')
  if echo "$OUTPUT2" | grep -q "project build task"; then
    echo "ERROR: 'pakro run :build' from app dir incorrectly matched //project:build"
    exit 1
  fi
)

# Test 3: Verify that 'pakro run build' does NOT match monorepo tasks
unset PAKRO_EXPERIMENTAL

cat <<'EOF' >pakro.toml
[tasks.build]
run = 'echo "root build"'

[tasks."project:build"]
run = 'echo "project build"'
EOF

# Should only run 'build', not 'project:build'
OUTPUT2=$(pakro run build)

assert_contains "pakro run build" "root build"

if echo "$OUTPUT2" | grep -q "project build"; then
  echo "ERROR: 'pakro run build' incorrectly matched 'project:build'"
  exit 1
fi
