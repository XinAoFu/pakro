#!/usr/bin/env bash

cat <<EOF >pakro.toml
tasks.a = "echo running a"
tasks.b = "echo running b"
tasks.c = "echo running c"
tasks.all.run = "echo testing!"
tasks.all.depends = ["a", "b", "c"]
EOF

assert_contains "pakro run all" "running b"
PAKRO_TASK_SKIP=b assert_not_contains "pakro run all" "running b"
