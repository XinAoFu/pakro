#!/usr/bin/env bash

# Test successful validation
cat <<EOF >pakro.toml
[tasks.valid]
run = "echo valid"

[tasks.meta-task]
depends = ["valid"]
EOF

assert_contains "pakro tasks validate" "✓ All 2 task(s) validated successfully"

# Test circular dependency detection
cat <<EOF >pakro.toml
[tasks.a]
run = "echo a"
depends = ["b"]

[tasks.b]
run = "echo b"
depends = ["a"]
EOF

assert_contains "pakro tasks validate 2>&1 || true" "Circular dependency detected"
assert_contains "pakro tasks validate 2>&1 || true" "circular-dependency"
assert_contains "pakro tasks validate 2>&1 || true" "a -> b -> a"

# Test cycles involving wait_for are detected by validation and before execution
cat <<EOF >pakro.toml
[tasks.a]
run = "echo a"
depends = ["b"]

[tasks.b]
run = "echo b"
wait_for = ["a"]
EOF

assert_contains "pakro tasks validate 2>&1 || true" "a -> b -> a"
assert_contains "pakro run a 2>&1 || true" "circular dependency detected: a -> b -> a"

# Test cycles introduced by rendering a nested task's usage defaults
cat <<'EOF' >pakro.toml
[tasks.a]
run = "echo a"
depends = ["b"]

[tasks.b]
usage = 'flag "--enabled" default=#true'
run = "echo b"
depends = ["{% if usage.enabled %}a{% endif %}"]
EOF

assert_contains "pakro tasks validate 2>&1 || true" "a -> b -> a"
assert_contains "pakro run a 2>&1 || true" "circular dependency detected: a -> b -> a"

# Test non-cycle dependency graph failures are reported as validation errors
cat <<'EOF' >pakro.toml
[tasks.root]
run = "echo root"
depends = ["child"]

[tasks.child]
usage = "not valid usage syntax"
run = "echo child"
depends = ["{{usage.target}}"]
EOF

assert_contains "pakro tasks validate 2>&1 || true" "Failed to build task dependency graph"
assert_contains "pakro tasks validate 2>&1 || true" "dependency-graph-error"

# Test an unrelated graph failure does not hide a cycle in another task graph
cat <<'EOF' >pakro.toml
[tasks.a]
run = "echo a"
depends = ["b"]

[tasks.b]
run = "echo b"
depends = ["a"]

[tasks.c]
run = "echo c"
depends = ["d"]

[tasks.d]
run = "echo d"
depends = ["c"]

[tasks.overlap]
run = "echo overlap"
depends = ["overlap-left", "overlap-right"]

[tasks.overlap-left]
run = "echo overlap-left"
depends = ["overlap"]

[tasks.overlap-right]
run = "echo overlap-right"
depends = ["overlap"]

[tasks.wait-a]
run = "echo wait-a"
wait_for = ["wait-b"]

[tasks.wait-b]
run = "echo wait-b"
wait_for = ["wait-a"]

[tasks.wait-c]
run = "echo wait-c"
wait_for = ["wait-d"]

[tasks.wait-d]
run = "echo wait-d"
wait_for = ["wait-c"]

[tasks.invalid]
run = "echo invalid"
depends = ["nonexistent"]

[tasks.also-invalid]
run = "echo also-invalid"
depends = ["nonexistent"]
EOF

assert_contains "pakro tasks validate 2>&1 || true" "dependency-graph-error"
assert_contains "pakro tasks validate 2>&1 || true" "circular-dependency"
assert_contains "pakro tasks validate 2>&1 || true" "a -> b -> a"
graph_error_count=$(pakro tasks validate --json 2>&1 | grep -c '"category": "dependency-graph-error"' || true)
assert "echo $graph_error_count" "2"
cycle_error_count=$(pakro tasks validate --json 2>&1 | grep -c '"category": "circular-dependency"' || true)
assert "echo $cycle_error_count" "6"

# A depends_post reference creates a separate post phase, so this is acyclic:
# a runs normally, then again as b's post-phase prerequisite, followed by b.
cat <<EOF >pakro.toml
[tasks.a]
run = "echo a"
depends_post = ["b"]

[tasks.b]
run = "echo b"
depends = ["a"]
EOF

assert_contains "pakro tasks validate" "✓ All 2 task(s) validated successfully"
assert "pakro run a" "a
a
b"

# Test missing dependency
cat <<EOF >pakro.toml
[tasks.valid]
run = "echo valid"

[tasks.invalid]
run = "echo invalid"
depends = ["nonexistent"]
EOF

assert_contains "pakro tasks validate 2>&1 || true" "Dependency 'nonexistent' not found"
assert_contains "pakro tasks validate 2>&1 || true" "missing-dependency"

# Test invalid timeout
cat <<EOF >pakro.toml
[tasks.bad-timeout]
run = "echo test"
timeout = "not-a-duration"
EOF

assert_contains "pakro tasks validate 2>&1 || true" "Invalid timeout format"
assert_contains "pakro tasks validate 2>&1 || true" "invalid-timeout"

# Test valid timeout formats
cat <<EOF >pakro.toml
[tasks.good-timeout-1]
run = "echo test"
timeout = "30s"

[tasks.good-timeout-2]
run = "echo test"
timeout = "5m"

[tasks.good-timeout-3]
run = "echo test"
timeout = "1h"
EOF

assert_contains "pakro tasks validate" "✓ All 3 task(s) validated successfully"

# Test duplicate aliases (should only report once, not for each task)
cat <<EOF >pakro.toml
[tasks.task1]
run = "echo 1"
alias = "myalias"

[tasks.task2]
run = "echo 2"
alias = "myalias"
EOF

assert_contains "pakro tasks validate 2>&1 || true" "Alias 'myalias' is used by multiple tasks"
assert_contains "pakro tasks validate 2>&1 || true" "alias-conflict"
# Verify the error is only reported once (not duplicated for each task)
error_count=$(pakro tasks validate 2>&1 | grep -c "Alias 'myalias' is used by multiple tasks" || true)
[ "$error_count" = "1" ] || (echo "Expected 1 alias conflict error, got $error_count" && exit 1)

# Test empty task
cat <<EOF >pakro.toml
[tasks.empty]
description = "empty task"
EOF

assert_contains "pakro tasks validate 2>&1 || true" "Task has no executable content"
assert_contains "pakro tasks validate 2>&1 || true" "no-execution"

# Test invalid glob pattern
cat <<EOF >pakro.toml
[tasks.bad-glob]
run = "echo test"
sources = ["[invalid-glob"]
EOF

assert_contains "pakro tasks validate 2>&1 || true" "Invalid source glob pattern"
assert_contains "pakro tasks validate 2>&1 || true" "invalid-glob-pattern"

# Negation (`!`-prefixed) and escaped (`\!`-prefixed) source patterns are valid
# once the prefix is stripped, and must not be reported as invalid.
cat <<'EOF' >pakro.toml
[tasks.good-exclusions]
run = "echo test"
sources = ["src/**/*.ts", "!src/**/*.test.ts", "!src/**/*.spec.ts", "\\!literal.txt"]
EOF

assert_contains "pakro tasks validate" "✓ All 1 task(s) validated successfully"

# A `!`-prefixed pattern that is otherwise invalid should still be reported.
cat <<EOF >pakro.toml
[tasks.bad-exclusion]
run = "echo test"
sources = ["!{[bad"]
EOF

assert_contains "pakro tasks validate 2>&1 || true" "Invalid source glob pattern"
assert_contains "pakro tasks validate 2>&1 || true" "invalid-glob-pattern"

# Test JSON output
cat <<EOF >pakro.toml
[tasks.valid]
run = "echo valid"

[tasks.invalid]
run = "echo invalid"
depends = ["missing"]
EOF

assert_contains "pakro tasks validate --json 2>&1 || true" '"tasks_validated": 2'
assert_contains "pakro tasks validate --json 2>&1 || true" '"errors": 2'
assert_contains "pakro tasks validate --json 2>&1 || true" '"category": "missing-dependency"'

# Test errors-only flag
cat <<EOF >pakro.toml
[tasks.error-task]
depends = ["missing"]

[tasks.warning-task]
file = "./non-executable.sh"
EOF

touch non-executable.sh
assert_contains "pakro tasks validate --errors-only 2>&1 || true" "error-task"
assert_not_contains "pakro tasks validate --errors-only 2>&1 || true" "warning-task"

# The remedy is platform-specific -- Windows has no chmod and its `is_executable` does not look at
# a permission bit -- so pin the unix wording here.
assert_contains "pakro tasks validate 2>&1 || true" "chmod +x"

# Test specific task validation
cat <<EOF >pakro.toml
[tasks.good]
run = "echo good"

[tasks.bad]
depends = ["missing"]
EOF

assert_contains "pakro tasks validate good" "✓ All 1 task(s) validated successfully"
assert_contains "pakro tasks validate bad 2>&1 || true" "Dependency 'missing' not found"

# Test validation with file-based tasks
mkdir -p pakro-tasks
cat <<'SCRIPT' >pakro-tasks/filetask.sh
#!/usr/bin/env bash
#PAKRO description="Test file task"
#PAKRO depends=["valid"]
echo "file task"
SCRIPT
chmod +x pakro-tasks/filetask.sh

cat <<EOF >pakro.toml
[tasks.valid]
run = "echo valid"
EOF

assert_contains "pakro tasks validate filetask" "✓ All 1 task(s) validated successfully"

# Test missing file
cat <<EOF >pakro.toml
[tasks.missing-file]
file = "./does-not-exist.sh"
EOF

assert_contains "pakro tasks validate 2>&1 || true" "Task file not found"
assert_contains "pakro tasks validate 2>&1 || true" "missing-file"

# Clean up before next test
rm -rf pakro-tasks non-executable.sh

# Test that run entries can reference tasks by alias (not just by name)
cat <<'EOF' >pakro.toml
[tasks.build]
run = "echo building"
alias = "b"

[tasks.deploy]
run = [
  { task = "b" }
]
EOF

assert_contains "pakro tasks validate" "✓ All 2 task(s) validated successfully"

# Test that command-line validation can use task aliases
assert_contains "pakro tasks validate b" "✓ All 1 task(s) validated successfully"
assert_contains "pakro tasks validate build" "✓ All 1 task(s) validated successfully"

# Test unknown field validation in file tasks
mkdir -p pakro-tasks
cat <<'SCRIPT' >pakro-tasks/bad-field
#!/usr/bin/env bash
#PAKRO description="Test file task"
#PAKRO not_a_valid_field="this should error"
echo "should not run"
SCRIPT
chmod +x pakro-tasks/bad-field

assert_contains "pakro tasks validate bad-field 2>&1 || true" "unknown field"
assert_contains "pakro tasks validate bad-field 2>&1 || true" "not_a_valid_field"

# Clean up
rm -rf pakro-tasks

# Test unknown field validation in TOML tasks
cat <<EOF >pakro.toml
[tasks.toml-bad-field]
run = "echo test"
not_a_valid_field = "this should error"
EOF

assert_contains "pakro tasks validate toml-bad-field 2>&1 || true" "unknown field"
assert_contains "pakro tasks validate toml-bad-field 2>&1 || true" "not_a_valid_field"

# Clean up pakro.toml before next test
rm -f pakro.toml

# Test multiple alias fields (both alias and aliases)
mkdir -p pakro-tasks
cat <<'SCRIPT' >pakro-tasks/multiple-alias
#!/usr/bin/env bash
#PAKRO description="Task with both alias and aliases"
#PAKRO alias="single"
#PAKRO aliases=["multi1", "multi2"]
echo "should not run"
SCRIPT
chmod +x pakro-tasks/multiple-alias

assert_contains "pakro tasks validate multiple-alias 2>&1 || true" "Cannot define both 'alias' and 'aliases'"

# Clean up
rm -rf pakro-tasks

# Test monorepo config_root dependency validation matches runtime resolution
rm -f pakro.toml
mkdir -p monorepo-validate/pkg
cat <<'EOF' >monorepo-validate/pakro.toml
monorepo_root = true

[settings]
experimental = true

[monorepo]
config_roots = ["pkg"]
EOF

cat <<'EOF' >monorepo-validate/pkg/pakro.toml
[tasks._dep]
hide = true
alias = "dep-alias"
usage = 'arg "<name>"'
run = 'echo "arg=$usage_name"'

[tasks.w_bare]
depends = ["_dep bare"]

[tasks.w_colon]
depends = [":_dep colon"]

[tasks.w_full]
depends = ["//pkg:_dep full"]

[tasks.w_alias]
depends = ["dep-alias alias"]
EOF

(
  cd monorepo-validate/pkg
  assert_contains "pakro tasks validate" "✓ All 5 task(s) validated successfully"
)

assert_contains "pakro -C monorepo-validate run //pkg:w_bare" "arg=bare"
assert_contains "pakro -C monorepo-validate run //pkg:w_colon" "arg=colon"
assert_contains "pakro -C monorepo-validate run //pkg:w_full" "arg=full"
assert_contains "pakro -C monorepo-validate run //pkg:w_alias" "arg=alias"

# Clean up
rm -rf monorepo-validate

# Test that run.tasks entries with inline arguments are accepted
mkdir -p pakro-tasks
cat <<'SCRIPT' >pakro-tasks/test
#!/usr/bin/env bash
#PAKRO description="Run tests"
#USAGE flag "--mode <mode>" {
#USAGE   choices "integration" "unit"
#USAGE   default "unit"
#USAGE   help "Test suite to run"
#USAGE }
echo "running ${usage_mode} tests"
SCRIPT
chmod +x pakro-tasks/test

cat <<'EOF' >pakro.toml
[tasks.build]
run = "echo building"

[tasks.integrate]
description = "Run integration tests"
depends = ["build"]
run = [
  { task = "test --mode=integration" }
]

[tasks.parallel-tests]
description = "Run tests in parallel"
run = [
  { tasks = ["test --mode=integration", "test --mode=unit"] }
]
EOF

assert_contains "pakro tasks validate" "✓ All 4 task(s) validated successfully"

# Clean up
rm -rf pakro-tasks

# Test that a file task whose #USAGE spec does not parse fails validation. Loading the task
# falls back to an empty spec, which would otherwise make the spec look valid.
rm -f pakro.toml
touch pakro.toml
mkdir -p pakro-tasks
cat <<'SCRIPT' >pakro-tasks/bad-usage
#!/usr/bin/env bash
#USAGE arg "<x" {{{
echo hi
SCRIPT
chmod +x pakro-tasks/bad-usage

assert_fail "pakro tasks validate --errors-only"
assert_contains "pakro tasks validate --errors-only 2>&1 || true" "usage-parse-error"
assert_contains "pakro tasks validate --errors-only 2>&1 || true" "invalid usage spec in task file"
assert_contains "pakro tasks validate --json 2>&1 || true" '"severity": "error"'

# A KDL bool written as `true` instead of `#true` is also a spec error
cat <<'SCRIPT' >pakro-tasks/bad-usage
#!/usr/bin/env bash
#USAGE flag "--v" default=true
echo hi
SCRIPT

assert_fail "pakro tasks validate --errors-only"
assert_contains "pakro tasks validate --errors-only 2>&1 || true" "usage-parse-error"
