#!/usr/bin/env bash

cat <<'EOF' >pakro.toml
[tasks.check]
env = { TASK_ENV_VALUE = "from-task" }
EOF

mkdir -p .pakro/tasks
cat <<'EOF' >.pakro/tasks/check
#!/usr/bin/env bash
set -euo pipefail

eval "$(pakro hook-env -s bash)"
printf "dir=%s env=%s\n" "${PAKRO_TASK_DIR:-missing}" "${TASK_ENV_VALUE:-missing}"
EOF
chmod +x .pakro/tasks/check

assert "pakro run check" "dir=$PWD/.pakro/tasks env=from-task"
