#!/usr/bin/env bash
# Requires usage >= 4.0, the version that accepts `effect=` (jdx/usage#739,
# #742), which pakro's spec now carries. `latest` only reaches a new release
# once it clears the default 24h minimum_release_age, so opt out of the delay
# here — same as test_task_completion_global_flags.
export PAKRO_MINIMUM_RELEASE_AGE=0s

cat <<EOF >pakro.toml
[tools]
"usage" = { version = "latest", os = ["linux", "macos"] }

[tasks.build]
run = 'echo build'
EOF

pakro usage >./pakro.usage.kdl
assert "pakro exec -- usage complete-word --shell zsh -f ./pakro.usage.kdl -- pakro tasks run build -- -c ''" "pakro.toml		pakro.toml
pakro.usage.kdl		pakro.usage.kdl"
