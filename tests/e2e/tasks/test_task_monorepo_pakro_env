#!/usr/bin/env bash
# Test that monorepo tasks properly load PAKRO_ENV-specific config files
export PAKRO_EXPERIMENTAL=1

# Create monorepo root config
cat <<EOF >pakro.toml
monorepo_root = true

[monorepo]
config_roots = ["projects/*"]

[env]
ROOT_VAR = "root_value"
ENV_VAR = "root_default"

[tasks.root-task]
run = 'echo "ROOT: ENV_VAR=\$ENV_VAR DEV_VAR=\$DEV_VAR"'
EOF

# Create PAKRO_ENV-specific config at root
cat <<EOF >pakro.dev.toml
[env]
ENV_VAR = "root_dev"
DEV_VAR = "root_dev_only"
EOF

# Create frontend project with its own config
mkdir -p projects/frontend
cat <<EOF >projects/frontend/pakro.toml
[env]
FRONTEND_VAR = "frontend_value"
ENV_VAR = "frontend_default"

[tasks.build]
run = '''
echo "FRONTEND_VAR=\$FRONTEND_VAR"
echo "ENV_VAR=\$ENV_VAR"
echo "DEV_VAR=\$DEV_VAR"
echo "PROD_VAR=\$PROD_VAR"
echo "DEV_CONF_D=\$DEV_CONF_D"
echo "PROD_CONF_D=\$PROD_CONF_D"
echo "ROOT_VAR=\$ROOT_VAR"
'''
EOF

# Create PAKRO_ENV-specific config for frontend
cat <<EOF >projects/frontend/pakro.dev.toml
[env]
ENV_VAR = "frontend_dev"
DEV_VAR = "frontend_dev_only"
EOF

cat <<EOF >projects/frontend/pakro.prod.toml
[env]
ENV_VAR = "frontend_prod"
PROD_VAR = "frontend_prod_only"
EOF

mkdir -p projects/frontend/.pakro/conf.d
echo 'env.DEV_CONF_D = "dev-conf-d"' >projects/frontend/.pakro/conf.d/frontend.dev.toml
echo 'env.PROD_CONF_D = "prod-conf-d"' >projects/frontend/.pakro/conf.d/frontend.prod.toml
export PAKRO_ENV_CONF_D=true

# Create backend project
mkdir -p projects/backend
cat <<EOF >projects/backend/pakro.toml
[env]
BACKEND_VAR = "backend_value"
ENV_VAR = "backend_default"

[tasks.build]
run = '''
echo "BACKEND_VAR=\$BACKEND_VAR"
echo "ENV_VAR=\$ENV_VAR"
echo "DEV_VAR=\$DEV_VAR"
echo "ROOT_VAR=\$ROOT_VAR"
'''
EOF

# Create PAKRO_ENV-specific config for backend
cat <<EOF >projects/backend/pakro.dev.toml
[env]
ENV_VAR = "backend_dev"
DEV_VAR = "backend_dev_only"
EOF

# Test 1: Root task with default PAKRO_ENV should use default values
echo "=== Test 1: Root task with default env ==="
unset PAKRO_ENV
output=$(pakro run //:root-task)
echo "$output"
assert_contains "echo '$output'" "ENV_VAR=root_default"

# Test 2: Root task with PAKRO_ENV=dev should load pakro.dev.toml
echo "=== Test 2: Root task with PAKRO_ENV=dev ==="
output=$(PAKRO_ENV=dev pakro run //:root-task)
echo "$output"
assert_contains "echo '$output'" "ENV_VAR=root_dev"
assert_contains "echo '$output'" "DEV_VAR=root_dev_only"

# Test 3: Frontend task with default PAKRO_ENV should use frontend default
echo "=== Test 3: Frontend task with default env ==="
unset PAKRO_ENV
output=$(pakro run '//projects/frontend:build')
echo "$output"
assert_contains "echo '$output'" "ENV_VAR=frontend_default"
assert_contains "echo '$output'" "FRONTEND_VAR=frontend_value"
assert_contains "echo '$output'" "ROOT_VAR=root_value"
assert_not_contains "echo '$output'" "dev-conf-d"
assert_not_contains "echo '$output'" "prod-conf-d"

# Test 4: Frontend task with PAKRO_ENV=dev should load pakro.dev.toml
echo "=== Test 4: Frontend task with PAKRO_ENV=dev ==="
output=$(PAKRO_ENV=dev pakro run '//projects/frontend:build')
echo "$output"
# Should load frontend/pakro.dev.toml which overrides ENV_VAR
assert_contains "echo '$output'" "ENV_VAR=frontend_dev"
# Should load DEV_VAR from frontend/pakro.dev.toml
assert_contains "echo '$output'" "DEV_VAR=frontend_dev_only"
# Should still have ROOT_VAR from root config
assert_contains "echo '$output'" "ROOT_VAR=root_value"
# Should have FRONTEND_VAR from base frontend config
assert_contains "echo '$output'" "FRONTEND_VAR=frontend_value"
assert_contains "echo '$output'" "DEV_CONF_D=dev-conf-d"
assert_not_contains "echo '$output'" "prod-conf-d"

# Test 5: Frontend task with PAKRO_ENV=prod should load pakro.prod.toml
echo "=== Test 5: Frontend task with PAKRO_ENV=prod ==="
output=$(PAKRO_ENV=prod pakro run '//projects/frontend:build')
echo "$output"
# Should load frontend/pakro.prod.toml which overrides ENV_VAR
assert_contains "echo '$output'" "ENV_VAR=frontend_prod"
# Should load PROD_VAR from frontend/pakro.prod.toml
assert_contains "echo '$output'" "PROD_VAR=frontend_prod_only"
assert_contains "echo '$output'" "PROD_CONF_D=prod-conf-d"
assert_not_contains "echo '$output'" "dev-conf-d"

# Test 6: Backend task with PAKRO_ENV=dev should load backend's dev config
echo "=== Test 6: Backend task with PAKRO_ENV=dev ==="
output=$(PAKRO_ENV=dev pakro run '//projects/backend:build')
echo "$output"
# Should load backend/pakro.dev.toml
assert_contains "echo '$output'" "ENV_VAR=backend_dev"
assert_contains "echo '$output'" "DEV_VAR=backend_dev_only"
assert_contains "echo '$output'" "BACKEND_VAR=backend_value"
assert_contains "echo '$output'" "ROOT_VAR=root_value"

# Test 7: Verify that parent PAKRO_ENV configs are also loaded
# Frontend should inherit root's dev config for DEV_VAR if not overridden
mkdir -p projects/minimal
cat <<EOF >projects/minimal/pakro.toml
[env]
MINIMAL_VAR = "minimal"

[tasks.build]
run = 'echo "MINIMAL_VAR=\$MINIMAL_VAR DEV_VAR=\$DEV_VAR ENV_VAR=\$ENV_VAR"'
EOF

echo "=== Test 7: Minimal project inherits root PAKRO_ENV config ==="
output=$(PAKRO_ENV=dev pakro run '//projects/minimal:build')
echo "$output"
# Should have its own var
assert_contains "echo '$output'" "MINIMAL_VAR=minimal"
# Should inherit DEV_VAR from root's pakro.dev.toml
assert_contains "echo '$output'" "DEV_VAR=root_dev_only"
# Should inherit ENV_VAR from root's pakro.dev.toml
assert_contains "echo '$output'" "ENV_VAR=root_dev"

echo "=== All tests passed! ==="
