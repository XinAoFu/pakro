#!/usr/bin/env bash

cat <<EOF >pakro.toml
[tasks.echo-args]
run = 'echo args:'

[tasks.hello]
run = 'echo hello'

[tasks.check-tiny]
# tiny is not installed, so this would fail without --skip-tools
# if tools were being installed, pakro would try to install tiny
tools = { tiny = "1.0.0" }
run = 'echo ran'

[tasks.deferred-check]
tools = { tiny = "2.0.0" }
run = 'echo deferred ran'

[tasks.deferred-parent]
run = [{ task = "deferred-check" }]
EOF

# --skip-tools before task name is a pakro flag (skips tool install, task runs)
assert "pakro run --skip-tools hello" "hello"

# --skip-tools after task name is a task arg (passed through to task)
assert "pakro run echo-args --skip-tools" "args: --skip-tools"

# verify --skip-tools skips task-level tool installation
# task declares tools = { tiny = "1.0.0" } but --skip-tools prevents install attempt
assert "pakro run --skip-tools check-tiny" "ran"

# --skip-tools also applies to tasks resolved later from run entries.
assert "pakro run --skip-tools deferred-parent" "deferred ran"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/tiny/2.0.0'"

credential_marker="$HOME/github-credential-command-called"
credential_command="$HOME/fake-github-credential-command"
cat >"$credential_command" <<EOF
#!/usr/bin/env bash
touch "$credential_marker"
echo fake-token
EOF
chmod +x "$credential_command"

mkdir -p "$PAKRO_CONFIG_DIR"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<EOF
[settings]
auto_install = false
github.credential_command = "$credential_command"
minimum_release_age = "3d"
EOF

cat >pakro.toml <<EOF
[tools]
"github:cli/cli" = "latest"

[tasks.nop-test]
run = "echo Hello World!"
EOF

assert "pakro run --skip-tools nop-test" "Hello World!"
assert_fail "test -f '$credential_marker'"

rm -f "$credential_marker"

assert "pakro run nop-test" "Hello World!"
assert_fail "test -f '$credential_marker'"
