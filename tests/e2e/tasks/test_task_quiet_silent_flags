#!/usr/bin/env bash

# Test that --quiet and --silent global flags work correctly for task output

cat <<EOF >pakro.toml
[tasks.hello]
run = 'echo "task output"'
EOF

# --quiet: should show task stdout, suppress pakro info messages
assert "pakro --quiet run hello 2>&1" "task output"

# --silent: should suppress both task stdout AND pakro info messages
assert_empty "pakro --silent run hello 2>&1"

# -q (short for --quiet): same as --quiet
assert "pakro -q run hello 2>&1" "task output"

# pakro run -S (short for --silent on run subcommand): should suppress task output
assert_empty "pakro run -S hello 2>&1"
