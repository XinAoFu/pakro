#!/usr/bin/env bash
# Test that file-based task aliases resolve for `pakro run` in monorepo mode

export PAKRO_EXPERIMENTAL=1

# === Test 1: Monorepo with config_roots=["."] ===
cat <<'TOML' >pakro.toml
monorepo_root = true

[monorepo]
config_roots = ["."]
TOML

mkdir -p .pakro/tasks/pr
cat <<'EOF' >.pakro/tasks/pr/list
#!/usr/bin/env bash
#PAKRO alias="prl"
echo "pr-list ran with args: $@"
EOF
chmod +x .pakro/tasks/pr/list

assert_contains "pakro run //:pr:list" "pr-list ran"
assert_contains "pakro run //:prl" "pr-list ran"
assert_contains "pakro run prl" "pr-list ran"
assert_contains "pakro run prl my-arg" "pr-list ran with args: my-arg"

# === Test 2: Monorepo with config_roots including subdirectories ===
cat <<'TOML' >pakro.toml
monorepo_root = true

[monorepo]
config_roots = [".", "projects/*"]
TOML

mkdir -p projects/backend/.pakro/tasks
cat <<'EOF' >projects/backend/.pakro/tasks/deploy
#!/usr/bin/env bash
#PAKRO alias="d"
echo "backend deploy ran"
EOF
chmod +x projects/backend/.pakro/tasks/deploy
cat <<'TOML' >projects/backend/pakro.toml
TOML

assert_contains "pakro run prl" "pr-list ran"
assert_contains "pakro run //projects/backend:d" "backend deploy ran"
assert_contains "pakro run d" "backend deploy ran"

# === Test 3: Usage spec includes monorepo-prefixed aliases for completion ===
output=$(pakro tasks --usage 2>&1)
echo "$output" | grep -q '"//:prl"' || (echo "FAIL: prefixed alias //:prl not in usage spec" && echo "$output" && exit 1)
