#!/usr/bin/env bash

cat <<EOF >pakro.toml
[tasks.echo]
env = { "SUB_TASK" = "sub_task_env" }
run = 'echo "\$SUB_TASK \$MY_VAR"'


[tasks.propagation]
run = [{ task = "echo" }]
env = { "MY_VAR" = "my_variable" }
EOF

assert_contains "pakro run echo" "sub_task_env " # with trailing space
assert_contains "pakro run propagation" "sub_task_env my_variable"
