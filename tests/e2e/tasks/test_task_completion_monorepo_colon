#!/usr/bin/env bash
# `:task` runs a task of the current config root, so it must complete as one too.
# Without its own candidates the shell got the path fallback, which fish expands
# by treating `:` as a PATH-list separator.

export PAKRO_EXPERIMENTAL=1

cat <<'EOF' >pakro.toml
monorepo_root = true

[monorepo]
config_roots = ["apps/*"]

[tasks."env:update"]
description = "Bump the lockfile"
alias = "eu"
run = 'echo updated'

[tasks."env:clear"]
run = 'echo cleared'

[tasks.precedence]
alias = ["//apps/web:collision", "pc"]
run = 'echo precedence'
EOF

mkdir -p apps/web
cat <<'EOF' >apps/web/pakro.toml
[tasks.build]
description = "Build web"
usage = '''
flag "--mode <mode>" {
  choices "dev" "prod"
}
'''
run = 'echo built'
EOF

assert "pakro -q :env:update" "updated"

naked="$(pakro __complete_word__ --shell fish --line 'pakro :env:upd')"
assert_contains_text "$naked" $':env:update\tBump the lockfile'
assert_not_contains_text "$naked" $'\001files'

run="$(pakro __complete_word__ --shell fish --line 'pakro run :env:')"
assert_contains_text "$run" ':env:update'
assert_contains_text "$run" ':env:clear'
assert_not_contains_text "$run" $'\001files'

# Only task names get the shorthand: no `:alias` forms, absolute or not
root_shorthands="$(pakro __complete_word__ --shell fish --line 'pakro run :')"
assert_contains_text "$root_shorthands" ':precedence'
assert_not_contains_text "$root_shorthands" ':eu'
assert_not_contains_text "$root_shorthands" ':pc'
assert_not_contains_text "$root_shorthands" '://'
assert_contains_text "$(pakro __complete_word__ --shell fish --line 'pakro tasks run :env:u')" ':env:update'
assert_contains_text "$(pakro __complete_word__ --shell zsh --line 'pakro run :env:u')" $':env:update\tBump the lockfile\t:env:update'

# The absolute spelling still completes
assert_contains_text "$(pakro __complete_word__ --shell fish --line 'pakro //:env:upd')" '//:env:update'
run_all="$(pakro __complete_word__ --shell fish --line 'pakro run ')"
assert_contains_text "$run_all" $'//:env:update\tBump the lockfile'
assert_contains_text "$run_all" $':env:update\tBump the lockfile'

# Tasks of other config roots have no shorthand here
assert_not_contains_text "$root_shorthands" ':build'

# Inside a config root, `:` means that root, and the task's own arguments complete after it
cd apps/web || exit 1
assert "pakro -q :build" "built"
web="$(pakro __complete_word__ --shell fish --line 'pakro :bu')"
assert_contains_text "$web" $':build\tBuild web'
assert_not_contains_text "$web" ':env:update'
mode="$(pakro __complete_word__ --shell fish --line 'pakro run :build --mode ')"
assert_contains_text "$mode" 'dev'
assert_contains_text "$mode" 'prod'
