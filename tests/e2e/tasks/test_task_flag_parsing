#!/usr/bin/env bash

# Test that flags work with both `pakro run` and naked runs

cat <<'EOF' >pakro.toml
[tasks.mytask]
run = 'echo "flag=$usage_flag"'
usage = '''
flag "--flag"
'''
EOF

# Test that -- works to pass flags to task
assert "pakro run mytask -- --flag" "flag=true"
assert "pakro run mytask" "flag="

# Test naked runs (without `run` subcommand)
assert "pakro mytask --flag" "flag=true"
assert "pakro mytask" "flag="

# Test with a flag that takes a value
cat <<'EOF' >pakro.toml
[tasks.mytask]
run = 'echo "level=$usage_level"'
usage = '''
flag "--level <level>" default="info"
'''
EOF

assert "pakro run mytask -- --level debug" "level=debug"
assert "pakro run mytask" "level=info"

# Test naked runs with flag values
assert "pakro mytask --level debug" "level=debug"
assert "pakro mytask" "level=info"

# Test with multiple flags
cat <<'EOF' >pakro.toml
[tasks.mytask]
run = 'echo "flag=$usage_flag output=$usage_output"'
usage = '''
flag "--flag"
flag "--output <output>" default="default.txt"
'''
EOF

assert "pakro run mytask -- --flag --output result.txt" "flag=true output=result.txt"
assert "pakro run mytask -- --output result.txt" "flag= output=result.txt"

# Test naked runs with multiple flags (--output is a pakro flag, so use -- to pass both to task)
assert "pakro mytask -- --flag --output result.txt" "flag=true output=result.txt"
assert "pakro mytask -- --output result.txt" "flag= output=result.txt"

# Test that pakro global flags can be passed to tasks using --
cat <<'EOF' >pakro.toml
[tasks.mytask]
run = 'echo "verbose=$usage_verbose"'
usage = '''
flag "--verbose"
'''
EOF

# --verbose is a pakro flag, so use -- to pass it to the task
assert "pakro mytask -- --verbose" "verbose=true"
assert "pakro mytask" "verbose="
