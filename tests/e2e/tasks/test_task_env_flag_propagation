#!/usr/bin/env bash

# Test that -E/--env flag is propagated to child tasks
# See: https://github.com/jdx/mise/discussions/7865

# Create env-specific config with env vars
cat <<EOF >pakro.dev.toml
[env]
MY_DEV_VAR = "dev-value"
EOF

# Create main config with tasks that depend on each other
cat <<EOF >pakro.toml
[tasks.child]
run = 'echo "MY_DEV_VAR=\$MY_DEV_VAR"'

[tasks.parent]
depends = ["child"]
run = 'echo "parent done"'

# A task that invokes pakro run internally (simulates nested pakro invocation)
[tasks.nested-pakro]
run = 'pakro run child'
EOF

# Test 1: Child task should see env vars when called with -E
assert_contains "pakro -E dev run child" "MY_DEV_VAR=dev-value"

# Test 2: Parent task should see env vars in its child when called with -E
assert_contains "pakro -E dev run parent" "MY_DEV_VAR=dev-value"

# Test 3: Nested pakro invocation should inherit PAKRO_ENV
assert_contains "pakro -E dev run nested-pakro" "MY_DEV_VAR=dev-value"

# Test 4: Same tests with --env instead of -E
assert_contains "pakro --env dev run child" "MY_DEV_VAR=dev-value"
assert_contains "pakro --env dev run parent" "MY_DEV_VAR=dev-value"
assert_contains "pakro --env dev run nested-pakro" "MY_DEV_VAR=dev-value"
