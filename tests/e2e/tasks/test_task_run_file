#!/usr/bin/env bash

cat <<EOF >.pakro.toml
[tasks.configtask]
run = 'echo "configtask:"'
[tasks.lint]
run = 'echo "linting!"'
[tasks.test]
run = 'echo "testing!"'
EOF

mkdir -p .pakro/tasks
cat <<'EOF' >.pakro/tasks/filetask
#!/usr/bin/env bash
#PAKRO description="This is a test build script"
#PAKRO depends=["lint", "test"]
#PAKRO sources=[".test-tool-versions"]
#PAKRO outputs=["$PAKRO_PROJECT_ROOT/test-e2e/test-build-output.txt"]
#PAKRO env={TEST_BUILDSCRIPT_ENV_VAR = "VALID"}

set -euxo pipefail
cd "$PAKRO_PROJECT_ROOT" || exit 1
echo "running test-build script"
mkdir -p test-e2e
echo "TEST_BUILDSCRIPT_ENV_VAR: $TEST_BUILDSCRIPT_ENV_VAR" >test-e2e/test-build-output.txt
echo "ARGS: $*" >>test-e2e/test-build-output.txt
EOF
chmod +x .pakro/tasks/filetask

pakro r --cd "$PWD" configtask arg1 arg2 ::: filetask arg1 arg2
assert "cat test-e2e/test-build-output.txt" "TEST_BUILDSCRIPT_ENV_VAR: VALID
ARGS: arg1 arg2"

assert "pakro run test arg1 arg2 arg3" "testing! arg1 arg2 arg3"

cat <<'EOF' >.pakro/tasks/filetask
#!/usr/bin/env bash
#USAGE flag "-u --user <user>" help="User to run as"
#USAGE flag "-p --port <port>" help="Port to run on" default="8080"

echo "user=$usage_user"
echo "port=$usage_port"
EOF

cat <<'EOF' >.pakro/tasks/filetask.bat
#windows filetask
#USAGE flag "-u --user <user>" help="User to run as"
#USAGE flag "-p --port <port>" help="Port to run on" default="8080"

echo "user=$usage_user"
echo "port=$usage_port"
EOF
assert "pakro run filetask --user=jdx" "user=jdx
port=8080"
assert "pakro run filetask --port=8081" "user=
port=8081"
assert_contains "pakro run filetask --help 2>&1 || true" "-u --user <user>"
assert_contains "pakro run filetask --help 2>&1 || true" "-p --port <port>"

cat <<'EOF' >.pakro/tasks/jstask
#!/usr/bin/env node
//PAKRO description="This is a test build script"
//PAKRO env={MYVAR = "1"}

console.log(`MYVAR: ${process.env.MYVAR}`);
EOF
chmod +x .pakro/tasks/jstask
assert "pakro run jstask" "MYVAR: 1"
assert "pakro tasks -x" "configtask     ./.pakro.toml
filetask       ./.pakro/tasks/filetask
jstask         ./.pakro/tasks/jstask    This is a test build script
lint           ./.pakro.toml
test           ./.pakro.toml"
