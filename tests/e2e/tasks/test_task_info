#!/usr/bin/env bash

mkdir -p pakro-tasks && echo "" >pakro-tasks/build.sh && chmod +x pakro-tasks/build.sh
assert "pakro tasks info build" 'Task: build
Description:
Source: ~/workdir/pakro-tasks/build.sh
File: ~/workdir/pakro-tasks/build.sh

Usage Spec:
  name build
  bin build'

assert_contains "pakro tasks info build.sh --json" '"name": "build"'

assert_json_partial_object "pakro tasks info build --json" "name,source,description" '{
  "name": "build",
  "source": "'"$PWD"'/pakro-tasks/build.sh",
  "description": ""
}'

pakro tasks add lint --depends "build -v" -- 'echo "linting!"'
