#!/usr/bin/env bash
# Regression test for https://github.com/jdx/mise/discussions/11282
# Everything after a task name is forwarded to the task, so pakro's own flags are not
# usable there (`pakro run my:task --silent` fails with "unexpected word: --silent").
# Completion must therefore offer only the task's own flags after the task name, and a
# task flag that shares a name with a pakro global (e.g. `--env`) must keep its own
# choices instead of being shadowed by the global.
#
# Requires usage >= 3.5.7, which stops the mounting CLI's flags from being inherited
# into mounted commands (jdx/usage#738). `latest` only reaches it once it clears the
# default 24h minimum_release_age, so opt out of the delay here.
export PAKRO_MINIMUM_RELEASE_AGE=0s

cat <<'EOF' >pakro.toml
[tools]
"usage" = { version = "latest", os = ["linux", "macos"] }

[tasks.deploy]
usage = '''
flag "--env <name>" {
  choices "dev" "stage" "prod"
}
flag "--bump <type>" {
  choices "auto" "major" "minor" "patch"
}
flag "--output-dir <path>" {}
'''
run = 'echo deploy'
EOF

pakro usage >./pakro.usage.kdl

# only the task's own flags are offered after the task name — not pakro globals like
# --cd/--env/--jobs/--quiet/--raw/--silent/--verbose/--yes
assert "pakro exec -- usage complete-word --shell bash -f ./pakro.usage.kdl -- pakro run deploy --" "--bump
--env
--output-dir"

# same over the `tasks run` path, which additionally used to leak the `tasks` flags
# (--all, --extended, --global, --json, --local, --sort, …)
assert "pakro exec -- usage complete-word --shell bash -f ./pakro.usage.kdl -- pakro tasks run deploy --" "--bump
--env
--output-dir"

# and over the naked path (`pakro deploy` == `pakro run deploy`)
assert "pakro exec -- usage complete-word --shell bash -f ./pakro.usage.kdl -- pakro deploy --" "--bump
--env
--output-dir"

# --env collides with pakro's global -E/--env: the task's choices must win (previously
# fell through to file completion, which is why renaming it to --environment "fixed" it)
assert "pakro exec -- usage complete-word --shell bash -f ./pakro.usage.kdl -- pakro run deploy --env ''" "dev
stage
prod"

# a non-colliding task flag is unaffected
assert "pakro exec -- usage complete-word --shell bash -f ./pakro.usage.kdl -- pakro run deploy --bump ''" "auto
major
minor
patch"

# pakro's flags still complete *before* the task name
assert_contains "pakro exec -- usage complete-word --shell bash -f ./pakro.usage.kdl -- pakro run --" "--silent"

# and a global before the task still parses, so the task's own flag values still
# complete after it (jdx/mise#10069 behavior is preserved)
assert "pakro exec -- usage complete-word --shell bash -f ./pakro.usage.kdl -- pakro -C . run deploy --bump ''" "auto
major
minor
patch"

# a global whose name the task also uses keeps parsing as the global before the task,
# while the task's flag still owns the name after it
assert "pakro exec -- usage complete-word --shell bash -f ./pakro.usage.kdl -- pakro --env dev run deploy --env ''" "dev
stage
prod"
