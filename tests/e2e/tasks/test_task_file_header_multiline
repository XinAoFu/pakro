#!/usr/bin/env bash

# Multi-line `#PAKRO` headers in file tasks.
# https://github.com/jdx/mise/discussions/4603
#
# A TOML value left open at the end of a header line continues on the following
# `#PAKRO` lines, and those continuation lines must not leak into the usage spec.

cat <<'EOF' >pakro.toml
[tasks.lint]
run = 'echo "linting!"'
[tasks.test]
run = 'echo "testing!"'
EOF

mkdir -p pakro-tasks
touch src.txt

cat <<'EOF' >pakro-tasks/build
#!/usr/bin/env bash
#PAKRO description="Build the CLI"
#PAKRO depends=[
#PAKRO   "lint",
#PAKRO   "test",
#PAKRO ]
#PAKRO sources=[
#PAKRO   "src.txt"
#PAKRO ]
#USAGE flag "--release" help="Release build"
echo "building! release=$usage_release"
EOF
chmod +x pakro-tasks/build

assert_contains "pakro tasks ls" "Build the CLI"
assert_contains "pakro tasks info build" "src.txt"

# --force so the multi-line `sources` cache can't skip the run between assertions
assert_contains "pakro run --force build --release" "linting!"
assert_contains "pakro run --force build --release" "testing!"
assert_contains "pakro run --force build --release" "building! release=true"

# continuation lines are config, not usage spec text. `release=true` above
# already proves the spec parsed; this pins down that nothing leaked into it.
assert_contains "pakro tasks ls --usage" "Release build"
assert_not_contains "pakro tasks ls --usage" '"lint",'

# an array of inline tables may also span lines
cat <<'EOF' >pakro-tasks/structured
#!/usr/bin/env bash
#PAKRO depends=[
#PAKRO   { task = "lint" },
#PAKRO   "test",
#PAKRO ]
echo "structured!"
EOF
chmod +x pakro-tasks/structured

assert_contains "pakro run structured" "linting!"
assert_contains "pakro run structured" "structured!"
rm pakro-tasks/structured

# headers are parsed as TOML 1.1, so inline tables may span lines too
cat <<'EOF' >pakro-tasks/tabled
#!/usr/bin/env bash
#PAKRO env={
#PAKRO   FOO = "bar",
#PAKRO   BAZ = "qux"
#PAKRO }
echo "FOO=$FOO BAZ=$BAZ"
EOF
chmod +x pakro-tasks/tabled

assert_contains "pakro run tabled" "FOO=bar BAZ=qux"
rm pakro-tasks/tabled

# an unterminated value is still an error, but names the whole entry
cat <<'EOF' >pakro-tasks/broken
#!/usr/bin/env bash
#PAKRO depends=[
#PAKRO   "lint"
echo hi
EOF
chmod +x pakro-tasks/broken

assert_fail "pakro tasks ls" "failed to parse task header TOML"
assert_fail "pakro tasks ls" "lines 2-3"
rm pakro-tasks/broken

# dotted keys still build a table across several lines
cat <<'EOF' >pakro-tasks/dotted
#!/usr/bin/env bash
#PAKRO description="dotted keys"
#PAKRO tools.node="20"
#PAKRO tools.python="3.11"
echo hi
EOF
chmod +x pakro-tasks/dotted

assert_contains "pakro tasks ls" "dotted keys"
