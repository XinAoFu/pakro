#!/usr/bin/env bash

cat <<EOF >pakro.toml
tasks.a.run = "echo a"
tasks.b.depends = ["a"]
tasks.b.run = "echo b"
tasks.c.depends = ["a"]
tasks.c.run = "echo c"
tasks.c.wait_for = ["b"]
tasks.d.depends = ["c"]
tasks.d.run = "echo d"
tasks.d.wait_for = ["b"]
EOF

assert "pakro run d" "a
c
d"

assert "pakro run d ::: b" "a
b
c
d"

cat <<EOF >pakro.toml
[tasks."hello:1"]
description = "Hello from 1"
run = "echo Hello from 1"

[tasks."hello:2"]
description = "Hello from 2"
run = "echo Hello from 2"

[tasks."hello:all"]
description = "Hello from all"
depends = ["hello:*"]
EOF
assert_contains "pakro run hello:all" "[hello:1] Hello from 1"
assert_contains "pakro run hello:all" "[hello:2] Hello from 2"
assert "pakro tasks deps" "hello:1
hello:2
hello:all
├── hello:2
└── hello:1"

cat <<EOF >>pakro.toml

[tasks.leaf]
run = "echo leaf"

[tasks.shared]
depends = ["leaf"]
run = "echo shared"

[tasks.left]
depends = ["shared"]
run = "echo left"

[tasks.right]
depends = ["shared"]
run = "echo right"

[tasks.root]
depends = ["left", "right"]
run = "echo root"
EOF

compact_output="$(pakro tasks deps --compact root)"
assert_contains "printf '%s\n' \"$compact_output\"" "shared (already shown)"
leaf_count="$(printf '%s\n' "$compact_output" | grep -c 'leaf')"
if [[ $leaf_count -ne 1 ]]; then
  echo "Expected compact dependency output to expand leaf once, got $leaf_count"
  printf '%s\n' "$compact_output"
  exit 1
fi

multi_root_output="$(pakro tasks deps --compact left right)"
assert_contains "printf '%s\n' \"$multi_root_output\"" "shared (already shown)"
multi_root_leaf_count="$(printf '%s\n' "$multi_root_output" | grep -c 'leaf')"
if [[ $multi_root_leaf_count -ne 1 ]]; then
  echo "Expected compact multi-root output to expand leaf once, got $multi_root_leaf_count"
  printf '%s\n' "$multi_root_output"
  exit 1
fi

explicit_root_output="$(pakro tasks deps --compact root left)"
explicit_left_count="$(printf '%s\n' "$explicit_root_output" | grep -c '^left$')"
if [[ $explicit_left_count -ne 1 ]]; then
  echo "Expected explicitly selected left root to be expanded"
  printf '%s\n' "$explicit_root_output"
  exit 1
fi

assert_fail "pakro tasks deps --compact --dot root"

hello_all_info="$(pakro tasks hello:all)"
assert_contains "printf '%s\n' \"$hello_all_info\"" "Task: hello:all"
assert_contains "printf '%s\n' \"$hello_all_info\"" "Description: Hello from all"
assert_contains "printf '%s\n' \"$hello_all_info\"" "Source: ~/workdir/pakro.toml"
assert_contains "printf '%s\n' \"$hello_all_info\"" "Depends on: hello:*"
assert_contains "printf '%s\n' \"$hello_all_info\"" "name hello:all"
assert_contains "printf '%s\n' \"$hello_all_info\"" "bin hello:all"

echo '' >pakro.toml

mkdir -p pakro-tasks && echo "" >pakro-tasks/build.sh && chmod +x pakro-tasks/build.sh
assert "pakro tasks deps build" "build"
assert "pakro tasks deps build.sh" "build"
