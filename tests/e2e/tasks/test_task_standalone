#!/usr/bin/env bash

start_http_server

cat <<EOF >mytask
#!/usr/bin/env bash
echo "running mytask"
EOF
chmod +x mytask

assert "pakro run ./mytask" "running mytask"

cat <<EOF >pakro.toml
[tasks.mytask]
file = "./mytask"
EOF

mkdir -p subdir
cd subdir || exit 1
assert "pakro run mytask" "running mytask"
cd .. || exit 1

cat <<EOF >pakro.toml
tasks.mytask.file = "http://localhost:${HTTP_PORT}/test/mytask"
EOF
assert "pakro run mytask" "running mytask"
