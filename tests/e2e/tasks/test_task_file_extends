#!/usr/bin/env bash
# Test that file tasks can extend a task template via `#PAKRO extends=...`

cat <<'EOF' >pakro.toml
[task_templates.shared]
description = "template description"
alias = "sh"
env = { FOO = "template_foo", BAR = "template_bar" }
run = "echo template run"

[task_templates.other]
env = { FOO = "other_foo" }
EOF

mkdir -p pakro-tasks
cat <<'EOF' >pakro-tasks/build
#!/usr/bin/env bash
#PAKRO extends="shared"
#PAKRO env={BAR = "local_bar"}
echo "FOO=$FOO BAR=$BAR"
EOF
chmod +x pakro-tasks/build

# `extends` is honored rather than reported as an unknown header field
assert_not_contains "pakro tasks ls 2>&1" "unknown field"

# env deep merges the same way it does for a toml task
assert "pakro run build" "FOO=template_foo BAR=local_bar"

# scalar fields fall back to the template
assert_contains "pakro tasks ls" "template description"
assert_contains "pakro run sh" "FOO=template_foo"

# the script file is the command: the template's `run` must not replace or shadow it
assert_not_contains "pakro run build" "template run"

# a local value still wins over the template's
cat <<'EOF' >pakro-tasks/build
#!/usr/bin/env bash
#PAKRO extends="shared"
#PAKRO description="local description"
echo "FOO=$FOO"
EOF
chmod +x pakro-tasks/build

assert_contains "pakro tasks ls" "local description"
assert_not_contains "pakro tasks ls" "template description"

# an unknown template name is an error rather than a silent fallback
cat <<'EOF' >pakro-tasks/build
#!/usr/bin/env bash
#PAKRO extends="nope"
echo hi
EOF
chmod +x pakro-tasks/build

assert_fail "pakro run build" "which was not found"
