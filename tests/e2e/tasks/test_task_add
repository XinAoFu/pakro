#!/usr/bin/env bash

pakro tasks add pre-commit --depends "test" --depends "render" -- echo pre-commit
assert "cat pakro.toml" '[tasks.pre-commit]
depends = ["test", "render"]
run = "echo pre-commit"'

pakro tasks add os --run-windows "echo windows" -- echo unix
assert_contains "cat pakro.toml" '[tasks.os]
run = "echo unix"
run_windows = "echo windows"'

pakro tasks add --file pre-commit --depends "test" --depends "render" -- echo pre-commit
assert "cat pakro-tasks/pre-commit" '#!/usr/bin/env bash
#PAKRO depends=["test", "render"]
set -euxo pipefail

echo pre-commit'
