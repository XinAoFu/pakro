#!/usr/bin/env bash
# Test basic monorepo task syntax (//pkg:task addressing)
# These tests verify the fundamental task addressing works, not inheritance
export PAKRO_EXPERIMENTAL=1

# Create monorepo root config with tasks
cat <<'TOML' >pakro.toml
monorepo_root = true

[monorepo]
config_roots = ["example-pkg", "libs/*"]

[tasks.rootTask]
run = "echo 'task from root'"

[tasks.build]
run = "echo 'root build'"
TOML

# Create subdirectory with its own tasks
mkdir -p example-pkg
cat <<'TOML' >example-pkg/pakro.toml
[tasks.build]
run = "echo 'example-pkg build'"

[tasks.localTask]
run = "echo 'local task'"
TOML

# Create intermediate parent with tasks
mkdir -p libs
cat <<'TOML' >libs/pakro.toml
[tasks.build]
run = "echo 'libs build'"
TOML

mkdir -p libs/example-lib1
cat <<'TOML' >libs/example-lib1/pakro.toml
[tasks.build]
run = "echo 'example-lib1 build'"
TOML

# --- Tests for basic monorepo syntax ---

# Test 1: Root tasks appear in task list with // prefix
assert_contains "pakro tasks --all" "//:rootTask"
assert_contains "pakro tasks --all" "//:build"

# Test 2: Root tasks can be run with // prefix
assert_contains "pakro run //:rootTask" "task from root"

# Test 3: Subpackage local tasks can be run
assert_contains "pakro run //example-pkg:build" "example-pkg build"
assert_contains "pakro run //example-pkg:localTask" "local task"

# Test 4: Child's local task shadows parent's task of same name
assert_contains "pakro run //libs/example-lib1:build" "example-lib1 build"

# Test 5: Local task runs from its definition directory
cat <<'TOML' >example-pkg/pakro.toml
[tasks.showdir]
run = "pwd"
TOML

assert_contains "pakro run //example-pkg:showdir" "example-pkg"
