#!/usr/bin/env bash
# Test that PAKRO_*_VERSION environment variable overrides work for monorepo tasks
export PAKRO_EXPERIMENTAL=1

cat <<EOF >pakro.toml
monorepo_root = true

[monorepo]
config_roots = ["projects/*"]

[tools]
tiny = "2.0.0"

[tasks.root-task]
run = 'rtx-tiny'
EOF

mkdir -p projects/backend
cat <<EOF >projects/backend/pakro.toml
[tasks.build]
run = 'rtx-tiny'
EOF

pakro install tiny@2.0.0 tiny@3.0.0 tiny@3.1.0

echo "=== Test 1: Without env override, uses config version ==="
assert_contains "pakro run //projects/backend:build" "v2.0.0"

echo "=== Test 2: With PAKRO_TINY_VERSION, should use env override version ==="
assert_contains "PAKRO_TINY_VERSION=3.0.0 pakro run //projects/backend:build" "v3.0.0"

echo "=== Test 3: Root task should respect env override ==="
assert_contains "PAKRO_TINY_VERSION=3.0.0 pakro run //:root-task" "v3.0.0"

mkdir -p projects/frontend
cat <<EOF >projects/frontend/pakro.toml
[tools]
tiny = "2.0.0"

[tasks.build]
run = 'rtx-tiny'
EOF

echo "=== Test 4: Project with tools, env override should still win ==="
assert_contains "PAKRO_TINY_VERSION=3.1.0 pakro run //projects/frontend:build" "v3.1.0"

echo "=== All PAKRO_*_VERSION environment override tests passed! ==="
