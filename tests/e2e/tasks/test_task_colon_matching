#!/usr/bin/env bash

# Test that task names with colons are not incorrectly matched in non-monorepo context
# Bug: `pakro run build` was matching both `build` and `project:build` tasks

# Create a regular pakro.toml (NOT a monorepo)
cat <<'EOF' >pakro.toml
[tasks.build]
run = 'echo "build"'

[tasks."project:build"]
run = 'echo "project:build"'

[tasks."app:build"]
run = 'echo "app:build"'

[tasks.test]
run = 'echo "test"'

[tasks."unit:test"]
run = 'echo "unit:test"'
EOF

# Running 'pakro run build' should ONLY run the 'build' task
# It should NOT run 'project:build' or 'app:build'
OUTPUT=$(pakro run build)

# Should run the build task
assert_contains "pakro run build" "build"

# Should NOT run tasks with colons
if echo "$OUTPUT" | grep -E "project:build|app:build"; then
  echo "ERROR: 'pakro run build' incorrectly matched tasks with colons"
  echo "Output:"
  echo "$OUTPUT"
  exit 1
fi

# Similarly, 'pakro run test' should only run 'test', not 'unit:test'
OUTPUT2=$(pakro run test)

assert_contains "pakro run test" "test"

if echo "$OUTPUT2" | grep "unit:test"; then
  echo "ERROR: 'pakro run test' incorrectly matched 'unit:test'"
  echo "Output:"
  echo "$OUTPUT2"
  exit 1
fi

# Also test with file-based tasks
mkdir -p .pakro/tasks

cat <<'EOF' >.pakro/tasks/deploy
#!/usr/bin/env bash
echo "deploy"
EOF

cat <<'EOF' >.pakro/tasks/prod:deploy
#!/usr/bin/env bash
echo "prod:deploy"
EOF

chmod +x .pakro/tasks/*

# Running 'pakro run deploy' should only run 'deploy', not 'prod:deploy'
OUTPUT3=$(pakro run deploy)

assert_contains "pakro run deploy" "deploy"

if echo "$OUTPUT3" | grep "prod:deploy"; then
  echo "ERROR: 'pakro run deploy' incorrectly matched 'prod:deploy'"
  echo "Output:"
  echo "$OUTPUT3"
  exit 1
fi
