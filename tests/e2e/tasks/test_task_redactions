#!/usr/bin/env bash

cat <<EOF >pakro.toml
redactions = ["SECRET"]
[env]
SECRET = "my_secret"

[tasks.a]
run = 'echo secret: \$SECRET'
EOF

assert "pakro run a" "secret: [redacted]"

# Test config-level redact=false exclusions survive task context construction
cat <<'TOML' >pakro.toml
redactions = ["*TOKEN*"]
[env]
TEST_TOKEN = { value = "e", redact = false }

[tasks.a]
run = 'echo "secret value:$TEST_TOKEN"'
TOML
assert "pakro run a" "secret value:e"

# Test a task-level redact=true assignment overrides a config-level exclusion
cat <<'TOML' >pakro.toml
redactions = ["*TOKEN*"]
[env]
TEST_TOKEN = { value = "e", redact = false }

[tasks.a]
run = 'echo "secret:$TEST_TOKEN"'
env.TEST_TOKEN = { value = "task_secret", redact = true }
TOML
assert "pakro run a" "secret:[redacted]"

cat <<EOF >pakro.toml
redactions = ["secret"]
[tasks.a]
run = 'echo secret: {{ vars.secret }}'

[vars]
secret = "my_secret"
EOF
assert "pakro run a" "secret: [redacted]"

cat <<EOF >pakro.toml
redactions = ["SECRET*"]
[env]
SECRET_FOO = "my_secret_wild"

[tasks.a]
run = 'echo secret: \$SECRET_FOO'
EOF
assert "pakro run a" "secret: [redacted]"

cat <<'TOML' >pakro.toml
redactions = ["*_KEY"]
[env]
DISABLE_FEEDBACK_SURVEY = "1"

[tasks.a]
run = 'echo "version 1.2.3"'
TOML
assert "pakro run a" "version 1.2.3"

cat <<EOF >pakro.toml
[env]
SECRET= {value = "my_secret", redact = true}

[tasks.a]
run = 'echo secret: \$SECRET'
EOF
assert "pakro run a" "secret: [redacted]"

echo '{ "SECRET": "my_secret" }' >.env.json
cat <<EOF >pakro.toml
[env]
_.file = {path = ".env.json", redact = true}

[tasks.a]
run = 'echo secret: \$SECRET'
EOF
assert "pakro run a" "secret: [redacted]"

cat <<'TOML' >pakro.toml
[env]
EMPTY_SECRET = { value = "", redact = true }

[tasks.empty_redaction]
run = 'echo "Hello $EMPTY_SECRET"'
TOML
assert "pakro run empty_redaction" "Hello "

cat <<'TOML' >pakro.toml
[env]
SECRET_WITH_TOOLS = { value = "tools_secret", tools = true, redact = true }

[tasks.a]
run = 'echo secret: $SECRET_WITH_TOOLS'
TOML
assert "pakro run a" "secret: [redacted]"

# Test task-specific env._.file with redactions pattern
echo '{ "NOTIFY_AVATAR": "task_file_secret" }' >.env.json
cat <<'TOML' >pakro.toml
redactions = ["NOTIFY_*"]
[tasks.a]
run = "echo secret: $NOTIFY_AVATAR"
env._.file = ".env.json"
TOML
assert "pakro run a" "secret: [redacted]"

# Test task-specific env._.file with redact=true
echo '{ "TASK_SECRET": "task_secret_val" }' >.env.json
cat <<'TOML' >pakro.toml
[tasks.a]
run = "echo secret: $TASK_SECRET"
env._.file = {path = ".env.json", redact = true}
TOML
assert "pakro run a" "secret: [redacted]"

# Overlapping values: the longest match wins
cat <<'TOML' >pakro.toml
redactions = ["SHORT", "LONG"]
[env]
SHORT = "abc"
LONG = "xxabcSECRETPART"
[tasks.a]
run = 'echo "long:$LONG"'
TOML
assert "pakro run a" "long:[redacted]"
