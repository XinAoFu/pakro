#!/usr/bin/env bash

# Test that tasks can use tools from idiomatic version files
# Issue: Since v2025.10.3, idiomatic_version_file_enable_tools stopped working in task execution

# First disable the parent /tmp/pakro.toml experimental monorepo setting
# to avoid interference with this test
if [ -f /tmp/pakro.toml ]; then
  mv /tmp/pakro.toml /tmp/pakro.toml.bak
  trap "mv /tmp/pakro.toml.bak /tmp/pakro.toml" EXIT
fi

# Create a .node-version file
echo "24.1.0" >.node-version

# Create pakro.toml with idiomatic_version_file_enable_tools setting
cat >pakro.toml <<'EOF'
[settings]
idiomatic_version_file_enable_tools = ["node"]

[tasks.call-node]
run = "which node"
EOF

# Trust the config
pakro trust

# Install node from .node-version
pakro install

# Run the task and verify it uses the pakro-installed node
assert_contains "pakro run call-node" ".local/share/pakro/installs/node/24"
