#!/usr/bin/env bash

# Test that monorepo task shorthand syntax (pakro //path:task and pakro :task) works
# This tests the fix for the bug where these patterns only worked with 'pakro run'

export PAKRO_EXPERIMENTAL=1

cat <<'EOF' >pakro.toml
monorepo_root = true

[monorepo]
config_roots = ["project", "app", "deep/nested/dir"]

[tasks.build]
run = 'echo "root build task"'
EOF

mkdir -p project
cat <<'EOF' >project/pakro.toml
[tasks.build]
run = 'echo "project build task"'
EOF

mkdir -p app
cat <<'EOF' >app/pakro.toml
[tasks.build]
run = 'echo "app build task"'
EOF

# Test 1: pakro //project:build (shorthand, without 'run')
assert_contains "pakro '//project:build'" "project build task"

# Test 2: pakro //app:build (shorthand, without 'run')
assert_contains "pakro '//app:build'" "app build task"

# Test 3: pakro :build from root (should run root task)
assert_contains "pakro ':build'" "root build task"

# Test 4: pakro :build from project directory (should run project task)
(cd project && assert_contains "pakro ':build'" "project build task")

# Test 5: pakro :build from app directory (should run app task)
(cd app && assert_contains "pakro ':build'" "app build task")

# Test 6: Verify that the shorthand syntax is equivalent to 'pakro run'
OUTPUT_SHORTHAND=$(pakro '//project:build')
OUTPUT_RUN=$(pakro run '//project:build')
if [ "$OUTPUT_SHORTHAND" != "$OUTPUT_RUN" ]; then
  echo "ERROR: Shorthand 'pakro //project:build' output differs from 'pakro run //project:build'"
  echo "Shorthand output: $OUTPUT_SHORTHAND"
  echo "Run output: $OUTPUT_RUN"
  exit 1
fi

# Test 7: Test with nested subdirectories
mkdir -p deep/nested/dir
cat <<'EOF' >deep/nested/dir/pakro.toml
[tasks.test]
run = 'echo "nested task"'
EOF

assert_contains "pakro '//deep/nested/dir:test'" "nested task"

(cd deep/nested/dir && assert_contains "pakro ':test'" "nested task")

# Test 8: Bare and colon task names walk up to the nearest config root from deep directories
mkdir -p project/deep/deeper
(
  cd project/deep/deeper
  assert_contains "pakro run build" "project build task"
  assert_contains "pakro run ':build'" "project build task"
)

# Test 9: A directory outside the configured projects resolves against the monorepo root
mkdir -p unconfigured/deep
(
  cd unconfigured/deep
  assert_contains "pakro run build" "root build task"
  assert_contains "pakro run ':build'" "root build task"
)
