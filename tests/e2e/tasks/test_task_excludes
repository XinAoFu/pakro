#!/usr/bin/env bash

mkdir -p .pakro/tasks/problem .pakro/tasks/generated .pakro/tasks/keep

cat <<'EOF' >.pakro/tasks/problem/_default
#!/usr/bin/env bash
echo problem
EOF
chmod +x .pakro/tasks/problem/_default

cat <<'EOF' >.pakro/tasks/problem/pyproject.toml
[project]
name = "problem"
version = "0.1.0"
EOF

cat <<'EOF' >.pakro/tasks/keep/_default
#!/usr/bin/env bash
echo keep
EOF
chmod +x .pakro/tasks/keep/_default

cat <<'EOF' >.pakro/tasks/generated/hidden.toml
[generated]
run = "echo generated"
EOF

cat <<'EOF' >standalone.toml
[standalone]
run = "echo standalone"
EOF

# Config-defined task.disable_paths entries resolve from the declaring config root.
cat <<'EOF' >.pakro/config.toml
[settings.task]
disable_paths = [".pakro/tasks/problem"]
EOF

assert_contains "pakro tasks" "keep"
assert_not_contains "pakro tasks" "problem"

# Scoped excludes support directories, globs, and direct TOML includes.
cat <<'EOF' >.pakro/config.toml
[task_config]
includes = [".pakro/tasks", "standalone.toml"]
excludes = [
  ".pakro/tasks/problem",
  ".pakro/tasks/generated/*.toml",
  "standalone.toml",
]
EOF

assert_contains "pakro tasks" "keep"
assert_not_contains "pakro tasks" "problem"
assert_not_contains "pakro tasks" "generated"
assert_not_contains "pakro tasks" "standalone"
assert "pakro run keep" "keep"
