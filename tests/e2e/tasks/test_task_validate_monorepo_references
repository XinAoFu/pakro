#!/usr/bin/env bash

assert_validation() {
  local count="$1" command="$2"
  assert_succeed "$command --json >validation.json"
  assert "jq -c '[.tasks_validated, .errors, .warnings]' validation.json" "[$count,0,0]"
}

# Root validation must recognize child references without validating child tasks.
mkdir -p crates/gui crates/tui
cat >pakro.toml <<'EOF'
monorepo_root = true
[monorepo]
config_roots = ["crates/gui", "crates/tui"]
[tasks.dev]
depends = ["//crates/gui:dev"]
[tasks.build]
run = "echo build"
[tasks.check]
run = "echo check"
[tasks.fix]
run = "echo fix"
[tasks.setup]
run = "echo setup"
[tasks.test]
run = "echo test"
EOF
cat >crates/gui/pakro.toml <<'EOF'
[tasks.dev]
run = "echo gui"
EOF
cat >crates/tui/pakro.toml <<'EOF'
[tasks.dev]
run = "echo tui"
EOF

assert_validation 6 "pakro tasks validate"
assert_validation 7 "pakro -C crates/gui tasks validate"
assert_validation 1 "pakro tasks validate //:dev"
assert "pakro run dev" "gui"
# Explicit task selection and the scope of --all are unchanged.
assert_fail "pakro tasks validate //crates/gui:dev" "Task '//crates/gui:dev' not found"
assert_fail "pakro tasks --all validate" "task list options cannot be used with subcommands"

# Dependency traversal can cross into a sibling without widening validation scope.
echo 'depends = ["//crates/tui:dev"]' >>crates/gui/pakro.toml
assert_validation 6 "pakro tasks validate"
assert_validation 7 "pakro -C crates/gui tasks validate"
assert "pakro run dev" $'tui\ngui'

# Child-only validation issues, aliases and remote files must not enter root checks.
cat >>pakro.toml <<'EOF'
[tasks.local]
alias = "shared"
run = "echo local"
EOF
cat >>crates/tui/pakro.toml <<'EOF'
[tasks.invalid]
alias = "shared"
timeout = "not-a-duration"
run = "echo invalid"
[tasks.remote]
file = "http://127.0.0.1:1/not-fetched.sh"
EOF
assert_validation 7 "pakro tasks validate"

# Each reference form uses the same scoped lookup, including relative paths and aliases.
cat >>crates/gui/pakro.toml <<'EOF'
[tasks.target]
alias = "target-alias"
run = "echo target"
EOF
for reference in \
  'depends = ["//crates/gui:target-alias"]' \
  'depends_post = ["//crates/gui:target"]' \
  'wait_for = ["//crates/gui:target"]' \
  'run = [{task = "./crates/gui:target"}]' \
  'run = [{tasks = ["//crates/gui:target argument"]}]'; do
  cat >pakro.toml <<EOF
monorepo_root = true
[monorepo]
config_roots = ["crates/gui", "crates/tui"]
[tasks.wrapper]
$reference
EOF
  # wait_for does not provide executable content on its own.
  if [[ $reference == wait_for* ]]; then
    echo 'run = "echo wrapper"' >>pakro.toml
  fi
  assert_validation 1 "pakro tasks validate"
done

# Missing references still fail for each form, with the existing diagnostic category.
for reference in \
  'depends = ["//crates/gui:absent"]' \
  'depends_post = ["//crates/gui:absent"]' \
  'wait_for = ["//crates/gui:absent"]' \
  'run = [{task = "//crates/gui:absent"}]' \
  'run = [{tasks = ["//crates/gui:absent argument"]}]' \
  'run = [{task = "target"}]' \
  'run = [{task = "//:target"}]'; do
  cat >pakro.toml <<EOF
monorepo_root = true
[monorepo]
config_roots = ["crates/gui", "crates/tui"]
[tasks.wrapper]
$reference
EOF
  if [[ $reference == wait_for* ]]; then
    echo 'run = "echo wrapper"' >>pakro.toml
  fi
  if [[ $reference == run* ]]; then
    assert_fail "pakro tasks validate" "missing-task-reference"
  else
    assert_fail "pakro tasks validate" "missing-dependency"
  fi
done

# Optional missing references retain their existing semantics.
cat >pakro.toml <<'EOF'
monorepo_root = true
[monorepo]
config_roots = ["crates/gui", "crates/tui"]
[tasks.wrapper]
depends = [{task = "//crates/gui:absent", optional = true}]
run = "echo wrapper"
EOF
assert_validation 1 "pakro tasks validate"

# A child loading failure must expose its cause instead of reporting a missing task.
mkdir -p broken/pkg
cat >broken/pakro.toml <<'EOF'
monorepo_root = true
[monorepo]
config_roots = ["pkg"]
[tasks.wrapper]
run = [{task = "//pkg:dev"}]
EOF
cat >broken/pkg/pakro.toml <<'EOF'
[tasks.dev]
extends = "missing-template"
EOF
assert_fail "pakro -C broken tasks validate" "extends template 'missing-template' which was not found"
assert_not_contains "pakro -C broken tasks validate 2>&1 || true" "missing-task-reference"

# Distinct child scopes share one reference load, rather than loading once per scope.
mkdir -p batched
cat >batched/pakro.toml <<'EOF'
monorepo_root = true
[monorepo]
config_roots = ["projects/*"]
EOF
for i in {1..12}; do
  mkdir -p "batched/projects/p$i"
  cat >"batched/projects/p$i/pakro.toml" <<'EOF'
[tasks.dev]
run = "echo child"
EOF
  cat >>batched/pakro.toml <<EOF
[tasks.wrapper$i]
run = [{task = "//projects/p$i:dev"}]
EOF
done
assert_succeed "PAKRO_TRACE=1 pakro -C batched tasks validate --json >validation.json 2>trace.log"
assert "jq -c '[.tasks_validated, .errors, .warnings]' validation.json" '[12,0,0]'
load_count=$(awk '/config::load_all_tasks_with_context start/ {count++} END {print count+0}' trace.log)
# One default load, one batched reference load, and two dependency-graph discovery loads.
if ((load_count != 4)); then
  fail "expected shared task loading for 12 child scopes, got $load_count loads"
fi
