#!/usr/bin/env bash

cat <<EOF >pakro.toml
[tasks.shell-invalid]
shell = 'invalid_shell'
run = 'echo "invalid shell"'
[tasks.shell]
shell = 'bash -c'
run = 'echo "using shell $0"'
EOF

assert "pakro run shell" "using shell bash"
# A forwarded arg is appended to the inline command, so it does NOT shift the
# shell's $0 (which stays "bash"); before the Windows fix, `bash -c <script> arg`
# made the first arg $0. See #9355.
assert "pakro run shell -- myarg" "using shell bash myarg"
assert_fail "pakro run shell-invalid" "invalid shell"

cat <<EOF >pakro.toml
tasks.escapeme = "echo \"{{arg(name='a')}}\""
tasks.escapeme_var = "echo \"{{arg(name='a', var=true)}}\""
tasks.bashshebang1 = """
#!/usr/bin/env -S bash
echo "{{arg(name='a')}}"
echo "{{arg(name='b', var=true)}}"
"""
tasks.bashshebang2 = """
#!/usr/bin/env bash
echo "{{arg(name='a')}}"
echo "{{arg(name='b', var=true)}}"
"""
tasks.bashshebang3 = """
#!/bin/bash
echo "{{arg(name='a')}}"
echo "{{arg(name='b', var=true)}}"
"""
tasks.bashshebangargs = """
#!/usr/bin/env bash
printf '<%s>\\n' "\$@"
"""
tasks.escapenode = """
#!/usr/bin/env -S python3
print("{{arg(name='a')}}")
print("{{arg(name='b', var=true)}}")
"""
EOF

assert "pakro run escapeme 'hello world'" "'hello world'"
assert "pakro run escapeme_var hello 'world of pakro'" "hello 'world of pakro'"
assert "pakro run bashshebang1 'a with space' hello 'world of pakro'" "'a with space'
hello 'world of pakro'"
assert "pakro run bashshebang2 my_a hello 'world of pakro'" "my_a
hello 'world of pakro'"
assert "pakro run bashshebang3 my_a hello 'world of pakro'" "my_a
hello 'world of pakro'"
assert "pakro run bashshebangargs 'a with space' second" "<a with space>
<second>"
assert "pakro run escapenode my_a hello 'world of pakro'" "my_a
hello 'world of pakro'"
assert "pakro run escapenode 'a with space' hello 'world of pakro'" "a with space
hello 'world of pakro'"
