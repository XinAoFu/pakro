#!/usr/bin/env bash

# tests that "test.sh" gets mapped to "test" except when an existing task is there named "test"
assert "pakro tasks add --file test.sh --description sh"
assert "pakro tasks ls" "test  sh"
assert_json_partial_array "pakro tasks ls --json" "name,description,source" "[
  {
    \"name\": \"test\",
    \"description\": \"sh\",
    \"source\": \"$PWD/pakro-tasks/test.sh\"
  }
]"
assert "pakro tasks ls --usage" 'cmd test help=sh {
    arg "[ARGS]…" help="Arguments to pass to the tasks. Use \":::\" to separate tasks." required=#false var=#true hide=#true
}'

assert "pakro tasks add --file test --description no-sh"
assert "pakro tasks ls" "test     no-sh
test.sh  sh"
assert_json_partial_array "pakro tasks ls --json" "name,description,source" "[
  {
    \"name\": \"test\",
    \"description\": \"no-sh\",
    \"source\": \"$PWD/pakro-tasks/test\"
  },
  {
    \"name\": \"test.sh\",
    \"description\": \"sh\",
    \"source\": \"$PWD/pakro-tasks/test.sh\"
  }
]"

assert_json_partial_array "pakro tasks ls --json" "name,description,source" "$(
  cat <<EOF
[
  {
    "name": "test",
    "description": "no-sh",
    "source": "$PWD/pakro-tasks/test"
  },
  {
    "name": "test.sh",
    "description": "sh",
    "source": "$PWD/pakro-tasks/test.sh"
  }
]
EOF
)"

assert "pakro tasks ls --usage" 'cmd test help=no-sh {
    arg "[ARGS]…" help="Arguments to pass to the tasks. Use \":::\" to separate tasks." required=#false var=#true hide=#true
}
cmd test.sh help=sh {
    arg "[ARGS]…" help="Arguments to pass to the tasks. Use \":::\" to separate tasks." required=#false var=#true hide=#true
}'

touch script.sh
chmod +x script.sh
cat <<EOF >pakro.toml
[tasks.mytask]
run = [
  'echo abc',
  './script.sh {{flag(name="test", default="false")}}',
]
EOF

assert "pakro run mytask" "abc"

mkdir -p pakro-tasks
cat <<EOF >pakro-tasks/test-args
#!/usr/bin/env bash
#PAKRO description="Compare block IDs between grower and packer tenants"
#USAGE flag "-g --grower <growerTenant>" required=#true var=#true help="The grower tenant ID(s) to compare"
#USAGE flag "-p --packer <packerTenant>" required=#true help="The packer tenant ID to match against"

echo "grower: \$usage_grower"
echo "packer: \$usage_packer"
EOF
chmod +x pakro-tasks/test-args

# assert_fail "pakro run test-args --grower 1 -g 2" "Missing required flag: --packer <packer>"
assert "pakro run --trace test-args --grower 1 -g 2 --packer 3" "grower: 1 2
packer: 3"

cat <<'EOF' >pakro.toml
[tasks.usage-env]
usage = '''
arg "myarg" "myarg description" default="foo"
'''
run = 'echo myarg=$usage_myarg'
EOF

assert "pakro run usage-env" "myarg=foo"
assert "pakro run usage-env bar" "myarg=bar"

cat <<'EOF' >pakro.toml
[tasks.usage-env]
usage = '''
flag "-m --myflag <myflag>" default="foo"
'''
run = 'echo myflag=$usage_myflag'
EOF

assert "pakro run usage-env" "myflag=foo"
assert "pakro run usage-env -m bar" "myflag=bar"
assert "pakro run usage-env --myflag bar" "myflag=bar"

cat <<'EOF' >pakro.toml
[tasks.usage-env]
usage = '''
arg "myarg" "myarg description" default="foo"
'''
run = [
'echo "Command 1: $usage_myarg"',
'echo "Command 2: {{arg(name="myarg", default="bar")}} $usage_myarg"',
]
EOF

assert "pakro run usage-env" "\
Command 1: foo
Command 2: foo foo"
assert "pakro run usage-env baz" "\
Command 1: baz
Command 2: baz baz"

cat <<'EOF' >pakro.toml
[tasks.usage-env]
usage = '''
flag "-m --myflag <myflag>" default="false"
'''
run = [
'echo "Command 1: $usage_myflag"',
'echo "Command 2: {{flag(name="myflag", default="false")}} $usage_myflag"',
]
EOF

assert "pakro run usage-env" "\
Command 1: false
Command 2: false false"
assert "pakro run usage-env -m true" "\
Command 1: true
Command 2: true true"
assert "pakro run usage-env --myflag true" "\
Command 1: true
Command 2: true true"

cat <<'EOF' >pakro.toml
[tasks.usage-env]
usage = '''
arg "myarg" "myarg description"
'''
run = [
'echo "Command 1: $usage_myarg"',
'echo "Command 2: {{arg(name="myarg", default="bar")}} $usage_myarg"',
]
EOF

assert_fail "pakro run usage-env"
