#!/usr/bin/env bash
# Test that monorepo tasks inherit tools from intermediate parent directories
export PAKRO_EXPERIMENTAL=1
export PAKRO_NODE_VERIFY=0

cat <<EOF >pakro.toml
monorepo_root = true

[monorepo]
config_roots = ["parent/*"]
EOF

mkdir -p parent
cat <<EOF >parent/pakro.toml
[tools]
node = "20"
EOF

mkdir -p parent/child
cat <<EOF >parent/child/pakro.toml
[tasks.build]
run = 'echo "NODE_VERSION=\$(node --version | cut -c2- | cut -d. -f1)"'
EOF

# Install node from the parent directory where it's defined
(cd parent && pakro install)

echo "=== Test: Child task inherits node 20 from intermediate parent ==="
assert_contains "pakro run //parent/child:build" "NODE_VERSION=20"

echo "=== Intermediate parent tool inheritance test passed! ==="
