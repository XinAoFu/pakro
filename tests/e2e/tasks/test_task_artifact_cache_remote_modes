#!/usr/bin/env bash

cat <<'EOF' >pakro.toml
[settings]
experimental = true
task.cache.remote_url = "http://127.0.0.1:9/cache"

[task_config.cache]
enabled = true

[tasks.build]
run = "printf 'ran\\n' >> runs.txt"
sources = ["input.txt"]
outputs = []
EOF

printf 'input\n' >input.txt

assert_fail_contains "pakro run build" "task.cache.remote_namespace is required"

# local-only must bypass remote configuration completely.
PAKRO_TASK_CACHE=local-only pakro run build
assert "wc -l < runs.txt | tr -d ' '" "1"

assert_fail_contains "PAKRO_TASK_CACHE_REMOTE_MODE=invalid pakro run build" "unknown variant"
