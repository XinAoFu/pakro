#!/usr/bin/env bash

# Test that tasks properly inherit environment from PAKRO_ENV-specific config files
# Regression test for issue where monorepo task changes broke PAKRO_ENV env inheritance

# Test 1 & 2: Basic PAKRO_ENV inheritance
cat <<EOF >pakro.toml
[env]
TEST_VAR = "base_value"

[tasks.print-env]
run = 'echo "TEST_VAR=\$TEST_VAR"'
EOF

cat <<EOF >.pakro.override.toml
[env]
TEST_VAR = "override_value"
OVERRIDE_ONLY_VAR = "from_override_config"
EOF

# Update task to print both variables
cat <<EOF >pakro.toml
[env]
TEST_VAR = "base_value"

[tasks.print-env]
run = 'echo "TEST_VAR=\$TEST_VAR OVERRIDE_ONLY_VAR=\$OVERRIDE_ONLY_VAR"'
EOF

# Test 1: Task should use base value without PAKRO_ENV
assert "pakro run print-env" "TEST_VAR=base_value OVERRIDE_ONLY_VAR="

# Test 2: Task should use override value with PAKRO_ENV=override
PAKRO_ENV=override assert "pakro run print-env" "TEST_VAR=override_value OVERRIDE_ONLY_VAR=from_override_config"

# Clean up for next test
rm -f pakro.toml .pakro.override.toml

# Test 3: Test with multiple environment profiles
cat <<EOF >.pakro.production.toml
[env]
TEST_VAR = "production_value"
DATABASE_URL = "postgres://prod"
EOF

cat <<EOF >.pakro.staging.toml
[env]
TEST_VAR = "staging_value"
DATABASE_URL = "postgres://staging"
EOF

cat <<EOF >pakro.toml
[env]
TEST_VAR = "base_value"
DATABASE_URL = "postgres://local"

[tasks.print-all-env]
run = 'echo "TEST_VAR=\$TEST_VAR DATABASE_URL=\$DATABASE_URL"'
EOF

# Test with different PAKRO_ENV values
assert "pakro run print-all-env" "TEST_VAR=base_value DATABASE_URL=postgres://local"
PAKRO_ENV=production assert "pakro run print-all-env" "TEST_VAR=production_value DATABASE_URL=postgres://prod"
PAKRO_ENV=staging assert "pakro run print-all-env" "TEST_VAR=staging_value DATABASE_URL=postgres://staging"

# Test 4: Multiple PAKRO_ENV profiles (later ones override earlier ones)
PAKRO_ENV=staging,production assert "pakro run print-all-env" "TEST_VAR=production_value DATABASE_URL=postgres://prod"

# Clean up for next test
rm -f pakro.toml .pakro.production.toml .pakro.staging.toml

# Test 5: Task-specific env should override both base config and PAKRO_ENV config
cat <<EOF >pakro.toml
[env]
TEST_VAR = "base_value"

[tasks.task-with-env]
run = 'echo "TEST_VAR=\$TEST_VAR"'
[tasks.task-with-env.env]
TEST_VAR = "task_override_value"
EOF

cat <<EOF >.pakro.custom.toml
[env]
TEST_VAR = "custom_value"
EOF

# Task env should override base config
assert "pakro run task-with-env" "TEST_VAR=task_override_value"
# Task env should also override PAKRO_ENV config
PAKRO_ENV=custom assert "pakro run task-with-env" "TEST_VAR=task_override_value"
