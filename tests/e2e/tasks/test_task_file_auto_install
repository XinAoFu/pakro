#!/usr/bin/env bash

# Test that tools defined in pakro.toml are auto-installed for file tasks
# Reproduces: https://github.com/jdx/mise/discussions/8014
#
# File tasks (scripts in pakro-tasks/) previously didn't trigger auto-install
# of tools from pakro.toml because t.cf(config) returns None for file tasks.

cat <<EOF >pakro.toml
[tools]
tiny = "1"

[settings]
task.run_auto_install = true
EOF

mkdir -p pakro-tasks
cat <<'EOF' >pakro-tasks/mytask
#!/usr/bin/env bash
rtx-tiny
EOF
chmod +x pakro-tasks/mytask

assert_contains "pakro run mytask" "rtx-tiny: v1.1.0"
