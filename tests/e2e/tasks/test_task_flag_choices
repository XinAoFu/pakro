#!/usr/bin/env bash

# Test that flags with choices work in pakro.toml tasks

cat <<'EOF' >pakro.toml
[tasks.deploy]
run = 'echo "Deploying to $usage_stage"'
usage = '''
flag "--stage <stage>" default="preview" {
  choices "preview" "production"
}
'''
EOF

# Test with default value
assert "pakro run deploy" "Deploying to preview"

# Test with valid choice
assert "pakro run deploy --stage production" "Deploying to production"

# Test with invalid choice should fail
assert_fail "pakro run deploy --stage invalid"

# Test flag choices using template syntax in run script
cat <<'EOF' >pakro.toml
[tasks.deploy]
run = 'echo "Deploying to {{flag(name="stage", default="preview", choices=["preview", "production"])}}"'
EOF

# Test with default value
assert "pakro run deploy" "Deploying to preview"

# Test with valid choice
assert "pakro run deploy --stage production" "Deploying to production"

# Test with invalid choice should fail
assert_fail "pakro run deploy --stage invalid"
