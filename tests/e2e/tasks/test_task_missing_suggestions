#!/usr/bin/env bash

cat <<EOF >pakro.toml
[tasks.compile]
description = "compile project"
run = 'echo "compile"'

[tasks.clean]
description = "clean compile dir"
run = 'echo "clean"'
EOF

assert_fail_contains "pakro run complie" "no task complie found"
assert_fail_contains "pakro run complie" "Did you mean one of these?"
assert_fail_contains "pakro run complie" "compile"
assert_fail_contains "pakro run build" "Available tasks:"
assert_fail_contains "pakro run build" "clean    clean compile dir"

rm pakro.toml
export PAKRO_EXPERIMENTAL=1

cat <<EOF >pakro.toml
monorepo_root = true

[monorepo]
config_roots = ["projects/*"]
EOF

mkdir -p projects/app
cat <<EOF >projects/app/pakro.toml
[tasks.compile]
description = "compile app"
run = 'echo "compile app"'
EOF

assert_fail_contains "pakro run build" "no task //:build found"
assert_fail_contains "pakro run build" "pakro tasks ls --all"
assert_fail_contains "pakro run build" "//projects/app:compile"
