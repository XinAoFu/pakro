#!/usr/bin/env bash

echo "tasks.mylocal = { run = 'echo mylocal' }" >pakro.toml
cat >~/.config/pakro/config.toml <<'TOML'
tasks.myglobal = { run = 'echo myglobal' }

[task_config]
includes = [".config/pakro/tasks", "dotfiles/tasks"]
TOML
mkdir -p ~/.config/pakro/tasks
cat <<'EOF' >~/.config/pakro/tasks/myglobalfile
#!/usr/bin/env bash
echo myglobalfile
EOF
chmod +x ~/.config/pakro/tasks/myglobalfile
mkdir -p ~/.config/pakro/conf.d ~/lower-global-tasks
cat <<'EOF' >~/lower-global-tasks/lower-global-only
#!/usr/bin/env bash
echo lower-global-only
EOF
chmod +x ~/lower-global-tasks/lower-global-only
cat <<'TOML' >~/.config/pakro/conf.d/relative-overlay.toml
[task_config]
includes = ["lower-global-tasks"]

[tasks.relative-meta]
file = ".config/pakro/tasks/relative-meta"
env = { RELATIVE_OVERLAY = "applied" }

[tasks.templated-meta]
file = "{{config_root}}/.config/pakro/tasks/templated-meta"
env = { TEMPLATED_OVERLAY = "applied" }
TOML
cat <<'EOF' >~/.config/pakro/tasks/relative-meta
#!/usr/bin/env bash
echo "RELATIVE_OVERLAY=${RELATIVE_OVERLAY:-<unset>}"
EOF
chmod +x ~/.config/pakro/tasks/relative-meta
cat <<'EOF' >~/.config/pakro/tasks/templated-meta
#!/usr/bin/env bash
echo "TEMPLATED_OVERLAY=${TEMPLATED_OVERLAY:-<unset>}"
EOF
chmod +x ~/.config/pakro/tasks/templated-meta
mkdir -p ~/dotfiles/tasks
cat <<'EOF' >~/dotfiles/tasks/customglobalfile
#!/usr/bin/env bash
echo "PROJECT_ROOT=$PAKRO_PROJECT_ROOT"
EOF
chmod +x ~/dotfiles/tasks/customglobalfile
mkdir -p "$PWD/system-config" "$PWD/system-tasks"
cat >"$PWD/system-config/config.toml" <<EOF
[task_config]
includes = ["$PWD/system-tasks"]
EOF
cat <<'EOF' >"$PWD/system-tasks/systemglobalfile"
#!/usr/bin/env bash
echo "PROJECT_ROOT=$PAKRO_PROJECT_ROOT"
EOF
chmod +x "$PWD/system-tasks/systemglobalfile"
export PAKRO_SYSTEM_CONFIG_FILE="$PWD/system-config/config.toml"

assert "pakro tasks" "customglobalfile
myglobal
myglobalfile
mylocal
relative-meta
systemglobalfile
templated-meta"
assert "pakro tasks --local" "mylocal"
assert "pakro tasks --global" "customglobalfile
myglobal
myglobalfile
relative-meta
systemglobalfile
templated-meta"
assert "pakro tasks ls --local" "mylocal"
assert "pakro tasks --local ls" "mylocal"
assert_fail "pakro tasks --name-only ls --json" "--name-only cannot be used with --json, --extended, or --usage"
assert_contains "pakro tasks mylocal --json" '"name": "mylocal"'
assert_fail "pakro tasks mylocal --local" "task list options cannot be used with task info"
assert_fail "pakro tasks deps --local" "unexpected argument '--local'"
assert_fail "pakro tasks --global deps" "task list options cannot be used with subcommands"
assert "pakro run customglobalfile" "PROJECT_ROOT=$PWD"
assert "pakro run systemglobalfile" "PROJECT_ROOT=$PWD"
assert "pakro run relative-meta" "RELATIVE_OVERLAY=applied"
assert "pakro run templated-meta" "TEMPLATED_OVERLAY=applied"
assert_fail "pakro run lower-global-only" "no task lower-global-only found"
