#!/usr/bin/env bash

# The pakro registry marks github:aubepkg/aube as publishing GitHub attestations
# from 2.2.5 on (`attestations_since`). Locking such a version records
# github-attestations provenance, and installing it verifies an attestation,
# rather than trusting a "none" answer from pakro-versions.

export PAKRO_LOCKFILE=1

cat <<EOF >pakro.toml
[tools]
"github:aubepkg/aube" = "2.3.0"
EOF
touch pakro.lock

pakro lock --platform linux-x64
assert_contains "cat pakro.lock" 'provenance = "github-attestations"'

pakro install
assert_contains "pakro x -- aube --version" "2.3.0"
