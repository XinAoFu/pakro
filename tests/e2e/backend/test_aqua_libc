#!/usr/bin/env bash

# The registry names rustnet's static musl build. The release also ships a gnu build,
# which pakro prefers on an unqualified Linux platform unless the tool sets `libc`.
export PAKRO_LOCKFILE=1
export PAKRO_AQUA_BAKED_REGISTRY=0

REGISTRY_DIR="$PWD/aqua-registry-local"
mkdir -p "$REGISTRY_DIR"

cat <<'EOF_REGISTRY' >"$REGISTRY_DIR/registry.yml"
packages:
  - type: github_release
    repo_owner: domcyrus
    repo_name: rustnet
    files:
      - name: rustnet
        src: "{{.AssetWithoutExt}}/rustnet"
    asset: rustnet-{{.Version}}-{{.Arch}}-{{.OS}}.{{.Format}}
    format: tar.gz
    replacements:
      amd64: x86_64
      arm64: aarch64
      darwin: apple-darwin
      linux: unknown-linux-musl
EOF_REGISTRY

export PAKRO_AQUA_REGISTRY_URL="file://$REGISTRY_DIR"
RELEASE_URL="https://github.com/domcyrus/rustnet/releases/download/v1.6.0"

cat <<'EOF_PAKRO' >pakro.toml
[tools]
"aqua:domcyrus/rustnet" = "1.6.0"
EOF_PAKRO
touch pakro.lock
pakro lock --platform linux-arm64
assert_contains "cat pakro.lock" "url = \"$RELEASE_URL/rustnet-v1.6.0-aarch64-unknown-linux-gnu.tar.gz\""

cat <<'EOF_PAKRO' >pakro.toml
[tools]
"aqua:domcyrus/rustnet" = { version = "1.6.0", libc = "musl" }
EOF_PAKRO
rm -f pakro.lock
touch pakro.lock
pakro lock --platform linux-arm64
assert_contains "cat pakro.lock" 'libc = "musl"'
assert_contains "cat pakro.lock" "url = \"$RELEASE_URL/rustnet-v1.6.0-aarch64-unknown-linux-musl.tar.gz\""
assert_not_contains "cat pakro.lock" "unknown-linux-gnu"

# A platform that names its libc keeps it: a gnu build cannot run on a musl target.
cat <<'EOF_PAKRO' >pakro.toml
[tools]
"aqua:domcyrus/rustnet" = { version = "1.6.0", libc = "glibc" }
EOF_PAKRO
rm -f pakro.lock
touch pakro.lock
pakro lock --platform linux-arm64,linux-x64-musl
assert_contains "cat pakro.lock" 'libc = "gnu"'
assert_contains "cat pakro.lock" "url = \"$RELEASE_URL/rustnet-v1.6.0-aarch64-unknown-linux-gnu.tar.gz\""
assert_contains "cat pakro.lock" "url = \"$RELEASE_URL/rustnet-v1.6.0-x86_64-unknown-linux-musl.tar.gz\""

# A musl platform nobody asked for keeps the registry's asset: it names only a gnu build here,
# so pakro does not go looking for a musl one.
cat <<'EOF_REGISTRY' >"$REGISTRY_DIR/registry.yml"
packages:
  - type: github_release
    repo_owner: domcyrus
    repo_name: rustnet
    files:
      - name: rustnet
        src: "{{.AssetWithoutExt}}/rustnet"
    asset: rustnet-{{.Version}}-{{.Arch}}-{{.OS}}.{{.Format}}
    format: tar.gz
    replacements:
      amd64: x86_64
      arm64: aarch64
      darwin: apple-darwin
      linux: unknown-linux-gnu
EOF_REGISTRY
cat <<'EOF_PAKRO' >pakro.toml
[tools]
"aqua:domcyrus/rustnet" = "1.6.0"
EOF_PAKRO
rm -f pakro.lock
touch pakro.lock
pakro lock --platform linux-x64-musl
assert_contains "cat pakro.lock" "url = \"$RELEASE_URL/rustnet-v1.6.0-x86_64-unknown-linux-gnu.tar.gz\""
assert_not_contains "cat pakro.lock" "unknown-linux-musl"

# `libc = "musl"` in settings asks for musl on every musl platform, so the gnu-only registry
# entry is still switched to the musl build, including for a platform other than the host's.
rm -f pakro.lock
touch pakro.lock
PAKRO_LIBC=musl pakro lock --platform linux-x64-musl,linux-arm64-musl
assert_contains "cat pakro.lock" "url = \"$RELEASE_URL/rustnet-v1.6.0-x86_64-unknown-linux-musl.tar.gz\""
assert_contains "cat pakro.lock" "url = \"$RELEASE_URL/rustnet-v1.6.0-aarch64-unknown-linux-musl.tar.gz\""
assert_not_contains "cat pakro.lock" "unknown-linux-gnu"

# Install the musl build on a Linux host and run it: it is statically linked, so it does
# not need libpcap. Changing `libc` for an installed version needs `--force`.
if [[ "$(uname -s)" == "Linux" ]]; then
  cat <<'EOF_PAKRO' >pakro.toml
[tools]
"aqua:domcyrus/rustnet" = { version = "1.6.0", libc = "musl" }
EOF_PAKRO
  rm -f pakro.lock
  pakro install --force aqua:domcyrus/rustnet@1.6.0
  assert_contains "pakro which rustnet" "unknown-linux-musl/rustnet"
  assert_succeed "pakro x -- rustnet --version"
fi
