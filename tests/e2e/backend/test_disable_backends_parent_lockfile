#!/usr/bin/env bash
export PAKRO_EXPERIMENTAL=1
export PAKRO_DISABLE_BACKENDS=asdf,ubi

detect_platform

cat >pakro.toml <<'EOF'
[tools]
yarn = "4.16.0"
EOF
cat >pakro.lock <<'EOF'
lockfile_version = 1

[[tools.yarn]]
version = "4.16.0"
backend = "asdf:yarn"
specifiers = ["4.16.0"]
EOF

mkdir child
(
  cd child
  cat >pakro.toml <<'EOF'
[tools]
yarn = "4.16.0"
EOF

  # Parent pins still participate in discovery when their backend is enabled.
  assert "PAKRO_DISABLE_BACKENDS= pakro tool yarn --backend" "asdf:yarn"

  # No installed tools, plugins, or child lockfile are needed to trigger this bug.
  assert "pakro tool yarn --backend" "aqua:yarnpkg/berry"
  pakro lock --platform "$PAKRO_PLATFORM"
  assert_contains "cat pakro.lock" 'backend = "aqua:yarnpkg/berry"'
  assert_not_contains "cat pakro.lock" 'asdf:'
  assert_contains "cat ../pakro.lock" 'backend = "asdf:yarn"'

  # Explicit requests must still fail instead of silently choosing another backend.
  assert_fail "pakro install asdf:yarn@4.16.0" "backend asdf is disabled by disable_backends"
)

# Skip a disabled first pin without losing a later enabled, non-default backend.
cat >pakro.lock <<'EOF'
lockfile_version = 1

[[tools.yarn]]
version = "4.15.0"
backend = "asdf:yarn"
specifiers = ["4.15.0"]

[[tools.yarn]]
version = "4.16.0"
backend = "cargo:yarn"
specifiers = ["4.16.0"]
EOF
mkdir mixed-child
cp pakro.toml mixed-child/pakro.toml
cd mixed-child
assert "pakro tool yarn --backend" "cargo:yarn"
pakro lock --platform "$PAKRO_PLATFORM"
assert_contains "cat pakro.lock" 'backend = "cargo:yarn"'
assert_not_contains "cat pakro.lock" 'asdf:'
