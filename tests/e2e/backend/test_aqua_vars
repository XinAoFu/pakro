#!/usr/bin/env bash

export PAKRO_EXPERIMENTAL=1
export PAKRO_LOCKFILE=1
export PAKRO_AQUA_BAKED_REGISTRY=0

detect_platform

REGISTRY_DIR="$PWD/aqua-registry-local"
mkdir -p "$REGISTRY_DIR"

cat <<'EOF_REGISTRY' >"$REGISTRY_DIR/registry.yml"
packages:
  - type: http
    name: example/vars-tool
    supported_envs:
      - darwin
      - linux
      - windows
    url: https://mise.jdx.dev/test-fixtures/hello-world-{{.Vars.fixture_version}}.tar.gz
    files:
      - name: hello-world
        src: hello-world-{{.Vars.fixture_version}}/bin/hello-world
    vars:
      - name: fixture_version
        required: true
EOF_REGISTRY

export PAKRO_AQUA_REGISTRY_URL="file://$REGISTRY_DIR"

cat <<'EOF_PAKRO' >pakro.toml
[tools]
"aqua:example/vars-tool" = { version = "1.0.0", fixture_version = "1.0.0" }
EOF_PAKRO

PAKRO_TIMINGS=1 pakro install
assert_contains "pakro x -- hello-world" "hello world"

cat <<'EOF_PAKRO' >pakro.toml
[tools]
"aqua:example/vars-tool" = { version = "1.0.0", fixture_version = "2.0.0" }
EOF_PAKRO

PAKRO_TIMINGS=1 pakro install --force aqua:example/vars-tool@1.0.0
assert_contains "pakro x -- hello-world" "hello world 2.0.0"

rm -f pakro.lock
cat <<'EOF_PAKRO' >pakro.toml
[tools]
"aqua:example/vars-tool" = { version = "1.0.0", vars = { fixture_version = "2.0.0" } }
EOF_PAKRO

PAKRO_TIMINGS=1 pakro lock --platform "$PAKRO_PLATFORM"
assert_contains "cat pakro.lock" '"vars.fixture_version" = "2.0.0"'
assert_contains "cat pakro.lock" 'url = "https://mise.jdx.dev/test-fixtures/hello-world-2.0.0.tar.gz"'
cp pakro.lock nested-vars.lock

cat <<'EOF_PAKRO' >pakro.toml
[tools]
"aqua:example/vars-tool" = { version = "1.0.0", fixture_version = "2.0.0" }
EOF_PAKRO

PAKRO_TIMINGS=1 pakro lock --platform "$PAKRO_PLATFORM"
assert_succeed "cmp pakro.lock nested-vars.lock"

rm -f pakro.toml pakro.lock
mkdir -p .config/pakro/conf.d

cat <<'EOF_PAKRO' >.config/pakro/conf.d/01-base.toml
[tools."aqua:example/vars-tool"]
version = "1.0.0"
vars.fixture_version = "1.0.0"
EOF_PAKRO

cat <<'EOF_PAKRO' >.config/pakro/conf.d/02-override.toml
[tools."aqua:example/vars-tool"]
version = "1.0.0"
fixture_version = "2.0.0"
EOF_PAKRO

PAKRO_TIMINGS=1 pakro lock --platform "$PAKRO_PLATFORM"
assert_contains "cat .config/pakro/pakro.lock" '"vars.fixture_version" = "2.0.0"'
assert_contains "cat .config/pakro/pakro.lock" 'url = "https://mise.jdx.dev/test-fixtures/hello-world-2.0.0.tar.gz"'
assert_not_contains "cat .config/pakro/pakro.lock" '"vars.fixture_version" = "1.0.0"'
rm -rf .config/pakro

cat <<'EOF_PAKRO' >pakro.toml
[tools]
"aqua:example/vars-tool" = { version = "1.0.0", vars = { fixture_version = ["2.0.0"] } }
EOF_PAKRO

# shellcheck disable=SC2016
assert_fail "pakro install --force aqua:example/vars-tool@1.0.0" 'aqua var `vars.fixture_version` must be a string, got array'
