#!/usr/bin/env bash

# hk started publishing Packslip manifests in 1.58.1. Earlier releases must
# continue to install through the registry shorthand, using Aqua.
export PAKRO_EXPERIMENTAL=0
export PAKRO_MINIMUM_RELEASE_AGE=0
export PAKRO_REGISTRY_FLOATING=0
detect_platform

# Registry CI must exercise the newly published preferred backend immediately.
PAKRO_MINIMUM_RELEASE_AGE=90d pakro test-tool hk

assert_contains "pakro ls-remote hk@1.57" "1.57.0"
assert_contains "pakro ls-remote hk 1.57" "1.57.0"
assert_contains "pakro ls-remote hk@sub-0.1:1.58.1" "1.57.0"
assert_contains "pakro ls-remote hk@prefix:1.57" "1.57.0"
assert "pakro latest hk@1.57" "1.57.0"
assert "pakro latest hk 1.57" "1.57.0"
assert_not_contains "PAKRO_BACKENDS_HK=packslip:github.com/jdx/hk pakro ls-remote hk@1.57" "1.57"
assert_fail_contains "PAKRO_DISABLE_BACKENDS=aqua pakro latest hk@1.57" "none of its backends"

cat >pakro.toml <<'TOML'
[tools]
hk = ["1.57.0", "1.58.1"]

[settings]
lockfile = true
TOML
pakro install
assert_contains "pakro exec hk@1.57.0 -- hk --version" "hk 1.57.0"
assert_contains "pakro exec hk@1.58.1 -- hk --version" "hk 1.58.1"
assert_contains "cat pakro.lock" 'backend = "aqua:jdx/hk"'
assert_contains "cat pakro.lock" 'backend = "packslip:github.com/jdx/hk"'
assert_contains "PAKRO_OFFLINE=1 pakro --locked exec hk@1.57.0 -- hk --version" "hk 1.57.0"
assert_contains "PAKRO_OFFLINE=1 pakro --locked exec hk@1.58.1 -- hk --version" "hk 1.58.1"
assert_fail_contains "PAKRO_DISABLE_BACKENDS=aqua pakro latest hk@1.57" "none of its backends"

# Aliases can cross the boundary after their version string is resolved.
cat >>pakro.toml <<'TOML'
[tool_alias.hk.versions]
old = "1.57.0"
old_prefix = "prefix:1.57"
TOML
assert_contains "pakro exec hk@old -- hk --version" "hk 1.57.0"
assert "pakro latest hk@old" "1.57.0"
assert_contains "pakro ls-remote hk@old" "1.57.0"
assert_contains "pakro ls-remote hk@old_prefix" "1.57.0"

# Explicit backends remain explicit; no fallback after a verification error.
assert_fail_contains "pakro install --force packslip:github.com/jdx/hk@1.57.0" "no release"

# Packslip resolves signed artifact metadata for the host and non-host
# platforms, and locked installation consumes the generated host entry.
pakro lock hk@1.58.1 --platform "$PAKRO_PLATFORM,windows-x64"
assert_contains "cat pakro.lock" '[tools.hk."platforms.windows-x64"]'
assert_contains "awk '/\[tools.hk\.\"platforms.windows-x64\"\]/{f=1;next}/^\[/{f=0}f' pakro.lock" 'checksum = "sha256:'
assert_contains "awk '/\[tools.hk\.\"platforms.windows-x64\"\]/{f=1;next}/^\[/{f=0}f' pakro.lock" 'url = "https://github.com/jdx/hk/releases/download/v1.58.1/hk-x86_64-pc-windows-msvc.zip"'
assert_contains "awk '/\[tools.hk\.\"platforms.windows-x64\"\]/{f=1;next}/^\[/{f=0}f' pakro.lock" 'signer = "sigstore-oidc:https://github.com/jdx/hk/.github/workflows/release.yml"'
pakro uninstall hk@1.58.1
pakro install --locked hk@1.58.1
assert_contains "pakro exec hk@1.58.1 -- hk --version" "hk 1.58.1"
