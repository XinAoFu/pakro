#!/usr/bin/env bash

unset PAKRO_GITHUB_TOKEN GITHUB_API_TOKEN GITHUB_TOKEN

# Create a cargo-binstall stub that just outputs the value of GITHUB_TOKEN
cat >~/bin/cargo-binstall <<'EOF'
#!/usr/bin/env bash
echo "token=$GITHUB_TOKEN"
echo "args=$*"
exit "${BINSTALL_EXIT_CODE:-0}"
EOF
cat >~/bin/cargo <<'EOF'
#!/usr/bin/env bash
echo "cargo-args=$*"
EOF
chmod u+x ~/bin/cargo-binstall ~/bin/cargo
export PATH="$HOME/bin:$PATH"

# This should reuse the existing GITHUB_TOKEN variable
assert_contains "GITHUB_TOKEN=foobar pakro install -f cargo:eza@0.18.24 2>&1" "token=foobar"

# This should use the GITHUB_API_TOKEN variable
assert_contains "GITHUB_API_TOKEN=foobar pakro install -f cargo:eza@0.18.24 2>&1" "token=foobar"

# This should prefer GITHUB_API_TOKEN
assert_contains "GITHUB_API_TOKEN=foobar GITHUB_TOKEN=barquz pakro install -f cargo:eza@0.18.24 2>&1" "token=foobar"

# This should prefer PAKRO_GITHUB_TOKEN
assert_contains "PAKRO_GITHUB_TOKEN=foobar GITHUB_API_TOKEN=barquz GITHUB_TOKEN=barquz pakro install -f cargo:eza@0.18.24 2>&1" "token=foobar"

# compile and quick-install should be disabled by default
assert_contains "pakro install -f cargo:eza@0.18.24 2>&1" "args=-y --disable-strategies compile,quick-install eza@0.18.24"
install_path="$(pakro where cargo:eza@0.18.24)"
assert_contains "cat '$install_path/.pakro-cargo-install.toml'" "default_features = true"
assert_contains "cat '$install_path/.pakro-cargo-install.toml'" "locked = true"

# The setting should allow quick-install while compile remains disabled
assert_contains "PAKRO_CARGO_BINSTALL_QUICKINSTALL=1 pakro install -f cargo:eza@0.18.24 2>&1" "args=-y --disable-strategies compile eza@0.18.24"

# Exit code 94 means no prebuilt artifact, so pakro should run cargo install
assert_contains "BINSTALL_EXIT_CODE=94 pakro install -f cargo:eza@0.18.24 2>&1" "cargo-args=install eza@0.18.24 --locked"

# Other cargo-binstall failures must not fall back to cargo install
output="$(BINSTALL_EXIT_CODE=1 pakro install -f cargo:eza@0.18.24 2>&1)" && fail "cargo-binstall exit code 1 unexpectedly succeeded"
assert_not_contains_text "$output" "cargo-args="

# binstall_only must not allow pakro's cargo install fallback
output="$(PAKRO_CARGO_BINSTALL_ONLY=1 BINSTALL_EXIT_CODE=94 pakro install -f cargo:eza@0.18.24 2>&1)" && fail "cargo-binstall exit code 94 unexpectedly succeeded with binstall_only"
assert_not_contains_text "$output" "cargo-args="

# Explicit git sources use cargo install even when binstall_only is enabled
output="$(PAKRO_CARGO_BINSTALL_ONLY=1 pakro install -f cargo:https://github.com/example/example@HEAD 2>&1)"
assert_contains_text "$output" "cargo-args=install --git=https://github.com/example/example"
assert_not_contains_text "$output" "example@example@HEAD"

# Cargo-only options on explicit git sources remain unaffected by binstall_only
cat >pakro.toml <<'EOF'
[tools]
"cargo:https://github.com/example/features" = { version = "HEAD", features = "extra" }
EOF
assert_contains "PAKRO_CARGO_BINSTALL_ONLY=1 pakro install 2>&1" "cargo-args=install --git=https://github.com/example/features --locked --features=extra"
