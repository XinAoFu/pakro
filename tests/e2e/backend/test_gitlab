#!/usr/bin/env bash

# Test basic GitLab backend functionality with real tools
cat <<EOF >pakro.toml
[tools]
"gitlab:jdxcode/mise-test-fixtures" = { version = "1.0.0", asset_pattern = "hello-world-1.0.0.tar.gz", bin_path = "hello-world-1.0.0/bin", postinstall = "chmod +x \$PAKRO_TOOL_INSTALL_PATH/hello-world-1.0.0/bin/hello-world" }
EOF

pakro install
assert_contains "pakro x -- hello-world" "hello world"
pakro uninstall gitlab:jdxcode/mise-test-fixtures

# Test GitLab backend with platform-specific URLs
cat <<EOF >pakro.toml
[tools."gitlab:jdxcode/mise-test-fixtures"]
platform_darwin_arm64_url = "https://mise.jdx.dev/test-fixtures/hello-world-1.0.0.tar.gz"
platform_darwin_amd64_url = "https://mise.jdx.dev/test-fixtures/hello-world-1.0.0.tar.gz"
platform_linux_amd64_url = "https://mise.jdx.dev/test-fixtures/hello-world-1.0.0.tar.gz"
version = "1.0.0"
bin_path = "bin"
postinstall = "chmod +x \$PAKRO_TOOL_INSTALL_PATH/bin/hello-world"
strip_components = 1
EOF

pakro install
assert_contains "pakro x -- hello-world" "hello world"
pakro uninstall gitlab:jdxcode/mise-test-fixtures

# Test GitLab backend with pakro.lock checksum generation
export PAKRO_LOCKFILE=1
export PAKRO_EXPERIMENTAL=1

touch pakro.lock
cat <<EOF >pakro.toml
[tools]
"gitlab:jdxcode/mise-test-fixtures" = { version = "1.0.0", asset_pattern = "hello-world-1.0.0.tar.gz", bin_path = "hello-world-1.0.0/bin", postinstall = "chmod +x \$PAKRO_TOOL_INSTALL_PATH/hello-world-1.0.0/bin/hello-world" }
EOF

pakro install
# Verify pakro.lock is written correctly with checksums
assert_contains "cat pakro.lock" '[[tools."gitlab:jdxcode/mise-test-fixtures"]]'
assert_contains "cat pakro.lock" 'version = "1.0.0"'
assert_contains "cat pakro.lock" 'backend = "gitlab:jdxcode/mise-test-fixtures"'
assert_contains "cat pakro.lock" 'asset_pattern = "hello-world-1.0.0.tar.gz"'
# Get the current platform key
PLATFORM_KEY=$(pakro x --cd . -- bash -c "echo \"\$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/')-\$(uname -m | sed 's/x86_64/x64/' | sed 's/aarch64/arm64/')\"")
assert_contains "cat pakro.lock" "\"platforms.$PLATFORM_KEY\""
assert_contains "cat pakro.lock" 'checksum = "blake3:71f774faa03daf1a58cc3339f8c73e6557348c8e0a2f3fb8148cc26e26bad83f"'
# URL comes from the upstream GitLab release asset, which was published with the upstream asset hostname.
assert_contains "cat pakro.lock" 'url = "https://mise.jdx.dev/test-fixtures/hello-world-1.0.0.tar.gz"'

pakro uninstall gitlab:jdxcode/mise-test-fixtures

# Test GitLab backend with tool alias propagates options correctly
# Regression test for https://github.com/jdx/mise/discussions/8079
cat <<EOF >pakro.toml
[tools]
"gitlab:jdxcode/mise-test-fixtures" = { version = "1.0.0", asset_pattern = "hello-world-1.0.0.tar.gz", bin_path = "hello-world-1.0.0/bin", postinstall = "chmod +x \$PAKRO_TOOL_INSTALL_PATH/hello-world-1.0.0/bin/hello-world" }

[tool_alias]
my-test-tool = 'gitlab:jdxcode/mise-test-fixtures'
EOF

# Verify ls-remote works via alias (exercises _list_remote_versions with get_tool_opts)
assert_contains "pakro ls-remote my-test-tool" "1.0.0"

pakro install
assert_contains "pakro x my-test-tool -- hello-world" "hello world"
