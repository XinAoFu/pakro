#!/usr/bin/env bash

# Test GitHub backend URL tracking functionality
export PAKRO_LOCKFILE=1
export PAKRO_EXPERIMENTAL=1

# Clean up any existing installations
pakro uninstall github:jdx/mise-test-fixtures 2>/dev/null || true

# Create initial configuration
cat <<EOF >pakro.toml
[tools]
"github:jdx/mise-test-fixtures" = { version = "1.0.0", asset_pattern = "hello-world-1.0.0.tar.gz", bin_path = "hello-world-1.0.0/bin", postinstall = "chmod +x \$PAKRO_TOOL_INSTALL_PATH/hello-world-1.0.0/bin/hello-world" }
EOF

# Create lockfile
touch pakro.lock

# First install - should fetch URL from GitHub API
echo "=== First install - fetching URL from GitHub API ==="
pakro install
assert_contains "pakro x -- hello-world" "hello world"

# Verify URL is stored in lockfile
echo "=== Verifying URL is stored in lockfile ==="
assert_contains "cat pakro.lock" '[[tools."github:jdx/mise-test-fixtures"]]'
assert_contains "cat pakro.lock" 'version = "1.0.0"'
assert_contains "cat pakro.lock" 'backend = "github:jdx/mise-test-fixtures"'
assert_contains "cat pakro.lock" 'asset_pattern = "hello-world-1.0.0.tar.gz"'
# Get the current platform key
PLATFORM_KEY=$(pakro x --cd . -- bash -c "echo \"\$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/')-\$(uname -m | sed 's/x86_64/x64/' | sed 's/aarch64/arm64/')\"")
assert_contains "cat pakro.lock" "\"platforms.$PLATFORM_KEY\""
assert_contains "cat pakro.lock" 'url = "https://github.com/jdx/mise-test-fixtures/releases/download/v1.0.0/hello-world-1.0.0.tar.gz"'
assert_contains "cat pakro.lock" 'url_api = "https://api.github.com/repos/jdx/mise-test-fixtures/releases/assets/272317030"'

echo "Lockfile after installation:"
cat pakro.lock

# Uninstall and reinstall - should reuse URL from lockfile
echo "=== Uninstall and reinstall - should reuse cached URL ==="
pakro uninstall "github:jdx/mise-test-fixtures@1.0.0"
pakro install

# Should still work with cached URL
assert_contains "pakro x -- hello-world" "hello world"

# Lockfiles created before url_api tracking can have a cached browser URL with
# no matching API URL. Reinstalling from that lockfile should still use the
# browser URL instead of treating the missing API URL as a custom API endpoint.
echo "=== Reinstall from cached URL without url_api ==="
pakro uninstall "github:jdx/mise-test-fixtures@1.0.0"
grep -v 'url_api = "' pakro.lock >pakro.lock.tmp
mv pakro.lock.tmp pakro.lock
assert_not_contains "cat pakro.lock" 'url_api = "'
pakro install
assert_contains "pakro x -- hello-world" "hello world"
assert_not_contains "cat pakro.lock" 'url_api = "'

echo "Test completed successfully!"
