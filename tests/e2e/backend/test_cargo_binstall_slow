#!/usr/bin/env bash
require_cmd cargo

export PAKRO_CARGO_BINSTALL=1
echo "tools.cargo-binstall = 'latest'" >pakro.toml
pakro i
assert "PAKRO_CARGO_BINSTALL_ONLY=1 pakro x cargo:eza@0.18.24 -- eza -v" "eza - A modern, maintained replacement for ls
v0.18.24 [+git]
https://github.com/eza-community/eza"

cat >pakro.toml <<EOF
tools.cargo-binstall = "latest"
tools."cargo:cargo-show" = "latest"
EOF

pakro i
pakro uninstall cargo:cargo-show cargo-binstall

###### TEST CUSTOM REGISTRY ######
export CARGO_REGISTRIES_OFFICIAL_GIT_INDEX=https://github.com/rust-lang/crates.io-index
export PAKRO_CARGO_REGISTRY_NAME=official_git
pakro i
