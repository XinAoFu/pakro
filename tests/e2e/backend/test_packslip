#!/usr/bin/env bash

# The packslip backend installs a release from its vendor's signed manifest.
# jdx/packslip publishes one for its own releases, signed keylessly by its
# release workflow, which is the identity the project name pins.

# Every release carrying a packslip is recent; do not let the default
# minimum release age hide them all.
export PAKRO_MINIMUM_RELEASE_AGE=0

# The backend needs no setting turned on to be used.
assert_contains "env -u PAKRO_EXPERIMENTAL pakro ls-remote packslip:github.com/jdx/packslip" "0.2.0"

# The registry supplies the canonical project and pins each publishing workflow
# separately so CI signing jobs cannot authorize either bundles or the index.
mkdir canonical
pushd canonical >/dev/null
cat >pakro.toml <<'EOF'
[tools]
packslip = "latest"
EOF
# Latest resolves and verifies the vendor recommendation without installing it.
latest=$(pakro latest packslip) || exit 1
[[ -n $latest ]] || exit 1
assert_contains "pakro ls-remote packslip" "$latest"
# The quickstart works with no explicit signer options in the user's config.
PAKRO_GLOBAL_CONFIG_FILE="$PWD/global.toml" pakro use -g packslip
assert_contains "cat global.toml" 'packslip ='
assert_contains "pakro exec -- packslip version" "packslip $latest"
canonical_install_path="$(pakro where packslip)"
assert_contains "cat $canonical_install_path/.pakro-packslip.json" '"project": "packslip.dev"'
# Changing a list policy must not reuse the accepted versions from the warm cache.
assert_fail_contains "pakro ls-remote 'packslip[list_identity_prefix=https://github.com/jdx/packslip/.github/workflows/ci.yml@]'" "verifying the release list"
# A trusted index does not authorize its signer (or CI) to sign release bundles.
assert_fail_contains "pakro latest 'packslip[identity_prefix=https://github.com/jdx/packslip/.github/workflows/packslip-releases.yml@]'" "expected an identity starting with"
assert_fail_contains "pakro latest 'packslip[identity_prefix=https://github.com/jdx/packslip/.github/workflows/ci.yml@]'" "expected an identity starting with"
pakro packslip forget packslip.dev
popd >/dev/null

# A warm accepted-version cache must not hide changed stamper policy.
mkdir stamp-policy
pushd stamp-policy >/dev/null
cat >pakro.toml <<'EOF'
[settings.packslip]
stampers = ["invalid"]
EOF
assert_fail_contains "pakro ls-remote packslip:github.com/jdx/packslip" "has no pin"
popd >/dev/null

pakro use packslip:github.com/jdx/packslip@0.2.0
assert_contains "$PAKRO_DATA_DIR/shims/packslip version" "packslip 0.2.0"

# github.com is implied for owner/repo.
assert_contains "pakro x packslip:jdx/packslip@0.2.0 -- packslip version" "packslip 0.2.0"

# The verified statement is kept beside the install, and the lockfile
# entry carries the URL and digest the statement signed.
install_path="$(pakro where packslip:github.com/jdx/packslip@0.2.0)"
assert_contains "cat $install_path/.pakro-packslip.json" '"project": "github.com/jdx/packslip"'
assert_contains "pakro tool packslip:github.com/jdx/packslip" "packslip"

# The signer is pinned, the way SSH remembers a host, and can be forgotten.
assert_contains "pakro packslip pins" "https://github.com/jdx/packslip/.github/workflows/release.yml"
assert_contains "pakro packslip forget jdx/packslip" "forgot the pinned signer"
assert_contains "pakro packslip pins" "no packslip signers pinned"

# This release's packslip lists no completion, and pakro says so rather
# than guessing at one; a tool pakro does not know has no packslip at all.
assert_fail_contains "pakro completion zsh --tool packslip" "declares no zsh completion"
assert_fail_contains "pakro completion zsh --tool nope" "not an active, installed tool"

# This release declares no skill either, and sync links nothing.
assert_contains "pakro skills ls" "no skills declared"
assert "pakro skills ls --json" "[]"
assert_contains "pakro skills sync --dir skills" "nothing to link"
assert_directory_not_exists skills
assert_contains "env PAKRO_SKILLS_DIR=agents/skills pakro skills sync" "nothing to link"
assert_directory_not_exists agents

# A lockfile records who signed, so the project commits to that signer.
export PAKRO_LOCKFILE=1
mkdir -p locked && cd locked
touch pakro.lock
cat <<EOF >pakro.toml
[tools]
"packslip:github.com/jdx/packslip" = "0.2.0"
EOF
pakro uninstall packslip:github.com/jdx/packslip@0.2.0
pakro install
assert_contains "cat pakro.lock" 'signer = "sigstore-oidc:https://github.com/jdx/packslip/.github/workflows/release.yml"'
# The commitment carries the repository's forge ID, so it follows a rename
# and refuses a different repository that takes the name.
assert_contains "cat pakro.lock" 'repository_ids = { repository = "1356006409" }'
# A lockfile is an already-reviewed selection. A later release-age policy must
# not make that committed install unreproducible.
pakro uninstall packslip:github.com/jdx/packslip@0.2.0
PAKRO_MINIMUM_RELEASE_AGE=2000-01-01 pakro install
cd ..
unset PAKRO_LOCKFILE

# Naming one release is itself the selection release age governs, so a config
# that pins an exact version installs during the cooling window with no
# lockfile, and locking records the same selection.
mkdir -p pinned && cd pinned
cat <<EOF >pakro.toml
[tools]
"packslip:github.com/jdx/packslip" = "0.2.0"
EOF
pakro uninstall packslip:github.com/jdx/packslip@0.2.0
PAKRO_MINIMUM_RELEASE_AGE=2000-01-01 pakro install
assert_contains "pakro x -- packslip version" "packslip 0.2.0"
PAKRO_MINIMUM_RELEASE_AGE=2000-01-01 pakro lock
assert_contains "cat pakro.lock" 'version = "0.2.0"'
cd ..

# A release that carries no packslip is refused rather than guessed at.
assert_fail_contains "pakro install packslip:jdx/mise-test-fixtures@1.0.0" "no release"
