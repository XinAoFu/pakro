#!/usr/bin/env bash
export PAKRO_EXPERIMENTAL=1

detect_platform

assert_fail "PAKRO_DISABLE_BACKENDS=ubi pakro install ubi:example/example@1.0.0" "backend ubi is disabled by disable_backends"
assert_fail "PAKRO_DISABLE_BACKENDS=ubi pakro use -g ubi:example/example@1.0.0" "backend ubi is disabled by disable_backends"
assert_fail "PAKRO_DISABLE_BACKENDS=asdf pakro install asdf:dummy@1.0.0" "backend asdf is disabled by disable_backends"

assert "pakro registry age" "aqua:FiloSottile/age asdf:threkk/asdf-age"

pakro install age
assert_fail "ls $PAKRO_DATA_DIR/plugins/age"
pakro uninstall age

PAKRO_DISABLE_BACKENDS=aqua pakro install age@1.2.1
ls "$PAKRO_DATA_DIR/plugins/age"
assert "PAKRO_DISABLE_BACKENDS=asdf pakro tool age --backend" "aqua:FiloSottile/age"
eval "$(pakro activate bash)" && _pakro_hook
assert_contains "PAKRO_DISABLE_BACKENDS=asdf pakro doctor 2>&1 || true" "age"
assert_contains "PAKRO_DISABLE_BACKENDS=asdf pakro doctor -J 2>&1 || true" '"age"'

# a disabled plugin never overrides an enabled registry backend, even when the requested
# version was installed through that plugin
cat <<EOF >pakro.toml
[tools]
age = "1.2.1"
EOF
assert "PAKRO_DISABLE_BACKENDS=asdf pakro tool age --backend" "aqua:FiloSottile/age"
PAKRO_DISABLE_BACKENDS=asdf pakro install --dry-run
PAKRO_DISABLE_BACKENDS=asdf pakro lock --platform "$PAKRO_PLATFORM"
assert_contains "cat pakro.lock" 'backend = "aqua:FiloSottile/age"'

# the backends section marks disabled backends instead of listing them as if enabled
assert_contains "PAKRO_DISABLE_BACKENDS=asdf pakro doctor 2>&1 || true" "asdf (disabled)"
assert_not_contains "pakro doctor 2>&1 || true" "(disabled)"

# a leftover plugin must not route a registry shorthand to a disabled backend: with nothing
# installed through it, resolution falls back to the registry instead of failing the install
# https://github.com/jdx/mise/discussions/6021
pakro uninstall --all age
ls "$PAKRO_DATA_DIR/plugins/age"
assert "PAKRO_DISABLE_BACKENDS=asdf pakro tool age --backend" "aqua:FiloSottile/age"

# and the install that follows uses the registry backend rather than failing
PAKRO_DISABLE_BACKENDS=asdf pakro install age
assert_contains "pakro ls age" "age  "
