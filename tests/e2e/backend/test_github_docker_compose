#!/usr/bin/env bash
# Test GitHub backend with docker-compose

set -euo pipefail

# Test: Install docker-compose via GitHub backend
cat >pakro.toml <<EOF
[tools]
"github:docker/compose" = "2.29.1"
EOF

assert_succeed "pakro install -f github:docker/compose"

# Verify it's executable
assert_succeed "pakro exec github:docker/compose -- docker-compose version"
assert "pakro x github:docker/compose -- which docker-compose" "$PAKRO_DATA_DIR/installs/github-docker-compose/2.29.1/docker-compose"
