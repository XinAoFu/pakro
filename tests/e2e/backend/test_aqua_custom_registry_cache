#!/usr/bin/env bash

export PAKRO_EXPERIMENTAL=1
export PAKRO_LOCKFILE=1
export PAKRO_AQUA_BAKED_REGISTRY=0
export PAKRO_AQUA_REGISTRY_URL="file://$ROOT/runtimes/vendor/aqua-registry"

cat <<'EOF_PAKRO' >pakro.toml
[tools]
"aqua:BurntSushi/ripgrep" = "14.1.1"
EOF_PAKRO

output=$(PAKRO_TIMINGS=1 pakro lock --platform linux-x64 2>&1)
printf '%s\n' "$output"

[[ $output == *"pakro::aqua::aqua_registry_wrapper::aqua_registry::parse_yaml"* ]] ||
  fail "expected custom aqua registry parse timing in output"
[[ $output == *"pakro::aqua::aqua_registry_wrapper::aqua_registry::write_compiled_cache"* ]] ||
  fail "expected custom aqua registry cache generation timing in output"

assert_contains "cat pakro.lock" 'backend = "aqua:BurntSushi/ripgrep"'
assert_contains "cat pakro.lock" '[[tools."aqua:BurntSushi/ripgrep"]]'

second_output=$(PAKRO_TIMINGS=1 pakro lock --platform linux-x64 2>&1)
printf '%s\n' "$second_output"

[[ $second_output != *"pakro::aqua::aqua_registry_wrapper::aqua_registry::write_compiled_cache"* ]] ||
  fail "expected unchanged registry source hash to reuse the compiled cache"
