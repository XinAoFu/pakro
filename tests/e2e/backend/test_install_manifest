#!/usr/bin/env bash
# Test the consolidated install manifest (.pakro-installs.toml)

set -euo pipefail

MANIFEST="$PAKRO_DATA_DIR/installs/.pakro-installs.toml"

# Install a tool — manifest should be created
pakro install tiny@3.1.0
assert_contains "cat $MANIFEST" "tiny"
assert_contains "cat $MANIFEST" "full"

# Verify the tool is installed
assert_contains "pakro ls tiny" "3.1.0"

# Install a second version — manifest entry should persist
pakro install tiny@2.1.0
assert_contains "cat $MANIFEST" "tiny"
assert_contains "pakro ls tiny" "2.1.0"

# Remove the tool dir (rm -rf workflow) — pakro should handle it cleanly
rm -rf "$PAKRO_DATA_DIR/installs/tiny"
# The manifest still references tiny, but the dir is gone — pakro should not error
assert_succeed "pakro ls"
# tiny should no longer appear as installed
assert_not_contains "pakro ls tiny 2>&1" "3.1.0"

# Re-install — manifest should be updated and tool should work
pakro install tiny@3.1.0
assert_contains "pakro ls tiny" "3.1.0"

# Test migration from legacy .pakro.backend files
# Create a fake tool with a legacy .pakro.backend file and no manifest entry
mkdir -p "$PAKRO_DATA_DIR/installs/legacy-test/1.0.0"
echo -e "legacy-test\nasdf:legacy-test\n0" >"$PAKRO_DATA_DIR/installs/legacy-test/.pakro.backend"

# Remove manifest so migration is triggered on next init
rm -f "$MANIFEST"

# Running pakro should migrate the legacy entry into the manifest
assert_succeed "pakro ls"
assert_contains "cat $MANIFEST" "legacy-test"
assert_contains "cat $MANIFEST" "asdf:legacy-test"

# Per-tool manifests should allow install dirs copied from different roots to merge
rm -f "$MANIFEST"
mkdir -p "$PAKRO_DATA_DIR/installs/source-a/1.0.0"
mkdir -p "$PAKRO_DATA_DIR/installs/source-b/2.0.0"
cat >"$PAKRO_DATA_DIR/installs/source-a/.pakro.backend.toml" <<'TOML'
short = "source-a"
full = "asdf:source-a"
explicit_backend = false
TOML
cat >"$PAKRO_DATA_DIR/installs/source-b/.pakro.backend.toml" <<'TOML'
short = "source-b"
full = "asdf:source-b"
explicit_backend = false
TOML

assert_contains "pakro ls --installed" "source-a"
assert_contains "pakro ls --installed" "source-b"

# New installs should write sidecar metadata so the directory is self-describing
rm -f "$PAKRO_DATA_DIR/installs/tiny/.pakro.backend.toml"
pakro install --force tiny@3.1.0
assert_contains "cat $PAKRO_DATA_DIR/installs/tiny/.pakro.backend.toml" 'short = "tiny"'
