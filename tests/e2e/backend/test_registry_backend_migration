#!/usr/bin/env bash

# Simulate npm installed through the old registry default. Non-explicit short
# names should migrate to the current aqua backend as a single unit: backend
# type and tool name must both come from aqua:npm/cli.
mkdir -p "$PAKRO_DATA_DIR/installs/npm/11.0.0"
cat <<'EOF' >"$PAKRO_DATA_DIR/installs/npm/.pakro.backend.toml"
short = "npm"
full = "npm:npm"
explicit_backend = false
EOF

pakro cache clear
assert "pakro tool npm --backend" "aqua:npm/cli"
assert_succeed "pakro latest npm"
