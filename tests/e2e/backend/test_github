#!/usr/bin/env bash

# Test use of release/latest endpoint for GitHub backend
assert_not_empty "pakro latest github:unikraft/kraftkit"

# Test basic GitHub backend functionality with real tools
cat <<EOF >pakro.toml
[tools]
"github:jdx/mise-test-fixtures" = { version = "1.0.0", asset_pattern = "hello-world-1.0.0.tar.gz", bin_path = "hello-world-1.0.0/bin", postinstall = "chmod +x \$PAKRO_TOOL_INSTALL_PATH/hello-world-1.0.0/bin/hello-world" }
EOF

pakro install
assert_contains "pakro x -- hello-world" "hello world"

# Test GitHub backend with platform-specific URLs
cat <<EOF >pakro.toml
[tools."github:jdx/mise-test-fixtures"]
platform_darwin_arm64_url = "https://mise.jdx.dev/test-fixtures/hello-world-1.0.0.tar.gz"
platform_darwin_amd64_url = "https://mise.jdx.dev/test-fixtures/hello-world-1.0.0.tar.gz"
platform_linux_amd64_url = "https://mise.jdx.dev/test-fixtures/hello-world-1.0.0.tar.gz"
version = "1.0.0"
bin_path = "hello-world-1.0.0/bin"
postinstall = "chmod +x \$PAKRO_TOOL_INSTALL_PATH/hello-world-1.0.0/bin/hello-world"
strip_components = 1
EOF

pakro install
assert_contains "pakro x -- hello-world" "hello world"

# Test GitHub backend with a raw file asset
cat <<EOF >pakro.toml
[tools]
"github:jdx/mise-test-fixtures" = { version = "1.0.0", asset_pattern = "hello-world", postinstall = "chmod +x \$PAKRO_TOOL_INSTALL_PATH/hello-world" }
EOF

pakro uninstall github:jdx/mise-test-fixtures
pakro install
assert_contains "pakro x -- hello-world" "hello world"

# Test GitHub backend with a raw file asset and rename_exe
cat <<EOF >pakro.toml
[tools]
"github:jdx/mise-test-fixtures" = { version = "1.0.0", asset_pattern = "hello-world", rename_exe = "hello-renamed" }
EOF

pakro uninstall github:jdx/mise-test-fixtures
pakro install
assert_contains "pakro x -- hello-renamed" "hello world"

# Test GitHub backend with pakro.lock checksum generation
export PAKRO_LOCKFILE=1
export PAKRO_EXPERIMENTAL=1

touch pakro.lock
cat <<EOF >pakro.toml
[tools]
"github:jdx/mise-test-fixtures" = { version = "1.0.0", asset_pattern = "hello-world-1.0.0.tar.gz", bin_path = "hello-world-1.0.0/bin", postinstall = "chmod +x \$PAKRO_TOOL_INSTALL_PATH/hello-world-1.0.0/bin/hello-world" }
EOF

pakro uninstall github:jdx/mise-test-fixtures
assert "pakro install"
# Verify pakro.lock is written correctly with checksums
assert_contains "cat pakro.lock" '[[tools."github:jdx/mise-test-fixtures"]]'
assert_contains "cat pakro.lock" 'version = "1.0.0"'
assert_contains "cat pakro.lock" 'backend = "github:jdx/mise-test-fixtures"'
# Get the current platform key
PLATFORM_KEY=$(pakro x --cd . -- bash -c "echo \"\$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/')-\$(uname -m | sed 's/x86_64/x64/' | sed 's/aarch64/arm64/')\"")
assert_contains "cat pakro.lock" "\"platforms.$PLATFORM_KEY\""
# GitHub API provides sha256 digests for release assets
# This checksum is the same across all platforms (macos-arm64, linux-x64, linux-arm64)
# because hello-world-1.0.0.tar.gz is a generic tarball, not platform-specific
assert_contains "cat pakro.lock" 'checksum = "sha256:dbca4f08377d70dc0828f5822fc47ecec3895cd9a6dacbc54cc984d346a571af"'
assert_contains "cat pakro.lock" 'url = "https://github.com/jdx/mise-test-fixtures/releases/download/v1.0.0/hello-world-1.0.0.tar.gz"'
assert_contains "cat pakro.lock" 'url_api = "https://api.github.com/repos/jdx/mise-test-fixtures/releases/assets/272317030"'
