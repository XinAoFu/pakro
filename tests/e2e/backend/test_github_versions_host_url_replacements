#!/usr/bin/env bash

# When url_replacements reroutes GitHub (a proxy, a mirror, a fixture), the
# replacement is the only source of GitHub data: the upstream versions service answers for
# github.com itself, so it must not be asked instead.

HEADERS_LOG_DIR="$TMPDIR/github_api_replacement_logs"
mkdir -p "$HEADERS_LOG_DIR"
start_http_server --headers-log "$HEADERS_LOG_DIR"

cat <<EOF >pakro.toml
[settings]
url_replacements = { "https://api.github.com" = "http://127.0.0.1:$HTTP_PORT" }
EOF

# The stand-in server has no releases, so listing fails; what matters is
# where the requests went.
output="$(PAKRO_DEBUG=1 pakro ls-remote github:jdx/communique 2>&1 || true)"

if [[ $output == *"mise-versions.jdx.dev/api/github"* ]]; then
  echo "$output"
  fail "the upstream versions service was asked for GitHub metadata although GitHub is rerouted"
fi
if [[ $output != *"url_replacements reroutes GitHub"* ]]; then
  echo "$output"
  fail "expected pakro to report that it skipped the upstream versions service"
fi
if ! compgen -G "$HEADERS_LOG_DIR/request_*.json" >/dev/null; then
  echo "$output"
  fail "the url_replacements endpoint was not used"
fi
