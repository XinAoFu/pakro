#!/usr/bin/env bash

# Test that auto platform environments (auto_env) select matching
# pakro.<env>.lock lockfiles, and explicit PAKRO_ENV lockfiles still win

export PAKRO_LOCKFILE=1

os="$(uname -s)"
case "$os" in
  Darwin) os=macos ;;
  Linux) os=linux ;;
esac

cat >"pakro.$os.toml" <<'EOF'
[tools]
tiny = "2"
EOF

touch "pakro.$os.lock"

assert "pakro install tiny@2.1.0"

# with auto_env enabled, pakro.$os.toml is active and its lockfile is written
assert "PAKRO_AUTO_ENV=true pakro use tiny@2"
assert_contains "cat pakro.$os.lock" '[[tools.tiny]]'
assert_contains "cat pakro.$os.lock" 'version = "2.1.0"'

# the locked version is honored when resolving with auto_env enabled
assert "PAKRO_AUTO_ENV=true pakro ls tiny --json | jq -r '.[0].version'" "2.1.0"

# explicit env lockfile takes precedence over the auto platform one
cat >pakro.prod.toml <<'EOF'
[tools]
tiny = "1"
EOF
touch pakro.prod.lock
assert "pakro install tiny@1.0.1"
assert "PAKRO_ENV=prod pakro use tiny@1"
assert_contains "cat pakro.prod.lock" 'version = "1.0.1"'
assert "PAKRO_AUTO_ENV=true PAKRO_ENV=prod pakro ls tiny --json | jq -r '.[0].version'" "1.0.1"
