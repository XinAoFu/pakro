#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

detect_platform
PLATFORM="$PAKRO_PLATFORM"

echo "=== Testing SLSA without signer identity is omitted on every platform ==="
cat <<EOF >pakro.toml
[tools]
sops = "3.12.1"
EOF

# Lock for current platform + a cross-platform target
if [[ $PLATFORM == "macos-arm64" ]]; then
  CROSS_PLATFORM="linux-x64"
else
  CROSS_PLATFORM="macos-arm64"
fi

pakro lock --platform "$PLATFORM,$CROSS_PLATFORM"
assert "test -f pakro.lock"

# Both platform entries still have artifact URLs and no unsupported SLSA lock.
assert_contains "cat pakro.lock" "\"platforms.$PLATFORM\""
assert_contains "cat pakro.lock" "\"platforms.$CROSS_PLATFORM\""
assert_contains "cat pakro.lock" 'url = "https://'
assert_not_contains "cat pakro.lock" 'provenance.slsa'
assert_not_contains "cat pakro.lock" 'provenance = "slsa"'

echo "=== Testing lockfile is deterministic across runs ==="
cp pakro.lock pakro.lock.first

pakro lock --platform "$PLATFORM,$CROSS_PLATFORM"

# Second run should produce identical output
assert "diff pakro.lock pakro.lock.first"

echo "pakro lockfile provenance determinism tests passed!"
