#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

# Use local fixture plugin for tiny to avoid network access.
ln -sf "$ROOT/tests/support/data/plugins/tiny" "$PAKRO_DATA_DIR/plugins/tiny"
rm -f pakro.toml pakro.lock

echo "=== Lockfile with initial tool ==="
cat <<EOF >pakro.toml
[tools]
dummy = "1.0.0"
EOF

pakro install dummy@1.0.0
pakro lock --platform linux-x64
assert_contains "cat pakro.lock" "[[tools.dummy]]"
assert_not_contains "cat pakro.lock" "[[tools.tiny]]"

echo "=== Replace configured tool and relock ==="
cat <<EOF >pakro.toml
[tools]
tiny = "2.1.0"
EOF

pakro install tiny@2.1.0
pakro lock --platform linux-x64
assert_contains "cat pakro.lock" "[[tools.tiny]]"
assert_not_contains "cat pakro.lock" "[[tools.dummy]]"

echo "=== Preserve tool excluded on the current OS ==="
if [[ $(uname -s) == Darwin ]]; then
  INACTIVE_OS=linux
else
  INACTIVE_OS=macos
fi
cat <<EOF >pakro.toml
[tools]
cocoapods = { version = "1.16.2", os = ["$INACTIVE_OS"] }
EOF
cat <<EOF >>pakro.lock

[[tools.cocoapods]]
version = "1.16.2"
backend = "gem:cocoapods"
EOF

OUTPUT=$(pakro lock --platform linux-x64 2>&1)
assert_contains "echo \"$OUTPUT\"" "Pruned 1 stale tool entry"
assert_not_contains "echo \"$OUTPUT\"" "No tools configured to lock"
assert_not_contains "cat pakro.lock" "[[tools.tiny]]"
assert_contains "cat pakro.lock" "[[tools.cocoapods]]"

echo "=== Remove all tools and relock ==="
cat <<EOF >pakro.toml
[tools]
EOF

assert_contains \
  "pakro lock --dry-run --platform linux-x64" \
  "Dry run - would prune 1 stale tool entry"
assert_contains "cat pakro.lock" "[[tools.cocoapods]]"

OUTPUT=$(pakro lock --platform linux-x64 2>&1)
assert_contains "echo \"$OUTPUT\"" "Pruned 1 stale tool entry"
assert_not_contains "echo \"$OUTPUT\"" "No tools configured to lock"
# empty lockfile should just have header and tools section
assert "cat pakro.lock" "$LOCKFILE_HEADER

lockfile_version = 3

[tools]"

echo "=== Cleanup ==="
rm -f pakro.toml pakro.lock
