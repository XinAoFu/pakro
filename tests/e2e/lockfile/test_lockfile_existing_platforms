#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

detect_platform
PLATFORM="$PAKRO_PLATFORM"

# === Test 1: pakro lock respects existing platform subset ===
# If a lockfile already has a curated subset of platforms,
# running `pakro lock` without --platform should only target those.

cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

# Create lockfile with only the current platform
pakro lock --platform "$PLATFORM"
assert_contains "cat pakro.lock" "\"platforms.$PLATFORM\""
assert_not_contains "cat pakro.lock" "platforms.windows-x64"

# Running pakro lock again should only target the same platform
pakro lock
assert_contains "cat pakro.lock" "\"platforms.$PLATFORM\""
assert_not_contains "cat pakro.lock" "platforms.windows-x64"

# === Test 2: pakro lock with empty lockfile targets all common platforms ===

cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

rm -f pakro.lock
touch pakro.lock
pakro lock
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_contains "cat pakro.lock" "platforms.macos-arm64"

# === Test 3: pakro lock --platform overrides existing platforms ===

cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

rm -f pakro.lock
pakro lock --platform "$PLATFORM"
assert_contains "cat pakro.lock" "\"platforms.$PLATFORM\""

# Now override with a different explicit set
pakro lock --platform "$PLATFORM,windows-x64"
assert_contains "cat pakro.lock" "\"platforms.$PLATFORM\""
assert_contains "cat pakro.lock" "platforms.windows-x64"

rm -f pakro.toml pakro.lock
