#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

detect_platform
PLATFORM="$PAKRO_PLATFORM"

touch pakro.lock
pakro use tiny
cat <<EOF >pakro.lock
[[tools.tiny]]
version = "1.0.0"
EOF
rm -rf "$PAKRO_DATA_DIR/installs/tiny"
pakro install
assert "pakro ls tiny --json --current | jq -r '.[0].requested_version'" "latest"
assert "pakro ls tiny --json --current | jq -r '.[0].version'" "1.0.0"

# validates checksum
pakro use gh@2.62.0
cat pakro.lock
assert_contains "cat pakro.lock" "\"platforms.$PLATFORM\""
assert_contains "cat pakro.lock" 'checksum = "sha256:'

# Test rewriting existing lockfile section with same content
# Using inline table format
GH_URL="https://github.com/cli/cli/releases/download/v2.62.0/gh_2.62.0_$(
  case "$PLATFORM" in
    linux-x64) echo "linux_amd64" ;;
    linux-arm64) echo "linux_arm64" ;;
    macos-x64) echo "macOS_amd64" ;;
    macos-arm64) echo "macOS_arm64" ;;
    *) echo "$PLATFORM" ;;
  esac
).zip"
cat <<EOF >pakro.lock
[[tools.gh]]
version = "2.62.0"
backend = "aqua:cli/cli"
"platforms.$PLATFORM" = { checksum = "blake3:aaaaa", url = "$GH_URL" }
EOF
assert_fail "pakro i gh -f"
