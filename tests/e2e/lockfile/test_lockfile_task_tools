#!/usr/bin/env bash

export PAKRO_LOCKFILE=1
export PAKRO_EXPERIMENTAL=1

detect_platform
PLATFORM="$PAKRO_PLATFORM"

SERVER_ROOT="$TMPDIR/task-tool-lock-server"
mkdir -p "$SERVER_ROOT/task-only-1.0.0/bin"

cat >"$SERVER_ROOT/task-only-1.0.0/bin/task-only" <<'EOF'
#!/usr/bin/env bash
echo task-only-ok
EOF
chmod +x "$SERVER_ROOT/task-only-1.0.0/bin/task-only"
tar -C "$SERVER_ROOT" -czf "$SERVER_ROOT/task-only-1.0.0.tar.gz" task-only-1.0.0
CHECKSUM=$(shasum -a 256 "$SERVER_ROOT/task-only-1.0.0.tar.gz" | awk '{print $1}')
printf '1.0.0\n2.0.0\n' >"$SERVER_ROOT/versions.txt"

start_http_server --dir "$SERVER_ROOT"

cat >pakro.toml <<EOF
[task_config]
includes = ["tasks.toml"]

[task_templates.locked]
tools."http:template-only" = { version = "1.0.0", url = "http://127.0.0.1:${HTTP_PORT}/task-only-1.0.0.tar.gz", checksum = "sha256:${CHECKSUM}" }

[tasks.from-template]
extends = "locked"
run = "true"

[tasks.task-only]
run = "task-only > task-ran"

[tasks.task-only.tools."http:task-only"]
version = "1.0.0"
url = "http://127.0.0.1:${HTTP_PORT}/task-only-1.0.0.tar.gz"
checksum = "sha256:${CHECKSUM}"
bin_path = "task-only-1.0.0/bin"
postinstall = "chmod +x \$PAKRO_TOOL_INSTALL_PATH/task-only-1.0.0/bin/task-only"
EOF

cat >tasks.toml <<EOF
[included]
run = "true"
tools."http:included-only" = { version = "1.0.0", url = "http://127.0.0.1:${HTTP_PORT}/task-only-1.0.0.tar.gz", checksum = "sha256:${CHECKSUM}" }
EOF

if ! output=$(pakro lock --dry-run --platform "$PLATFORM" 2>&1); then
  echo "$output" >&2
  fail "task-only lock dry-run failed"
fi
assert_contains "echo '$output'" "http:task-only@1.0.0"
assert_not_contains "echo '$output'" "No tools configured to lock"
assert "test ! -e pakro.lock"
assert "test ! -e task-ran"
assert "test ! -e '$PAKRO_DATA_DIR/installs/http-task-only/1.0.0'"

pakro lock --platform "$PLATFORM"
assert_contains "cat pakro.lock" '[[tools."http:task-only"]]'
assert_contains "cat pakro.lock" 'version = "1.0.0"'
assert_contains "cat pakro.lock" "checksum = \"sha256:${CHECKSUM}\""
assert_contains "cat pakro.lock" '[[tools."http:template-only"]]'
assert_contains "cat pakro.lock" '[[tools."http:included-only"]]'

cp pakro.lock pakro.lock.before-task
pakro run task-only
assert_contains "cat task-ran" "task-only-ok"
assert "cmp pakro.lock.before-task pakro.lock"

cat >>pakro.toml <<EOF

[tasks.latest]
run = "true"

[tasks.latest.tools."http:task-latest"]
version = "latest"
url = "http://127.0.0.1:${HTTP_PORT}/task-only-1.0.0.tar.gz"
version_list_url = "http://127.0.0.1:${HTTP_PORT}/versions.txt"

[tasks.variant-one]
run = "true"

[tasks.variant-one.tools."http:task-variant"]
version = "1.0.0"
url = "http://127.0.0.1:${HTTP_PORT}/task-only-1.0.0.tar.gz"
rename_exe = "one"

[tasks.variant-two]
run = "true"

[tasks.variant-two.tools."http:task-variant"]
version = "1.0.0"
url = "http://127.0.0.1:${HTTP_PORT}/task-only-1.0.0.tar.gz"
rename_exe = "two"
EOF

pakro lock --platform "$PLATFORM"
assert_contains "cat pakro.lock" '[[tools."http:task-latest"]]'
assert_contains "cat pakro.lock" 'version = "2.0.0"'
assert "test \"\$(grep -c '\[\[tools.\"http:task-variant\"\]\]' pakro.lock)\" -eq 2"
assert_contains "cat pakro.lock" 'rename_exe = "one"'
assert_contains "cat pakro.lock" 'rename_exe = "two"'

pakro lock http:task-only --dry-run --platform "$PLATFORM"

cat >pakro.toml <<'EOF'
[tasks.no-tools]
run = "true"
EOF
rm tasks.toml

pakro lock --platform "$PLATFORM"
assert_not_contains "cat pakro.lock" 'http:task-only'
assert_not_contains "cat pakro.lock" 'http:task-latest'
assert_not_contains "cat pakro.lock" 'http:task-variant'

cat >pakro.test.toml <<EOF
[tasks.environment-only]
run = "true"
tools."http:environment-only" = { version = "1.0.0", url = "http://127.0.0.1:${HTTP_PORT}/task-only-1.0.0.tar.gz", checksum = "sha256:${CHECKSUM}" }
EOF

env PAKRO_ENV=test pakro lock --platform "$PLATFORM"
assert_contains "cat pakro.test.lock" '[[tools."http:environment-only"]]'
assert_not_contains "cat pakro.lock" 'http:environment-only'

cat >pakro.local.toml <<EOF
[tasks.local-only]
run = "true"
tools."http:local-only" = { version = "1.0.0", url = "http://127.0.0.1:${HTTP_PORT}/task-only-1.0.0.tar.gz", checksum = "sha256:${CHECKSUM}" }
EOF

pakro lock --local --platform "$PLATFORM"
assert_contains "cat pakro.local.lock" '[[tools."http:local-only"]]'
assert_not_contains "cat pakro.lock" 'http:local-only'

mkdir -p monorepo/packages/app
cat >monorepo/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
lockfile = true
config_roots = ["packages/*"]
EOF
cat >monorepo/packages/app/pakro.toml <<EOF
[tasks.child-only]
run = "true"
tools."http:child-only" = { version = "1.0.0", url = "http://127.0.0.1:${HTTP_PORT}/task-only-1.0.0.tar.gz", checksum = "sha256:${CHECKSUM}" }
EOF

(cd monorepo && pakro lock --platform "$PLATFORM")
assert_contains "cat monorepo/pakro.lock" '[[tools."http:child-only"]]'
assert "test ! -e monorepo/packages/app/pakro.lock"
