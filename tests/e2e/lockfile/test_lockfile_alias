#!/usr/bin/env bash

# Test that lockfile is respected when using version aliases
# https://github.com/jdx/mise/discussions/8175

export PAKRO_LOCKFILE=1

cat <<EOF >pakro.toml
[tools]
tiny = "myalias"

[tool_alias.tiny.versions]
myalias = "2"

[settings]
lockfile = true
EOF

cat <<EOF >pakro.lock
[[tools.tiny]]
version = "2.0.0"
EOF

rm -rf "$PAKRO_DATA_DIR/installs/tiny"
pakro install
assert "pakro ls tiny --json --current | jq -r '.[0].requested_version'" "myalias"
assert "pakro ls tiny --json --current | jq -r '.[0].version'" "2.0.0"
