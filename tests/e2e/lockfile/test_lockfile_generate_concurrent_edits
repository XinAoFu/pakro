#!/usr/bin/env bash
set -euo pipefail
export PAKRO_LOCKFILE_MODE=generate
export PAKRO_HTTP_RETRIES=0
detect_platform

start_http_server --handler - <<'PY'
from http.server import BaseHTTPRequestHandler
from pathlib import Path
import threading

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/config":
            with open("pakro.toml", "a") as config:
                config.write("\n# concurrent config edit\n")
        elif self.path == "/lock":
            Path("pakro.lock").write_text("# concurrent lock edit\n[tools]\n")
        elif self.path == "/cancel":
            Path("started").touch()
            threading.Event().wait(30)
        self.send_response(200)
        self.send_header("Content-Length", "7")
        self.end_headers()
        self.wfile.write(b"fixture")
PY

configure() {
  cat >pakro.toml <<EOF
[tools."http:concurrent"]
version = "1.0"
url = "http://127.0.0.1:$HTTP_PORT/$1"
EOF
}

printf '[tools]\n' >pakro.lock
cp pakro.lock expected.lock
configure config
assert_fail "pakro lock --platform $PAKRO_PLATFORM"
diff -u expected.lock pakro.lock
assert_contains "cat pakro.toml" "concurrent config edit"

configure config
if pakro install >install.log 2>&1; then
  echo "install unexpectedly published after a concurrent config edit" >&2
  exit 1
fi
assert_contains "cat install.log" "changed during installation"
diff -u expected.lock pakro.lock

configure lock
assert_fail "pakro lock --platform $PAKRO_PLATFORM"
assert_contains "cat pakro.lock" "concurrent lock edit"

cp pakro.lock expected.lock
configure cancel
pakro lock --platform "$PAKRO_PLATFORM" >cancel.log 2>&1 &
LOCK_PID=$!
for _ in {1..100}; do
  [[ -f started ]] && break
  sleep 0.05
done
test -f started
kill -TERM "$LOCK_PID"
if wait "$LOCK_PID"; then
  echo "cancelled lock unexpectedly succeeded" >&2
  exit 1
fi
diff -u expected.lock pakro.lock
