#!/usr/bin/env bash

# Test that when a tool exists in both base and env-specific configs,
# it goes into both lockfiles independently (no cross-contamination)

export PAKRO_LOCKFILE=1

echo "=== Setup: tiny in both base and dev config ==="

cat >pakro.toml <<'EOF'
[settings]
lockfile = true

[tools]
tiny = "1"
EOF

cat >pakro.dev.toml <<'EOF'
[tools]
tiny = "1"
EOF

touch pakro.lock pakro.dev.lock

# Install with base config first
assert "pakro install tiny@1.0.1"

echo "=== Test: PAKRO_ENV=dev should create entries in both lockfiles ==="

assert "PAKRO_ENV=dev pakro install"

# The base lockfile should have the tool
assert_contains "cat pakro.lock" '[[tools.tiny]]'
# The dev lockfile should also have the tool
assert_contains "cat pakro.dev.lock" '[[tools.tiny]]'
# Neither should have env field (env is encoded in filename)
assert_not_contains "cat pakro.lock" 'env = '
assert_not_contains "cat pakro.dev.lock" 'env = '

echo "=== Test: tool only in env config should only be in env lockfile ==="

# Remove tiny from base config
cat >pakro.toml <<'EOF'
[settings]
lockfile = true
EOF

rm -f pakro.lock pakro.dev.lock
touch pakro.dev.lock

assert "PAKRO_ENV=dev pakro install"

# Base lockfile should not exist or not have tiny (no tools in pakro.toml)
assert_fail "grep -q 'tools.tiny' pakro.lock 2>/dev/null"
# Dev lockfile should have tiny
assert_contains "cat pakro.dev.lock" '[[tools.tiny]]'

echo "=== Cleanup ==="
rm -f pakro.lock pakro.dev.lock pakro.toml pakro.dev.toml

echo "lockfile env base override tests passed!"
