#!/usr/bin/env bash

echo "=== new lockfiles use request bindings ==="
mkdir -p versioned/packages/b
cat >versioned/pakro.toml <<'EOF'
monorepo_root = true

[tools]
dummy = "1"

[settings]
lockfile = true

[monorepo]
lockfile = true
config_roots = ["packages/*"]
EOF
cat >versioned/packages/b/pakro.toml <<'EOF'
[tools]
dummy = "1.0.0"
EOF

assert_succeed "cd versioned && pakro install"
assert_succeed "cd versioned/packages/b && pakro install"
assert_contains "cat versioned/pakro.lock" "lockfile_version = 3"
assert_contains "cat versioned/pakro.lock" 'specifiers = ["1"]'
assert_contains "cat versioned/pakro.lock" 'specifiers = ["1.0.0"]'
assert "cd versioned && pakro ls dummy --json --current | jq -r '.[0].version'" "1.1.0"
assert "cd versioned/packages/b && pakro ls dummy --json --current | jq -r '.[0].version'" "1.0.0"

echo "=== upgrades move only the matching request binding ==="
mkdir -p upgrade/packages/b
cp versioned/pakro.toml upgrade/pakro.toml
cp versioned/packages/b/pakro.toml upgrade/packages/b/pakro.toml
cat >upgrade/pakro.lock <<'EOF'
lockfile_version = 1

[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
specifiers = ["1", "1.0.0"]
EOF
assert "cd upgrade && pakro ls dummy --json --current | jq -r '.[0].version'" "1.0.0"
assert_succeed "cd upgrade && pakro upgrade dummy"
assert "cd upgrade && pakro ls dummy --json --current | jq -r '.[0].version'" "1.1.0"
assert "cd upgrade/packages/b && pakro ls dummy --json --current | jq -r '.[0].version'" "1.0.0"

echo "=== legacy lockfiles require an explicit format upgrade ==="
mkdir legacy
cat >legacy/pakro.toml <<'EOF'
[tools]
dummy = "1.0.0"
EOF
cat >legacy/pakro.lock <<'EOF'
[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
EOF

assert_contains "cd legacy && pakro lock 2>&1" "uses lockfile format version 0"
assert_not_contains "cat legacy/pakro.lock" "lockfile_version"
assert_not_contains "cat legacy/pakro.lock" "specifiers"

echo "=== missing variant lockfiles do not promote legacy lookups ==="
mkdir legacy-argument
cat >legacy-argument/pakro.toml <<'EOF'
[settings]
lockfile = true
EOF
cat >legacy-argument/pakro.lock <<'EOF'
[[tools.dummy]]
version = "2.0.0"
backend = "asdf:dummy"

[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
EOF

assert "cd legacy-argument && pakro x dummy@latest -- dummy --version" "This is Dummy 2.0.0! --version"

assert_contains "cd legacy && pakro lock --upgrade" "Upgraded"
assert_contains "cat legacy/pakro.lock" "lockfile_version = 3"
assert_contains "cat legacy/pakro.lock" 'specifiers = ["1.0.0"]'

echo "=== upgrades bind distinct requests resolving to the same version ==="
mkdir same-version
cat >same-version/pakro.toml <<'EOF'
[tools]
dummy = ["1.0", "1.0.0"]
EOF
cat >same-version/pakro.lock <<'EOF'
[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
EOF

assert_succeed "cd same-version && pakro lock --upgrade --platform linux-x64"
assert_contains "sed -n '/specifiers = \[/,/]/p' same-version/pakro.lock" '"1.0",'
assert_contains "sed -n '/specifiers = \[/,/]/p' same-version/pakro.lock" '"1.0.0",'

echo "=== dry-run reports but does not upgrade legacy lockfiles ==="
mkdir legacy-dry-run
cp legacy/pakro.toml legacy-dry-run/pakro.toml
cat >legacy-dry-run/pakro.lock <<'EOF'
[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
EOF

assert_contains "cd legacy-dry-run && pakro lock --upgrade --dry-run" "Would upgrade"
assert_not_contains "cat legacy-dry-run/pakro.lock" "lockfile_version"

echo "=== format upgrades cannot be filtered ==="
mkdir legacy-filtered
cat >legacy-filtered/pakro.toml <<'EOF'
[tools]
dummy = "1.0.0"
tiny = "2.1.0"
EOF
cat >legacy-filtered/pakro.lock <<'EOF'
[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"

[[tools.tiny]]
version = "2.1.0"
backend = "asdf:tiny"
EOF

assert_fail "cd legacy-filtered && pakro lock --upgrade dummy"
assert_not_contains "cat legacy-filtered/pakro.lock" "lockfile_version"
assert_contains "cat legacy-filtered/pakro.lock" '[[tools.tiny]]'

echo "=== mixed-format monorepo migration preserves bindings ==="
mkdir -p mixed-monorepo/packages/b
cat >mixed-monorepo/pakro.toml <<'EOF'
monorepo_root = true

[tools]
dummy = "1"

[monorepo]
lockfile = true
config_roots = ["packages/*"]
EOF
cat >mixed-monorepo/packages/b/pakro.toml <<'EOF'
[tools]
dummy = "1.0.0"
EOF
cat >mixed-monorepo/pakro.lock <<'EOF'
[[tools.dummy]]
version = "1.1.0"
backend = "asdf:dummy"
EOF
cat >mixed-monorepo/packages/b/pakro.lock <<'EOF'
lockfile_version = 1

[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
specifiers = ["1.0.0"]
EOF

assert_succeed "cd mixed-monorepo && pakro lock --upgrade --platform linux-x64"
assert_fail "test -f mixed-monorepo/packages/b/pakro.lock"
assert_contains "cat mixed-monorepo/pakro.lock" 'specifiers = ["1.0.0"]'

echo "=== unbound versioned entries use backend version order ==="
mkdir unbound-versioned
cat >unbound-versioned/pakro.toml <<'EOF'
[tools]
dummy = "latest"
EOF
cat >unbound-versioned/pakro.lock <<'EOF'
lockfile_version = 1

[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"

[[tools.dummy]]
version = "2.0.0"
backend = "asdf:dummy"
EOF

assert "cd unbound-versioned && pakro ls dummy --json --current | jq -r '.[0].version'" "2.0.0"

echo "=== legacy latest picks the newer of two versions that compare equal ==="
# `versions` compares an alphanumeric chunk by its leading digits and stops, so
# 3.7b and 3.7c both reduce to 7 and tie. Entries are written in lexicographic
# order of the version string, and the sort is stable, so without a tie-break
# the older entry always won. Listed here in the order pakro itself writes.
mkdir legacy-tie
cat >legacy-tie/pakro.toml <<'EOF'
[tools]
dummy = "latest"
EOF
cat >legacy-tie/pakro.lock <<'EOF'
[[tools.dummy]]
version = "3.7b"
backend = "asdf:dummy"

[[tools.dummy]]
version = "3.7c"
backend = "asdf:dummy"
EOF

assert "cd legacy-tie && pakro ls dummy --json --current | jq -r '.[0].version'" "3.7c"

echo "=== failed upgrades preserve legacy monorepo lockfiles ==="
mkdir -p failed-monorepo-upgrade/packages/b
cat >failed-monorepo-upgrade/pakro.toml <<'EOF'
monorepo_root = true

[tools]
dummy = "3.0.0"

[monorepo]
lockfile = true
config_roots = ["packages/*"]
EOF
cat >failed-monorepo-upgrade/packages/b/pakro.toml <<'EOF'
[env]
CHILD = "true"
EOF
cat >failed-monorepo-upgrade/packages/b/pakro.lock <<'EOF'
[[tools.tiny]]
version = "1.0.0"
backend = "asdf:tiny"
EOF
cp failed-monorepo-upgrade/packages/b/pakro.lock failed-monorepo-upgrade/packages/b/pakro.lock.before

pakro cache clear dummy
assert_fail_contains "cd failed-monorepo-upgrade && RTX_FAILURE=1 pakro lock --upgrade --platform linux-x64 2>&1" "failed to resolve"
assert_succeed "test -f failed-monorepo-upgrade/packages/b/pakro.lock"
assert_succeed "cmp failed-monorepo-upgrade/packages/b/pakro.lock.before failed-monorepo-upgrade/packages/b/pakro.lock"
assert_fail "test -f failed-monorepo-upgrade/pakro.lock"

echo "=== failed upgrades do not commit or report earlier targets ==="
mkdir failed-multi-target-upgrade
cat >failed-multi-target-upgrade/pakro.toml <<'EOF'
[tools]
tiny = "1.0.0"
EOF
cat >failed-multi-target-upgrade/pakro.local.toml <<'EOF'
[tools]
dummy = "3.0.0"
EOF
cat >failed-multi-target-upgrade/pakro.lock <<'EOF'
[[tools.tiny]]
version = "1.0.0"
backend = "asdf:tiny"
EOF
cat >failed-multi-target-upgrade/pakro.local.lock <<'EOF'
[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
EOF
cp failed-multi-target-upgrade/pakro.lock failed-multi-target-upgrade/pakro.lock.before
cp failed-multi-target-upgrade/pakro.local.lock failed-multi-target-upgrade/pakro.local.lock.before

pakro cache clear dummy
assert_fail_contains "cd failed-multi-target-upgrade && RTX_FAILURE=1 pakro lock --upgrade --platform linux-x64 2>&1" "failed to resolve"
assert_succeed "cmp failed-multi-target-upgrade/pakro.lock.before failed-multi-target-upgrade/pakro.lock"
assert_succeed "cmp failed-multi-target-upgrade/pakro.local.lock.before failed-multi-target-upgrade/pakro.local.lock"
assert_not_contains "cd failed-multi-target-upgrade && RTX_FAILURE=1 pakro lock --upgrade --platform linux-x64 2>&1 || true" "Upgrading"
assert_not_contains "cd failed-multi-target-upgrade && RTX_FAILURE=1 pakro lock --upgrade --platform linux-x64 2>&1 || true" "Pruned"
assert_not_contains "cd failed-multi-target-upgrade && RTX_FAILURE=1 pakro lock --upgrade --platform linux-x64 2>&1 || true" "Lockfile written"

echo "=== monorepo format upgrades retain shadowed root requests ==="
mkdir -p shadowed-root/packages/b
cat >shadowed-root/pakro.toml <<'EOF'
monorepo_root = true

[tools]
dummy = "1"

[settings]
lockfile = true

[monorepo]
lockfile = true
config_roots = ["packages/*"]
EOF
cat >shadowed-root/packages/b/pakro.toml <<'EOF'
[tools]
dummy = "2.0.0"
EOF
cat >shadowed-root/pakro.lock <<'EOF'
[[tools.dummy]]
version = "1.1.0"
backend = "asdf:dummy"

[[tools.dummy]]
version = "2.0.0"
backend = "asdf:dummy"
EOF

assert_succeed "cd shadowed-root && pakro install"
assert_succeed "cd shadowed-root/packages/b && pakro install"
assert_succeed "cd shadowed-root && pakro lock --upgrade --platform linux-x64"
assert_contains "cat shadowed-root/pakro.lock" 'specifiers = ["1"]'
assert_contains "cat shadowed-root/pakro.lock" 'specifiers = ["2.0.0"]'
assert "cd shadowed-root && pakro ls dummy --json --current | jq -r '.[0].version'" "1.1.0"
assert "cd shadowed-root/packages/b && pakro ls dummy --json --current | jq -r '.[0].version'" "2.0.0"

echo "=== plain pakro lock retains shadowed root entries ==="
assert_succeed "cd shadowed-root && pakro lock"
assert_contains "cat shadowed-root/pakro.lock" 'specifiers = ["1"]'
assert_contains "cat shadowed-root/pakro.lock" 'specifiers = ["2.0.0"]'
assert "cd shadowed-root && pakro ls dummy --json --current | jq -r '.[0].version'" "1.1.0"
