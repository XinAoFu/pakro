#!/usr/bin/env bash
set -euo pipefail

detect_platform
export PAKRO_LOCKFILE_MODE=generate
assert_fail "PAKRO_LOCKFILE_MODE=invalid pakro settings get lockfile_mode"

cat >pakro.toml <<'EOF'
[settings]
lockfile_platforms = ["linux-x64", "macos-arm64"]

[tools."http:generate-fixture"]
version = "1.0.0"
url = "https://mise.jdx.dev/test-fixtures/hello-world-1.0.0.tar.gz"
bin_path = "hello-world-1.0.0/bin"
EOF

# Choosing the generator does not opt in to creating a file during install.
pakro install
assert "test -e pakro.lock && echo exists || echo absent" "absent"

pakro lock
assert_contains "cat pakro.lock" 'sha256:'
assert_not_contains "cat pakro.lock" 'provenance_verified'
cp pakro.lock expected.lock
pakro lock
diff -u expected.lock pakro.lock
pakro install
diff -u expected.lock pakro.lock

# A filtered update must carry the other target forward.
pakro lock --platform linux-x64
diff -u expected.lock pakro.lock

# `pakro unuse` prunes the removed tool's entry, but an unuse that edits nothing
# leaves the lockfile exactly as it found it.
cp pakro.toml with-fixture.toml
pakro unuse http:generate-absent
diff -u expected.lock pakro.lock
pakro unuse http:generate-fixture
assert_not_contains "cat pakro.lock" 'generate-fixture'
cp with-fixture.toml pakro.toml
cp expected.lock pakro.lock

# Explicit choices override the configured mode, with no format migration.
pakro settings --local set lockfile_mode merge
assert "pakro settings get lockfile_mode" "generate"
unset PAKRO_LOCKFILE_MODE
assert "pakro settings get lockfile_mode" "merge"
pakro install
diff -u expected.lock pakro.lock
export PAKRO_LOCKFILE_MODE=generate
pakro lock
diff -u expected.lock pakro.lock

# Failure cannot publish over an existing lockfile.
pakro settings --local set lockfile_mode generate
cat >>pakro.toml <<'EOF'

[tools."http:generate-broken"]
version = "1.0.0"
url = "http://127.0.0.1:1/unavailable.tar.gz"
EOF
assert_fail "PAKRO_HTTP_RETRIES=0 pakro lock"
diff -u expected.lock pakro.lock
