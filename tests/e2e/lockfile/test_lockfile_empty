#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

# Create base config
cat >pakro.toml <<'EOF'
[tools]
tiny = "1"
EOF

touch pakro.lock
assert "pakro install tiny@1.0.0"
assert "pakro use tiny@1"

# Base tool should be in pakro.lock
assert_contains "cat pakro.lock" "[[tools.tiny]]"
assert_contains "cat pakro.lock" 'version = "1.0.0"'

# Now let's empty out our tools, uninstall everything and confirm we just end up with an empty lockfile
assert "pakro uninstall --all"
assert "pakro unuse tiny"
assert "pakro lock"

# empty lockfile should keep its revision and tools section
assert "cat pakro.lock" "$LOCKFILE_HEADER

lockfile_version = 3

[tools]"
