#!/usr/bin/env bash

# Test that `pakro lock <tool>` prunes stale version entries when the resolved
# version changes. This is a regression test for the bug where filtered lock
# runs appended a new [[tools.X]] section instead of replacing the old one.

export PAKRO_LOCKFILE=1

rm -f pakro.toml pakro.lock

echo "=== Setup: lock dummy at 1.0.0 ==="
cat <<'EOF' >pakro.toml
[tools]
dummy = "1.0.0"
EOF

pakro install dummy@1.0.0
pakro lock --platform linux-x64
assert_contains "cat pakro.lock" 'version = "1.0.0"'
assert_not_contains "cat pakro.lock" 'version = "1.1.0"'

echo "=== Change config to 1.1.0 and re-lock with filter ==="
cat <<'EOF' >pakro.toml
[tools]
dummy = "1.1.0"
EOF

pakro install dummy@1.1.0

# Filtered lock run targeting only dummy
pakro lock dummy --platform linux-x64

# Should have the new version
assert_contains "cat pakro.lock" 'version = "1.1.0"'
# Should NOT have the old version (this was the bug: both would be present)
assert_not_contains "cat pakro.lock" 'version = "1.0.0"'

echo "=== Cleanup ==="
rm -f pakro.toml pakro.lock
