#!/usr/bin/env bash

# `pakro x <tool>@latest` resolves only the named tool to the newest release.
# Configured `latest` tools keep using the locked, installed version instead of
# being reported missing at a newer release that `pakro install` does not want.

export PAKRO_LOCKFILE=1

touch pakro.lock
pakro use tiny@1.0.0
cat <<EOF2 >pakro.toml
[tools]
tiny = "latest"
EOF2
# A newer version is installed, so only the lockfile keeps tiny at 1.0.0.
pakro install tiny@1.0.1
assert "pakro x -- rtx-tiny" "rtx-tiny: v1.0.0 args:"

assert "pakro x dummy@latest -- rtx-tiny" "rtx-tiny: v1.0.0 args:"
assert_not_contains "pakro x dummy@latest -- rtx-tiny 2>&1" "missing"
assert_contains "pakro x dummy@latest -- dummy" "2.0.0"
