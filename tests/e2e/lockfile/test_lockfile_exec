#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

touch pakro.lock
assert "pakro install tiny@1.0.0"
assert "pakro use tiny@1"
assert "pakro current tiny" "1.0.0"
assert "pakro install tiny@1.0.1"
assert "pakro current tiny" "1.0.0"
assert "pakro x -- rtx-tiny" "rtx-tiny: v1.0.0 args:"
#TODO: assert "pakro x tiny -- rtx-tiny" "rtx-tiny: v1.0.0 args:"
assert "pakro x tiny@1.0.1 -- rtx-tiny" "rtx-tiny: v1.0.1 args:"
assert "pakro x -- rtx-tiny" "rtx-tiny: v1.0.0 args:"
assert "pakro x tiny@3.0.0 -- rtx-tiny" "rtx-tiny: v3.0.0 args:"
