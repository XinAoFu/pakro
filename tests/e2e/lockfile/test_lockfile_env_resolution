#!/usr/bin/env bash

# Test that PAKRO_ENV selects the correct locked version from separate lockfiles

export PAKRO_LOCKFILE=1

# Create base config and env-specific config both requesting "tiny"
cat >pakro.toml <<'EOF'
[tools]
tiny = "latest"
EOF

cat >pakro.test.toml <<'EOF'
[tools]
tiny = "latest"
EOF

# Install both versions FIRST (before creating lockfile)
# This prevents install from overwriting our manually-crafted lockfile
assert "pakro install tiny@1.0.0"
assert "pakro install tiny@2.1.0"

# Create separate lockfiles: base and env-specific
cat >pakro.lock <<'EOF'
[[tools.tiny]]
version = "1.0.0"
backend = "asdf:tiny"
EOF

cat >pakro.test.lock <<'EOF'
[[tools.tiny]]
version = "2.1.0"
backend = "asdf:tiny"
EOF

# Without PAKRO_ENV, should use base version from pakro.lock (1.0.0)
assert "pakro where tiny" "$PAKRO_DATA_DIR/installs/tiny/1.0.0"

# With PAKRO_ENV=test, should use version from pakro.test.lock (2.1.0)
# Note: Must pass PAKRO_ENV in the command itself since assert uses bash -c
assert "PAKRO_ENV=test pakro where tiny" "$PAKRO_DATA_DIR/installs/tiny/2.1.0"

# With PAKRO_ENV=production (no pakro.production.lock), should fall back to base (1.0.0)
assert "PAKRO_ENV=production pakro where tiny" "$PAKRO_DATA_DIR/installs/tiny/1.0.0"
