#!/usr/bin/env bash

# A tool stub's lock data lives in its project's pakro.lock, found by walking
# up from where the stub lives.

export PAKRO_LOCKFILE=1

mkdir -p proj/bin elsewhere pathbin
cd proj || exit 1
echo '[tools]' >pakro.toml
# A committed stub locks the same way everywhere, so local configs are skipped.
echo '[tools]' >pakro.local.toml

cat >bin/jq <<'EOF'
#!/usr/bin/env -S pakro tool-stub

tool = "aqua:jqlang/jq"
version = "1.7"
EOF
chmod +x bin/jq

# Without an entry, locked mode rejects the stub. This runs before anything
# installs jq, since an installed version would satisfy the request.
assert_fail_contains "PAKRO_LOCKED=1 pakro tool-stub bin/jq --version 2>&1" "is not in the lockfile"

assert_contains "pakro generate tool-stub bin/jq --lock" "Updated lockfile:"
# The stub keeps its request; the lockfile records the resolution and the stub.
assert_not_contains "cat bin/jq" "[lock"
assert_contains "cat bin/jq" 'version = "1.7"'
assert_contains "cat pakro.lock" 'tool-stubs = ["bin/jq"]'
assert_contains "cat pakro.lock" '[[tools."aqua:jqlang/jq"]]'
assert_fail "test -f pakro.local.lock"

# Checksums from pakro.lock are verified. This runs before jq is installed.
cp pakro.lock pakro.lock.good
sed -e "s/^checksum = .*/checksum = \"sha256:$(printf '0%.0s' {1..64})\"/" pakro.lock.good >pakro.lock
assert_fail_contains "pakro tool-stub bin/jq --version 2>&1" "Checksum mismatch"
cp pakro.lock.good pakro.lock

# Locked mode works from any directory, and through a symlink to the stub.
ln -s "$PWD/bin/jq" ../pathbin/jq
cd ../elsewhere || exit 1
assert_contains "PAKRO_LOCKED=1 pakro tool-stub ../pathbin/jq --version" "jq-1.7"
cd ../proj || exit 1

# `pakro lock` keeps the stub's entry even though no config declares the tool.
assert_succeed "pakro lock"
assert_contains "cat pakro.lock" 'tool-stubs = ["bin/jq"]'
assert_contains "cat pakro.lock" '[[tools."aqua:jqlang/jq"]]'

# A selective run reaches the stub too.
assert_contains "pakro lock aqua:jqlang/jq 2>&1" "aqua:jqlang/jq@1.7"

# Once the stub is gone, `pakro lock` drops its reference and its entry.
mv bin/jq jq.bak
assert_succeed "pakro lock"
assert_not_contains "cat pakro.lock" "tool-stubs"
assert_not_contains "cat pakro.lock" "jqlang"
mv jq.bak bin/jq

# Outside a project there is no pakro.lock to record into.
cp bin/jq ../elsewhere/jq
assert_fail_contains "pakro generate tool-stub ../elsewhere/jq --lock 2>&1" "no project config found"

# Lock data only lives in pakro.lock, so --lock removes a `[lock]` section.
cat >>bin/jq <<'EOF'

[lock.platforms.linux-x64]
url = "https://example.com/jq"
EOF
assert_succeed "pakro generate tool-stub bin/jq --lock"
assert_not_contains "cat bin/jq" "[lock"

# In a monorepo with a root lockfile, a subproject's stub uses the root
# pakro.lock even when run from outside the monorepo.
cd "$HOME/workdir" || exit 1
mkdir -p mono/packages/a/bin
# The deprecated alias still declares the monorepo root.
cat >mono/pakro.toml <<'TOML'
experimental_monorepo_root = true

[monorepo]
lockfile = true
config_roots = ["packages/*"]
TOML
echo '[tools]' >mono/packages/a/pakro.toml
# A local override is not committed, so it must not move a committed stub.
cat >mono/pakro.local.toml <<'TOML'
[monorepo]
lockfile = false
TOML
cat >mono/packages/a/bin/jq <<'STUB'
#!/usr/bin/env -S pakro tool-stub

tool = "aqua:jqlang/jq"
version = "1.7"
STUB
chmod +x mono/packages/a/bin/jq
assert_succeed "cd mono/packages/a && PAKRO_EXPERIMENTAL=1 pakro generate tool-stub bin/jq --lock"
assert_contains "cat mono/pakro.lock" 'tool-stubs = ["packages/a/bin/jq"]'
assert_fail "test -f mono/packages/a/pakro.lock"
# An installed version would satisfy locked mode without the lockfile.
rm -rf "$PAKRO_DATA_DIR/installs/aqua-jqlang-jq"
assert_fail "test -d $PAKRO_DATA_DIR/installs/aqua-jqlang-jq"
assert_contains "cd elsewhere && PAKRO_EXPERIMENTAL=1 PAKRO_LOCKED=1 pakro tool-stub ../mono/packages/a/bin/jq --version" "jq-1.7"
