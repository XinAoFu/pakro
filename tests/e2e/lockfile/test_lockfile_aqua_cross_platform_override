#!/usr/bin/env bash

# Test that aqua lockfile URL resolution uses the target platform and does not
# leak host-only overrides.

export PAKRO_EXPERIMENTAL=1
export PAKRO_LOCKFILE=1

detect_platform

if [[ $PAKRO_PLATFORM_OS == "macos" ]]; then
  HOST_GOOS="darwin"
elif [[ $PAKRO_PLATFORM_OS == "linux" ]]; then
  HOST_GOOS="linux"
else
  echo "Skipping unsupported host OS: $PAKRO_PLATFORM_OS"
  return 0
fi

TARGET_PLATFORM="windows-x64"
TARGET_AQUA_OS="windows"

REGISTRY_DIR="$PWD/aqua-registry-local"
mkdir -p "$REGISTRY_DIR"

cat <<EOF_REGISTRY >"$REGISTRY_DIR/registry.yaml"
packages:
  - type: http
    name: example/testtool
    supported_envs:
      - linux
      - darwin
      - windows
    url: https://example.com/base-{{.OS}}-{{.Arch}}-{{.Version}}.zip
    overrides:
      - goos: $HOST_GOOS
        url: https://example.com/host-{{.OS}}-{{.Arch}}-{{.Version}}.pkg
        format: pkg
EOF_REGISTRY

export PAKRO_AQUA_BAKED_REGISTRY=0
export PAKRO_AQUA_REGISTRY_URL="file://$REGISTRY_DIR"

cat <<'EOF_PAKRO' >pakro.toml
[tools]
"aqua:example/testtool" = "1.0.0"
EOF_PAKRO

output=$(PAKRO_TIMINGS=1 pakro lock --platform "$TARGET_PLATFORM" 2>&1)
printf '%s\n' "$output"
assert_contains "echo '$output'" "Targeting 1 platform(s)"
assert_contains "echo '$output'" "$TARGET_PLATFORM"

EXPECTED_URL="https://example.com/base-${TARGET_AQUA_OS}-amd64-1.0.0.zip"
assert_contains "cat pakro.lock" "\"platforms.$TARGET_PLATFORM\""
assert_contains "cat pakro.lock" "url = \"$EXPECTED_URL\""
assert_not_contains "cat pakro.lock" "https://example.com/host-"
