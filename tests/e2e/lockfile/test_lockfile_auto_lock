#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

# === Test 1: pakro use auto-locks all platforms ===
# When using a tool that supports cross-platform resolution (aqua tool),
# the lockfile should automatically get entries for all 5 common platforms,
# not just the current one.

cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

touch pakro.lock
pakro use "aqua:jqlang/jq@1.7.1"

# Verify all 5 common platforms are in the lockfile (auto-locked)
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_contains "cat pakro.lock" "platforms.linux-arm64"
assert_contains "cat pakro.lock" "platforms.macos-x64"
assert_contains "cat pakro.lock" "platforms.macos-arm64"
assert_contains "cat pakro.lock" "platforms.windows-x64"
assert_contains "cat pakro.lock" "jqlang/jq"

# === Test 2: subsequent install doesn't modify lockfile ===
# Simulates another developer running pakro install - lockfile should not change
# because all platforms are already populated.

cp pakro.lock pakro.lock.before
pakro install
assert "diff pakro.lock pakro.lock.before" ""

# === Test 3: pakro install auto-locks a newly added tool ===

cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
"aqua:mikefarah/yq" = "4.44.6"
EOF

pakro install
assert_contains "cat pakro.lock" "mikefarah/yq"
assert_contains "cat pakro.lock" "platforms.linux-x64"

rm -f pakro.toml pakro.lock pakro.lock.before

# === Test 4: removed platform stays removed across installs ===
# A user-curated lockfile is authoritative — auto-lock must not silently re-add
# platforms (e.g. macos-x64) that were deliberately deleted.

cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

touch pakro.lock
pakro use "aqua:jqlang/jq@1.7.1"
assert_contains "cat pakro.lock" "platforms.macos-x64"

# Simulate a user dropping macos-x64 / macos-x64-baseline from the lockfile.
sed -i '/\[tools\."aqua:jqlang\/jq"."platforms\.macos-x64"\]/,/^$/d' pakro.lock
sed -i '/\[tools\."aqua:jqlang\/jq"."platforms\.macos-x64-baseline"\]/,/^$/d' pakro.lock
assert_fail "grep -q 'platforms.macos-x64' pakro.lock"

# Adding another tool must not bring macos-x64 back.
cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
"aqua:mikefarah/yq" = "4.44.6"
EOF
pakro install
assert_fail "grep -q 'platforms.macos-x64' pakro.lock"
assert_contains "cat pakro.lock" "mikefarah/yq"

rm -f pakro.toml pakro.lock
