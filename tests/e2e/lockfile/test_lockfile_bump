#!/usr/bin/env bash

# Test `pakro lock --bump`: re-resolves fuzzy version selectors against the
# latest matching remote versions without installing anything and without
# modifying config files. Also tests the `--json` change report.

export PAKRO_LOCKFILE=1

reset_lockfile() {
  cat <<'EOF' >pakro.lock
# @generated - this file is auto-generated by `pakro lock` https://mise.jdx.dev/dev-tools/mise-lock.html

[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
EOF
}

echo "=== Setup: prefix selector locked at an old version ==="
cat <<'EOF' >pakro.toml
[tools]
dummy = "1"
EOF
reset_lockfile

echo "=== Without --bump, lock keeps the locked version ==="
pakro lock --platform linux-x64
assert_contains "cat pakro.lock" 'version = "1.0.0"'

echo "=== --bump re-resolves the selector to the latest matching version ==="
pakro lock --bump --platform linux-x64
assert_contains "cat pakro.lock" 'version = "1.1.0"'
assert_not_contains "cat pakro.lock" 'version = "1.0.0"'
# config selector is left untouched
assert_contains "cat pakro.toml" 'dummy = "1"'

echo "=== --bump --dry-run --json reports changes without writing ==="
reset_lockfile
assert_contains "pakro lock --bump --dry-run --json --platform linux-x64" '"name": "dummy"'
assert_contains "pakro lock --bump --dry-run --json --platform linux-x64" '"1.0.0"'
assert_contains "pakro lock --bump --dry-run --json --platform linux-x64" '"1.1.0"'
assert_contains "cat pakro.lock" 'version = "1.0.0"'

echo "=== --bump --json writes and reports ==="
pakro lock --bump --json --platform linux-x64
assert_contains "cat pakro.lock" 'version = "1.1.0"'
# a second run has nothing to change
assert "pakro lock --bump --json --platform linux-x64" "[]"

echo "=== 'latest' selector bumps to the latest version ==="
cat <<'EOF' >pakro.toml
[tools]
dummy = "latest"
EOF
reset_lockfile
pakro lock --bump --platform linux-x64
assert_contains "cat pakro.lock" 'version = "2.0.0"'

echo "=== exactly pinned versions are not bumped ==="
cat <<'EOF' >pakro.toml
[tools]
dummy = "1.0.0"
EOF
reset_lockfile
assert "pakro lock --bump --json --platform linux-x64" "[]"
assert_contains "cat pakro.lock" 'version = "1.0.0"'
assert_contains "cat pakro.toml" 'dummy = "1.0.0"'

echo "=== --bump never rewrites config, even with explicit tool@version ==="
cat <<'EOF' >pakro.toml
[tools]
dummy = "1"
EOF
reset_lockfile
pakro lock --bump dummy@2 --platform linux-x64
assert_contains "cat pakro.toml" 'dummy = "1"'
# without --bump the same invocation bumps the config prefix
pakro lock dummy@2.0.0 --platform linux-x64
assert_contains "cat pakro.toml" 'dummy = "2"'

echo "=== tools removed from config are reported as pruned in --json ==="
cat <<'EOF' >pakro.toml
[tools]
dummy = "1"
EOF
reset_lockfile
pakro lock --bump --platform linux-x64
cat <<'EOF' >pakro.toml
[tools]
EOF
assert_contains "pakro lock --json --platform linux-x64" '"new_versions": []'
assert_not_contains "cat pakro.lock" 'tools.dummy'

echo "=== --bump looks past an installed match to the remote versions ==="
cat <<'EOF2' >pakro.toml
[tools]
dummy = "1"
EOF2
reset_lockfile
pakro install dummy@1.0.0
assert_contains "pakro lock --bump --dry-run --json --platform linux-x64" '"1.1.0"'
pakro lock --bump --platform linux-x64
assert_contains "cat pakro.lock" 'version = "1.1.0"'

echo "=== --bump fails when the remote versions cannot be listed ==="
reset_lockfile
export PAKRO_CACHE_DIR="$HOME/lock-bump-listing-failure-cache"
assert_fail "RTX_FAILURE=1 pakro lock --bump --platform linux-x64"
assert_contains "cat pakro.lock" 'version = "1.0.0"'
# without --bump the locked version is kept, as before
RTX_FAILURE=1 pakro lock --platform linux-x64
assert_contains "cat pakro.lock" 'version = "1.0.0"'
# nor does an explicit tool@selector
assert_fail "RTX_FAILURE=1 pakro lock --bump dummy@1 --platform linux-x64"
assert_contains "cat pakro.lock" 'version = "1.0.0"'

echo "=== --bump keeps an installed exact pin without the remote versions ==="
cat <<'EOF2' >pakro.toml
[tools]
dummy = "1.0.0"
EOF2
reset_lockfile
RTX_FAILURE=1 pakro lock --bump --platform linux-x64
assert_contains "cat pakro.lock" 'version = "1.0.0"'
RTX_FAILURE=1 pakro lock --bump dummy@1.0.0 --platform linux-x64
assert_contains "cat pakro.lock" 'version = "1.0.0"'
# an explicit installed pin other than the configured one is what gets locked
pakro install dummy@1.1.0
RTX_FAILURE=1 pakro lock --bump dummy@1.1.0 --platform linux-x64
assert_contains "cat pakro.lock" 'version = "1.1.0"'
