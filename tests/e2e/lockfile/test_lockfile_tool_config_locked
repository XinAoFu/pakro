#!/usr/bin/env bash

# Config-root-scoped locked policy applies only to tools declared at that root.
export PAKRO_LOCKFILE=1
detect_platform
PLATFORM="$PAKRO_PLATFORM"
pakro plugin install tiny

cat <<'EOF' >"$PAKRO_CONFIG_DIR/config.toml"
[tools]
dummy = "latest"
EOF

cat <<'EOF' >pakro.toml
[tools]
tiny = "1"
EOF

# Policy in a sibling config applies to tools from the same config root.
cat <<'EOF' >pakro.local.toml
[tool_config]
locked = true
EOF

# The project tool must be locked, but the unrelated global tool must not be
# required in the global lockfile.
cat <<EOF >pakro.lock
[[tools.tiny]]
version = "1.0.0"
backend = "asdf:tiny"
"platforms.$PLATFORM" = { url = "https://example.com/tiny-1.0.0.tar.gz" }
EOF

assert_contains "pakro install --dry-run 2>&1" "tiny@1.0.0"
assert_contains "pakro install --dry-run 2>&1" "dummy@2.0.0"

rm pakro.lock
assert_fail_contains "pakro install --dry-run 2>&1" "tiny@1 is not in the lockfile"
assert_fail_contains "pakro install --dry-run 2>&1" "tool_config.locked"

# Invocation-wide locked mode retains its existing behavior for global tools.
rm pakro.toml
rm pakro.local.toml
assert_fail_contains "PAKRO_LOCKED=1 pakro install --dry-run 2>&1" "dummy@latest is not in the lockfile"

# A local config directly in $HOME has the same path-valued config_root as the
# global config by default, but they remain distinct policy scopes.
cat <<'EOF' >"$HOME/pakro.toml"
[tool_config]
locked = true

[tools]
tiny = "1"
EOF

cat <<EOF >"$HOME/pakro.lock"
[[tools.tiny]]
version = "1.0.0"
backend = "asdf:tiny"
"platforms.$PLATFORM" = { url = "https://example.com/tiny-1.0.0.tar.gz" }
EOF

assert_contains "pakro -C \"$HOME\" install --dry-run 2>&1" "tiny@1.0.0"
assert_contains "pakro -C \"$HOME\" install --dry-run 2>&1" "dummy@2.0.0"
