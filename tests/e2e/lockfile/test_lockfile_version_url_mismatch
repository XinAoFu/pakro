#!/usr/bin/env bash

# A lockfile entry whose `version` was rewritten without refreshing its platform
# block downloads one release under another's name. Nothing downstream compares
# the two — the install directory and everything pakro prints come from `version`,
# the bytes come from the URL — so the install "succeeds" with the wrong binary
# and `pakro install` never repairs the entry. pakro must refuse instead.

export PAKRO_LOCKFILE=1

detect_platform

case "$PAKRO_PLATFORM_OS" in
  macos) ASSET_OS="darwin" ;;
  *) ASSET_OS="linux" ;;
esac

case "$PAKRO_PLATFORM_ARCH" in
  arm64) ASSET_ARCH="arm64" ;;
  *) ASSET_ARCH="amd64" ;;
esac

cat <<EOF >pakro.toml
[tools]
shfmt = "3.10.0"
EOF

write_lock() {
  cat <<EOF >pakro.lock
[[tools.shfmt]]
version = "3.10.0"
backend = "aqua:mvdan/sh"
"platforms.$PAKRO_PLATFORM" = { url = "https://github.com/mvdan/sh/releases/download/v$1/shfmt_v$1_${ASSET_OS}_${ASSET_ARCH}" }
EOF
}

# The URL names 3.7.0 while the entry claims 3.10.0.
write_lock 3.7.0

assert_fail "pakro install" "locked to a download URL from 3.7.0"
assert_fail "pakro install" "to regenerate the entry"
assert_fail "pakro install --locked" "locked to a download URL from 3.7.0"

# The refusal comes before the download, so nothing landed under the wrong name.
assert_fail "test -d \"$PAKRO_DATA_DIR/installs/shfmt/3.10.0\""

# `pakro lock` is the documented repair, so it must still read the broken entry.
pakro lock --platform "$PAKRO_PLATFORM"
assert_contains "cat pakro.lock" "v3.10.0/shfmt_v3.10.0_${ASSET_OS}_${ASSET_ARCH}"

# A URL that agrees with the version installs as usual.
write_lock 3.10.0
pakro install --locked
assert_contains "pakro x shfmt -- shfmt --version" "v3.10.0"
