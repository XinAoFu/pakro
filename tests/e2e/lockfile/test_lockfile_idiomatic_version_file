#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

detect_platform
PLATFORM="$PAKRO_PLATFORM"

cat <<'EOF' >pakro.toml
[settings]
idiomatic_version_file_enable_tools = ["node"]
lockfile = true
EOF

echo "24" >.node-version

assert_contains "pakro ls --current node" ".node-version"

pakro lock --platform "$PLATFORM"

assert_contains "cat pakro.lock" '[[tools.node]]'
assert_contains "cat pakro.lock" 'backend = "core:node"'
assert_contains "cat pakro.lock" "\"platforms.$PLATFORM\""

assert_contains "pakro install --locked --dry-run node 2>&1" "would install"

rm -f pakro.toml pakro.lock .node-version

cat <<'EOF' >pakro.toml
[settings]
idiomatic_version_file_enable_tools = ["dummy"]
lockfile = true

[tools]
dummy = "2"
EOF

echo "1" >.dummy-version

output=$(pakro lock --dry-run --platform "$PLATFORM" 2>&1)
assert_contains "echo '$output'" "dummy@1.1.0"
assert_contains "echo '$output'" "dummy@2.0.0"

rm -f pakro.toml .dummy-version

cat <<'EOF' >pakro.toml
[settings]
idiomatic_version_file_enable_tools = ["dummy"]
lockfile = true
EOF

# Keep pakro.toml and .pakro/config.toml together to verify that an idiomatic
# .dummy-version maps to .pakro/pakro.lock instead of the root pakro.lock.
mkdir -p .pakro
cat <<'EOF' >.pakro/config.toml
[settings]
idiomatic_version_file_enable_tools = ["dummy"]
lockfile = true
EOF

echo "1" >.dummy-version

output=$(pakro lock --dry-run --platform "$PLATFORM" 2>&1)
assert_contains "echo '$output'" ".pakro/pakro.lock"
assert_not_contains "echo '$output'" "for ~/workdir/pakro.lock"

rm -rf pakro.toml .pakro .dummy-version

cat <<'EOF' >pakro.toml
[settings]
idiomatic_version_file_enable_tools = ["dummy"]
lockfile = true
EOF

echo "1" >.dummy-version
touch pakro.lock

pakro install dummy

assert_contains "cat pakro.lock" '[[tools.dummy]]'
assert_contains "cat pakro.lock" 'backend = "asdf:dummy"'
assert "pakro install --locked --dry-run dummy >/dev/null 2>&1"

rm -f pakro.toml pakro.lock .dummy-version
