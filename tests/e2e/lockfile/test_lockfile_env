#!/usr/bin/env bash

# Test that environment-specific configs create separate lockfiles
# When PAKRO_ENV=test, tools from pakro.test.toml go into pakro.test.lock

export PAKRO_LOCKFILE=1

# Create env-specific config only (to avoid override complexity)
cat >pakro.test.toml <<'EOF'
[tools]
tiny = "2"
EOF

# Create both lockfiles so they get updated
touch pakro.lock pakro.test.lock

# Install version
assert "pakro install tiny@2.1.0"

# With PAKRO_ENV=test, use the test config
# Note: Must pass PAKRO_ENV in the command itself since assert uses bash -c
assert "PAKRO_ENV=test pakro use tiny@2"

# Check that pakro.test.lock has the tool (not pakro.lock)
assert_contains "cat pakro.test.lock" 'version = "2.1.0"'
assert_contains "cat pakro.test.lock" '[[tools.tiny]]'
# No env field should be in the lockfile (env is encoded in filename)
assert_not_contains "cat pakro.test.lock" 'env = '
