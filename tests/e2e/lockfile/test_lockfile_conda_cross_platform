#!/usr/bin/env bash

# Regression test for https://github.com/jdx/mise/discussions/11944.
# Foreign-platform conda solves need usable virtual package defaults, and a
# failed re-solve must not delete an existing platform's dependency metadata.

export PAKRO_LOCKFILE=1

cat <<EOF >pakro.toml
[tools]
"conda:ffmpeg" = "7.1.1"
EOF

pakro lock --platform linux-x64
assert_contains "cat pakro.lock" 'platforms.linux-x64'
assert_contains "cat pakro.lock" 'conda_deps = ['
assert_contains "cat pakro.lock" '[conda-packages.linux-x64.'

cp pakro.lock pakro.lock.before
assert_fail "CONDA_OVERRIDE_GLIBC=0 pakro lock --platform linux-x64"
assert_succeed "cmp -s pakro.lock.before pakro.lock"
