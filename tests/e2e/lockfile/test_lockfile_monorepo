#!/usr/bin/env bash

export PAKRO_EXPERIMENTAL=1
export PAKRO_LOCKFILE=1
export PAKRO_IDIOMATIC_VERSION_FILE_ENABLE_TOOLS=dummy

rm -rf "$PAKRO_DATA_DIR/plugins/tiny"
ln -s "$ROOT/tests/support/data/plugins/tiny" "$PAKRO_DATA_DIR/plugins/tiny"

echo "=== unset [monorepo].lockfile keeps subproject lockfiles during rollout ==="
mkdir -p monorepo-unset/packages/a
cat >monorepo-unset/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
config_roots = ["packages/*"]
EOF
cat >monorepo-unset/packages/a/pakro.toml <<'EOF'
[tools]
tiny = "1.0.0"
EOF
touch monorepo-unset/packages/a/pakro.lock

assert "cd monorepo-unset/packages/a && pakro install"
assert_contains "cat monorepo-unset/packages/a/pakro.lock" '[[tools.tiny]]'
assert_fail "test -f monorepo-unset/pakro.lock"

echo "=== [monorepo] lockfile = true routes subprojects to root ==="
mkdir -p monorepo/packages/a monorepo/packages/b
cat >monorepo/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
lockfile = true
config_roots = ["packages/*"]
EOF
cat >monorepo/packages/a/pakro.toml <<'EOF'
[tools]
tiny = "1.0.0"
EOF
cat >monorepo/packages/b/pakro.toml <<'EOF'
[tools]
tiny = "2.1.0"
dummy = "1.0.0"
EOF
touch monorepo/pakro.lock

assert "cd monorepo/packages/a && pakro install"
assert_contains "cat monorepo/pakro.lock" 'version = "1.0.0"'
assert_fail "test -f monorepo/packages/a/pakro.lock"

assert "cd monorepo/packages/b && pakro install"
assert_contains "cat monorepo/pakro.lock" 'version = "1.0.0"'
assert_contains "cat monorepo/pakro.lock" 'version = "2.1.0"'
assert_contains "cat monorepo/pakro.lock" '[[tools.dummy]]'
assert_fail "test -f monorepo/packages/b/pakro.lock"

echo "=== pakro lock prunes from the full monorepo view ==="
cat >monorepo/packages/b/pakro.toml <<'EOF'
[tools]
tiny = "2.1.0"
EOF
output=$(cd monorepo && pakro lock --platform linux-x64 2>&1)
assert_contains "echo '$output'" "Pruned 1 stale tool entry"
assert_not_contains "cat monorepo/pakro.lock" '[[tools.dummy]]'
assert_contains "cat monorepo/pakro.lock" 'version = "1.0.0"'
assert_contains "cat monorepo/pakro.lock" 'version = "2.1.0"'

echo "=== subproject lockfiles migrate into root lockfiles ==="
mkdir -p monorepo-migrate/packages/a monorepo-migrate/packages/b/.pakro
cat >monorepo-migrate/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
lockfile = true
config_roots = ["packages/*"]
EOF
cat >monorepo-migrate/packages/a/pakro.toml <<'EOF'
[tools]
tiny = "1.0.0"
EOF
cat >monorepo-migrate/packages/a/pakro.lock <<'EOF'
[[tools.tiny]]
version = "1.0.0"
backend = "asdf:tiny"
EOF
cat >monorepo-migrate/packages/b/.pakro/config.toml <<'EOF'
[tools]
dummy = "1.0.0"
EOF
cat >monorepo-migrate/packages/b/.pakro/pakro.lock <<'EOF'
[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
EOF

output=$(cd monorepo-migrate && pakro lock --platform linux-x64 2>&1)
assert_contains "echo '$output'" "migrated 2 subproject lockfile"
assert_contains "cat monorepo-migrate/pakro.lock" 'version = "1.0.0"'
assert_contains "cat monorepo-migrate/pakro.lock" '[[tools.dummy]]'
assert_fail "test -f monorepo-migrate/packages/a/pakro.lock"
assert_fail "test -f monorepo-migrate/packages/b/.pakro/pakro.lock"

echo "=== idiomatic roots migrate colocated lockfiles into root lockfiles ==="
mkdir -p monorepo-idiomatic-migrate/packages/a
cat >monorepo-idiomatic-migrate/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
lockfile = true
config_roots = ["packages/*"]
EOF
echo "2" >monorepo-idiomatic-migrate/packages/a/.dummy-version
cat >monorepo-idiomatic-migrate/packages/a/pakro.lock <<'EOF'
[[tools.dummy]]
version = "2.0.0"
backend = "asdf:dummy"
EOF
cat >monorepo-idiomatic-migrate/packages/a/pakro.ci.lock <<'EOF'
[[tools.dummy]]
version = "2.0.0"
backend = "asdf:dummy"
EOF

output=$(cd monorepo-idiomatic-migrate && pakro lock --platform linux-x64 2>&1)
assert_contains "echo '$output'" "migrated 2 subproject lockfile"
assert_contains "cat monorepo-idiomatic-migrate/pakro.lock" '[[tools.dummy]]'
assert_contains "cat monorepo-idiomatic-migrate/pakro.lock" 'version = "2.0.0"'
assert_contains "cat monorepo-idiomatic-migrate/pakro.ci.lock" '[[tools.dummy]]'
assert_contains "cat monorepo-idiomatic-migrate/pakro.ci.lock" 'version = "2.0.0"'
assert_fail "test -f monorepo-idiomatic-migrate/packages/a/pakro.lock"
assert_fail "test -f monorepo-idiomatic-migrate/packages/a/pakro.ci.lock"

echo "=== dry-run reads legacy subproject lockfiles without migrating ==="
mkdir -p monorepo-dry-run/packages/a
cat >monorepo-dry-run/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
lockfile = true
config_roots = ["packages/*"]
EOF
cat >monorepo-dry-run/packages/a/pakro.toml <<'EOF'
[tools]
tiny = "latest"
EOF
cat >monorepo-dry-run/packages/a/pakro.lock <<'EOF'
[[tools.tiny]]
version = "1.0.0"
backend = "asdf:tiny"
EOF

rm -rf "$PAKRO_DATA_DIR/installs/tiny"
output=$(cd monorepo-dry-run/packages/a && pakro install --dry-run 2>&1)
assert_contains "echo '$output'" "tiny@1.0.0"
assert "test -f monorepo-dry-run/packages/a/pakro.lock"
assert_fail "test -f monorepo-dry-run/pakro.lock"

output=$(cd monorepo-dry-run && pakro lock --dry-run --platform linux-x64 2>&1)
assert_contains "echo '$output'" "tiny@1.0.0"
assert "test -f monorepo-dry-run/packages/a/pakro.lock"
assert_fail "test -f monorepo-dry-run/pakro.lock"

echo "=== install --monorepo updates colocated subproject lockfiles ==="
mkdir -p monorepo-install-colocated/packages/a monorepo-install-colocated/packages/b
cat >monorepo-install-colocated/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
lockfile = false
config_roots = ["packages/*"]
EOF
cat >monorepo-install-colocated/packages/a/pakro.toml <<'EOF'
[tools]
tiny = "1.0.0"
EOF
cat >monorepo-install-colocated/packages/b/pakro.toml <<'EOF'
[tools]
tiny = "2.1.0"
EOF
touch monorepo-install-colocated/packages/a/pakro.lock
touch monorepo-install-colocated/packages/b/pakro.lock

rm -rf "$PAKRO_DATA_DIR/installs/tiny"
assert "cd monorepo-install-colocated && pakro install --monorepo"
assert_contains "cat monorepo-install-colocated/packages/a/pakro.lock" 'version = "1.0.0"'
assert_contains "cat monorepo-install-colocated/packages/b/pakro.lock" 'version = "2.1.0"'
assert_fail "test -f monorepo-install-colocated/pakro.lock"

echo "=== lockfile = true still routes to root when config_roots are invalid ==="
mkdir -p monorepo-bad-roots/packages/a
cat >monorepo-bad-roots/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
lockfile = true
config_roots = ["missing/*"]
EOF
cat >monorepo-bad-roots/packages/a/pakro.toml <<'EOF'
[tools]
tiny = "1.0.0"
EOF
touch monorepo-bad-roots/pakro.lock

rm -rf "$PAKRO_DATA_DIR/installs/tiny"
if [[ ${PAKRO_LOCKFILE_MODE:-merge} == generate ]]; then
  # Complete generation cannot prune safely without resolving membership.
  cp monorepo-bad-roots/pakro.lock monorepo-bad-roots/pakro.lock.before
  assert_fail "cd monorepo-bad-roots/packages/a && pakro install"
  assert "cmp monorepo-bad-roots/pakro.lock.before monorepo-bad-roots/pakro.lock"
else
  output=$(cd monorepo-bad-roots/packages/a && pakro install 2>&1)
  assert_contains "echo '$output'" "lockfile = true is set"
  assert_contains "cat monorepo-bad-roots/pakro.lock" 'version = "1.0.0"'
fi
assert_fail "test -f monorepo-bad-roots/packages/a/pakro.lock"

echo "=== [monorepo] lockfile = false keeps subproject lockfiles ==="
mkdir -p monorepo-optout/packages/a
cat >monorepo-optout/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
lockfile = false
config_roots = ["packages/*"]

[tools]
dummy = "1.0.0"
EOF
cat >monorepo-optout/packages/a/pakro.toml <<'EOF'
[tools]
tiny = "1.0.0"
EOF
touch monorepo-optout/packages/a/pakro.lock

assert "cd monorepo-optout/packages/a && pakro install"
assert_contains "cat monorepo-optout/packages/a/pakro.lock" '[[tools.tiny]]'
assert_fail "test -f monorepo-optout/pakro.lock"

output=$(cd monorepo-optout/packages/a && pakro lock --dry-run --platform linux-x64 2>&1)
assert_contains "echo '$output'" "tiny"
assert_not_contains "echo '$output'" "dummy"
