#!/usr/bin/env bash
# Regression test: top-level aqua cosign config should record cosign provenance.

set -euo pipefail

export PAKRO_LOCKFILE=1
export PAKRO_AQUA_COSIGN=true
export PAKRO_AQUA_SLSA=false
export PAKRO_GITHUB_ATTESTATIONS=0
export PAKRO_AQUA_GITHUB_ATTESTATIONS=false

detect_platform
PLATFORM="$PAKRO_PLATFORM"

echo "=== Testing top-level cosign lockfile provenance ==="

cat <<EOF >pakro.toml
[tools]
"aqua:technicalpickles/envsense" = "0.3.4"
EOF

pakro lock --platform "$PLATFORM"
assert "test -f pakro.lock"
assert_contains "cat pakro.lock" 'provenance = "cosign"'

echo "=== Testing install with top-level cosign lockfile ==="
pakro install

echo "top-level cosign lockfile test passed!"
