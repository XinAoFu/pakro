#!/usr/bin/env bash

# A tool locked under a backend the registry has since replaced keeps using the
# locked backend, including when `pakro lock --bump` re-resolves its version, and
# pakro says how to switch. hk moved from Aqua to Packslip at 1.58.1; Aqua still
# serves every release.
export PAKRO_LOCKFILE=1
export PAKRO_MINIMUM_RELEASE_AGE=0
detect_platform

reset_lockfile() {
  cat <<'EOF' >pakro.lock
lockfile_version = 2

[[tools.hk]]
version = "1.57.0"
backend = "aqua:jdx/hk"
specifiers = ["1"]
EOF
}

cat <<'EOF' >pakro.toml
[tools]
hk = "1"
EOF
reset_lockfile

echo "=== --bump with a tool argument re-resolves under the locked backend ==="
pakro lock --bump hk --platform "$PAKRO_PLATFORM" 2>stderr
assert_contains "cat pakro.lock" 'version = "1.58.1"'
assert_contains "cat pakro.lock" 'backend = "aqua:jdx/hk"'
assert_not_contains "cat pakro.lock" 'packslip:'
assert_contains "cat stderr" 'hk is locked to aqua:jdx/hk, but the registry now installs it from packslip:github.com/jdx/hk'
assert_contains "cat stderr" 'pakro backends switch hk'

echo "=== --bump without arguments keeps the locked backend too ==="
reset_lockfile
pakro lock --bump --platform "$PAKRO_PLATFORM"
assert_contains "cat pakro.lock" 'version = "1.58.1"'
assert_contains "cat pakro.lock" 'backend = "aqua:jdx/hk"'

echo "=== installing warns and installs from the locked backend ==="
assert_contains "pakro install 2>&1" 'pakro backends switch hk'
assert_contains "cat $PAKRO_DATA_DIR/installs/hk/.pakro.backend.toml" 'full = "aqua:jdx/hk"'

echo "=== --dry-run reports the switch without writing ==="
assert_contains "pakro backends switch --dry-run 2>&1" 'would switch hk@1.58.1 from aqua:jdx/hk to packslip:github.com/jdx/hk'
assert_contains "cat pakro.lock" 'backend = "aqua:jdx/hk"'

echo "=== named tools accept a version or the locked backend ==="
assert_contains "pakro backends switch --dry-run hk@1.58.1 2>&1" 'would switch hk@1.58.1'
assert_contains "pakro backends switch --dry-run aqua:jdx/hk 2>&1" 'would switch hk@1.58.1'
assert_fail_contains "pakro backends switch --dry-run hk@1.57.0" "not locked to a backend the registry has replaced"

echo "=== a switch that cannot relock restores the lockfile ==="
cp pakro.lock pakro.lock.before
assert_fail_contains "PAKRO_OFFLINE=1 pakro backends switch hk" "restored the previous lockfiles"
assert "cmp -s pakro.lock pakro.lock.before && echo same" "same"

echo "=== switch moves the lock entry at the same version and reinstalls ==="
pakro backends switch hk
assert_contains "cat pakro.lock" 'version = "1.58.1"'
assert_contains "cat pakro.lock" 'backend = "packslip:github.com/jdx/hk"'
assert_contains "cat pakro.lock" "[tools.hk.\"platforms.$PAKRO_PLATFORM\"]"
assert_contains "cat $PAKRO_DATA_DIR/installs/hk/.pakro.backend.toml" 'full = "packslip:github.com/jdx/hk"'
assert_contains "pakro exec -- hk --version" "hk 1.58.1"
assert_not_contains "pakro lock --platform $PAKRO_PLATFORM 2>&1" 'pakro backends switch'
assert_contains "pakro backends switch" "every tool in the project lockfile already uses the registry's backend"
assert_fail_contains "pakro backends switch hk" "not locked to a backend the registry has replaced"

echo "=== a backend named in the config is the user's choice, not superseded ==="
cat <<'EOF' >pakro.toml
[tools]
"aqua:jdx/hk" = "1.58.1"
EOF
cat <<'EOF' >pakro.lock
lockfile_version = 2

[[tools."aqua:jdx/hk"]]
version = "1.58.1"
backend = "aqua:jdx/hk"
EOF
assert_not_contains "pakro lock --platform $PAKRO_PLATFORM 2>&1" 'pakro backends switch'

echo "=== the global lockfile switches only with --global ==="
# The project's own hk, already on the registry's backend, must not hide the
# global one.
cat <<'EOF' >pakro.toml
[tools]
hk = "1.58.1"
EOF
cat <<'EOF' >pakro.lock
lockfile_version = 2

[[tools.hk]]
version = "1.58.1"
backend = "packslip:github.com/jdx/hk"
specifiers = ["1.58.1"]
EOF
cat <<'EOF' >"$PAKRO_CONFIG_DIR/config.toml"
[tools]
hk = "1"
EOF
cat <<EOF >"$PAKRO_CONFIG_DIR/pakro.lock"
lockfile_version = 2

[[tools.hk]]
version = "1.58.1"
backend = "aqua:jdx/hk"
specifiers = ["1"]

[tools.hk."platforms.$PAKRO_PLATFORM"]
url = "https://github.com/jdx/hk/releases/download/v1.58.1/placeholder"
EOF
assert_contains "pakro backends switch --dry-run" "every tool in the project lockfile already uses the registry's backend"
cp pakro.lock project.lock.before
assert_contains "pakro backends switch --global --dry-run 2>&1" 'would switch hk@1.58.1'
pakro backends switch --global
# the project's own hk entry is not touched
assert "cmp -s pakro.lock project.lock.before && echo same" "same"
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" 'backend = "packslip:github.com/jdx/hk"'
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" "[tools.hk.\"platforms.$PAKRO_PLATFORM\"]"
assert_not_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" 'placeholder'
# the relock kept the lockfile's one platform instead of the common defaults
assert_not_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" 'platforms.windows-x64'

echo "=== a global lockfile already switched does not unlock the project's backend ==="
# The global lockfile now locks hk on packslip; the project's own entries,
# all on aqua, still decide its backend when --bump picks a new version.
cat <<'TOML' >pakro.toml
[tools]
hk = "1"
TOML
reset_lockfile
pakro lock --bump hk --platform "$PAKRO_PLATFORM"
assert_contains "cat pakro.lock" 'version = "1.58.1"'
assert_contains "cat pakro.lock" 'backend = "aqua:jdx/hk"'

echo "=== an entry the request no longer resolves from still switches ==="
# The entry's specifier does not match the config, so the lockfile no longer
# supplies the version, but it still binds the backend and install warns.
cat <<'TOML' >pakro.toml
[tools]
hk = "1"
TOML
cat <<'EOF2' >pakro.lock
lockfile_version = 2

[[tools.hk]]
version = "1.58.1"
backend = "aqua:jdx/hk"
specifiers = ["1.58"]
EOF2
assert_contains "pakro backends switch --dry-run 2>&1" 'would switch hk@1.58.1 from aqua:jdx/hk to packslip:github.com/jdx/hk'
pakro backends switch hk
assert_contains "cat pakro.lock" 'backend = "packslip:github.com/jdx/hk"'
assert_not_contains "cat pakro.lock" 'aqua:jdx/hk'

echo "=== a stale entry at another version, with artifact data, still switches ==="
# The request resolves to a newer hk, so the stale entry only rebinds the
# backend: the relock drops it and locks the config's own version on the new
# backend, without pinning the config to the stale version.
cat <<TOML >pakro.toml
[tools]
hk = "2"
TOML
cat <<EOF2 >pakro.lock
lockfile_version = 2

[[tools.hk]]
version = "2.3.0"
backend = "aqua:jdx/hk"
specifiers = ["2.3"]

[tools.hk."platforms.$PAKRO_PLATFORM"]
url = "https://github.com/jdx/hk/releases/download/v2.3.0/placeholder"
EOF2
assert_contains "pakro backends switch --dry-run 2>&1" 'would replace stale hk@2.3.0 (aqua:jdx/hk)'
# The version the config resolves to is installed from the locked backend,
# and the switch reinstalls it from the new one.
pakro install
assert_contains "cat $PAKRO_DATA_DIR/installs/hk/.pakro.backend.toml" 'full = "aqua:jdx/hk"'
pakro backends switch hk
assert_contains "cat $PAKRO_DATA_DIR/installs/hk/.pakro.backend.toml" 'full = "packslip:github.com/jdx/hk"'
assert_not_contains "cat pakro.lock" 'aqua:jdx/hk'
assert_not_contains "cat pakro.lock" 'placeholder'
assert_not_contains "cat pakro.lock" 'version = "2.3.0"'
assert_contains "cat pakro.lock" 'backend = "packslip:github.com/jdx/hk"'
assert_contains "cat pakro.lock" "[tools.hk.\"platforms.$PAKRO_PLATFORM\"]"
