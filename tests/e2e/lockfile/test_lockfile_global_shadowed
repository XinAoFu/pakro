#!/usr/bin/env bash

# `pakro lock --global` locks the global config's request even when the
# project config declares the same tool and shadows it in the toolset.

export PAKRO_MINIMUM_RELEASE_AGE=0

# Pin the global request below the newest 2.x, so a plain lock must keep the
# pin and --bump must move it. hk releases before 1.58.1 carry no packslip.
write_global_lock() {
  cat >"$PAKRO_CONFIG_DIR/pakro.lock" <<'TOML'
[[tools.hk]]
version = "2.0.0"
backend = "packslip:github.com/jdx/hk"
specifiers = ["2"]

[tools.hk."platforms.linux-x64"]
TOML
}

cat >"$PAKRO_CONFIG_DIR/config.toml" <<'TOML'
[tools]
hk = "2"
TOML
cat >pakro.toml <<'TOML'
[tools]
hk = "1.58.1"
TOML

write_global_lock
assert_succeed "pakro lock --global --platform linux-x64"
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" 'version = "2.0.0"'
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" "download/v2.0.0/hk-x86_64-unknown-linux-gnu.tar.gz"
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" 'checksum = "sha256:'
assert_fail "test -f pakro.lock"

write_global_lock
assert_succeed "pakro lock --global hk --platform linux-x64"
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" 'version = "2.0.0"'
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" 'checksum = "sha256:'

# --bump advances the shadowed global request without touching either config.
write_global_lock
assert_succeed "pakro lock --global --bump --platform linux-x64"
assert_not_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" 'version = "2.0.0"'
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" 'version = "2.'
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" 'checksum = "sha256:'
assert "cat $PAKRO_CONFIG_DIR/config.toml" '[tools]
hk = "2"'
assert "cat pakro.toml" '[tools]
hk = "1.58.1"'
assert_fail "test -f pakro.lock"

# An identical project request pinned elsewhere must not overwrite the global
# pin: each request resolves through its own config's lockfile.
cat >pakro.toml <<'TOML'
[tools]
hk = "2"
TOML
cat >pakro.lock <<'TOML'
lockfile_version = 2

[[tools.hk]]
version = "2.1.0"
backend = "packslip:github.com/jdx/hk"
specifiers = ["2"]
TOML
write_global_lock
assert_succeed "pakro lock --global --platform linux-x64"
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" 'version = "2.0.0"'
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" "download/v2.0.0/hk-x86_64-unknown-linux-gnu.tar.gz"
assert_contains "cat pakro.lock" 'version = "2.1.0"'
