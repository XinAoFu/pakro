#!/usr/bin/env bash

# Test that local configs use pakro.local.lock

export PAKRO_LOCKFILE=1

# Create base config
cat >pakro.toml <<'EOF'
[tools]
tiny = "1"
EOF

# Create local config
cat >pakro.local.toml <<'EOF'
[tools]
dummy = "1.0.0"
EOF

# Create both lockfiles
touch pakro.lock
touch pakro.local.lock

# Install tools
assert "pakro install tiny@1.0.0"
assert "pakro install dummy@1.0.0"

# Use the tools to trigger lockfile updates
# Use --path to ensure tiny goes to pakro.toml (not pakro.local.toml which takes precedence)
assert "pakro use tiny@1 --path pakro.toml"
# Use dummy to trigger pakro.local.lock update
assert "pakro use dummy@1.0.0 --path pakro.local.toml"

# Base tool should be in pakro.lock
assert_contains "cat pakro.lock" "[[tools.tiny]]"
assert_contains "cat pakro.lock" 'version = "1.0.0"'

# Local tool should be in pakro.local.lock
assert_contains "cat pakro.local.lock" "[[tools.dummy]]"
assert_contains "cat pakro.local.lock" 'version = "1.0.0"'

# pakro.lock should NOT contain dummy
assert_not_contains "cat pakro.lock" "dummy"

# pakro.local.lock should NOT contain tiny
assert_not_contains "cat pakro.local.lock" "tiny"
