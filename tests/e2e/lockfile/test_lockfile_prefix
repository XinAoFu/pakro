#!/usr/bin/env bash

# Test that the lockfile pins `prefix:` version selectors: `pakro install` must
# respect the locked version instead of re-resolving to the newest prefix match.
# https://github.com/jdx/mise/discussions/5781

export PAKRO_LOCKFILE=1

cat <<EOF >pakro.toml
[tools]
dummy = "prefix:1"

[settings]
lockfile = true
EOF

# dummy exposes 1.0.0, 1.1.0, 2.0.0 — lock to the older 1.0.0
cat <<EOF >pakro.lock
[[tools.dummy]]
version = "1.0.0"
EOF

rm -rf "$PAKRO_DATA_DIR/installs/dummy"
pakro install
assert "pakro ls dummy --json --current | jq -r '.[0].requested_version'" "prefix:1"
# must be the locked 1.0.0, not the newest prefix match 1.1.0
assert "pakro ls dummy --json --current | jq -r '.[0].version'" "1.0.0"
assert_contains "cat pakro.lock" 'version = "1.0.0"'
assert_not_contains "cat pakro.lock" 'version = "1.1.0"'

# a second install is a no-op and must not rewrite the lockfile
pakro install
assert_contains "cat pakro.lock" 'version = "1.0.0"'
assert_not_contains "cat pakro.lock" 'version = "1.1.0"'

# pakro upgrade still bypasses the lock and bumps within the prefix range
pakro upgrade dummy
assert "pakro ls dummy --json --current | jq -r '.[0].version'" "1.1.0"
assert_contains "cat pakro.lock" 'version = "1.1.0"'

# a lock entry that does not match the prefix is ignored (fresh resolution)
cat <<EOF >pakro.lock
[[tools.dummy]]
version = "2.0.0"
EOF
rm -rf "$PAKRO_DATA_DIR/installs/dummy"
pakro install
assert "pakro ls dummy --json --current | jq -r '.[0].version'" "1.1.0"
assert_contains "cat pakro.lock" 'version = "1.1.0"'

# a stale entry that textually starts with the prefix but crosses a version
# boundary (10.0.0 vs prefix:1) must be rejected, not pinned
cat <<EOF >pakro.lock
[[tools.dummy]]
version = "10.0.0"
EOF
rm -rf "$PAKRO_DATA_DIR/installs/dummy"
pakro install
assert "pakro ls dummy --json --current | jq -r '.[0].version'" "1.1.0"
assert_contains "cat pakro.lock" 'version = "1.1.0"'

# an alias that resolves to a `prefix:` selector is pinned the same way
cat <<EOF >pakro.toml
[tools]
dummy = "my1"

[tool_alias.dummy.versions]
my1 = "prefix:1"

[settings]
lockfile = true
EOF
cat <<EOF >pakro.lock
[[tools.dummy]]
version = "1.0.0"
EOF
rm -rf "$PAKRO_DATA_DIR/installs/dummy"
pakro install
assert "pakro ls dummy --json --current | jq -r '.[0].requested_version'" "my1"
assert "pakro ls dummy --json --current | jq -r '.[0].version'" "1.0.0"
assert_contains "cat pakro.lock" 'version = "1.0.0"'
