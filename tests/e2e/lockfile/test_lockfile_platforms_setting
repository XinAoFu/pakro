#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

detect_platform

# === Test 1: Setting restricts auto-lock platforms ===
export PAKRO_LOCKFILE_PLATFORMS=macos-arm64,linux-x64

cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

touch pakro.lock
pakro install
assert_contains "cat pakro.lock" "platforms.macos-arm64"
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_contains "cat pakro.lock" "platforms.$PAKRO_PLATFORM"
assert_not_contains "cat pakro.lock" "platforms.windows-x64"

# === Test 2: Setting restricts pakro lock without --platform ===
rm -f pakro.lock
touch pakro.lock
pakro lock
assert_contains "cat pakro.lock" "platforms.macos-arm64"
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_not_contains "cat pakro.lock" "platforms.windows-x64"

# === Test 3: --platform flag overrides the setting ===
rm -f pakro.lock
pakro lock --platform windows-x64
assert_contains "cat pakro.lock" "platforms.windows-x64"

# === Test 4: Setting via pakro.toml ===
unset PAKRO_LOCKFILE_PLATFORMS

cat <<EOF >pakro.toml
[settings]
lockfile_platforms = ["macos-arm64", "linux-x64"]

[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

rm -f pakro.lock
touch pakro.lock
pakro lock
assert_contains "cat pakro.lock" "platforms.macos-arm64"
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_not_contains "cat pakro.lock" "platforms.windows-x64"

# === Test 5: pakro use respects lockfile_platforms setting ===
export PAKRO_LOCKFILE_PLATFORMS=macos-arm64,linux-x64

cat <<EOF >pakro.toml
[tools]
EOF

rm -f pakro.lock
touch pakro.lock
pakro use "aqua:jqlang/jq@1.7.1"
assert_contains "cat pakro.lock" "platforms.macos-arm64"
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_not_contains "cat pakro.lock" "platforms.windows-x64"
