#!/usr/bin/env bash

# Test --locked mode enforcement during install and dry-run

export PAKRO_LOCKFILE=1

detect_platform
PLATFORM="$PAKRO_PLATFORM"

# Use jq via aqua backend, which supports lockfile URLs
cat <<'EOF' >pakro.toml
[tools]
jq = "1.7.1"
EOF

# Uninstall jq so it's not already present
pakro uninstall jq@1.7.1 2>/dev/null || true

# --- Test 1: --locked fails when no lockfile URL exists ---
cat <<EOF >pakro.lock
[[tools.jq]]
version = "1.7.1"
backend = "aqua:jqlang/jq"
EOF

assert_fail_contains "pakro install --locked 2>&1" "No lockfile URL found"

# --- Test 2: --locked --dry-run also fails when no lockfile URL exists ---
# This is the key behavior: locked validation must run before dry-run short-circuit
assert_fail_contains "pakro install --locked --dry-run 2>&1" "No lockfile URL found"

# --- Test 3: --locked --dry-run succeeds when lockfile URL exists ---
cat <<EOF >pakro.lock
[[tools.jq]]
version = "1.7.1"
backend = "aqua:jqlang/jq"
"platforms.$PLATFORM" = { url = "https://example.com/jq-1.7.1.tar.gz" }
EOF

assert_contains "pakro install --locked --dry-run 2>&1" "would install"

# --- Test 4: locked=true with PAKRO_LOCKFILE=false errors (contradictory config) ---
cat <<EOF >pakro.lock
[[tools.jq]]
version = "1.7.1"
backend = "aqua:jqlang/jq"
"platforms.$PLATFORM" = { url = "https://example.com/jq-1.7.1.tar.gz" }
EOF

PAKRO_LOCKFILE=0 assert_fail_contains "pakro install --locked --dry-run 2>&1" "locked mode requires lockfile to be enabled"

# --- Test 5: locked setting via config with lockfile=false errors ---
# Unset PAKRO_LOCKFILE so the env var doesn't override the config file setting
unset PAKRO_LOCKFILE

cat <<'EOF' >pakro.toml
[tools]
jq = "1.7.1"
[settings]
locked = true
lockfile = false
EOF

assert_fail_contains "pakro install --dry-run 2>&1" "locked mode requires lockfile to be enabled"

# --- Test 6: locked=true with lockfile unset (not in config) works fine ---
cat <<'EOF' >pakro.toml
[tools]
jq = "1.7.1"
[settings]
locked = true
EOF

cat <<EOF >pakro.lock
[[tools.jq]]
version = "1.7.1"
backend = "aqua:jqlang/jq"
"platforms.$PLATFORM" = { url = "https://example.com/jq-1.7.1.tar.gz" }
EOF

assert_contains "pakro install --dry-run 2>&1" "would install"

# --- Test 7: pakro lock can refresh lockfiles in locked mode ---
export PAKRO_LOCKFILE=1

cat <<'EOF' >pakro.toml
[tools]
jq = "1.7.1"
EOF

cat <<EOF >pakro.lock
[[tools.jq]]
version = "1.7.1"
backend = "aqua:jqlang/jq"
"platforms.$PLATFORM" = { url = "https://example.com/jq-1.7.1.tar.gz" }
EOF

pakro lock --locked --platform "$PLATFORM"
assert_contains "cat pakro.lock" "1.7.1"
PAKRO_LOCKED=1 pakro lock --platform "$PLATFORM"
assert_contains "cat pakro.lock" "1.7.1"

# --- Test 8: links from another backend do not suppress lock data ---
# An alias can share an install directory with another backend (for example, core rust).
# External symlinks in that directory must not prevent the aliased HTTP tool from loading
# its platform URL from the lockfile.
mkdir -p "$PWD/linked-rust" "$PAKRO_DATA_DIR/installs/rust"
ln -s "$PWD/linked-rust" "$PAKRO_DATA_DIR/installs/rust/external"
cat <<'EOF' >"$PAKRO_DATA_DIR/installs/rust/.pakro.backend.toml"
short = "rust"
full = "core:rust"
explicit_backend = true
EOF

cat <<EOF >pakro.toml
[tools.rust]
version = "1.90.0"

[tools.rust.platforms.$PLATFORM]
url = "https://example.com/rust-1.90.0.tar.gz"

[tool_alias]
rust = "http:rust"
EOF

cat <<EOF >pakro.lock
[[tools.rust]]
version = "1.90.0"
backend = "http:rust"
"platforms.$PLATFORM" = { url = "https://example.com/rust-1.90.0.tar.gz" }
EOF

assert_contains "pakro install --locked --dry-run rust 2>&1" "would install"

# --- Test 9: targeted install does not warn about other tools missing from the lockfile
# `pakro install tiny` with --locked should not warn about a global dummy that
# was never requested. `pakro ls` still warns. Installing dummy itself, or a
# bare `pakro install`, still fails because dummy is not in the lockfile.
rm -rf "$PAKRO_DATA_DIR/plugins/tiny"
ln -s "$ROOT/tests/support/data/plugins/tiny" "$PAKRO_DATA_DIR/plugins/tiny"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools]
dummy = "latest"
EOF

cat <<'EOF' >pakro.toml
[tools]
tiny = "1.0.0"
EOF

cat <<EOF >pakro.lock
[[tools.tiny]]
version = "1.0.0"
backend = "asdf:tiny"
EOF

tiny_out="$(PAKRO_LOCKED=1 pakro install tiny 2>&1)" || fail "PAKRO_LOCKED=1 pakro install tiny failed: $tiny_out"
assert_not_contains_text "$tiny_out" "dummy@latest is not in the lockfile"
assert_not_contains_text "$tiny_out" "Failed to resolve tool version list for dummy"
assert_contains "PAKRO_LOCKED=1 pakro ls 2>&1" "dummy@latest is not in the lockfile"
assert_fail_contains "PAKRO_LOCKED=1 pakro install dummy 2>&1" "dummy@latest is not in the lockfile"
assert_fail_contains "PAKRO_LOCKED=1 pakro install 2>&1" "dummy@latest is not in the lockfile"

# Restore for any subsequent tests
export PAKRO_LOCKFILE=1
rm -f "$PAKRO_CONFIG_DIR/config.toml"
