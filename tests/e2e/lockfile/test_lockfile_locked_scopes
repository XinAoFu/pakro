#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

pakro plugin install tiny
mkdir -p system-config
export PAKRO_SYSTEM_CONFIG_FILE="$PWD/system-config/config.toml"

# System tools are strict by default, but a distribution can exempt its
# rolling system config without weakening project or user-global tools.
cat >"$PAKRO_SYSTEM_CONFIG_FILE" <<'EOF'
[tools]
dummy = "latest"
EOF

assert_fail_contains "PAKRO_LOCKED=1 pakro install --dry-run 2>&1" "dummy@latest is not in the lockfile"
cat >>"$PAKRO_SYSTEM_CONFIG_FILE" <<'EOF'

[settings]
locked_scopes = ["project", "global"]
EOF
assert_contains "PAKRO_LOCKED=1 pakro install --dry-run 2>&1" "would install"
assert_contains "PAKRO_LOCKED=1 PAKRO_LOCKFILE=0 pakro install --dry-run 2>&1" "would install"

# User-global config has its own independently selectable scope.
rm "$PAKRO_SYSTEM_CONFIG_FILE"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools]
tiny = "1"
EOF

assert_fail_contains "PAKRO_LOCKED=1 pakro install --dry-run 2>&1" "tiny@1 is not in the lockfile"
assert_contains "PAKRO_LOCKED=1 PAKRO_LOCKED_SCOPES=project,system pakro install --dry-run 2>&1" "would install"

# A project cannot weaken the user's locked-mode policy because the scope
# selection setting is global-only.
cat >pakro.toml <<'EOF'
[tools]
dummy = "latest"

[settings]
locked_scopes = []
EOF

assert_fail_contains "PAKRO_LOCKED=1 pakro install --dry-run 2>&1" "dummy@latest is not in the lockfile"

# Config-root policy is authoritative even when invocation-wide locking omits
# that scope.
rm pakro.toml "$PAKRO_CONFIG_DIR/config.toml"
cat >"$PAKRO_SYSTEM_CONFIG_FILE" <<'EOF'
[tool_config]
locked = true

[tools]
dummy = "latest"
EOF

assert_fail_contains "PAKRO_LOCKED=1 PAKRO_LOCKED_SCOPES=project,global pakro install --dry-run 2>&1" "tool_config.locked"

# Direct arguments do not have a config scope and remain strict.
rm "$PAKRO_SYSTEM_CONFIG_FILE"
assert_fail_contains "PAKRO_LOCKED=1 PAKRO_LOCKED_SCOPES=project pakro install --dry-run jq@1.7.1 2>&1" "No lockfile URL found"

# Unsupported values fail closed instead of silently weakening locked mode.
assert_fail_contains "PAKRO_LOCKED_SCOPES=projct pakro settings get locked_scopes 2>&1" 'invalid locked_scopes value "projct"'
