#!/usr/bin/env bash

unset PAKRO_LOCKFILE

cat <<EOF >pakro.toml
[settings]
lockfile = true
EOF
cat <<EOF >pakro.local.toml
[env]
LOCKFILE_TEST = "1"
EOF

assert "test ! -e pakro.lock"
pakro use --pin tiny@1
assert "test -f pakro.lock"
assert "test ! -e pakro.local.lock"
assert_contains "cat pakro.lock" 'version = "1.1.0"'

rm pakro.lock
pakro use --global --pin tiny@2
assert "test ! -e pakro.lock"
assert "test ! -e $PAKRO_CONFIG_DIR/pakro.lock"

cat <<EOF >pakro.toml
[settings]
lockfile = true

[tools]
dummy = "1"
EOF

pakro install
assert "test -f pakro.lock"

rm pakro.lock
cat <<EOF >pakro.toml
[tools]
tiny = "1"
EOF

pakro install
assert "test ! -e pakro.lock"

PAKRO_LOCKFILE=1 pakro install
assert "test ! -e pakro.lock"

cat <<EOF >"$PAKRO_CONFIG_DIR/config.toml"
[settings]
lockfile = true
EOF

pakro install
assert "test -f pakro.lock"
rm pakro.lock "$PAKRO_CONFIG_DIR/config.toml"

cat <<EOF >pakro.toml
[settings]
lockfile = true

[tools]
dummy = "1"
EOF
cat <<EOF >pakro.dev.toml
[tools]
tiny = "2"
EOF

pakro use --env dev --pin tiny@2
assert "test -f pakro.lock"
assert "test -f pakro.dev.lock"
assert_contains "cat pakro.lock" '[[tools.dummy]]'
assert_contains "cat pakro.dev.lock" '[[tools.tiny]]'
