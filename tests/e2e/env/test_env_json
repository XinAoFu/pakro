#!/usr/bin/env bash
require_cmd jq

cat >/tmp/.env-test <<EOF
AAA=bbb
EOF

cat >.pakro.toml <<EOF
[tools]
deno = "2"

[env]
_.file = '/tmp/.env-test'
FOO = "bar"
EOF

assert "pakro env --json dummy@latest | jq -r .FOO" "bar"

assert "pakro env --json-extended dummy@latest | jq -r '.FOO.value'" "bar"
assert_contains "pakro env --json-extended dummy@latest | jq -r '.FOO.source'" ".pakro.toml"

assert "pakro env --json-extended dummy@latest | jq -r '.AAA.value'" "bbb"
assert "pakro env --json-extended dummy@latest | jq -r '.AAA.source'" "/tmp/.env-test"

pakro i
assert "pakro env --json-extended | jq -r '.DENO_INSTALL_ROOT.tool'" "deno"
assert_contains "pakro env --json-extended | jq -r '.DENO_INSTALL_ROOT.value'" ".deno"
assert_contains "pakro env --json-extended | jq -r '.DENO_INSTALL_ROOT.source'" ".pakro.toml"

assert_contains "pakro env --json-extended go@1.23.4 | jq -r '.GOBIN.value'" "go/1.23.4/bin"
assert_contains "pakro env --json-extended go@1.23.4 | jq -r '.GOBIN.tool'" "go"
assert_contains "pakro env --json-extended go@1.23.4 | jq -r '.GOBIN.source'" ""
