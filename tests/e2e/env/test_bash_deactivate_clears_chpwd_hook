#!/usr/bin/env bash
set -euo pipefail

# Verify that bash deactivation removes the stale `_pakro_hook_chpwd` entry from
# `chpwd_functions` as well as unsetting the function itself.

eval "$(pakro activate bash --status)"

if [[ " ${chpwd_functions[*]-} " != *" _pakro_hook_chpwd "* ]]; then
  echo "expected _pakro_hook_chpwd to be registered after activation"
  printf '%s\n' "${chpwd_functions[@]-}"
  exit 1
fi

pakro deactivate

if [[ " ${chpwd_functions[*]-} " == *" _pakro_hook_chpwd "* ]]; then
  echo "expected _pakro_hook_chpwd to be removed from chpwd_functions after deactivation"
  printf '%s\n' "${chpwd_functions[@]-}"
  exit 1
fi
