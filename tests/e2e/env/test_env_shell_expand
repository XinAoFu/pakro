#!/usr/bin/env bash
# shellcheck disable=SC2016

# Test basic $VAR expansion
cat <<'EOF' >pakro.toml
[env]
FOO = "hello"
BAR = "$FOO-world"
EOF
assert_contains "pakro env -s bash | grep BAR" "export BAR=hello-world"

# Test $$ escapes a literal $
cat <<'EOF' >pakro.toml
[env]
SOME_VAR = "$$x"
EOF
assert_contains "pakro env -s bash 2>&1" "export SOME_VAR='\$x'"
assert_not_contains "pakro env -s bash 2>&1" "env var 'x' is not defined"

# Test ${VAR} brace syntax
cat <<'EOF' >pakro.toml
[env]
FOO = "hello"
BAR = "${FOO}_world"
EOF
assert_contains "pakro env -s bash | grep BAR" "export BAR=hello_world"

# Test ${VAR:-default} syntax
cat <<'EOF' >pakro.toml
[env]
BAR = "${NONEXISTENT:-fallback}"
EOF
assert_contains "pakro env -s bash | grep BAR" "export BAR=fallback"

# Test ${VAR:-default} treats empty strings as unset
cat <<'EOF' >pakro.toml
[env]
BAR = "${EMPTY_VAR:-fallback}"
EOF
EMPTY_VAR='' assert_contains "pakro env -s bash | grep BAR" "export BAR=fallback"

# Test ${VAR-default} treats empty strings as set
cat <<'EOF' >pakro.toml
[env]
BAR = "${EMPTY_VAR-fallback}"
EOF
EMPTY_VAR='' assert_contains "pakro env -s bash | grep BAR" "export BAR=''"

# Test default values are shell-expanded
cat <<'EOF' >pakro.toml
[env]
BAR = "${NONEXISTENT:-$OTHER}"
EOF
OTHER=hello assert_contains "pakro env -s bash | grep BAR" "export BAR=hello"

# Test unterminated braced expressions stay literal
cat <<'EOF' >pakro.toml
[env]
BAR = "${NONEXISTENT:-$OTHER"
EOF
OTHER=hello assert_contains "pakro env -s bash | grep BAR" "export BAR='\${NONEXISTENT:-\$OTHER'"

# Test } inside command substitution text does not close braced expressions
cat <<'EOF' >pakro.toml
[env]
BAR = "${NONEXISTENT:-$(echo })}"
EOF
assert_contains "pakro env -s bash | grep BAR" "export BAR='\$(echo })'"

# Test expansion from initial environment
cat <<'EOF' >pakro.toml
[env]
FOO = "$INITIAL_VAR"
EOF
INITIAL_VAR=from_env assert_contains "pakro env -s bash | grep FOO" "export FOO=from_env"

# Test disabled explicitly ($ stays literal, no warning)
cat <<'EOF' >pakro.toml
[env]
FOO = "hello"
BAR = "$FOO"
EOF
PAKRO_ENV_SHELL_EXPAND=false assert_contains "pakro env -s bash | grep BAR" 'export BAR='\''$FOO'\'

# Test mixed Tera + shell expand
cat <<'EOF' >pakro.toml
[env]
FOO = "hello"
BAR = "{{ env.FOO }}-$FOO"
EOF
assert_contains "pakro env -s bash | grep BAR" "export BAR=hello-hello"

# Test tools=true vars can reference each other via $
cat <<'EOF' >pakro.toml
[env]
TOOL_HOME = { value = "/opt/tools", tools = true }
TOOL_BIN = { value = "$TOOL_HOME/bin", tools = true }
EOF
assert_contains "pakro env -s bash | grep TOOL_BIN" "export TOOL_BIN=/opt/tools/bin"

# Test tools=true var can reference a non-tools var via $
# (non-tools vars are resolved first, so tools=true vars can see them)
cat <<'EOF' >pakro.toml
[env]
BASE_DIR = "/opt/tools"
TOOL_BIN = { value = "$BASE_DIR/bin", tools = true }
EOF
assert_contains "pakro env -s bash | grep TOOL_BIN" "export TOOL_BIN=/opt/tools/bin"

# Test chained $ expansion across multiple vars
cat <<'EOF' >pakro.toml
[env]
A = "base"
B = "$A/mid"
C = "$B/end"
EOF
assert_contains "pakro env -s bash | grep '^export C='" "export C=base/mid/end"

# Test warning for undefined var (bare $VAR)
cat <<'EOF' >pakro.toml
[env]
BAR = "$UNDEFINED_VAR"
EOF
assert_contains "pakro env -s bash 2>&1" "env var 'UNDEFINED_VAR' is not defined"
# The warning has to say what referenced it. A missing variable is by definition
# absent from `pakro env`, so naming it alone left the reporter in discussion
# #8232 with nothing to grep for.
assert_contains "pakro env -s bash 2>&1" 'referenced by `BAR`'
assert_contains "pakro env -s bash 2>&1" "pakro.toml"

# Test ${VAR:-} suppresses warning for undefined var
cat <<'EOF' >pakro.toml
[env]
BAR = "${UNDEFINED_VAR:-}"
EOF
assert_not_contains "pakro env -s bash 2>&1" "is not defined"
