#!/usr/bin/env bash

# Test --fresh-env flag with caching

# Enable env caching
export PAKRO_ENV_CACHE=1

# Set up a cache encryption key as if activated
export __PAKRO_ENV_CACHE_KEY="dGVzdGtleXRlc3RrZXl0ZXN0a2V5dGVzdGtleXRlc3Q="

# Create config
cat >"$PAKRO_CONFIG_DIR/config.toml" <<EOF
[env]
FRESH_TEST_VAR="original"
EOF

# First run caches
pakro exec -- true

# Modify config
sleep 1
cat >"$PAKRO_CONFIG_DIR/config.toml" <<EOF
[env]
FRESH_TEST_VAR="modified"
EOF

# Normal exec should see cache invalidated due to mtime change
assert_contains "pakro exec -- bash -c 'echo \$FRESH_TEST_VAR'" "modified"

# Verify --fresh-env flag exists on exec
assert_contains "pakro exec --help" "fresh-env"

# Verify --fresh-env flag exists on run
assert_contains "pakro run --help" "fresh-env"
