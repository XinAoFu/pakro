#!/usr/bin/env zsh
# shellcheck disable=SC1071
set -eu

# Verify that the first precmd after `pakro activate zsh` still runs hook-env.
# This protects the startup path where zsh may mutate PATH during shell
# initialization before the first prompt is rendered.

eval "$(pakro activate zsh --status)"

if [[ ${__PAKRO_ZSH_PRECMD_RUN:-unset} != "0" ]]; then
  echo "expected __PAKRO_ZSH_PRECMD_RUN=0 after activation"
  exit 1
fi

_pakro_hook_precmd >/dev/null 2>&1

if [[ ${__PAKRO_ZSH_PRECMD_RUN:-unset} != "1" ]]; then
  echo "expected first precmd after activation to run hook-env"
  exit 1
fi
