#!/usr/bin/env bash

pakro use dummy@1.0.0
assert_contains "pakro env -s bash | grep PATH" "/installs/dummy/1.0.0/bin"

pakro use dummy@2.0.0
assert_contains "pakro env -s bash | grep PATH" "/installs/dummy/2.0.0/bin"

assert_contains "pakro env -s bash dummy@1.0.1 | grep PATH" "/installs/dummy/1.0.1/bin"

cat <<'EOF' >pakro.toml
[env]
_.path = 'a'
EOF
assert "pakro dr path" "$PWD/a"

cat <<'EOF' >pakro.toml
[env]
_.path = ['a', 'b']
EOF
assert "pakro dr path" "$PWD/a
$PWD/b"

cat <<'EOF' >pakro.toml
[env]
_.path = { path = "a", tools = true }
EOF
assert "pakro dr path" "$PWD/a"

cat <<'EOF' >pakro.toml
[env]
_.path = { path = ["a"], tools = true }
EOF
assert "pakro dr path" "$PWD/a"

cat <<'EOF' >pakro.toml
[env]
_.path = { paths = ["a", "b"], tools = true }
EOF
assert_not_contains "pakro dr path 2>&1" "deprecated [config.directive"
assert "pakro dr path" "$PWD/a
$PWD/b"

cat <<'EOF' >pakro.toml
[env]
_.path = [{ path = "a", tools = true }, "b"]
EOF
assert "pakro dr path" "$PWD/a
$PWD/b"

cat <<'EOF' >pakro.toml
[env]
_.path = { path = "a", tools = true }
EOF
assert "pakro dr path" "$PWD/a"

cat <<'EOF' >pakro.toml
[env]
_.path = [{ path = ["a", "b"], tools = true }]
EOF
assert "pakro dr path" "$PWD/a
$PWD/b"

cat <<'EOF' >pakro.toml
[[env]]
_.path = [{ path = "a", tools = true }, "b"]
[[env]]
_.path = "c"
EOF
assert "pakro dr path" "$PWD/a
$PWD/b
$PWD/c"

cat <<'EOF' >pakro.toml
[env]
_.path = ['a', 'b']
EOF
mkdir -p sub_dir
cd sub_dir
cat <<'EOF' >pakro.toml
[env]
_.path = ['c', 'd']
EOF
assert "pakro dr path" "$PWD/c
$PWD/d
${PWD%/*}/a
${PWD%/*}/b"
