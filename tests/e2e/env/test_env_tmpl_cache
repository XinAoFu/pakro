#!/usr/bin/env bash

cat <<'EOF' >pakro.toml
[env]
NOW="{{ exec(command='date') }}"
EOF

now=$(pakro env --json | jq -r '.NOW')
sleep 1
assert_not_contains "pakro env --json | jq -r '.NOW'" "$now"

cat <<'EOF' >pakro.toml
[env]
NOW="{{ exec(command='date', cache_key='now') }}"
EOF

now=$(pakro env --json | jq -r '.NOW')
sleep 1
assert "pakro env --json | jq -r '.NOW'" "$now"

cat <<'EOF' >pakro.toml
[env]
NOW="{{ exec(command='date', cache_duration='2s') }}"
EOF

now=$(pakro env --json | jq -r '.NOW')
sleep 1
assert "pakro env --json | jq -r '.NOW'" "$now"
sleep 1
assert_not_contains "pakro env --json | jq -r '.NOW'" "$now"
