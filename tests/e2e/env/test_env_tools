#!/usr/bin/env bash

cat <<EOF >pakro.toml
[env]
FOO={value="bar", tools=true}
EOF
assert_contains "pakro hook-env -s bash" "export FOO=bar"

cat <<EOF >pakro.toml
[env]
WHICH={value="{{ exec(command='which which') }}", tools=true}
EOF
assert_contains "pakro hook-env -s bash" "export WHICH=$(which which)"

cat <<EOF >pakro.toml
[tools]
tiny = "latest"

[env]
TINY_V = { value = "{{ tools.tiny.version }}", tools = true }
TINY_P = { value = "{{ tools.tiny.path }}", tools = true }
EOF
pakro install tiny
TINY_VERSION=$(pakro latest tiny)
TINY_PATH=$(pakro where tiny)
assert_contains "pakro hook-env -s bash" "export TINY_V=$TINY_VERSION"
assert_contains "pakro hook-env -s bash" "export TINY_P=$TINY_PATH"

# test multiple versions of the same tool (array access)
cat <<EOF >pakro.toml
[tools]
tiny = ["3", "2"]

[env]
TINY_V0 = { value = "{{ tools.tiny[0].version }}", tools = true }
TINY_P0 = { value = "{{ tools.tiny[0].path }}", tools = true }
TINY_V1 = { value = "{{ tools.tiny[1].version }}", tools = true }
TINY_P1 = { value = "{{ tools.tiny[1].path }}", tools = true }
EOF
pakro install tiny@3 tiny@2
TINY_PATH0=$(pakro where tiny@3)
TINY_PATH1=$(pakro where tiny@2)
assert_contains "pakro hook-env -s bash" "export TINY_V0=3"
assert_contains "pakro hook-env -s bash" "export TINY_P0=$TINY_PATH0"
assert_contains "pakro hook-env -s bash" "export TINY_V1=2"
assert_contains "pakro hook-env -s bash" "export TINY_P1=$TINY_PATH1"
