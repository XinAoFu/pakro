#!/usr/bin/env bash

# Test that optional pakro.lock files do not prevent hook-env from stabilizing,
# while lockfile creation/removal still invalidates the session.

export PAKRO_ENV_CACHE=1
export __PAKRO_ENV_CACHE_KEY="dGVzdGtleXRlc3RrZXl0ZXN0a2V5dGVzdGtleXRlc3Q="

cat >pakro.toml <<'EOF'
[env]
FOO = "bar"
EOF

eval "$(pakro activate bash)"

# With no lockfile present, hook-env should be stable.
output=$(pakro hook-env -s bash)
if [[ -z $output ]]; then
  ok "no lockfile does not destabilize hook-env"
else
  fail "no lockfile should not destabilize hook-env but got: '$output'"
fi

# Creating a lockfile should invalidate once.
sleep 1
touch pakro.lock
output=$(pakro hook-env -s bash)
if [[ $output == *"__PAKRO_SESSION"* ]]; then
  ok "creating pakro.lock invalidates session"
else
  fail "creating pakro.lock should invalidate session but got: '$output'"
fi
eval "$output"

# Should stabilize after picking up the new lockfile.
output=$(pakro hook-env -s bash)
if [[ -z $output ]]; then
  ok "hook-env stabilizes after pakro.lock creation"
else
  fail "hook-env should stabilize after pakro.lock creation but got: '$output'"
fi

# Removing the lockfile should also invalidate once.
sleep 1
rm pakro.lock
output=$(pakro hook-env -s bash)
if [[ $output == *"__PAKRO_SESSION"* ]]; then
  ok "removing pakro.lock invalidates session"
else
  fail "removing pakro.lock should invalidate session but got: '$output'"
fi
eval "$output"

# And then stabilize again.
output=$(pakro hook-env -s bash)
if [[ -z $output ]]; then
  ok "hook-env stabilizes after pakro.lock removal"
else
  fail "hook-env should stabilize after pakro.lock removal but got: '$output'"
fi
