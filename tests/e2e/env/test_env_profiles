#!/usr/bin/env bash

echo 'env.AAA = "main"' >.pakro.toml
echo 'env.AAA = "override-1"' >pakro.override1.toml
echo 'env.AAA = "override-2"' >pakro.override2.toml

assert "pakro env --json | jq -r .AAA" "main"
PAKRO_ENV=override1 assert "pakro env --json | jq -r .AAA" "override-1"
PAKRO_ENV=override1,override2 assert "pakro env --json | jq -r .AAA" "override-2"

cat <<EOF >pakro.toml
[tasks.print]
run = '{% if pakro_env %}echo {{pakro_env}}{% endif %}'
EOF
assert "pakro run print" ""
PAKRO_ENV=env1 assert "pakro run print" "[env1]"
PAKRO_ENV=env1,env2 assert "pakro run print" "[env1, env2]"
assert "pakro --env env3 run print" "[env3]"
assert "pakro -E env3,env4 run print" "[env3, env4]"
