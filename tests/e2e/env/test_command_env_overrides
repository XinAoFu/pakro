#!/usr/bin/env bash
set -euo pipefail

cat >pakro.toml <<'EOF'
[env]
TMPL = '{{ get_env(name="TMPL", default="tmpl-default") }}'
DEFAULT = { default = "default-default" }
PLAIN = "plain-value"

[tasks.probe]
run = 'printf "%s|%s|%s" "$TMPL" "$DEFAULT" "$PLAIN"'
EOF

eval "$(pakro activate bash)"
eval "$(pakro hook-env -s bash --reason precmd)"

assert \
  "TMPL=override DEFAULT=override PLAIN=override pakro env -J | jq -r '[.TMPL, (if has(\"DEFAULT\") then .DEFAULT else \"omitted\" end), .PLAIN] | join(\"|\")'" \
  "override|omitted|plain-value"
assert \
  "TMPL=override DEFAULT=override PLAIN=override pakro run probe" \
  "override|override|plain-value"
