#!/usr/bin/env bash

# A decrypted age value is never written to the env cache, even with redact = false.
export PAKRO_EXPERIMENTAL=true
export PAKRO_ENV_CACHE=1
export __PAKRO_ENV_CACHE_KEY="dGVzdGtleXRlc3RrZXl0ZXN0a2V5dGVzdGtleXRlc3Q="
rm -f pakro.toml age.txt

pakro x age -- age-keygen -o age.txt 2>/dev/null
AGE_PUBLIC_KEY=$(grep "# public key:" age.txt | cut -d: -f2 | tr -d ' ')
export PAKRO_AGE_KEY
PAKRO_AGE_KEY=$(grep "AGE-SECRET-KEY-" age.txt)

pakro set AGE_SECRET="my-secret-value" --age-encrypt --age-recipient "$AGE_PUBLIC_KEY"
sed -i.bak 's/^\(AGE_SECRET = { age = "[^"]*"\) }/\1, redact = false }/' pakro.toml
assert_contains "cat pakro.toml" "redact = false"

rm -rf "$PAKRO_STATE_DIR/env-cache"
assert_contains "pakro env -s bash" "export AGE_SECRET=my-secret-value"
assert_contains "pakro env -s bash" "export AGE_SECRET=my-secret-value"
assert "find '$PAKRO_STATE_DIR/env-cache' -type f 2>/dev/null | wc -l | tr -d ' '" "0"

# The same holds for an age value in [vars] that [env] renders through a template.
VARS_LINE=$(grep '^AGE_SECRET = ' pakro.toml | sed 's/^AGE_SECRET/VAR_SECRET/; s/, redact = false//')
cat >pakro.toml <<EOF
[vars]
$VARS_LINE

[env]
FROM_VAR = "{{ vars.VAR_SECRET }}"
EOF
rm -rf "$PAKRO_STATE_DIR/env-cache"
assert_contains "pakro env -s bash" "export FROM_VAR=my-secret-value"
assert_contains "pakro env -s bash" "export FROM_VAR=my-secret-value"
assert "find '$PAKRO_STATE_DIR/env-cache' -type f 2>/dev/null | wc -l | tr -d ' '" "0"
