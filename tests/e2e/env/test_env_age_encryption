#!/usr/bin/env bash
# shellcheck disable=SC2016

# Test basic age encryption with x25519 key
export PAKRO_EXPERIMENTAL=true
rm -f pakro.toml age.txt

# Generate test age key
pakro x age -- age-keygen -o age.txt 2>/dev/null
AGE_PUBLIC_KEY=$(grep "# public key:" age.txt | cut -d: -f2 | tr -d ' ')
AGE_SECRET_KEY=$(grep "AGE-SECRET-KEY-" age.txt)

# Test encrypting a small value (should not compress, uses simplified TOML format)
PAKRO_EXPERIMENTAL=true pakro set SMALL_SECRET="my-secret-value" --age-encrypt --age-recipient "$AGE_PUBLIC_KEY"
assert_contains "cat pakro.toml" 'SMALL_SECRET = { age = "'
assert_not_contains "cat pakro.toml" 'format ='

# Test decrypting the value with pakro set
RESULT=$(PAKRO_EXPERIMENTAL=true PAKRO_AGE_KEY="$AGE_SECRET_KEY" pakro set SMALL_SECRET)
assert "echo $RESULT" "my-secret-value"

# Test decrypting in env resolution with pakro env
assert_contains "PAKRO_EXPERIMENTAL=true PAKRO_AGE_KEY=\"$AGE_SECRET_KEY\" pakro env -s bash | grep SMALL_SECRET" "export SMALL_SECRET=my-secret-value"

# Test pakro env shows decrypted value in list format
ENV_OUTPUT=$(PAKRO_EXPERIMENTAL=true PAKRO_AGE_KEY="$AGE_SECRET_KEY" pakro env)
assert_contains "echo '$ENV_OUTPUT'" "SMALL_SECRET=my-secret-value"

# Test encrypting a large value (should compress, uses complex TOML format)
LARGE_VALUE=$(python3 -c 'print("x" * 2000)')
PAKRO_EXPERIMENTAL=true pakro set LARGE_SECRET="$LARGE_VALUE" --age-encrypt --age-recipient "$AGE_PUBLIC_KEY"
assert_contains "cat pakro.toml" 'LARGE_SECRET = { age = { value ='
assert_contains "cat pakro.toml" 'format = "zstd"'

# Test decrypting the large value with pakro set
RESULT=$(PAKRO_EXPERIMENTAL=true PAKRO_AGE_KEY="$AGE_SECRET_KEY" pakro set LARGE_SECRET | head -c 10)
assert "echo $RESULT" "xxxxxxxxxx"

# Test large value decryption in pakro env
assert_contains "PAKRO_EXPERIMENTAL=true PAKRO_AGE_KEY=\"$AGE_SECRET_KEY\" pakro env -s bash | grep LARGE_SECRET" "export LARGE_SECRET=$LARGE_VALUE"

# Test pakro env with multiple encrypted variables
PAKRO_EXPERIMENTAL=true pakro set ANOTHER_SECRET="another-value" --age-encrypt --age-recipient "$AGE_PUBLIC_KEY"
ENV_BASH=$(PAKRO_EXPERIMENTAL=true PAKRO_AGE_KEY="$AGE_SECRET_KEY" pakro env -s bash)
assert_contains "echo '$ENV_BASH'" "export SMALL_SECRET=my-secret-value"
assert_contains "echo '$ENV_BASH'" "export ANOTHER_SECRET=another-value"

# Test with multiple recipients
rm -f age2.txt
# Temporarily move pakro.toml to avoid decryption errors when running pakro x
mv pakro.toml pakro.toml.tmp
pakro x age -- age-keygen -o age2.txt 2>/dev/null
mv pakro.toml.tmp pakro.toml
if [ ! -f age2.txt ]; then
  echo "age2.txt not found after generation"
  exit 1
fi
AGE_PUBLIC_KEY2=$(grep "# public key:" age2.txt | cut -d: -f2 | tr -d ' ')
AGE_SECRET_KEY2=$(grep "AGE-SECRET-KEY-" age2.txt)

PAKRO_EXPERIMENTAL=true pakro set MULTI_SECRET="multi-recipient-secret" --age-encrypt \
  --age-recipient "$AGE_PUBLIC_KEY" \
  --age-recipient "$AGE_PUBLIC_KEY2"

# Both keys should be able to decrypt via pakro set
RESULT=$(PAKRO_EXPERIMENTAL=true PAKRO_AGE_KEY="$AGE_SECRET_KEY" pakro set MULTI_SECRET)
assert "echo $RESULT" "multi-recipient-secret"

RESULT=$(PAKRO_EXPERIMENTAL=true PAKRO_AGE_KEY="$AGE_SECRET_KEY2" pakro set MULTI_SECRET)
assert "echo $RESULT" "multi-recipient-secret"

# Both keys should be able to decrypt via pakro env
assert_contains "PAKRO_EXPERIMENTAL=true PAKRO_AGE_KEY=\"$AGE_SECRET_KEY\" pakro env | grep MULTI_SECRET" "MULTI_SECRET=multi-recipient-secret"

# Test second key with clean environment (only multi-recipient variable)
rm -f pakro.toml
PAKRO_EXPERIMENTAL=true pakro set MULTI_SECRET="multi-recipient-secret" --age-encrypt \
  --age-recipient "$AGE_PUBLIC_KEY" \
  --age-recipient "$AGE_PUBLIC_KEY2"
assert_contains "PAKRO_EXPERIMENTAL=true PAKRO_AGE_KEY=\"$AGE_SECRET_KEY2\" pakro env | grep MULTI_SECRET" "MULTI_SECRET=multi-recipient-secret"

# Test with age key file
cat <<EOF >~/.config/pakro/age.txt
$AGE_SECRET_KEY
EOF

PAKRO_EXPERIMENTAL=true pakro set KEY_FILE_SECRET="key-file-secret" --age-encrypt --age-key-file age.txt
RESULT=$(PAKRO_EXPERIMENTAL=true pakro set KEY_FILE_SECRET)
assert "echo $RESULT" "key-file-secret"

# Test key file decryption in pakro env
assert_contains "PAKRO_EXPERIMENTAL=true pakro env | grep KEY_FILE_SECRET" "KEY_FILE_SECRET=key-file-secret"

# Test SSH recipient (if SSH key exists)
if [ -f ~/.ssh/id_ed25519.pub ]; then
  PAKRO_EXPERIMENTAL=true pakro set SSH_SECRET="ssh-encrypted-secret" --age-encrypt --age-ssh-recipient ~/.ssh/id_ed25519.pub

  # Decrypt with SSH key via pakro set
  if command -v age >/dev/null 2>&1; then
    # Only test if age CLI is available
    RESULT=$(PAKRO_EXPERIMENTAL=true pakro set SSH_SECRET)
    assert_contains "echo $RESULT" "ssh-encrypted-secret"

    # Test SSH key decryption in pakro env
    assert_contains "PAKRO_EXPERIMENTAL=true pakro env | grep SSH_SECRET" "SSH_SECRET=ssh-encrypted-secret"
  fi
fi

# Test default recipient behavior (uses age.txt if available)
rm -f pakro.toml
cat <<EOF >~/.config/pakro/age.txt
$AGE_SECRET_KEY
EOF

# Should work with defaults when age.txt exists
PAKRO_EXPERIMENTAL=true pakro set DEFAULT_SECRET="uses-default-key" --age-encrypt
RESULT=$(PAKRO_EXPERIMENTAL=true pakro set DEFAULT_SECRET)
assert "echo $RESULT" "uses-default-key"

# Test default key decryption in pakro env
assert_contains "PAKRO_EXPERIMENTAL=true pakro env | grep DEFAULT_SECRET" "DEFAULT_SECRET=uses-default-key"

# Test error cases

# Invalid recipient
assert_fail "PAKRO_EXPERIMENTAL=true pakro set INVALID=value --age-encrypt --age-recipient invalid-key"

# No recipients available (remove defaults)
rm -f ~/.config/pakro/age.txt
assert_fail "PAKRO_EXPERIMENTAL=true pakro set NO_RECIPIENT=value --age-encrypt"

# Decryption without key (strict mode should fail)
rm -f ~/.config/pakro/age.txt # Remove default key
PAKRO_EXPERIMENTAL=true pakro set ENCRYPTED_VALUE="encrypted" --age-encrypt --age-recipient "$AGE_PUBLIC_KEY"
# In strict mode, should fail when no key is available
assert_fail "PAKRO_EXPERIMENTAL=true pakro set ENCRYPTED_VALUE"

# Test that pakro env also fails when no key available (with encrypted values present)
assert_fail "PAKRO_EXPERIMENTAL=true pakro env"

# Test mixed encrypted and plain values in pakro env
rm -f pakro.toml
cat <<EOF >~/.config/pakro/age.txt
$AGE_SECRET_KEY
EOF

PAKRO_EXPERIMENTAL=true pakro set PLAIN_VAR="plain-value"
PAKRO_EXPERIMENTAL=true pakro set ENCRYPTED_VAR="encrypted-value" --age-encrypt --age-recipient "$AGE_PUBLIC_KEY"

# Test pakro env shows both correctly
ENV_ALL=$(PAKRO_EXPERIMENTAL=true pakro env)
assert_contains "echo '$ENV_ALL'" "PLAIN_VAR=plain-value"
assert_contains "echo '$ENV_ALL'" "ENCRYPTED_VAR=encrypted-value"

# Test shell-specific output formats
ENV_BASH=$(PAKRO_EXPERIMENTAL=true pakro env -s bash)
assert_contains "echo '$ENV_BASH'" "export PLAIN_VAR=plain-value"
assert_contains "echo '$ENV_BASH'" "export ENCRYPTED_VAR=encrypted-value"

ENV_FISH=$(PAKRO_EXPERIMENTAL=true pakro env -s fish)
assert_contains "echo '$ENV_FISH'" "set -gx PLAIN_VAR plain-value"
assert_contains "echo '$ENV_FISH'" "set -gx ENCRYPTED_VAR encrypted-value"

# Test --prompt flag with age encryption
rm -f pakro.toml
cat <<EOF >~/.config/pakro/age.txt
$AGE_SECRET_KEY
EOF

# Test that --prompt works even when variable doesn't exist yet
# This simulates: pakro set --age-encrypt PROMPT_SECRET --prompt
# User would enter "prompt-value" when prompted
echo "prompt-value" | PAKRO_EXPERIMENTAL=true pakro set --age-encrypt PROMPT_SECRET --prompt
RESULT=$(PAKRO_EXPERIMENTAL=true pakro set PROMPT_SECRET)
assert "echo $RESULT" "prompt-value"

# Verify it's actually encrypted in the file
assert_contains "cat pakro.toml" 'PROMPT_SECRET = { age = "'

# Test that --prompt works even when variable already exists
# This should re-prompt and overwrite
echo "new-prompt-value" | PAKRO_EXPERIMENTAL=true pakro set --age-encrypt PROMPT_SECRET --prompt
RESULT=$(PAKRO_EXPERIMENTAL=true pakro set PROMPT_SECRET)
assert "echo $RESULT" "new-prompt-value"
