#!/usr/bin/env bash

# Test 1: node defined before npm — shim should use explicit npm
cat >pakro.toml <<EOF
[tools]
node = "20.10.0"
npm = "10.9.0"
EOF

pakro install
pakro reshim
assert_contains "$PAKRO_DATA_DIR/shims/npm --version" "10.9.0"

# Test 2: npm defined before node — shim should still use explicit npm
cat >pakro.toml <<EOF
[tools]
npm = "10.9.0"
node = "20.10.0"
EOF

pakro install
pakro reshim
assert_contains "$PAKRO_DATA_DIR/shims/npm --version" "10.9.0"

# Test 3: a missing explicit npm is installed before falling back to Node's bundled npm
pakro uninstall npm@10.9.0
assert_contains "$PAKRO_DATA_DIR/shims/npm --version" "10.9.0"
assert_contains "pakro ls npm --installed" "10.9.0"
