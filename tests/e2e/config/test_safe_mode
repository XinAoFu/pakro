#!/usr/bin/env bash

# Test PAKRO_SAFE=1 (safe mode): a hard boundary against repo-controlled code
# execution. In safe mode, project (non-global) config `[env]`, `_.path`, and
# `_.source` are ignored entirely — they would otherwise be applied to the host
# environment and to subprocesses pakro spawns, an indirect code-execution
# vector (PATH, LD_PRELOAD, ...). Hooks, tasks, asdf plugin scripts, and plugin
# installation are refused. HTTP-backed version resolution keeps working.

export PAKRO_LOCKFILE=1

echo "=== project [env] (incl. exec/LD_PRELOAD/_.path) is ignored in safe mode ==="
cat <<'EOF' >pakro.toml
[env]
PLAIN = "value"
EVIL = "pwned"
LD_PRELOAD = "/tmp/evil.so"
FROM_EXEC = "{{ exec(command='echo pwned') }}"
_.path = ["/tmp/evilbin"]
EOF
# without safe mode, project env is applied (exec evaluated)
assert_contains "pakro env" "export PLAIN=value"
assert_contains "pakro env" "export FROM_EXEC=pwned"
assert_contains "pakro env" "/tmp/evilbin"
# in safe mode the whole project [env] block is inert: nothing set, no exec, no error
assert_not_contains "PAKRO_SAFE=1 pakro env" "PLAIN"
assert_not_contains "PAKRO_SAFE=1 pakro env" "EVIL"
assert_not_contains "PAKRO_SAFE=1 pakro env" "LD_PRELOAD"
assert_not_contains "PAKRO_SAFE=1 pakro env" "FROM_EXEC"
assert_not_contains "PAKRO_SAFE=1 pakro env" "/tmp/evilbin"

echo "=== _.source is ignored in safe mode (inert, not executed) ==="
echo 'export BAZ=frombash' >env.sh
cat <<'EOF' >pakro.toml
[env]
_.source = "env.sh"
EOF
assert_contains "pakro env" "export BAZ=frombash"
assert_not_contains "PAKRO_SAFE=1 pakro env" "BAZ"

# _.source is code execution, so even operator-owned global config is inert
# (it must not error, unlike a plain refused directive).
mkdir -p .config/pakro
echo 'export GLOBAL_SOURCED=yes' >global-env.sh
cat <<EOF >".config/pakro/config.toml"
[env]
GLOBAL_KEPT = "yes"
_.source = "$PWD/global-env.sh"
EOF
rm -f pakro.toml
# global [env] applies in safe mode, but global _.source is inert and does not error
assert_contains "PAKRO_GLOBAL_CONFIG_FILE=$PWD/.config/pakro/config.toml PAKRO_SAFE=1 pakro env" "GLOBAL_KEPT"
assert_not_contains "PAKRO_GLOBAL_CONFIG_FILE=$PWD/.config/pakro/config.toml PAKRO_SAFE=1 pakro env" "GLOBAL_SOURCED"
rm -rf .config global-env.sh

echo "=== tasks are refused ==="
cat <<'EOF' >pakro.toml
[tasks.hello]
run = "echo hello"
EOF
assert_fail "PAKRO_SAFE=1 pakro run hello" "running tasks is disabled in safe mode (PAKRO_SAFE=1)"
assert_contains "pakro run hello" "hello"

echo "=== hooks are skipped ==="
cat <<'EOF' >pakro.toml
[hooks]
enter = "echo HOOK_RAN"
EOF
assert_not_contains "PAKRO_SAFE=1 pakro hook-env -s bash" "HOOK_RAN"

echo "=== project shell aliases are dropped in safe mode ==="
cat <<'EOF' >pakro.toml
[shell_alias]
evilalias = "rm -rf ~"
EOF
# emitted through hook-env normally, dropped in safe mode
assert_contains "pakro hook-env -s bash" "evilalias"
assert_not_contains "PAKRO_SAFE=1 pakro hook-env -s bash" "evilalias"

echo "=== project [settings] are ignored in safe mode ==="
cat <<'EOF' >pakro.toml
[settings]
jobs = 7
EOF
assert "pakro settings get jobs" "7"
assert_not_contains "PAKRO_SAFE=1 pakro settings get jobs" "7"

echo "=== asdf plugin scripts are refused ==="
cat <<'EOF' >pakro.toml
[tools]
dummy = "1"
EOF
assert_fail "PAKRO_SAFE=1 pakro latest dummy" "executing asdf plugin scripts is disabled in safe mode (PAKRO_SAFE=1)"
# without safe mode the same command works
assert "pakro latest dummy" "2.0.0"

echo "=== plugin installation is refused ==="
assert_fail "PAKRO_SAFE=1 pakro plugins install tiny https://github.com/mise-plugins/mise-tiny" "installing plugins is disabled in safe mode (PAKRO_SAFE=1)"

echo "=== tool-level install options are refused before installation ==="
cat <<'EOF' >pakro.toml
[tools]
"http:safe-install" = { version = "1.0.0", url = "https://example.invalid/archive.tar.gz", postinstall = "touch postinstall-ran" }
EOF
assert_fail "PAKRO_SAFE=1 pakro install --force" "running tool-level postinstall hooks for http:safe-install is disabled in safe mode (PAKRO_SAFE=1)"
assert_fail "test -e postinstall-ran"
assert_fail "PAKRO_SAFE=1 pakro install-into http:safe-install@1.0.0 safe-install-into" "running tool-level postinstall hooks for http:safe-install is disabled in safe mode (PAKRO_SAFE=1)"
assert_fail "test -e safe-install-into"

cat <<'EOF' >pakro.toml
[tools]
"http:safe-install" = { version = "1.0.0", url = "https://example.invalid/archive.tar.gz", postinstall = { run = "touch postinstall-ran", when = "always" } }
EOF
assert_fail "PAKRO_SAFE=1 pakro install --force" "running tool-level postinstall hooks for http:safe-install is disabled in safe mode (PAKRO_SAFE=1)"
assert_fail "test -e postinstall-ran"

cat <<'EOF' >pakro.toml
[tools]
"http:safe-install" = { version = "1.0.0", url = "https://example.invalid/archive.tar.gz", install_env = { BASH_ENV = "./untrusted.sh" } }
EOF
assert_fail "PAKRO_SAFE=1 pakro install --force" "using tool-level install_env for http:safe-install is disabled in safe mode (PAKRO_SAFE=1)"
assert_fail "PAKRO_SAFE=1 pakro install-into http:safe-install@1.0.0 safe-install-into" "using tool-level install_env for http:safe-install is disabled in safe mode (PAKRO_SAFE=1)"
assert_fail "test -e safe-install-into"

# Note: safe mode also skips the trust requirement (trust_check returns Ok when
# `safe` is set). That isn't exercised here because the e2e harness auto-trusts
# the workdir (PAKRO_TRUSTED_CONFIG_PATHS) and applies CI-implicit trust, so a
# genuinely untrusted config can't be simulated reliably; see the unit-level
# behavior and PR notes.
