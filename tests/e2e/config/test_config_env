#!/usr/bin/env bash
# shellcheck disable=SC2209

echo "tools.dummy = '1'" >pakro.toml
echo "tools.dummy = '2'" >pakro.test.toml
echo "tools.dummy = '3'" >pakro.ci.toml

assert "pakro ls dummy" "dummy  1.1.0 (missing)  ~/workdir/pakro.toml  1"
PAKRO_ENV=test assert "pakro ls dummy" "dummy  2.0.0 (missing)  ~/workdir/pakro.test.toml  2"
PAKRO_ENV=ci assert "pakro ls dummy" "dummy  3 (missing)  ~/workdir/pakro.ci.toml  3"
PAKRO_ENV=ci,test assert "pakro ls dummy" "dummy  2.0.0 (missing)  ~/workdir/pakro.test.toml  2"
PAKRO_ENV=test,ci assert "pakro ls dummy" "dummy  3 (missing)  ~/workdir/pakro.ci.toml  3"

# Dotted conf.d fragments remain unconditional by default during migration.
mkdir -p .pakro/conf.d
cat >.pakro/conf.d/00-base.toml <<'EOF'
[env]
CONF_D_COMMON = "base"
CONF_D_ENV = "base"
EOF
cat >.pakro/conf.d/01-local.local.toml <<'EOF'
[env]
CONF_D_ALWAYS_LOCAL = "local"
EOF
cat >.pakro/conf.d/10-test.test.toml <<'EOF'
[env]
CONF_D_ENV = "test"
CONF_D_ENV_LOCAL = "test"
EOF
cat >.pakro/conf.d/11-test-local.test.local.toml <<'EOF'
[env]
CONF_D_ENV_LOCAL = "test-local"
EOF
cat >.pakro/conf.d/20-ci.ci.toml <<'EOF'
[env]
CONF_D_ENV = "ci"
EOF
cat >.pakro/conf.d/99-inactive.inactive.toml <<'EOF'
[env]
CONF_D_INACTIVE = "loaded"
EOF
mkdir -p pakro/conf.d
cat >pakro/conf.d/00-visible.toml <<'EOF'
[env]
VISIBLE_CONF_D_COMMON = "visible"
EOF
cat >pakro/conf.d/10-visible-test.test.toml <<'EOF'
[env]
VISIBLE_CONF_D_ENV = "test"
EOF

assert_contains "pakro env 2>&1" "deprecated [dotted_conf_d_filename]"
assert_not_contains "PAKRO_ENV_CONF_D=false pakro env 2>&1" "deprecated [dotted_conf_d_filename]"
assert "pakro env --json | jq -r '[.CONF_D_COMMON, .CONF_D_ENV, .CONF_D_ALWAYS_LOCAL, .CONF_D_INACTIVE] | @tsv'" $'base\tci\tlocal\tloaded'
PAKRO_ENV=test assert "pakro env --json | jq -r '[.CONF_D_ENV, .CONF_D_ENV_LOCAL, .CONF_D_INACTIVE] | @tsv'" $'ci\ttest-local\tloaded'

# Users can opt into environment-specific conf.d filenames immediately.
PAKRO_ENV_CONF_D=true assert "pakro env --json | jq -r '[.CONF_D_COMMON, .CONF_D_ENV, .CONF_D_ALWAYS_LOCAL, .CONF_D_INACTIVE] | @tsv'" $'base\tbase\tlocal\t'
PAKRO_ENV_CONF_D=true PAKRO_ENV=test assert "pakro env --json | jq -r '[.CONF_D_ENV, .CONF_D_ENV_LOCAL, .CONF_D_INACTIVE] | @tsv'" $'test\ttest-local\t'
PAKRO_ENV_CONF_D=true PAKRO_ENV=test,ci assert "pakro env --json | jq -r '[.CONF_D_ENV, .CONF_D_ENV_LOCAL] | @tsv'" $'ci\ttest-local'
PAKRO_ENV_CONF_D=true assert "pakro env --json | jq -r '[.VISIBLE_CONF_D_COMMON, .VISIBLE_CONF_D_ENV] | @tsv'" $'visible\t'
PAKRO_ENV_CONF_D=true PAKRO_ENV=test assert "pakro env --json | jq -r '[.VISIBLE_CONF_D_COMMON, .VISIBLE_CONF_D_ENV] | @tsv'" $'visible\ttest'

# Environment names are matched literally and by the complete suffix after the first dot
cat >'.pakro/conf.d/30-literal.qa*.toml' <<'EOF'
[env]
CONF_D_LITERAL = "literal"
EOF
cat >.pakro/conf.d/31-unrelated.qa1.toml <<'EOF'
[env]
CONF_D_UNRELATED = "loaded"
EOF
cat >.pakro/conf.d/40-dotted.qa.prod.toml <<'EOF'
[env]
CONF_D_DOTTED = "dotted"
EOF
cat >.pakro/conf.d/41-prod.prod.toml <<'EOF'
[env]
CONF_D_PROD = "prod"
EOF

PAKRO_ENV_CONF_D=true PAKRO_ENV='qa*' assert "pakro env --json | jq -r '[.CONF_D_LITERAL, .CONF_D_UNRELATED] | @tsv'" $'literal\t'
PAKRO_ENV_CONF_D=true PAKRO_ENV=prod assert "pakro env --json | jq -r '[.CONF_D_DOTTED, .CONF_D_PROD] | @tsv'" $'\tprod'
PAKRO_ENV_CONF_D=true PAKRO_ENV=qa.prod assert "pakro env --json | jq -r '[.CONF_D_DOTTED, .CONF_D_PROD] | @tsv'" $'dotted\t'
