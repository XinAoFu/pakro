#!/usr/bin/env bash

# Test auto_env: platform environments (unix, {os}, {os}-{arch}) are
# automatically active for config file discovery when enabled

os="$(uname -s)"
case "$os" in
  Darwin) os=macos ;;
  Linux) os=linux ;;
esac
arch="$(uname -m)"
case "$arch" in
  x86_64) arch=x64 ;;
  aarch64 | arm64) arch=arm64 ;;
esac

echo 'env.AAA = "base"
env.BBB = "base"' >pakro.toml
echo 'env.AAA = "unix"
env.UNIX_LOADED = "1"' >pakro.unix.toml
echo "env.AAA = \"$os\"" >"pakro.$os.toml"
echo "env.AAA = \"$os-$arch\"" >"pakro.$os-$arch.toml"
echo 'env.AAA = "prod"' >pakro.prod.toml
mkdir -p .pakro/conf.d
echo 'env.CONF_D_AUTO = "base"' >.pakro/conf.d/00-base.toml
echo 'env.CONF_D_AUTO = "unix"' >.pakro/conf.d/10-platform.unix.toml
echo "env.CONF_D_AUTO = \"$os\"" >".pakro/conf.d/20-platform.$os.toml"
echo "env.CONF_D_AUTO = \"$os-$arch\"" >".pakro/conf.d/30-platform.$os-$arch.toml"
export PAKRO_ENV_CONF_D=true

# default: off, platform configs are not loaded
assert "pakro env --json | jq -r .AAA" "base"
assert "pakro env --json | jq -r .CONF_D_AUTO" "base"

# the rollout warning never fires once the user has set auto_env explicitly,
# regardless of the phase the current version is in (the version-gated unset
# case is covered by the should_warn_auto_env unit tests)
assert_not_contains "PAKRO_AUTO_ENV=false pakro env 2>&1" "load automatically"
assert_not_contains "PAKRO_AUTO_ENV=true pakro env 2>&1" "load automatically"

# opt in: all platform configs load, most specific wins (unix < os < os-arch)
PAKRO_AUTO_ENV=true assert "pakro env --json | jq -r .AAA" "$os-$arch"
PAKRO_AUTO_ENV=true assert "pakro env --json | jq -r .UNIX_LOADED" "1"
PAKRO_AUTO_ENV=true assert "pakro env --json | jq -r .BBB" "base"
PAKRO_AUTO_ENV=true assert "pakro env --json | jq -r .CONF_D_AUTO" "$os-$arch"

# explicit PAKRO_ENV entries take precedence over auto platform envs
PAKRO_AUTO_ENV=true PAKRO_ENV=prod assert "pakro env --json | jq -r .AAA" "prod"

# explicit PAKRO_ENV listing a platform env dedupes (file loaded once) and
# keeps its user-specified (higher) precedence
PAKRO_AUTO_ENV=true PAKRO_ENV=$os assert "pakro env --json | jq -r .AAA" "$os"
PAKRO_AUTO_ENV=true PAKRO_ENV=$os assert "pakro config ls | grep -c \"pakro.$os.toml\"" "1"

# explicit opt-out
PAKRO_AUTO_ENV=false assert "pakro env --json | jq -r .AAA" "base"

# auto envs are not added to PAKRO_ENV itself: {{ pakro_env }} and PAKRO_ENV
# propagation to subprocesses only reflect explicit environments
cat <<'EOF' >>pakro.toml
[tasks.print]
run = '{% if pakro_env %}echo {{pakro_env}}{% endif %}'
EOF
PAKRO_AUTO_ENV=true assert "pakro run print" ""
PAKRO_AUTO_ENV=true PAKRO_ENV=prod assert "pakro run print" "[prod]"

# auto_env can be enabled via .pakrorc.toml
echo 'auto_env = true' >.pakrorc.toml
assert "pakro env --json | jq -r .AAA" "$os-$arch"
# env var overrides .pakrorc.toml
PAKRO_AUTO_ENV=false assert "pakro env --json | jq -r .AAA" "base"
rm -f .pakrorc.toml

# global config dir platform configs load too
mkdir -p "$PAKRO_CONFIG_DIR"
echo "env.GLOBAL_AUTO = \"$os\"" >"$PAKRO_CONFIG_DIR/config.$os.toml"
mkdir -p "$PAKRO_CONFIG_DIR/conf.d"
echo "env.GLOBAL_CONF_D_AUTO = \"$os\"" >"$PAKRO_CONFIG_DIR/conf.d/10-platform.$os.toml"
PAKRO_AUTO_ENV=true assert "pakro env --json | jq -r .GLOBAL_AUTO" "$os"
PAKRO_AUTO_ENV=true assert "pakro env --json | jq -r .GLOBAL_CONF_D_AUTO" "$os"
assert "pakro env --json | jq -r .GLOBAL_AUTO" "null"
assert "pakro env --json | jq -r .GLOBAL_CONF_D_AUTO" "null"
rm -f "$PAKRO_CONFIG_DIR/config.$os.toml"
