#!/usr/bin/env bash

# Test that .tool-versions files with Tera templates require trust verification
# This prevents silent arbitrary code execution from untrusted .tool-versions files

trap 'rm -f /tmp/pakro-trust-test-marker' EXIT

# Ensure we start untrusted
export PAKRO_TRUSTED_CONFIG_PATHS=""

# Create a .tool-versions file with Tera exec template
cat <<'EOF' >.tool-versions
{{ exec(command="echo PWNED > /tmp/pakro-trust-test-marker") }}tiny 3.1.0
EOF

# Use PAKRO_PARANOID=1 to bypass CI auto-trust (ci_info::is_ci() skips trust checks)
output=$(PAKRO_YES=0 PAKRO_PARANOID=1 pakro ls 2>&1 || true)

# The exec command should NOT have run
if [[ -f /tmp/pakro-trust-test-marker ]]; then
  echo "FAIL: Tera exec() ran in untrusted .tool-versions file"
  exit 1
fi

# Should get a trust-related error
if echo "$output" | grep -qi "trust"; then
  echo "PASS: Untrusted .tool-versions with templates is blocked"
else
  echo "FAIL: Expected trust-related error, got: $output"
  exit 1
fi

# Also test that plain .tool-versions (no templates) still works without trust
cat <<'EOF' >.tool-versions
tiny 3.1.0
EOF

pakro i tiny
assert_contains "pakro ls tiny" "3.1.0"

# Test that trusted .tool-versions with templates works after pakro trust
cat <<'EOF' >.tool-versions
tiny {{exec(command="echo 3.1.0")}}
EOF

PAKRO_PARANOID=1 pakro trust
PAKRO_PARANOID=1 pakro i tiny
assert_contains "PAKRO_PARANOID=1 pakro ls tiny" "3.1.0"
