#!/usr/bin/env bash

TOMBI_VERSION="0.9.22"

pakro use -g tombi@$TOMBI_VERSION

SCHEMA_PATH="$ROOT/src/schema/pakro.json"
TASK_SCHEMA_PATH="$ROOT/src/schema/pakro-task.json"
TOMBI="pakro x tombi@$TOMBI_VERSION -- tombi"
TOMBI_LINT="$TOMBI lint --offline --no-cache --error-on-warnings --quiet"
assert_contains "$TOMBI --version" "tombi $TOMBI_VERSION"

cat >"$HOME/tombi.toml" <<EOF
toml-version = "v1.0.0"

[schema]
enabled = true
strict = true

[[schemas]]
path = "file://$SCHEMA_PATH"
include = ["pakro-tool-selectors.toml", "pakro-bad-tool-selectors.toml"]

[[schemas]]
path = "file://$TASK_SCHEMA_PATH"
include = ["pakro-task-tool-selectors.toml", "pakro-bad-task-tool-selectors.toml"]
EOF

cat >"$HOME/workdir/pakro-tool-selectors.toml" <<'TOML'
[tools]
node = { version = "20" }
go = { prefix = "1.22" }
python = { ref = "main" }
shellcheck = { path = "/opt/shellcheck" }
ruby = [{ prefix = "3.3", os = "linux-x64" }]

[tasks.check]
run = "echo check"

[tasks.check.tools]
node = { version = "20", backend_options = { nested = [1, true] } }
go = { prefix = "1.22" }
python = { ref = "main" }
shellcheck = { path = "/opt/shellcheck" }
TOML

cd "$HOME/workdir"
assert_succeed "$TOMBI_LINT pakro-tool-selectors.toml"

cat >pakro-task-tool-selectors.toml <<'TOML'
[check]
run = "echo check"

[check.tools]
node = { version = "20", backend_options = { nested = [1, true] } }
go = { prefix = "1.22" }
python = { ref = "main" }
shellcheck = { path = "/opt/shellcheck" }
TOML
assert_succeed "$TOMBI_LINT pakro-task-tool-selectors.toml"

cat >pakro-bad-tool-selectors.toml <<'TOML'
[tools]
node = { version = "20", prefix = "20" }
TOML
assert_fail "$TOMBI_LINT pakro-bad-tool-selectors.toml"

cat >pakro-bad-task-tool-selectors.toml <<'TOML'
[check]
run = "echo check"

[check.tools]
node = { version = "20", prefix = "20" }
TOML
assert_fail "$TOMBI_LINT pakro-bad-task-tool-selectors.toml"

cat >pakro-bad-task-tool-selectors.toml <<'TOML'
[check]
run = "echo check"

[check.tools]
node = { os = "linux" }
TOML
assert_fail "$TOMBI_LINT pakro-bad-task-tool-selectors.toml"

cat >pakro-bad-task-tool-selectors.toml <<'TOML'
[check]
run = "echo check"

[check.tools]
node = { prefix = 20 }
TOML
assert_fail "$TOMBI_LINT pakro-bad-task-tool-selectors.toml"

cat >pakro-bad-tool-selectors.toml <<'TOML'
[tools]
node = [{ path = "/opt/node", ref = "main" }]
TOML
assert_fail "$TOMBI_LINT pakro-bad-tool-selectors.toml"

cat >pakro-bad-tool-selectors.toml <<'TOML'
[tasks.check]
run = "echo check"

[tasks.check.tools]
node = { version = "20", prefix = "20" }
TOML
assert_fail "$TOMBI_LINT pakro-bad-tool-selectors.toml"

cat >pakro-bad-tool-selectors.toml <<'TOML'
[tasks.check]
run = "echo check"

[tasks.check.tools]
node = { os = "linux" }
TOML
assert_fail "$TOMBI_LINT pakro-bad-tool-selectors.toml"
