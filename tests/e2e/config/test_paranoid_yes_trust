#!/usr/bin/env bash

export PAKRO_TRUSTED_CONFIG_PATHS=""

cat <<'EOF' >pakro.toml
[env]
PARANOID_TRUST_TEST = "original"
EOF

assert_contains "PAKRO_PARANOID=1 pakro trust --show" ": untrusted"

# Neither an environment-provided yes nor the CLI flag may approve a new file.
assert_fail_contains "PAKRO_PARANOID=1 PAKRO_YES=1 pakro env 2>&1" "not trusted"
assert_contains "PAKRO_PARANOID=1 pakro trust --show" ": untrusted"
assert_fail_contains "PAKRO_PARANOID=1 PAKRO_YES=0 pakro -y env 2>&1" "not trusted"
assert_contains "PAKRO_PARANOID=1 pakro trust --show" ": untrusted"

assert "PAKRO_PARANOID=1 pakro trust"
assert_contains "PAKRO_PARANOID=1 pakro trust --show" ": trusted"

cat <<'EOF' >pakro.toml
[env]
PARANOID_TRUST_TEST = "edited"
EOF

assert_contains "PAKRO_PARANOID=1 pakro trust --show" ": untrusted"
assert_fail_contains "PAKRO_PARANOID=1 PAKRO_YES=1 pakro env 2>&1" "not trusted"
assert_contains "PAKRO_PARANOID=1 pakro trust --show" ": untrusted"

# CI's automatic yes decision must not refresh the content-bound trust record.
assert_fail_contains "env -u PAKRO_YES CI=1 PAKRO_PARANOID=1 pakro env 2>&1" "not trusted"
assert_contains "PAKRO_PARANOID=1 pakro trust --show" ": untrusted"

assert "PAKRO_PARANOID=1 pakro trust"
assert_contains "PAKRO_PARANOID=1 pakro env" "PARANOID_TRUST_TEST=edited"
