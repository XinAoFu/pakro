#!/usr/bin/env bash

cat <<EOF >pakro.toml
[tools]
tiny = 'latest'
EOF

# Unset enable_tools should keep all tools enabled
unset PAKRO_ENABLE_TOOLS
assert_contains "pakro ls" "tiny"

# Empty values should not crash and should disable all tools
export PAKRO_ENABLE_TOOLS=""
pakro ls >/dev/null
assert_not_contains "pakro ls" "tiny"

export PAKRO_ENABLE_TOOLS="  "
pakro ls >/dev/null
assert_not_contains "pakro ls" "tiny"

# Explicit empty list in settings should disable all tools
cat <<EOF >pakro.toml
[tools]
tiny = 'latest'

[settings]
enable_tools = []
EOF

unset PAKRO_ENABLE_TOOLS
assert_not_contains "pakro ls" "tiny"

# Test with trailing comma
export PAKRO_ENABLE_TOOLS="tiny,"
assert_contains "pakro ls" "tiny"

# Test with comma-separated list with spaces
export PAKRO_ENABLE_TOOLS="tiny, dummy"
assert_contains "pakro ls" "tiny"
