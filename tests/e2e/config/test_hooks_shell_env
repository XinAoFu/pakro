#!/usr/bin/env bash

# Test that shell hooks receive environment variables
# (PAKRO_PROJECT_ROOT, PAKRO_CONFIG_ROOT, PAKRO_ORIGINAL_CWD)
# See: https://github.com/jdx/mise/discussions/4013
# See: https://github.com/jdx/mise/discussions/6054

cat <<EOF >pakro.toml
[hooks.enter]
shell = "bash"
script = 'echo SHELL_PROJECT_ROOT=\$PAKRO_PROJECT_ROOT'
EOF

# Initialize session
eval "$(pakro hook-env)"

# Leave workdir
cd ~ || exit 1
eval "$(pakro hook-env)"

# Re-enter to trigger enter hook - check that PAKRO_PROJECT_ROOT is exported
cd ~/workdir || exit 1

# The output should contain an export of PAKRO_PROJECT_ROOT before the script
assert_contains "pakro hook-env 2>&1" "PAKRO_PROJECT_ROOT"
assert_contains "pakro hook-env 2>&1" "PAKRO_CONFIG_ROOT"
