#!/usr/bin/env bash

# A safe (untrusted) pakro.toml is tracked and its tool pins remain visible
# through tracked-config reload paths like `pakro ls --all-sources`, even when
# invoked from a different directory. Regression: tracked-config loading used
# to skip any config without a trust marker, which safe configs don't create.

export PAKRO_TRUSTED_CONFIG_PATHS=""
unset CI GITHUB_ACTIONS GITHUB_ACTION 2>/dev/null || true

mkdir -p proj other
cat <<'EOF' >proj/pakro.toml
[tools]
tiny = "3.1.0"
EOF

# load the safe config so it is tracked, without creating a trust marker
(cd proj && PAKRO_YES=0 pakro ls)

# from an unrelated directory, the tracked safe config's pin is still listed
cd other || exit 1
assert_contains "PAKRO_YES=0 pakro ls --all-sources 2>&1" "proj/pakro.toml"
assert_contains "PAKRO_YES=0 pakro ls --all-sources 2>&1" "tiny"
