#!/usr/bin/env bash
# A folder inside conf.d is a config fragment with its own config root:
# conf.d/<name>/pakro.toml always loads, pakro.<env>.toml loads with that env,
# and relative paths resolve inside the folder.

# Project folder fragments
mkdir -p .pakro/conf.d/git .pakro/conf.d/.hidden
cat >.pakro/conf.d/01-file.toml <<'EOF'
[env]
FRAGMENT_ORDER = "file"
EOF
cat >.pakro/conf.d/git/pakro.toml <<'EOF'
[env]
FRAGMENT_ORDER = "folder"
GIT_ROOT = "{{ config_root }}"

[tasks.where]
run = "pwd"
EOF
cat >.pakro/conf.d/git/pakro.dev.toml <<'EOF'
[env]
GIT_ENV = "dev"
EOF
cat >.pakro/conf.d/.hidden/pakro.toml <<'EOF'
[env]
HIDDEN_FOLDER = "unexpected"
EOF

assert_contains "pakro config ls" ".pakro/conf.d/git/pakro.toml"
assert_not_contains "pakro config ls" ".pakro/conf.d/git/pakro.dev.toml"
assert_not_contains "pakro config ls" ".hidden"
# folders load after single-file fragments
assert_contains "pakro env -s bash" "FRAGMENT_ORDER=folder"
assert_contains "pakro env -s bash" "GIT_ROOT=$PWD/.pakro/conf.d/git"
assert_not_contains "pakro env -s bash" "GIT_ENV"
assert_not_contains "pakro env -s bash" "HIDDEN_FOLDER"
assert "pakro run --skip-tools where" "$PWD/.pakro/conf.d/git"

# a folder's task_config.includes resolve inside it, its file tasks run there,
# and it does not replace the project's default task directories
mkdir -p .pakro/tasks .pakro/conf.d/git/tasks
printf '#!/usr/bin/env bash\necho "project-task"\n' >.pakro/tasks/project-task
cat >.pakro/conf.d/git/tasks/git-file <<'EOF'
#!/usr/bin/env bash
echo "$PWD $PAKRO_CONFIG_ROOT"
EOF
chmod +x .pakro/tasks/project-task .pakro/conf.d/git/tasks/git-file
cat >>.pakro/conf.d/git/pakro.toml <<'EOF'

[task_config]
includes = ["tasks"]
EOF
assert "pakro run --skip-tools git-file" "$PWD/.pakro/conf.d/git $PWD/.pakro/conf.d/git"
assert "pakro run --skip-tools project-task" "project-task"
# a folder fragment has higher precedence than a single-file fragment
cat >>.pakro/conf.d/01-file.toml <<'EOF'

[tasks.where]
run = "echo file-fragment"
EOF
assert "pakro run --skip-tools where" "$PWD/.pakro/conf.d/git"

# a task a folder defines beats one from the enclosing root's default task
# directories, whether or not a single-file fragment sits beside the folder
mkdir -p shadow/.pakro/tasks shadow/.pakro/conf.d/folder
echo '[env]' >shadow/pakro.toml
cat >shadow/.pakro/tasks/shadowed <<'EOF'
#!/usr/bin/env bash
echo default-dir
EOF
chmod +x shadow/.pakro/tasks/shadowed
cat >shadow/.pakro/conf.d/folder/pakro.toml <<'EOF'
[tasks.shadowed]
run = "echo folder"
EOF
assert "cd shadow && pakro run --skip-tools shadowed" "folder"
echo '[env]' >shadow/.pakro/conf.d/00-file.toml
assert "cd shadow && pakro run --skip-tools shadowed" "folder"

# a metadata-only block in a folder still overlays a script from the
# enclosing root's default task directories, without the folder's defaults
cat >shadow/.pakro/tasks/described <<'EOF'
#!/usr/bin/env bash
echo "script $PWD"
EOF
chmod +x shadow/.pakro/tasks/described
cat >>shadow/.pakro/conf.d/folder/pakro.toml <<EOF

[task_config]
dir = "$PWD/shadow/.pakro/conf.d/folder"

[tasks.described]
description = "from the folder"
EOF
assert "cd shadow && pakro run --skip-tools described" "script $PWD/shadow"
assert_contains "cd shadow && pakro tasks ls" "from the folder"

# a block with only depends stands alone, so it still gets its folder's defaults
mkdir -p group/.pakro/conf.d/folder
cat >group/.pakro/conf.d/folder/pakro.toml <<'EOF'
[task_config]
global_inputs = ["in.txt"]

[tasks.a]
run = "echo a"

[tasks.group]
depends = ["a"]
EOF
assert_contains "cd group && PAKRO_EXPERIMENTAL=1 pakro tasks info group --json" "$PWD/group/.pakro/conf.d/folder/in.txt"

# task_config cascaded from a parent root still reaches a folder's tasks,
# including its excludes
mkdir -p cascade/child/.pakro/conf.d/frag/tasks
cat >cascade/wrap <<'EOF'
#!/usr/bin/env bash
echo wrapped
exec bash "$@"
EOF
chmod +x cascade/wrap
cat >cascade/pakro.toml <<EOF
[task_config]
cascade = true
shell = "$PWD/cascade/wrap -c"
excludes = ["child/.pakro/conf.d/frag/tasks/excluded"]
EOF
cat >cascade/child/.pakro/conf.d/frag/pakro.toml <<'EOF'
[task_config]
includes = ["tasks"]

[tasks.frag-shell]
run = "echo frag"
EOF
for t in kept excluded; do
  printf '#!/usr/bin/env bash\necho %s\n' "$t" >"cascade/child/.pakro/conf.d/frag/tasks/$t"
  chmod +x "cascade/child/.pakro/conf.d/frag/tasks/$t"
done
assert_contains "cd cascade/child && pakro tasks ls" "kept"
assert_not_contains "cd cascade/child && pakro tasks ls" "excluded"
assert "cd cascade/child && pakro run --skip-tools frag-shell" "wrapped
frag"

# and so does task_config cascaded from the folder's own project
mkdir -p enclosing/.pakro/conf.d/frag
cat >enclosing/pakro.toml <<EOF
[task_config]
cascade = true
shell = "$PWD/cascade/wrap -c"
EOF
cat >enclosing/.pakro/conf.d/frag/pakro.toml <<'EOF'
[tasks.enclosed-shell]
run = "echo enclosed"
EOF
assert "cd enclosing && pakro run --skip-tools enclosed-shell" "wrapped
enclosed"

# environment files inside a folder follow the usual rule
assert_contains "PAKRO_ENV=dev pakro config ls" ".pakro/conf.d/git/pakro.dev.toml"
assert_contains "PAKRO_ENV=dev pakro env -s bash" "GIT_ENV=dev"

# the project's own config still has higher precedence than every fragment
cat >.pakro/config.toml <<'EOF'
[env]
FRAGMENT_ORDER = "config"
EOF
assert_contains "pakro env -s bash" "FRAGMENT_ORDER=config"

# Global folder fragments keep relative sources and config_root inside the folder,
# including when the folder is a symlink into a dotfiles checkout.
mkdir -p "$HOME/dotfiles/shell/zsh" "$PAKRO_CONFIG_DIR/conf.d/dev-git"
echo "[user]" >"$PAKRO_CONFIG_DIR/conf.d/dev-git/gitconfig"
cat >"$PAKRO_CONFIG_DIR/conf.d/dev-git/pakro.toml" <<'EOF'
[env]
DEV_GIT_ROOT = "{{ config_root }}"

[dotfiles]
"~/.gitconfig" = "gitconfig"
EOF
echo "# zsh" >"$HOME/dotfiles/shell/zsh/zshrc"
cat >"$HOME/dotfiles/shell/zsh/pakro.dev.toml" <<'EOF'
[dotfiles]
"~/.zshrc" = "zshrc"
EOF
ln -s "$HOME/dotfiles/shell/zsh" "$PAKRO_CONFIG_DIR/conf.d/shell-zsh"

assert_contains "pakro env -s bash" "DEV_GIT_ROOT=$PAKRO_CONFIG_DIR/conf.d/dev-git"

# Global folder fragment tasks run in the folder too, with config_root and
# PAKRO_CONFIG_ROOT pointing at it, and leave the global tasks directory loaded.
mkdir -p "$PAKRO_CONFIG_DIR/tasks" "$PAKRO_CONFIG_DIR/conf.d/dev-git/tasks"
printf '#!/usr/bin/env bash\necho "global-task"\n' >"$PAKRO_CONFIG_DIR/tasks/global-task"
cat >"$PAKRO_CONFIG_DIR/conf.d/dev-git/tasks/dev-git-file" <<'EOF'
#!/usr/bin/env bash
echo "$PWD $PAKRO_CONFIG_ROOT"
EOF
chmod +x "$PAKRO_CONFIG_DIR/tasks/global-task" "$PAKRO_CONFIG_DIR/conf.d/dev-git/tasks/dev-git-file"
cat >>"$PAKRO_CONFIG_DIR/conf.d/dev-git/pakro.toml" <<'EOF'

[task_config]
includes = ["tasks"]

[tasks.dev-git-root]
run = 'echo "{{ config_root }}"'

[tasks.dev-git-pwd]
run = "pwd"
EOF
assert "pakro run --skip-tools dev-git-root" "$PAKRO_CONFIG_DIR/conf.d/dev-git"
assert "pakro run --skip-tools dev-git-pwd" "$PAKRO_CONFIG_DIR/conf.d/dev-git"
assert "pakro run --skip-tools dev-git-file" "$PAKRO_CONFIG_DIR/conf.d/dev-git $PAKRO_CONFIG_DIR/conf.d/dev-git"
assert "pakro run --skip-tools global-task" "global-task"
assert_contains "pakro bootstrap --dry-run" "conf.d/dev-git/gitconfig"
assert_not_contains "pakro bootstrap --dry-run" "zshrc"
assert_contains "PAKRO_ENV=dev pakro bootstrap --dry-run" "shell-zsh/zshrc"

# Folder fragments are never write targets, just like single-file fragments.
pakro set -g WRITE_TARGET=global
assert_contains "cat $PAKRO_CONFIG_DIR/config.toml" "WRITE_TARGET"
assert_not_contains "cat $PAKRO_CONFIG_DIR/conf.d/dev-git/pakro.toml" "WRITE_TARGET"
mkdir -p only-folder/.pakro/conf.d/tools
echo '[env]' >only-folder/.pakro/conf.d/tools/pakro.toml
pakro use --path only-folder dummy@system
assert_contains "cat only-folder/pakro.toml" "dummy"
assert_not_contains "cat only-folder/.pakro/conf.d/tools/pakro.toml" "dummy"
