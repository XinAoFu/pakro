#!/usr/bin/env bash

cat <<EOF >pakro.toml
[[env]]
A_PATH = "foo: {{ env.PATH }}"
B_PATH = { value = "foo: {{ env.PATH }}", tools = true }
[[env]]
_.path = {value = "tiny-{{env.JDXCODE_TINY}}-tiny", tools = true}

[tools]
tiny = "1.0.0"
EOF

pakro i
assert_not_contains "pakro env | grep A_PATH" "tiny"
assert_contains "pakro env | grep B_PATH" "tiny"

assert_contains "pakro dr path" "tiny-1.0.0-tiny"
