#!/usr/bin/env bash

# Test that config_root in hooks correctly points to the project root
# even when the config file is in a .pakro/ subdirectory
# See: https://github.com/jdx/mise/discussions/6531

# Create project structure with .pakro/config.toml
mkdir -p .pakro
cat <<EOF >.pakro/config.toml
[hooks]
enter = 'echo CONFIG_ROOT={{config_root}}'
EOF

# Initialize pakro and go to home first
eval "$(pakro hook-env)"

# Leave the workdir (go home)
cd ~ || exit 1
eval "$(pakro hook-env)"

# Now re-enter the workdir to trigger the enter hook
cd ~/workdir || exit 1

# The config_root should be ~/workdir, not ~/workdir/.pakro
assert_contains "pakro hook-env 2>&1" "CONFIG_ROOT=$HOME/workdir"
assert_not_contains "pakro hook-env 2>&1" "CONFIG_ROOT=$HOME/workdir/.pakro"
