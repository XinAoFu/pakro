#!/usr/bin/env bash

export PAKRO_SYSTEM_CONFIG_FILE="$HOME/system-pakro.toml"
mkdir -p "$PAKRO_CONFIG_DIR"

cat >"$PAKRO_SYSTEM_CONFIG_FILE" <<'EOF'
[settings]
shims_dir = "~/system-user-shims"
system_installs_dir = "~/system-installs"
system_shims_dir = "~/system-shims"
EOF
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[settings]
shims_dir = "~/global-user-shims"
system_installs_dir = "~/global-system-installs"
system_shims_dir = "~/global-system-shims"
EOF

assert "pakro settings get shims_dir" "$HOME/global-user-shims"
assert "pakro settings get system_installs_dir" "$HOME/global-system-installs"
assert "pakro settings get system_shims_dir" "$HOME/global-system-shims"

assert "PAKRO_SHIMS_DIR='$HOME/env-user-shims' pakro settings get shims_dir" "$HOME/env-user-shims"
assert "PAKRO_SYSTEM_INSTALLS_DIR='$HOME/env-system-installs' pakro settings get system_installs_dir" "$HOME/env-system-installs"
assert "PAKRO_SYSTEM_SHIMS_DIR='$HOME/env-system-shims' pakro settings get system_shims_dir" "$HOME/env-system-shims"

cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[settings]
shims_dir = "relative/shims"
EOF
assert_fail_contains "pakro settings get shims_dir 2>&1" "must resolve to an absolute path"
