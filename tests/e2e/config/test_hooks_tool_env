#!/usr/bin/env bash

# Test that tool-level postinstall hooks receive PAKRO_TOOL_NAME and PAKRO_TOOL_VERSION

cat <<EOF >pakro.toml
[tools]
dummy = { version = "latest", postinstall = "echo TOOL_NAME=\$PAKRO_TOOL_NAME TOOL_VERSION=\$PAKRO_TOOL_VERSION INSTALL_PATH=\$PAKRO_TOOL_INSTALL_PATH CONFIG_FILE=\$PAKRO_CONFIG_FILE" }
EOF

# Remove any existing dummy installation to force reinstall
pakro uninstall dummy --all >/dev/null 2>&1 || true

# Run install and capture output
output=$(pakro install dummy 2>&1)

# Check that PAKRO_TOOL_NAME is set
if [[ $output == *"TOOL_NAME=dummy"* ]]; then
  echo "✓ PAKRO_TOOL_NAME is set correctly"
else
  echo "✗ PAKRO_TOOL_NAME is NOT set correctly"
  echo "Output: $output"
  exit 1
fi

# Check that PAKRO_TOOL_VERSION is set (should be a version string)
if [[ $output == *"TOOL_VERSION="* ]] && [[ $output != *"TOOL_VERSION= "* ]]; then
  echo "✓ PAKRO_TOOL_VERSION is set"
else
  echo "✗ PAKRO_TOOL_VERSION is NOT set"
  echo "Output: $output"
  exit 1
fi

# Check that PAKRO_TOOL_INSTALL_PATH is set (contains pakro/installs/dummy)
if [[ $output == *"INSTALL_PATH="* ]] && [[ $output == *"/pakro/installs/dummy"* ]]; then
  echo "✓ PAKRO_TOOL_INSTALL_PATH is set"
else
  echo "✗ PAKRO_TOOL_INSTALL_PATH is NOT set correctly"
  echo "Output: $output"
  exit 1
fi

if [[ $output == *"CONFIG_FILE=$PWD/pakro.toml"* ]]; then
  echo "✓ PAKRO_CONFIG_FILE identifies the declaring config"
else
  echo "✗ PAKRO_CONFIG_FILE is not the declaring config"
  echo "Output: $output"
  exit 1
fi

# A tool declared globally receives the exact global source path as well.
rm pakro.toml
mkdir -p "$PAKRO_CONFIG_DIR"
cat <<EOF >"$PAKRO_CONFIG_DIR/config.toml"
[tools]
dummy = { version = "latest", postinstall = "pakro config set --global env.HOOK_NESTED hooked && echo GLOBAL_CONFIG_FILE=\$PAKRO_CONFIG_FILE PROJECT_ROOT=\$PAKRO_PROJECT_ROOT" }
EOF
mkdir -p project
cd project
printf '[env]\nPROJECT_MARKER = "local"\n' >pakro.toml
pakro uninstall dummy --all >/dev/null 2>&1 || true
output=$(pakro install dummy 2>&1)
if [[ $output == *"GLOBAL_CONFIG_FILE=$PAKRO_CONFIG_DIR/config.toml"* ]]; then
  echo "✓ PAKRO_CONFIG_FILE identifies the global declaring config"
else
  echo "✗ PAKRO_CONFIG_FILE is not the global declaring config"
  echo "Output: $output"
  exit 1
fi
if [[ $output == *"PROJECT_ROOT=$PWD"* ]]; then
  echo "✓ PAKRO_PROJECT_ROOT identifies the active project"
else
  echo "✗ PAKRO_PROJECT_ROOT is not the active project"
  echo "Output: $output"
  exit 1
fi
if [[ $(pakro config get --file "$PAKRO_CONFIG_DIR/config.toml" env.HOOK_NESTED) == "hooked" ]]; then
  echo "✓ nested pakro calls retain the actual global config"
else
  echo "✗ nested pakro calls treat the declaring config as global"
  echo "Output: $output"
  exit 1
fi
