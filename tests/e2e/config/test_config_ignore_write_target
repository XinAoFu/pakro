#!/usr/bin/env bash
# The write target has to respect the same exclusions as config loading.
#
# `--path`/`--file` resolve to a file inside the named directory, but the lookup did not apply
# the ignore filters, so `pakro use --path <dir>` could pick a config that loading skips --
# writing a tool somewhere pakro never reads back.
#
# `ignored_config_paths` is the lever that produces this state. The persisted ignore list
# (`pakro trust --ignore`) cannot: `trusted_config_paths` overrides it, and without that override
# the write fails the trust check instead of landing silently.

mkdir -p mixed excluded plain

cat <<EOF >mixed/pakro.toml
[env]
FROM = "pakro.toml"
EOF
cat <<EOF >mixed/pakro.local.toml
[env]
FROM = "pakro.local.toml"
EOF

#################################################################################
# One file in the directory is excluded, a sibling is not
#################################################################################

# pakro.toml sorts before pakro.local.toml, so it is what the unfiltered lookup returned.
PAKRO_IGNORED_CONFIG_PATHS="$PWD/mixed/pakro.toml" pakro use --path mixed dummy@1.0.0
assert_not_contains "cat mixed/pakro.toml" "dummy"
assert_contains "cat mixed/pakro.local.toml" "dummy"

#################################################################################
# The whole directory is excluded
#################################################################################

# It was named explicitly, so pakro still creates what was asked for -- but says that it will
# not be read back, instead of writing silently.
assert_contains "PAKRO_IGNORED_CONFIG_PATHS=$PWD/excluded pakro use --path excluded dummy@1.0.0 2>&1" \
  "will not read back what it writes there"
assert_contains "cat excluded/pakro.toml" "dummy"

#################################################################################
# Nothing excluded: unchanged
#################################################################################

cat <<EOF >plain/pakro.toml
[env]
FROM = "plain"
EOF

pakro use --path plain dummy@1.0.0
assert_contains "cat plain/pakro.toml" "dummy"
assert_not_contains "pakro use --path plain dummy@2.0.0 2>&1" "will not read back what it writes there"
