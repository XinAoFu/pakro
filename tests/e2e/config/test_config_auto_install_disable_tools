#!/usr/bin/env bash

# Clean up any previous installs
pakro uninstall dummy@1.0.0 || true

# Test auto_install_disable_tools via settings in pakro.toml
cat <<EOF >pakro.toml
[tools]
dummy = '1.0.0'

[settings]
auto_install_disable_tools = ["dummy"]
EOF

# Should NOT auto-install dummy when running a command
assert_fail "pakro exec dummy@1.0.0 -- dummy --version" "couldn't exec process"

# Remove auto_install_disable_tools and check auto-install works
cat <<EOF >pakro.toml
[tools]
dummy = '1.0.0'
EOF

assert "pakro exec dummy@1.0.0 -- dummy --version"

# Uninstall for env var test
pakro uninstall dummy@1.0.0 || true

# Test auto_install_disable_tools via environment variable
cat <<EOF >pakro.toml
[tools]
dummy = '1.0.0'
EOF

PAKRO_AUTO_INSTALL_DISABLE_TOOLS=dummy assert_fail "pakro exec dummy@1.0.0 -- dummy --version" "couldn't exec process"
PAKRO_AUTO_INSTALL_DISABLE_TOOLS='' assert "pakro exec dummy@1.0.0 -- dummy --version"
