#!/usr/bin/env bash

# Test PAKRO_IGNORED_CONFIG_PATHS with multiple colon-separated paths.
# This exercises the env.rs early-init parsing which was fixed to use
# std::env::split_paths instead of v.split(':').

export PAKRO_TRUSTED_CONFIG_PATHS=""

mkdir -p child

cat <<EOF >.pakro.toml
[env]
PARENT = "true"
EOF

cat <<EOF >child/.pakro.toml
[env]
CHILD = "true"
EOF

assert "pakro trust --all"
cd child

WORKDIR="$(cd .. && pwd)"
CHILD_DIR="$(pwd)"

# Baseline: both configs are visible from child dir
assert_contains "pakro env" "PARENT"
assert_contains "pakro env" "CHILD"

# Single ignored path: child config ignored, parent still visible
assert_not_contains "PAKRO_IGNORED_CONFIG_PATHS=$CHILD_DIR pakro env" "CHILD"
assert_contains "PAKRO_IGNORED_CONFIG_PATHS=$CHILD_DIR pakro env" "PARENT"

# Multiple colon-separated paths: both configs ignored
assert_not_contains "PAKRO_IGNORED_CONFIG_PATHS=$CHILD_DIR:$WORKDIR pakro env" "CHILD"
assert_not_contains "PAKRO_IGNORED_CONFIG_PATHS=$CHILD_DIR:$WORKDIR pakro env" "PARENT"

# Relative paths in a local .config/pakrorc.toml are based on the declaring
# file, and recursive glob patterns selectively ignore matching config names.
cd "$WORKDIR"
mkdir -p .config vendor/jj/.config
cat <<EOF >vendor/jj/.config/pakro.toml
[env]
IGNORED_VENDOR_CONFIG = "true"
EOF
cat <<EOF >vendor/jj/.pakro.toml
[env]
VISIBLE_VENDOR_CONFIG = "true"
EOF
cat <<EOF >.config/pakrorc.toml
ignored_config_paths = ["../vendor/./**/pakro.toml"]
EOF

assert_not_contains "pakro -C vendor/jj env" "IGNORED_VENDOR_CONFIG"
assert_contains "pakro -C vendor/jj env" "VISIBLE_VENDOR_CONFIG"

# Environment values use the invocation directory as their relative base,
# even when -C changes the directory used for config discovery.
rm .config/pakrorc.toml
assert_not_contains \
  "PAKRO_IGNORED_CONFIG_PATHS='vendor/**/pakro.toml' pakro -C vendor/jj env" \
  "IGNORED_VENDOR_CONFIG"
assert_contains \
  "PAKRO_IGNORED_CONFIG_PATHS='vendor/**/pakro.toml' pakro -C vendor/jj env" \
  "VISIBLE_VENDOR_CONFIG"
