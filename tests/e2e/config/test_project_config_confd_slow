#!/usr/bin/env bash

mkdir -p .pakro/conf.d

cat >.pakro/conf.d/01-base.toml <<'EOF'
[env]
CONFD_ORDER = "base"
CONFD_FROM_VAR = "{{ vars.fragment }}"

[vars]
fragment = "loaded"

[tools]
dummy = "1.0.0"

[tasks.confd]
description = "base fragment"
run = 'echo "$CONFD_ORDER:$CONFD_FROM_VAR"'
EOF

cat >.pakro/conf.d/02-override.toml <<'EOF'
[env]
CONFD_ORDER = "override"

[tasks.confd]
description = "override fragment"
run = 'echo "$CONFD_ORDER:$CONFD_FROM_VAR"'
EOF

cat >.pakro/conf.d/.hidden.toml <<'EOF'
[env]
HIDDEN_FRAGMENT = "unexpected"
EOF

assert_contains "pakro env -s bash" "CONFD_ORDER=override"
assert_contains "pakro env -s bash" "CONFD_FROM_VAR=loaded"
assert_contains "pakro config ls" ".pakro/conf.d/01-base.toml"
assert_contains "pakro config ls" ".pakro/conf.d/02-override.toml"
assert_not_contains "pakro config ls" ".pakro/conf.d/.hidden.toml"
assert_not_contains "pakro env -s bash" "HIDDEN_FRAGMENT"
assert_contains "pakro config ls --tracked-configs" ".pakro/conf.d/01-base.toml"
assert_contains "pakro config ls" "dummy"
assert_contains "pakro tasks" "confd  override fragment"
assert "pakro run --skip-tools confd" "override:loaded"

# The regular .pakro config has higher precedence than every fragment.
cat >.pakro/config.toml <<'EOF'
[env]
CONFD_ORDER = "config"
EOF
assert_contains "pakro env -s bash" "CONFD_ORDER=config"
assert "pakro run --skip-tools confd" "config:loaded"

# All fragments in .pakro/conf.d share the .pakro/pakro.lock destination.
export PAKRO_LOCKFILE=1
output=$(pakro lock --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" ".pakro/pakro.lock"
assert_not_contains "echo '$output'" ".pakro/conf.d/pakro.lock"

# Drop-ins are never implicit write targets.
mkdir -p write-target/.pakro/conf.d
cat >write-target/.pakro/conf.d/10-drop-in.toml <<'EOF'
[env]
DROP_IN_ONLY = "yes"
EOF
pakro use --path write-target dummy@system
assert_contains "cat write-target/pakro.toml" 'dummy = "system"'
assert_not_contains "cat write-target/.pakro/conf.d/10-drop-in.toml" 'dummy = "system"'

# Explicit monorepo roots recognize projects whose only config is a fragment.
mkdir -p monorepo/packages/app/.pakro/conf.d
cat >monorepo/pakro.toml <<'EOF'
min_version = "2026.1.0"
monorepo_root = true

[monorepo]
config_roots = ["packages/*"]
EOF
cat >monorepo/packages/app/.pakro/conf.d/tasks.toml <<'EOF'
[tasks.hello]
run = "echo fragment-root"
EOF
assert_contains "cd monorepo && pakro tasks --all" "app:hello"

# Visible pakro/conf.d fragments use the same project config behavior.
mkdir -p visible/pakro/conf.d
cat >visible/pakro/conf.d/01-base.toml <<'EOF'
[env]
VISIBLE_CONF_D = "base"
EOF
cat >visible/pakro/conf.d/02-override.toml <<'EOF'
[env]
VISIBLE_CONF_D = "override"
EOF
cat >visible/pakro/config.toml <<'EOF'
[env]
VISIBLE_CONF_D = "config"
EOF
assert_contains "cd visible && pakro config ls" "pakro/conf.d/01-base.toml"
assert_contains "cd visible && pakro config ls" "pakro/conf.d/02-override.toml"
assert "cd visible && pakro env --json | jq -r .VISIBLE_CONF_D" "config"

# Deprecated automatic discovery uses the same glob-aware root detection.
cat >monorepo/pakro.toml <<'EOF'
min_version = "2026.1.0"
monorepo_root = true
EOF
assert_contains "cd monorepo && pakro tasks --all" "app:hello"
