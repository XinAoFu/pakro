#!/usr/bin/env bash

export PAKRO_USE_TOML=0
export PAKRO_DEFAULT_TOOL_VERSIONS_FILENAME=.alternate-tool-versions
export PAKRO_DEFAULT_CONFIG_FILENAME=.MISSING

cat <<EOF >"$PAKRO_DEFAULT_TOOL_VERSIONS_FILENAME"
tiny 3.1.0
EOF

pakro i tiny
assert "pakro local" "tiny 3.1.0"
assert_contains "pakro exec -- rtx-tiny" "v3.1.0"

pakro local -p tiny@2.0.0
pakro i tiny
assert "pakro local -p" "tiny 2.0.0"
assert_contains "pakro exec -- rtx-tiny" "v2.0.0"

pakro local -p tiny@3.5.0
assert "pakro local tiny" "3.5.0"
