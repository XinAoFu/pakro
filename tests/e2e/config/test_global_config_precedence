#!/usr/bin/env bash
set -euo pipefail

# Inside ~/.config/pakro, config.local.toml overrides config.toml, which overrides
# conf.d fragments. List entries in minimum_release_age_excludes are merged instead.
# The ceiling keeps the config dir out of the cwd walk, so it is only found as the
# global config group, together with ~/.tool-versions.
export PAKRO_CEILING_PATHS="$HOME"

mkdir -p "$PAKRO_CONFIG_DIR/conf.d"

cat >dotted-fragment-target.toml <<EOF
[env]
DOTTED_SYMLINK = "loaded"
EOF
ln -s "$PWD/dotted-fragment-target.toml" "$PAKRO_CONFIG_DIR/conf.d/x.base.toml"

cat >"$PAKRO_CONFIG_DIR/conf.d/10-fragment.toml" <<EOF
[settings]
minimum_release_age_excludes = ["from-conf-d"]
[env]
GLOBAL_PRECEDENCE = "from-conf-d"
EOF

cat >"$PAKRO_CONFIG_DIR/config.toml" <<EOF
[settings]
minimum_release_age_excludes = ["from-config"]
[env]
GLOBAL_PRECEDENCE = "from-config"
[tools]
dummy = "2.0.0"
EOF

cat >"$PAKRO_CONFIG_DIR/config.local.toml" <<EOF
[settings]
minimum_release_age_excludes = ["from-local"]
[env]
GLOBAL_PRECEDENCE = "from-local"
EOF

cat >pakro.toml <<EOF
[settings]
minimum_release_age_excludes = ["from-project", "from-config"]
EOF

echo "dummy 1.0.0" >"$HOME/.tool-versions"

assert "pakro env | grep GLOBAL_PRECEDENCE" "export GLOBAL_PRECEDENCE=from-local"
assert "pakro env --json | jq -r .DOTTED_SYMLINK" "loaded"
PAKRO_ENV_CONF_D=true assert "pakro env --json | jq -r .DOTTED_SYMLINK" "null"
assert "pakro settings get minimum_release_age_excludes" '["from-conf-d", "from-config", "from-local", "from-project"]'
assert "PAKRO_MINIMUM_RELEASE_AGE_EXCLUDES=from-env pakro settings get minimum_release_age_excludes" '["from-env"]'
# ~/.tool-versions joins the global group only under PAKRO_USE_TOML=0, and outranks
# the config dir. Only the active version carries a source.
assert "PAKRO_USE_TOML=0 pakro ls dummy --json | jq -r '.[] | select(.source) | .source.path'" "$HOME/.tool-versions"

rm "$PAKRO_CONFIG_DIR/config.local.toml"
assert "pakro env | grep GLOBAL_PRECEDENCE" "export GLOBAL_PRECEDENCE=from-config"
assert "pakro settings get minimum_release_age_excludes" '["from-conf-d", "from-config", "from-project"]'
