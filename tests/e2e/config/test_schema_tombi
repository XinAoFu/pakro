#!/usr/bin/env bash

# Validate that the pakro JSON schema works correctly with tombi (strict mode).
# Tombi v0.9.19 fixed evaluated-property collection for allOf +
# unevaluatedProperties in tombi-toml/tombi#1725, which lets the schema share
# task properties through $refs without inlining them.

TOMBI_VERSION="0.9.22"

# Install a pinned tombi version so release asset packaging changes do not break
# this schema regression test.
pakro use -g tombi@$TOMBI_VERSION

SCHEMA_PATH="$ROOT/src/schema/pakro.json"
TASK_SCHEMA_PATH="$ROOT/src/schema/pakro-task.json"
REGISTRY_TOOL_SCHEMA_PATH="$ROOT/src/schema/pakro-registry-tool.json"
TOMBI="pakro x tombi@$TOMBI_VERSION -- tombi"
TOMBI_LINT="$TOMBI lint --offline --no-cache --error-on-warnings --quiet"
assert_contains "$TOMBI --version" "tombi $TOMBI_VERSION"

# Set up tombi config pointing to local schema
cat >"$HOME/tombi.toml" <<EOF
toml-version = "v1.0.0"

[schema]
enabled = true
strict = true

[[schemas]]
path = "file://$SCHEMA_PATH"
include = ["pakro.toml", "pakro-age.toml", "pakro-env-directives.toml", "pakro-os.toml", "pakro-vars.toml", "pakro-backend-options.toml"]

[[schemas]]
path = "file://$TASK_SCHEMA_PATH"
include = ["pakro-task-os.toml"]

[[schemas]]
path = "file://$REGISTRY_TOOL_SCHEMA_PATH"
include = ["pakro-registry-tool.toml"]
EOF

# Create a pakro.toml exercising task properties that were previously broken
cat >"$HOME/workdir/pakro.toml" <<'TOML'
env_file = ".env"
env_path = "./bin"

[[watch_files]]
patterns = ["src/**/*.rs"]
run = "cargo fmt"
shell = "bash -c"

[task_templates.base]
dir = "{{config_root}}"
deny_net = true
allow_env = ["CI"]

[tasks.build]
description = "Build the project"
depends = ["lint"]
run = "cargo build"
dir = "{{config_root}}"
quiet = true
usage = "build [args]"
deny_env = true
allow_read = ["."]

[tasks.lint]
extends = "base"
run = "cargo clippy"
description = "Lint the project"

[vars]
e2e_args = { default = "--headless", redact = true }

[dotfiles]
"~/.gitconfig" = { source = "dotfiles/gitconfig", mode = "symlink" }
"~/.zshrc/activate" = { block = "eval \"$(pakro activate zsh)\"", comment = "#" }
"~/.inline" = { content = "literal content" }
"~/.manifest" = { source = "dotfiles/config", mode = "copy", manifest = "git" }
"~/.manifest-default-mode" = { source = "dotfiles/default", manifest = "git" }
"~/.manifest-implied-source" = { mode = "symlink-each", manifest = "git" }

[tool_alias.java.versions]
"11.0" = "temurin-11"

[bootstrap.macos.launchd.agents.daily]
program = "/bin/echo"
start_calendar_interval = { hour = 2, minute = 0 }

[bootstrap.macos.launchd.agents.boundaries]
program = "/bin/echo"
start_calendar_interval = [
  { minute = 0, hour = 0, day = 1, weekday = 0, month = 1 },
  { minute = 59, hour = 23, day = 31, weekday = 7, month = 12 },
]

[bootstrap.macos.launchd.agents.queue]
program = "/bin/echo"
throttle_interval = 300
queue_directories = ["~/Library/Queues/sync", "/var/spool/sync"]

[bootstrap.linux.systemd.units.sync]
exec_start = "/usr/bin/rsync --archive source/ destination/"
type = "oneshot"
remain_after_exit = true
exec_stop = "/usr/bin/umount destination"
timeout_start_sec = "2min"
timeout_stop_sec = "30s"
no_new_privileges = true
private_tmp = true
requires = ["network-online.target"]
environment_file = ["-%h/.config/sync.env"]
nice = 10
umask = "0007"

[bootstrap.linux.systemd.units.sync-timer]
on_boot_sec = "2min"
on_unit_inactive_sec = "5min"
randomized_delay_sec = "30s"
accuracy_sec = "1s"
persistent = true
unit = "dev.pakro.sync.service"
wanted_by = ["timers.target"]

[bootstrap.pakro_shell_activate]
bash = true
zsh = false
fish = "activate"
bash_profile = "shims"
bashrc = { enabled = true, mode = "activate" }
zshenv = { enabled = false }
zprofile = { enabled = true, mode = "shims" }
zshrc = true

[bootstrap.packages]
"pacman:libreoffice-fresh" = { state = "absent" }

[[oci.copy]]
host = "dist/my-app"
image = "/usr/local/bin/my-app"

[[oci.copy]]
host = "assets"
image = "//srv//.assets///"
TOML

# Create a separate file for age schema coverage so pakro does not try to decrypt
# placeholder values while running tombi through `pakro x`.
cat >"$HOME/workdir/pakro-age.toml" <<'TOML'
[env]
VALUE_OBJECT = { value = 123, tools = true, redact = true, required = "set VALUE_OBJECT" }
VALUE_DEFAULT = { default = 123, tools = true, redact = true }
SECRET_SIMPLE = { age = "AGE-SECRET", tools = true }
SECRET_COMPLEX = { age = { value = "AGE-SECRET", format = "raw", tools = true, redact = true } }
TOML

cat >"$HOME/workdir/pakro-env-directives.toml" <<'TOML'
[env]
_.file = { path = ".env", tools = true, redact = true, required = true, expand = true }
_.source = [{ path = "env.sh", tools = true, redact = true, required = "source env.sh" }]
_.path = { paths = ["./bin", "./scripts"], tools = true }
TOML

cat >"$HOME/workdir/pakro-vars.toml" <<'TOML'
[vars]
STRING = "value"
INTEGER = 123
TRUE_BOOL = true
VALUE_STRING = { value = "value", redact = true }
VALUE_INTEGER = { value = 123 }
VALUE_TRUE = { value = true }
VALUE_DEFAULT = { default = 123, redact = true }
REQUIRED_TRUE = { required = true, redact = true }
REQUIRED_HELP = { required = "set REQUIRED_HELP in pakro.local.toml" }
SECRET_SIMPLE = { age = "AGE-SECRET", redact = false }
SECRET_COMPLEX = { age = { value = "AGE-SECRET", format = "raw", redact = true } }
_.file = ".env"
_.source = ["env.sh"]
TOML

cat >"$HOME/workdir/pakro-os.toml" <<'TOML'
[tools]
node = { version = "latest", os = ["linux", "macos/arm64", "darwin/aarch64", "win/amd64"], install_env = { KEEP = "value", REMOVE = false, RETRIES = 2 }, backend_options = { nested = true } }
go = { version = "latest", os = "linux/x64" }
python = { version = "latest", minimum_release_age = "2024-06-01", version_order = "source" }
ruby = { version = "latest", minimum_release_age = "7d", version_order = "semver" }

[tasks.build.tools]
rust = { version = "latest", minimum_release_age = "2024-06-01T12:00:00Z", os = ["linux/x64", "macos/arm64"], install_env = { KEEP = "value", REMOVE = false, RETRIES = 2 }, profile = "release", targets = ["x86_64-unknown-linux-gnu", "aarch64-apple-darwin"], backend_options = { nested = { enabled = true, retries = 2 } } }
TOML

cat >"$HOME/workdir/pakro-task-os.toml" <<'TOML'
[build]
run = "echo ok"

[build.tools]
node = { version = "latest", os = ["linux/x64", "macos/arm64"], install_env = { KEEP = "value", REMOVE = false, RETRIES = 2 }, profile = "release", matching = ["node", "npm"], platforms = { linux-x64 = { bin = ["node", "npm"], env = { NODE_ENV = "test" } } } }
TOML

cat >"$HOME/workdir/pakro-registry-tool.toml" <<'TOML'
backends = [
  { full = "aqua:ImageMagick/ImageMagick", platforms = ["windows-x64"] },
  { full = "github:owner/repo", platforms = ["linux", "arm64"], options = { platforms = { linux-x64 = { asset_pattern = "tool-linux.tar.gz" }, darwin-aarch64 = { asset_pattern = "tool-darwin.tar.gz" } } } },
]
description = "Example tool"
version_order = "source"
test = { cmd = "tool --version", expected = "tool {{version}}" }
TOML

# tombi lint should succeed with no errors (warnings about table order are ok)
cd "$HOME/workdir"
assert_succeed "$TOMBI_LINT pakro.toml"
assert_succeed "$TOMBI_LINT pakro-age.toml"
assert_succeed "$TOMBI_LINT pakro-env-directives.toml"
assert_succeed "$TOMBI_LINT pakro-vars.toml"
assert_succeed "$TOMBI_LINT pakro-os.toml"
assert_succeed "$TOMBI_LINT pakro-task-os.toml"
assert_succeed "$TOMBI_LINT pakro-registry-tool.toml"

# Verify that invalid properties on tasks are rejected
cat >"$HOME/workdir/pakro-bad.toml" <<'TOML'
[tasks.build]
description = "Build the project"
run = "cargo build"
bogus_invalid_property = "should fail"
TOML

cat >"$HOME/tombi.toml" <<EOF
toml-version = "v1.0.0"

[schema]
enabled = true
strict = true

[[schemas]]
path = "file://$SCHEMA_PATH"
include = ["pakro-bad.toml", "pakro-bad-age.toml", "pakro-bad-dotfiles.toml", "pakro-bad-dotfiles-manifest.toml", "pakro-bad-dotfiles-position.toml", "pakro-bad-env-default.toml", "pakro-bad-env-directive.toml", "pakro-bad-env-float.toml", "pakro-bad-install-env-float.toml", "pakro-bad-minimum-release-age-array.toml", "pakro-bad-minimum-release-age-table.toml", "pakro-bad-package-state.toml", "pakro-bad-postinstall.toml", "pakro-bad-vars.toml", "pakro-bad-tmpl.toml", "pakro-bad-tmpl-output-flag.toml", "pakro-bad-os.toml", "pakro-bad-watch-files.toml", "pakro-bad-launchd-calendar.toml", "pakro-bad-launchd-queue.toml", "pakro-bad-launchd-throttle.toml", "pakro-bad-systemd.toml", "pakro-bad-oci-copy.toml", "pakro-bad-shell-activate.toml", "pakro-bad-backend-options.toml", "pakro-bad-core-options.toml"]

[[schemas]]
path = "file://$TASK_SCHEMA_PATH"
include = ["pakro-bad-task-os.toml", "pakro-bad-task-install-env-float.toml", "pakro-bad-task-postinstall.toml"]

[[schemas]]
path = "file://$REGISTRY_TOOL_SCHEMA_PATH"
include = ["pakro-bad-registry-tool.toml"]

[[schemas]]
path = "file://$SCHEMA_PATH"
include = ["pakro-bad-tool-alias.toml"]
EOF

assert_fail "$TOMBI_LINT pakro-bad.toml"

# Verify that package state matches runtime validation
cat >"$HOME/workdir/pakro-bad-package-state.toml" <<'TOML'
[bootstrap.packages]
"pacman:libreoffice-fresh" = { state = "removed" }
TOML

assert_fail "$TOMBI_LINT pakro-bad-package-state.toml"

# Verify that options for complex age values must be nested inside age
cat >"$HOME/workdir/pakro-bad-age.toml" <<'TOML'
[env]
SECRET = { age = { value = "AGE-SECRET" }, tools = true }
SECRET_FORMAT = { age = { value = "AGE-SECRET", format = "zip" } }
TOML

assert_fail "$TOMBI_LINT pakro-bad-age.toml"

# Inline content is a complete whole-file entry and cannot be combined with
# source-backed fields, manifests, or file edit fields.
for other_field in \
  'source = "dotfiles/config"' \
  'manifest = "git"' \
  'mode = "copy"' \
  'exclude = ["*.tmp"]' \
  'block = "managed block"' \
  'line = "managed line"' \
  'position = "prepend"' \
  'template = "tera"' \
  'comment = "#"'; do
  cat >"$HOME/workdir/pakro-bad-dotfiles.toml" <<TOML
[dotfiles]
"~/.invalid" = { content = "literal content", $other_field }
TOML

  assert_fail "$TOMBI_LINT pakro-bad-dotfiles.toml"
done

# Line edits cannot also declare whole-file or block-only fields, and edit
# placement only applies to exact-line edits.
for conflicting_field in \
  'block = "managed block"' \
  'source = "dotfiles/snippet"' \
  'mode = "copy"' \
  'exclude = ["*.tmp"]' \
  'template = "tera"' \
  'comment = "#"'; do
  cat >"$HOME/workdir/pakro-bad-dotfiles-position.toml" <<TOML
[dotfiles]
"~/.invalid/partial" = { line = "managed line", $conflicting_field, position = "prepend" }
TOML

  assert_fail "$TOMBI_LINT pakro-bad-dotfiles-position.toml"
done

cat >"$HOME/workdir/pakro-bad-dotfiles-position.toml" <<'TOML'
[dotfiles]
"~/.invalid/partial" = { block = "managed block", position = "prepend" }
TOML

assert_fail "$TOMBI_LINT pakro-bad-dotfiles-position.toml"

# Manifests support only directory-walking modes. An omitted mode stays valid
# because `dotfiles.default_mode` may be set to `copy` or `symlink-each`, and an
# omitted source stays valid because runtime supports implied sources.
cat >"$HOME/workdir/pakro-bad-dotfiles-manifest.toml" <<'TOML'
[dotfiles]
"~/.invalid" = { manifest = "unsupported", mode = "copy" }
TOML

assert_fail "$TOMBI_LINT pakro-bad-dotfiles-manifest.toml"

cat >"$HOME/workdir/pakro-bad-dotfiles-manifest.toml" <<'TOML'
[dotfiles]
"~/.invalid" = { manifest = "git", mode = "symlink" }
TOML

assert_fail "$TOMBI_LINT pakro-bad-dotfiles-manifest.toml"

for incompatible_field in \
  'content = "literal content"' \
  'block = "managed block"' \
  'line = "managed line"' \
  'template = "tera"' \
  'comment = "#"'; do
  cat >"$HOME/workdir/pakro-bad-dotfiles-manifest.toml" <<TOML
[dotfiles]
"~/.invalid" = { manifest = "git", mode = "copy", $incompatible_field }
TOML

  assert_fail "$TOMBI_LINT pakro-bad-dotfiles-manifest.toml"
done

cat >"$HOME/workdir/pakro-bad-env-default.toml" <<'TOML'
[env]
VALUE_AND_DEFAULT = { value = "x", default = "y" }
REQUIRED_AND_DEFAULT = { required = true, default = "y" }
AGE_AND_DEFAULT = { age = "AGE-SECRET", default = "y" }
BOOL_DEFAULT = { default = false }

[vars]
VALUE_AND_DEFAULT = { value = "x", default = "y" }
BOOL_DEFAULT = { default = false }
TOML

assert_fail "$TOMBI_LINT pakro-bad-env-default.toml"

cat >"$HOME/workdir/pakro-bad-env-directive.toml" <<'TOML'
[env]
_.file = { path = ".env", required = 123 }
TOML

assert_fail "$TOMBI_LINT pakro-bad-env-directive.toml"

cat >"$HOME/workdir/pakro-bad-env-float.toml" <<'TOML'
[env]
FLOAT = 1.23
TOML

assert_fail "$TOMBI_LINT pakro-bad-env-float.toml"

cat >"$HOME/workdir/pakro-bad-install-env-float.toml" <<'TOML'
[tools]
node = { version = "latest", install_env = { FLOAT = 1.23 } }
TOML

assert_fail "$TOMBI_LINT pakro-bad-install-env-float.toml"

# minimum_release_age and its deprecated alias are string options; arrays and
# tables are not accepted.
cat >"$HOME/workdir/pakro-bad-minimum-release-age-array.toml" <<'TOML'
[tools]
node = { version = "latest", minimum_release_age = ["7d"] }
TOML

assert_fail "$TOMBI_LINT pakro-bad-minimum-release-age-array.toml"

cat >"$HOME/workdir/pakro-bad-minimum-release-age-table.toml" <<'TOML'
[tools]
node = { version = "latest", minimum_release_age = { days = 7 } }
TOML

assert_fail "$TOMBI_LINT pakro-bad-minimum-release-age-table.toml"

# Tool-level postinstall hooks must be strings in both schemas.
for postinstall in 123 true 1.23 2026-07-17T12:34:56Z; do
  cat >"$HOME/workdir/pakro-bad-postinstall.toml" <<TOML
[tools]
node = { version = "latest", postinstall = $postinstall }
TOML
  assert_fail "$TOMBI_LINT pakro-bad-postinstall.toml"

  cat >"$HOME/workdir/pakro-bad-task-postinstall.toml" <<TOML
[build]
run = "echo ok"

[build.tools]
node = { version = "latest", postinstall = $postinstall }
TOML
  assert_fail "$TOMBI_LINT pakro-bad-task-postinstall.toml"
done

cat >"$HOME/workdir/pakro-bad-vars.toml" <<'TOML'
[vars]
FALSE_BOOL = false
VALUE_FALSE = { value = false }
REQUIRED_FALSE = { required = false }
FLOAT = 1.23
VALUE_FLOAT = { value = 1.23 }
TOOLS_FILTERED = { value = "not actually resolved as a var", tools = true }
TOML

assert_fail "$TOMBI_LINT pakro-bad-vars.toml"

# Verify that extends is rejected on task_templates (not supported at runtime)
cat >"$HOME/workdir/pakro-bad-tmpl.toml" <<'TOML'
[task_templates.derived]
extends = "base"
TOML

assert_fail "$TOMBI_LINT pakro-bad-tmpl.toml"

# Verify that quiet/hide/raw/interactive/raw_args are rejected on task_templates
for flag in quiet hide raw interactive raw_args; do
  cat >"$HOME/workdir/pakro-bad-tmpl-output-flag.toml" <<TOML
[task_templates.base]
$flag = true
TOML
  assert_fail "$TOMBI_LINT pakro-bad-tmpl-output-flag.toml"
done

cat >"$HOME/workdir/pakro-bad-os.toml" <<'TOML'
[tools]
node = { version = "latest", os = true }
TOML

assert_fail "$TOMBI_LINT pakro-bad-os.toml"

cat >"$HOME/workdir/pakro-bad-tool-alias.toml" <<'TOML'
[tool_alias.node.versions]
lts = { bad = true }
TOML

assert_fail "$TOMBI_LINT pakro-bad-tool-alias.toml"

cat >"$HOME/workdir/pakro-bad-watch-files.toml" <<'TOML'
[[watch_files]]
patterns = ["uv.lock"]
task = "sync-deps"
shell = "bash -c"
TOML

assert_fail "$TOMBI_LINT pakro-bad-watch-files.toml"

# Verify that launchd calendar intervals match runtime validation
for interval in \
  '{}' \
  '[]' \
  '[{}]' \
  '{ minute = 60 }' \
  '{ hour = 24 }' \
  '{ day = 0 }' \
  '{ weekday = 8 }' \
  '{ month = 13 }' \
  '{ second = 0 }'; do
  cat >"$HOME/workdir/pakro-bad-launchd-calendar.toml" <<TOML
[bootstrap.macos.launchd.agents.invalid]
program = "/bin/echo"
start_calendar_interval = $interval
TOML
  assert_fail "$TOMBI_LINT pakro-bad-launchd-calendar.toml"
done

# Verify that launchd queue directories match runtime validation
for queue_directories in \
  '[""]' \
  '["   "]' \
  '["/var/spool/sync", ""]' \
  '["queues/sync"]' \
  '["./queues"]' \
  '["~user/queues"]' \
  '["/var/spool/sync", "queues/sync"]'; do
  cat >"$HOME/workdir/pakro-bad-launchd-queue.toml" <<TOML
[bootstrap.macos.launchd.agents.invalid]
program = "/bin/echo"
queue_directories = $queue_directories
TOML
  assert_fail "$TOMBI_LINT pakro-bad-launchd-queue.toml"
done

# Verify that a negative launchd throttle interval is rejected, matching the
# runtime type (u64)
cat >"$HOME/workdir/pakro-bad-launchd-throttle.toml" <<TOML
[bootstrap.macos.launchd.agents.invalid]
program = "/bin/echo"
throttle_interval = -1
TOML
assert_fail "$TOMBI_LINT pakro-bad-launchd-throttle.toml"

# Verify that systemd service/timer declarations match runtime validation
for unit in \
  '{ description = "service missing exec_start" }' \
  '{ persistent = true }' \
  '{ exec_start = "/bin/true", on_boot_sec = "1min" }' \
  '{ exec_start = "/bin/true", nice = 20 }' \
  '{ exec_start = "/bin/true", umask = "0888" }' \
  '{ exec_start = "/bin/true", type = "daemon" }'; do
  cat >"$HOME/workdir/pakro-bad-systemd.toml" <<TOML
[bootstrap.linux.systemd.units]
invalid = $unit
TOML
  assert_fail "$TOMBI_LINT pakro-bad-systemd.toml"
done

# Verify that OCI copy entries match runtime validation
for copy in \
  '{ image = "/srv/app" }' \
  '{ host = "assets" }' \
  '{ host = "", image = "/srv/app" }' \
  '{ host = "assets", image = "srv/app" }' \
  '{ host = "assets", image = "/" }' \
  '{ host = "assets", image = "////" }' \
  '{ host = "assets", image = "/srv/./app" }' \
  '{ host = "assets", image = "/srv/../app" }' \
  '{ host = "assets", image = "/srv/app", extra = true }'; do
  cat >"$HOME/workdir/pakro-bad-oci-copy.toml" <<TOML
[oci]
copy = [$copy]
TOML
  assert_fail "$TOMBI_LINT pakro-bad-oci-copy.toml"
done

# Verify that unknown shell activation targets and invalid values are rejected
cat >"$HOME/workdir/pakro-bad-shell-activate.toml" <<'TOML'
[bootstrap.pakro_shell_activate]
powershell = true
TOML
assert_fail "$TOMBI_LINT pakro-bad-shell-activate.toml"

cat >"$HOME/workdir/pakro-bad-shell-activate.toml" <<'TOML'
[bootstrap.pakro_shell_activate]
zsh = "invalid"
TOML
assert_fail "$TOMBI_LINT pakro-bad-shell-activate.toml"

cat >"$HOME/workdir/pakro-bad-shell-activate.toml" <<'TOML'
[bootstrap.pakro_shell_activate]
zsh = { mode = "activate" }
TOML
assert_fail "$TOMBI_LINT pakro-bad-shell-activate.toml"

cat >"$HOME/workdir/pakro-bad-shell-activate.toml" <<'TOML'
[bootstrap.pakro_shell_activate]
zsh = { enabled = true, unknown = true }
TOML
assert_fail "$TOMBI_LINT pakro-bad-shell-activate.toml"

cat >"$HOME/workdir/pakro-bad-task-os.toml" <<'TOML'
[build]
run = "echo ok"

[build.tools]
node = { version = "latest", os = true }
TOML

assert_fail "$TOMBI_LINT pakro-bad-task-os.toml"

cat >"$HOME/workdir/pakro-bad-task-install-env-float.toml" <<'TOML'
[build]
run = "echo ok"

[build.tools]
node = { version = "latest", install_env = { FLOAT = 1.23 } }
TOML

assert_fail "$TOMBI_LINT pakro-bad-task-install-env-float.toml"

cat >"$HOME/workdir/pakro-bad-registry-tool.toml" <<'TOML'
backends = [
  { full = "github:owner/repo", platforms = ["windows-amd64"] },
  { full = "github:owner/repo", options = { platforms = { linux-x64-musl = { asset_pattern = "tool-linux.tar.gz" } } } },
]
TOML

assert_fail "$TOMBI_LINT pakro-bad-registry-tool.toml"

# Backend-specific tool options are typed for tools of that backend only.
cat >"$HOME/workdir/pakro-backend-options.toml" <<'TOML'
[tools]
"github:cli/cli" = { version = "2", asset_pattern = "gh_*", no_app = true, platforms = { linux-x64 = { asset_pattern = "gh_linux*" } } }
"cargo:ripgrep" = { version = "latest", features = ["pcre2"], locked = false }
"spinel:tobi/try" = { version = "1.10.1", entrypoint = "try.rb", tag_prefix = "v" }
python = { version = "3.13", patch_sysconfig = false }
java = { version = "21", release_type = "ea" }
node = { version = "22", prerelease = true, lazy_bins = "node" }

[tasks.build.tools]
"github:cli/cli" = { version = "2", asset_pattern = "gh_*" }
TOML

assert_succeed "$TOMBI_LINT pakro-backend-options.toml"

cat >"$HOME/workdir/pakro-bad-backend-options.toml" <<'TOML'
[tools]
"github:cli/cli" = { version = "2", asset_pattern = 5 }
TOML

assert_fail "$TOMBI_LINT pakro-bad-backend-options.toml"

cat >"$HOME/workdir/pakro-bad-core-options.toml" <<'TOML'
[tools]
java = { version = "21", release_type = "stable" }
TOML

assert_fail "$TOMBI_LINT pakro-bad-core-options.toml"
