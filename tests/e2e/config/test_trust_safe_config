#!/usr/bin/env bash

# Safe pakro.toml files (min_version, [tools] with plain version strings, and
# [tasks]) can be loaded without trusting them first. Anything that can execute
# code at load time or change pakro's behavior still requires trust.

export PAKRO_TRUSTED_CONFIG_PATHS=""
unset CI GITHUB_ACTIONS GITHUB_ACTION 2>/dev/null || true

# Fail if any trust marker file/symlink exists under trusted-configs. This is
# precise (a stale empty dir won't mask a wrongly-written marker) unlike a bare
# directory-existence check.
assert_no_trust_marker() {
  local found
  found=$(find "$PAKRO_STATE_DIR/trusted-configs" -mindepth 1 \( -type f -o -type l \) 2>/dev/null || true)
  [[ -z $found ]] || fail "$1 (found trust markers: $found)"
}

mkdir -p project
cd project || exit 1

cat <<'EOF' >pakro.toml
min_version = "2024.1.1"

[tools]
tiny = "3.1.0"

[tasks.hi]
run = "echo task-ran-without-trust"
EOF

# loads without prompting and without creating a trust marker
assert_contains "PAKRO_YES=0 pakro ls" "3.1.0"
assert_no_trust_marker "safe config should not be silently trusted"

# safe config tool pins still prompt before installing non-registry plugin URLs
cat <<'EOF' >pakro.toml
[tools]
"asdf:attacker/evil" = "latest"
EOF
set +e
output=$(PAKRO_YES=0 pakro install 2>&1)
status=$?
set -e
[[ $status -ne 0 ]] || fail "expected community plugin install to abort without confirmation"
grep -q "community-developed plugin" <<<"$output" || fail "expected community plugin prompt, got: $output"
grep -q "github.com/attacker/evil" <<<"$output" || fail "expected attacker plugin URL, got: $output"
# `pakro install` trusts the active config independently of the later plugin
# confirmation. Remove that trust so the remaining checks start untrusted.
assert_contains "pakro trust --show" "trusted"
pakro untrust
assert_no_trust_marker "pakro untrust should remove install's implicit trust"

# config tasks execute on explicit `pakro run`, which now trusts active config
cat <<'EOF' >pakro.toml
min_version = "2024.1.1"

[tools]
tiny = "3.1.0"

[tasks.hi]
run = "echo task-ran-without-trust"
EOF
assert_contains "PAKRO_YES=0 pakro run hi" "task-ran-without-trust"
assert_contains "pakro trust --show" "trusted"
pakro untrust

# template-free file tasks are inert at load time; explicit `pakro run` trusts
# the active config before running them
mkdir -p pakro-tasks
cat <<'EOF' >pakro-tasks/filetask
#!/usr/bin/env bash
#PAKRO description="a plain file task"
echo file-task-ran-without-trust
EOF
chmod +x pakro-tasks/filetask
assert_contains "PAKRO_YES=0 pakro run filetask" "file-task-ran-without-trust"
assert_contains "pakro trust --show" "trusted"
pakro untrust
assert_no_trust_marker "pakro untrust should remove run's implicit trust"

# a template in a file task header renders at load time, so it requires trust
cat <<'EOF' >pakro-tasks/evil
#!/usr/bin/env bash
#PAKRO description="{{ exec(command='echo PWNED > marker') }}"
echo evil
EOF
chmod +x pakro-tasks/evil
output=$(PAKRO_YES=0 pakro tasks 2>&1 || true)
[[ ! -f marker ]] || fail "file task header template executed without trust"
grep -qi "trust" <<<"$output" || fail "expected trust error for templated file task, got: $output"
rm pakro-tasks/evil

# a template in a version string requires trust and must not execute
cat <<'EOF' >pakro.toml
[tools]
tiny = "{{ exec(command='echo PWNED > marker') }}"
EOF
output=$(PAKRO_YES=0 pakro ls 2>&1 || true)
[[ ! -f marker ]] || fail "template executed in untrusted config"
grep -qi "trust" <<<"$output" || fail "expected trust error for template, got: $output"

# the same holds when the template contains a colon. that used to be rejected earlier, by the
# version parser rather than by the trust check, so pin that trust is still what stops it.
cat <<'EOF' >pakro.toml
[tools]
tiny = "{{ exec(command='echo PWNED: 1 > marker') }}"
EOF
output=$(PAKRO_YES=0 pakro ls 2>&1 || true)
[[ ! -f marker ]] || fail "colon template executed in untrusted config"
grep -qi "trust" <<<"$output" || fail "expected trust error for colon template, got: $output"

# a template in a task renders at load time, so it requires trust
cat <<'EOF' >pakro.toml
[tasks.hi]
run = "echo hi"
description = "{{ exec(command='echo PWNED > marker') }}"
EOF
output=$(PAKRO_YES=0 pakro tasks 2>&1 || true)
[[ ! -f marker ]] || fail "task template executed in untrusted config"
grep -qi "trust" <<<"$output" || fail "expected trust error for task template, got: $output"

# escaped Tera delimiters ({ == '{', } == '}') decode to a template
# after TOML parsing; this must not bypass the safety check and exec
printf '[tools]\ntiny = "\\u007b\\u007b exec(command=%stouch marker%s) \\u007d\\u007d"\n' "'" "'" >pakro.toml
output=$(PAKRO_YES=0 pakro ls 2>&1 || true)
[[ ! -f marker ]] || fail "escaped template executed in untrusted config (tools)"
grep -qi "trust" <<<"$output" || fail "expected trust error for escaped tools template, got: $output"

printf '[tasks.hi]\nrun = "echo hi"\ndescription = "\\u007b\\u007b exec(command=%stouch marker%s) \\u007d\\u007d"\n' "'" "'" >pakro.toml
output=$(PAKRO_YES=0 pakro tasks 2>&1 || true)
[[ ! -f marker ]] || fail "escaped template executed in untrusted config (tasks)"
grep -qi "trust" <<<"$output" || fail "expected trust error for escaped task template, got: $output"

# tool options can run code (postinstall) or alter installs (install_env)
cat <<'EOF' >pakro.toml
[tools]
tiny = { version = "3.1.0", postinstall = "touch marker" }
EOF
output=$(PAKRO_YES=0 pakro ls 2>&1 || true)
grep -qi "trust" <<<"$output" || fail "expected trust error for tool options, got: $output"

# env vars require trust
cat <<'EOF' >pakro.toml
[env]
FOO = "bar"
EOF
output=$(PAKRO_YES=0 pakro env 2>&1 || true)
grep -qi "trust" <<<"$output" || fail "expected trust error for env, got: $output"

# unsafe configs still load normally once trusted
pakro trust
assert_contains "pakro env" "FOO=bar"
