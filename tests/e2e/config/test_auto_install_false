#!/usr/bin/env bash

# Test that auto_install=false prevents ALL automatic installation

# Clean up any previous installs
pakro uninstall dummy@1.0.0 2>/dev/null || true
pakro uninstall dummy@ref:master 2>/dev/null || true

# Test 1: pakro exec with auto_install=false should NOT install tools passed as CLI args
cat <<EOF >pakro.toml
[settings]
auto_install = false
EOF

# This should fail because auto_install is disabled
assert_fail "pakro exec dummy@1.0.0 -- dummy --version" "couldn't exec process"

# Test 2: pakro exec with exec_auto_install=false should NOT install tools
cat <<EOF >pakro.toml
[settings]
exec_auto_install = false
EOF

assert_fail "pakro x dummy@1.0.0 -- dummy --version" "couldn't exec process"

# Test 3: pakro run with task_run_auto_install=false should NOT install tools
cat <<EOF >pakro.toml
[tools]
dummy = '1.0.0'

[settings]
task.run_auto_install = false

[tasks.test]
run = 'dummy --version'
EOF

assert_fail "pakro run test" "not found"

# Test 4: Verify auto_install=false cascades to sub-settings
pakro uninstall dummy@1.0.0 2>/dev/null || true

cat <<EOF >pakro.toml
[tools]
dummy = '1.0.0'

[settings]
auto_install = false

[tasks.test]
run = 'dummy --version'
EOF

# Both exec and run should fail when auto_install is false
assert_fail "pakro x dummy@ref:master -- dummy --version" "couldn't exec process"
assert_fail "pakro run test" "not found"

# Test 5: Verify that explicit install still works
assert "pakro install dummy@1.0.0"

# Now exec should work since it's already installed
assert "pakro x dummy@1.0.0 -- dummy --version"
assert "pakro run test"
