#!/usr/bin/env bash
set -euo pipefail

# Test for PAKRO_CEILING_PATHS functionality
# This tests that pakro respects the ceiling paths configuration
# which prevents traversing up the directory tree beyond specified paths

# Create a test directory structure
TEST_ROOT=$(pwd)

# Setup directory structure
mkdir -p "$TEST_ROOT/parent/child/grandchild"

# Create config files at different levels using heredoc
cat <<EOF >"$TEST_ROOT/parent/.pakro.toml"
[env]
PARENT = "true"
EOF

cat <<EOF >"$TEST_ROOT/parent/child/.pakro.toml"
[env]
CHILD = "true"
EOF

cat <<EOF >"$TEST_ROOT/parent/child/grandchild/.pakro.toml"
[env]
GRANDCHILD = "true"
EOF
cd "$TEST_ROOT/parent/child/grandchild"

# Test 1: Normal behavior without ceiling paths
echo "Test 1: Without ceiling paths, should find all configs up to parent"
assert_contains "pakro env" "export GRANDCHILD=true"
assert_contains "pakro env" "export CHILD=true"
assert_contains "pakro env" "export PARENT=true"
echo "Test 1: Passed"

# Test 2: Set ceiling path to child directory
echo "Test 2: With ceiling path at child, should not find parent or child config"
export PAKRO_CEILING_PATHS="$TEST_ROOT/parent/child"
assert_contains "pakro env" "export GRANDCHILD=true"
assert_not_contains "pakro env" "export CHILD=true"
assert_not_contains "pakro env" "export PARENT=true"
echo "Test 2: Passed"

# Test 3: Set ceiling path to grandchild directory
echo "Test 3: With ceiling path at grandchild, should not find any config"
export PAKRO_CEILING_PATHS="$TEST_ROOT/parent/child/grandchild"
assert_not_contains "pakro env" "export GRANDCHILD=true"
assert_not_contains "pakro env" "export CHILD=true"
assert_not_contains "pakro env" "export PARENT=true"
echo "Test 3: Passed"

# Test 4: Multiple ceiling paths
echo "Test 4: With multiple ceiling paths"
export PAKRO_CEILING_PATHS="$TEST_ROOT/parent/child:$TEST_ROOT/parent"
assert_contains "pakro env" "export GRANDCHILD=true"
assert_not_contains "pakro env" "export CHILD=true"
assert_not_contains "pakro env" "export PARENT=true"
echo "Test 4: Passed"

# Test 5: Ceiling path with nonexistent directory
echo "Test 5: With nonexistent ceiling path, should find all configs"
export PAKRO_CEILING_PATHS="$TEST_ROOT/nonexistent"
assert_contains "pakro env" "export GRANDCHILD=true"
assert_contains "pakro env" "export CHILD=true"
assert_contains "pakro env" "export PARENT=true"
echo "Test 5: Passed"

echo "All tests passed!"
