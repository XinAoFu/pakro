#!/usr/bin/env bash

# soft min_version: should warn and succeed, showing instructions
cat >instructions.toml <<'TOML'
message = "To update, run brew upgrade pakro"
TOML

cat >pakro.toml <<'TOML'
min_version = { soft = "9999.0.0" }
TOML

assert_contains 'PAKRO_SELF_UPDATE_AVAILABLE=false PAKRO_SELF_UPDATE_INSTRUCTIONS=./instructions.toml PAKRO_LOG_LEVEL=warn pakro ls 2>&1' 'recommended'
assert_contains 'PAKRO_SELF_UPDATE_AVAILABLE=false PAKRO_SELF_UPDATE_INSTRUCTIONS=./instructions.toml PAKRO_LOG_LEVEL=warn pakro ls 2>&1' 'brew upgrade pakro'
assert_not_contains 'PAKRO_SELF_UPDATE_AVAILABLE=false PAKRO_SELF_UPDATE_INSTRUCTIONS=./instructions.toml PAKRO_LOG_LEVEL=warn pakro ls 2>&1' 'self-update is disabled for this install'

# hard min_version: should fail and include instructions
cat >pakro.toml <<'TOML'
min_version = { hard = "9999.0.0" }
TOML

assert_fail 'PAKRO_SELF_UPDATE_AVAILABLE=false PAKRO_SELF_UPDATE_INSTRUCTIONS=./instructions.toml pakro ls 2>&1' 'is required'
assert_fail 'PAKRO_SELF_UPDATE_AVAILABLE=false PAKRO_SELF_UPDATE_INSTRUCTIONS=./instructions.toml pakro ls 2>&1' 'brew upgrade pakro'

# hard min_version without packager instructions: still has to say how to update
assert_fail 'PAKRO_SELF_UPDATE_AVAILABLE=false pakro ls 2>&1' 'self-update is disabled for this install'

# soft min_version without packager instructions: same
cat >pakro.toml <<'TOML'
min_version = { soft = "9999.0.0" }
TOML

assert_contains 'PAKRO_SELF_UPDATE_AVAILABLE=false PAKRO_LOG_LEVEL=warn pakro ls 2>&1' 'self-update is disabled for this install'

# self-update available: unchanged advice, no generic hint
assert_contains 'PAKRO_SELF_UPDATE_AVAILABLE=true PAKRO_LOG_LEVEL=warn pakro ls 2>&1' 'pakro self-update'
assert_not_contains 'PAKRO_SELF_UPDATE_AVAILABLE=true PAKRO_LOG_LEVEL=warn pakro ls 2>&1' 'self-update is disabled for this install'
