#!/usr/bin/env bash

# Test that plugins in [plugins] section are auto-installed during pakro install
# even when there are no corresponding tools in [tools]

# Use mise-env-fnox - an env-only plugin with no corresponding tool
rm -rf "$PAKRO_DATA_DIR/plugins/fnox-env"
pakro plugin uninstall fnox-env 2>/dev/null || true

# Create a config with only a plugin (no tools using it)
cat <<EOF >pakro.toml
[plugins]
fnox-env = "https://github.com/jdx/mise-env-fnox"
EOF

# Run pakro install - plugin should be auto-installed even with no tools
pakro install

# Verify plugin was actually installed (has git refs, not just registered)
# Using --refs shows URL and git info only for installed plugins
assert_contains "pakro plugin ls --refs" "fnox-env"
assert_contains "pakro plugin ls --refs" "https://github.com/jdx/mise-env-fnox"

# Now test with both a plugin-only entry and a tool
rm -rf "$PAKRO_DATA_DIR/plugins/fnox-env"
rm -rf "$PAKRO_DATA_DIR/plugins/zprint"
pakro plugin uninstall fnox-env 2>/dev/null || true
pakro plugin uninstall zprint 2>/dev/null || true

cat <<EOF >pakro.toml
[plugins]
fnox-env = "https://github.com/jdx/mise-env-fnox"
zprint = "https://github.com/mise-plugins/mise-zprint"

[tools]
zprint = "latest"
EOF

# Run pakro install - both plugins should be installed, zprint tool should be installed
pakro install

# Verify both plugins were actually installed (have git refs)
# The URL only appears in --refs output when the plugin is actually installed
assert_contains "pakro plugin ls --refs" "https://github.com/jdx/mise-env-fnox"
assert_contains "pakro plugin ls --refs" "https://github.com/mise-plugins/mise-zprint"

# Verify zprint tool was installed
assert_contains "pakro ls --installed zprint" "zprint"
