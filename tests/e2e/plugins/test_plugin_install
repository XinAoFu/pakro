#!/usr/bin/env bash

cat <<EOF >.tool-versions
tiny latest
shfmt latest
asdf:mise-plugins/mise-zprint latest
EOF

# install/uninstall multiple
pakro plugin install tiny shfmt zprint
assert_contains "pakro plugin ls" "tiny"
assert_contains "pakro plugin ls" "shfmt"
assert_contains "pakro plugin ls" "zprint"

rm -rf "$PAKRO_DATA_DIR/plugins/tiny"
pakro plugin install https://github.com/mise-plugins/mise-tiny.git
assert_contains "pakro plugin ls" "tiny"
pakro plugin install -f tiny
assert_contains "pakro plugin ls" "tiny"

rm -rf "$PAKRO_DATA_DIR/plugins/tiny"
pakro plugin install tiny https://github.com/mise-plugins/mise-tiny
assert_contains "pakro plugin ls" "tiny"

rm -rf "$PAKRO_DATA_DIR/plugins/tiny"
pakro plugin install tiny https://github.com/mise-plugins/mise-tiny/archive/refs/heads/main.zip
assert_contains "pakro plugin ls" "tiny"
