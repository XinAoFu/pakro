#!/usr/bin/env bash

assert_fail "pakro current tiny"

cat <<EOF >pakro.toml
[tool_alias]
tiny = "asdf:mise-plugins/mise-tiny"
EOF

pakro i tiny

pakro local tiny@sub-1:latest
assert "pakro current tiny" "2.1.0"

pakro local tiny@sub-1:lts
assert "pakro current tiny" "2.1.0"

pakro local tiny@sub-0.1:3.1
assert "pakro current tiny" "3.0.1"

pakro local tiny@sub-0.0.1:3.0.0
assert "pakro current tiny" "2.1.0"
