#!/usr/bin/env bash

cat >pakro.toml <<EOF
[tools]
tiny = {version = "latest", postinstall = "echo 'postinstall'"}
[plugins]
tiny-ref = "https://github.com/mise-plugins/rtx-tiny#c532b140abd4ca00d3e76651b9bd32a980bd483c"
EOF

pakro plugin install tiny

pakro ls

# this will fail when calling bin/list-all, but it won't stop it from executing
PAKRO_TINY_LIST_ALL_FAIL=1 PAKRO_TINY_VERSION=latest pakro env >/dev/null

# check bin/list-legacy-files
assert "pakro current tiny" "3.1.0"
pakro local --remove tiny

# Enable idiomatic version files for tiny
pakro settings set idiomatic_version_file_enable_tools tiny

echo "2.0" >.tiny-version
assert "pakro current tiny" "2.0.1"
rm .tiny-version
pakro local tiny@latest
assert "pakro current tiny" "3.1.0"

# test outdated/upgrade
pakro settings experimental=true
rm -rf "$PAKRO_DATA_DIR/installs/tiny"
pakro use tiny@3
mv "$PAKRO_DATA_DIR/installs/tiny/"{3.1.0,3.0.0}
assert "pakro current tiny" "3.0.0"
assert "pakro outdated tiny" "tiny  3  3.0.0  3.1.0 ~/workdir/pakro.toml"
pakro upgrade tiny
assert "pakro current tiny" "3.1.0"
assert "pakro outdated tiny" ""
