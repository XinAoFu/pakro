#!/usr/bin/env bash

echo "tiny 3.1.0" >.tool-versions

pakro install tiny
assert_contains "pakro ls --installed" "tiny"

pakro plugin uninstall tiny
assert_contains "pakro ls --installed" "tiny"

pakro plugin install tiny
assert_contains "pakro ls --installed" "tiny"

pakro plugin uninstall tiny --purge
assert_not_contains "pakro ls --installed" "tiny"
