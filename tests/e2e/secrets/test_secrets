#!/usr/bin/env bash
set -x

pakro use sops age
age="$(pakro x -- age-keygen 2>&1)"
age_pub="$(echo "$age" | grep -E "(Public key:|# public key:)" | head -1 | awk '{print $(NF)}')"
PAKRO_SOPS_AGE_KEY="$(echo "$age" | grep "AGE-SECRET-KEY")"
export PAKRO_SOPS_AGE_KEY

# json
echo '{ "SECRET": "mysecret" }' >.env.json
pakro x -- sops encrypt -i --age "$age_pub" .env.json
assert "pakro set _.file=.env.json"
assert_contains "pakro env" "export SECRET=mysecret"

# yaml
unset PAKRO_SOPS_AGE_KEY
pakro unset _.file
rm .env.json
age_output="$(pakro x -- age-keygen -o ~/age.txt 2>&1)"
age_pub="$(echo "$age_output" | grep -E "(Public key:|# public key:)" | head -1 | awk '{print $(NF)}')"
pakro settings set sops.age_key_file "~/age.txt"
echo 'SECRET: mysecret' >.env.yaml
pakro x -- sops encrypt -i --age "$age_pub" .env.yaml
export PAKRO_SOPS_AGE_KEY=
assert "pakro set _.file=.env.yaml"
assert_contains "pakro env" "export SECRET=mysecret"

# sops CLI
pakro settings set sops.rops 0
assert_contains "pakro env" "export SECRET=mysecret"

# ordered env directives can provide the sops key for subsequent _.file directives
pakro settings set sops.rops 1
pakro settings unset sops.age_key_file
cat >pakro.toml <<EOF
[env]
PAKRO_SOPS_AGE_KEY_FILE = "~/age.txt"
_.file = ".env.yaml"
EOF
assert_contains "pakro env" "export SECRET=mysecret"
assert_contains "pakro hook-env -s bash --force" "export SECRET=mysecret"
