#!/usr/bin/env bash
set -x

# Test that with age.strict=false, pakro continues when age key is not available

pakro u age

# Generate an age key
age="$(pakro x -- age-keygen 2>&1)"
age_pub="$(echo "$age" | grep "# public key:" | awk '{print $4}')"
PAKRO_AGE_KEY="$(echo "$age" | grep "AGE-SECRET-KEY")"
export PAKRO_AGE_KEY
# Encrypt the secret and add it to pakro.toml
pakro set --age-encrypt --age-recipient "$age_pub" SECRET=mysecret

# Verify that pakro env works when age key is set
assert_contains "pakro env" "SECRET=mysecret"

# Set non-strict mode
pakro settings set age.strict false

# Clear age key to simulate missing key
export PAKRO_AGE_KEY=
rm -f ~/.config/pakro/age.txt

# The env should not contain the decrypted secret since key is missing
assert_not_contains "pakro env" "export SECRET=mysecret"

# Test with strict=true (default behavior)
pakro settings set age.strict true

# This should fail
assert_fail "pakro env"
