#!/usr/bin/env bash

set -euo pipefail

export PAKRO_LOCKFILE=1
export PAKRO_CARGO_HOME="$PWD/cargo"
export PAKRO_RUSTUP_HOME="$PWD/rustup"

SERVER_ROOT="$PWD/server"
MANIFEST="$SERVER_ROOT/dist/channel-rust-nightly.toml"
mkdir -p "$SERVER_ROOT/dist" "$SERVER_ROOT/repos/rust-lang/rust" "$PAKRO_CARGO_HOME/bin" "$PAKRO_RUSTUP_HOME"
touch "$PAKRO_RUSTUP_HOME/settings.toml"
printf '[]\n' >"$SERVER_ROOT/repos/rust-lang/rust/releases"

write_manifest() {
  cat >"$MANIFEST" <<EOF
manifest-version = "2"
date = "$1"
EOF
}

write_manifest 2026-08-12

cat >"$PAKRO_CARGO_HOME/bin/rustup" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

echo "$*" >>"$CARGO_HOME/rustup.log"
case "${1:-} ${2:-}" in
	"show profile")
		echo minimal
		;;
	"toolchain install")
		mkdir -p "$RUSTUP_HOME/toolchains/$3"
		;;
	"toolchain uninstall")
		;;
	"component list" | "target list")
		;;
	*)
		echo "unexpected rustup args: $*" >&2
		exit 1
		;;
esac
EOF

cat >"$PAKRO_CARGO_HOME/bin/rustc" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
test -d "$RUSTUP_HOME/toolchains/$RUSTUP_TOOLCHAIN"
echo "rustc $RUSTUP_TOOLCHAIN"
EOF

cat >"$PAKRO_CARGO_HOME/bin/cargo" <<'EOF'
#!/usr/bin/env bash
echo cargo
EOF

chmod +x "$PAKRO_CARGO_HOME/bin/rustup" "$PAKRO_CARGO_HOME/bin/rustc" "$PAKRO_CARGO_HOME/bin/cargo"

start_http_server --dir "$SERVER_ROOT"

cat >pakro.toml <<EOF
[settings]
lockfile = true
url_replacements = { "https://static.rust-lang.org" = "http://127.0.0.1:$HTTP_PORT", "https://api.github.com" = "http://127.0.0.1:$HTTP_PORT" }

[tools]
rust = "dev"

[tool_alias.rust.versions]
dev = "nightly"
EOF

# A legacy literal-nightly install is not a reproducible fallback for offline use,
# including when the rolling channel is reached through an alias.
mkdir -p "$PAKRO_DATA_DIR/installs/rust"
ln -s "$PAKRO_CARGO_HOME/bin" "$PAKRO_DATA_DIR/installs/rust/nightly"
assert_fail_contains "PAKRO_OFFLINE=1 pakro exec -- rustc -V 2>&1" "cannot resolve rolling channel rust@nightly while offline"

cat >pakro.toml <<EOF
[settings]
lockfile = true
url_replacements = { "https://static.rust-lang.org" = "http://127.0.0.1:$HTTP_PORT", "https://api.github.com" = "http://127.0.0.1:$HTTP_PORT" }

[tools]
rust = "nightly"

[tool_alias.rust.versions]
dev = "nightly"
EOF

# Locking resolves the rolling channel without installing it or changing config.
pakro lock
assert_contains "cat pakro.lock" 'version = "nightly-2026-08-12"'
assert_not_contains "cat pakro.lock" 'version = "nightly"'
assert "test ! -e '$PAKRO_CARGO_HOME/rustup.log'"
assert_contains "cat pakro.toml" 'rust = "nightly"'

# Explicit tool filtering follows the same concrete-resolution path.
rm pakro.lock
pakro lock rust@nightly
assert_contains "cat pakro.lock" 'version = "nightly-2026-08-12"'
assert_not_contains "cat pakro.lock" 'version = "nightly"'

# Explicit aliases are resolved before rolling-channel detection.
rm pakro.lock
pakro lock rust@dev
assert_contains "cat pakro.lock" 'version = "nightly-2026-08-12"'
assert_not_contains "cat pakro.lock" 'version = "dev"'

pakro install
assert_contains "cat '$PAKRO_CARGO_HOME/rustup.log'" "toolchain install nightly-2026-08-12"
assert "PAKRO_OFFLINE=1 pakro exec -- rustc -V" "rustc nightly-2026-08-12"

# Advancing the manifest makes the channel outdated and upgrade updates the lock,
# while the configured selector remains rolling.
write_manifest 2026-08-13
assert_contains "pakro outdated rust" "nightly-2026-08-13"
pakro upgrade rust --no-prune
assert_contains "cat pakro.lock" 'version = "nightly-2026-08-13"'
assert_contains "cat pakro.toml" 'rust = "nightly"'
assert_contains "cat '$PAKRO_CARGO_HOME/rustup.log'" "toolchain install nightly-2026-08-13"

# An explicit dated nightly remains pinned unless --bump is requested.
cat >pakro.toml <<EOF
[settings]
lockfile = true
url_replacements = { "https://static.rust-lang.org" = "http://127.0.0.1:$HTTP_PORT", "https://api.github.com" = "http://127.0.0.1:$HTTP_PORT" }

[tools]
rust = "nightly-2026-08-12"
EOF
write_manifest 2026-08-14
assert_not_contains "pakro outdated rust" "nightly-2026-08-14"
assert_contains "pakro outdated --bump rust" "nightly-2026-08-14"
pakro upgrade --bump rust --no-prune
assert_contains "cat pakro.toml" 'rust = "nightly-2026-08-14"'
assert_contains "cat '$PAKRO_CARGO_HOME/rustup.log'" "toolchain install nightly-2026-08-14"

# A malformed manifest must not replace a valid existing lock entry.
cat >pakro.toml <<EOF
[settings]
lockfile = true
url_replacements = { "https://static.rust-lang.org" = "http://127.0.0.1:$HTTP_PORT", "https://api.github.com" = "http://127.0.0.1:$HTTP_PORT" }

[tools]
rust = "nightly"
EOF
cp pakro.lock pakro.lock.before
printf 'manifest-version = "2"\ndate = "invalid"\n' >"$MANIFEST"
assert_fail_contains "pakro lock --bump 2>&1" "invalid Rust nightly channel manifest date"
assert "cmp pakro.lock.before pakro.lock"

# A broken nightly manifest does not prevent listing stable Rust releases.
pakro cache clear rust
assert_contains "pakro ls-remote --no-versions-host rust" "stable"

write_manifest 2026-08-14
pakro cache clear rust
assert_contains "pakro ls-remote --no-versions-host rust" "nightly-2026-08-14"
