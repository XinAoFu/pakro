#!/usr/bin/env bash

export PAKRO_NODE_COREPACK=1
export PAKRO_NODE_DEFAULT_PACKAGES_FILE="$PWD/.default-npm-packages"
export NPM_CONFIG_FUND=false

# Use Node 24 (LTS) for corepack tests since Node 25+ removed corepack
corepack_version=$(pakro latest node@24)
echo "v$corepack_version" >.node-version
echo "zx" >"$PAKRO_NODE_DEFAULT_PACKAGES_FILE"

# Enable idiomatic version files for node
pakro settings set idiomatic_version_file_enable_tools node

pakro i node@lts/hydrogen
pakro i -f node
hydrogen_path="$(pakro where node@lts/hydrogen)"
assert "pakro x node@$corepack_version -- $hydrogen_path/bin/npm config get prefix" "$hydrogen_path"
assert_contains "pakro x node@lts/hydrogen -- node --version" "v18."
assert "pakro x -- node --version" "v$corepack_version"
assert_contains "pakro x -- which yarn" "yarn"
assert_contains "pakro x -- which zx" "zx"

pakro use nodejs@20.1.0
pakro ls
assert "pakro x -- node --version" "v20.1.0"
assert_contains "pakro ls-remote nodejs" "20.1.0"

# a `nodejs` key is the same tool as `node`: rename it in place instead of adding a
# second key, which would silently outvote the one just written
cat >pakro.toml <<EOF
[tools]
nodejs = "20.1.0" # keep me
EOF
pakro use nodejs@20.1.0
assert "cat pakro.toml" '[tools]
node = "20.1.0" # keep me'

pakro use --rm node
