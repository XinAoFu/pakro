#!/usr/bin/env bash

if [[ ${PAKRO_DISABLE_TOOLS:-} == *deno* ]]; then
  warn "Skipping deno tests"
  exit 0
fi

cat <<EOF >.deno-version
1.43.3
EOF

# Enable idiomatic version files for deno
pakro settings set idiomatic_version_file_enable_tools deno

pakro i deno
assert_contains "pakro x deno -- deno -V" "deno 1.43.3"
