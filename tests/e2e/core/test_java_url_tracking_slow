#!/usr/bin/env bash

# Test Java plugin URL tracking functionality
export PAKRO_LOCKFILE=1
export PAKRO_EXPERIMENTAL=1

# Clean up any existing installations
pakro uninstall java@17.0.2 2>/dev/null || true

# Create initial configuration
cat <<EOF >pakro.toml
[tools]
java = { version = "17.0.2" }
EOF

# Create lockfile
touch pakro.lock

# First install - should fetch URL from Java metadata API
echo "=== First install - fetching URL from Java metadata API ==="
pakro install
assert_contains "pakro x java -- java -version 2>&1" 'openjdk version "17.0.2"'

# Verify URL is stored in lockfile
echo "=== Verifying URL is stored in lockfile ==="
assert_contains "cat pakro.lock" '[[tools.java]]'
assert_contains "cat pakro.lock" 'version = "17.0.2"'
assert_contains "cat pakro.lock" 'backend = "core:java"'
assert_contains "cat pakro.lock" 'url ='

# Uninstall and reinstall - should reuse URL from lockfile
echo "=== Reinstalling - should reuse URL from lockfile ==="
pakro uninstall java@17.0.2
pakro install
assert_contains "pakro x java -- java -version 2>&1" 'openjdk version "17.0.2"'

# Verify the tool still works after reinstall
echo "=== Verifying tool still works after reinstall ==="
assert_contains "pakro x java -- java -version 2>&1" 'openjdk version "17.0.2"'

echo "=== Java URL tracking test completed successfully ==="
