#!/usr/bin/env bash

# Test that core:elixir resolves lockfile URLs without installing first.
export PAKRO_LOCKFILE=1

detect_platform
CURRENT_PLATFORM="$PAKRO_PLATFORM"

cat <<'EOF' >pakro.toml
[tools]
elixir = "1.19.5-otp-28"
EOF

rm -f pakro.lock
pakro uninstall elixir@1.19.5-otp-28 2>/dev/null || true

pakro lock --platform "$CURRENT_PLATFORM"

assert_contains "cat pakro.lock" '[[tools.elixir]]'
assert_contains "cat pakro.lock" 'version = "1.19.5-otp-28"'
assert_contains "cat pakro.lock" "\"platforms.$CURRENT_PLATFORM\""
assert_contains "cat pakro.lock" 'url = "https://builds.hex.pm/builds/elixir/v1.19.5-otp-28.zip"'
assert_contains "cat pakro.lock" 'checksum = "sha256:'

assert "pakro install --locked --dry-run"
