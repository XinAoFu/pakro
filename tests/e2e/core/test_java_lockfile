#!/usr/bin/env bash

# Test that core:java resolves lockfile URLs without installing first.
export PAKRO_LOCKFILE=1

detect_platform
CURRENT_PLATFORM="$PAKRO_PLATFORM"
if [[ $PAKRO_PLATFORM_OS == "linux" ]] && type -P ldd >/dev/null && ldd --version 2>&1 | grep -qi musl; then
  CURRENT_PLATFORM="$CURRENT_PLATFORM-musl"
fi

cat <<'EOF' >pakro.toml
[tools]
java = "corretto-17.0.2.8.1"
EOF

rm -f pakro.lock
pakro uninstall java@corretto-17.0.2.8.1 2>/dev/null || true

pakro lock --platform "$CURRENT_PLATFORM,windows-x64"

assert_contains "cat pakro.lock" '[[tools.java]]'
assert_contains "cat pakro.lock" 'version = "corretto-17.0.2.8.1"'
assert_contains "cat pakro.lock" "\"platforms.$CURRENT_PLATFORM\""
assert_contains "cat pakro.lock" 'checksum = "'
assert_contains "cat pakro.lock" 'url = "https://'
assert_contains "cat pakro.lock" '"platforms.windows-x64"'
assert_contains "cat pakro.lock" 'amazon-corretto-17.0.2.8.1-windows-x64-jdk.zip'

assert "pakro install --locked --dry-run"
