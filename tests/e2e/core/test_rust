#!/usr/bin/env bash

export PAKRO_RUSTUP_HOME="$PAKRO_DATA_DIR/rustup"
export PAKRO_CARGO_HOME="$PAKRO_DATA_DIR/cargo"

assert_contains "pakro x rust@1.81.0 -- rustc --version" "rustc 1.81.0"

pakro settings set idiomatic_version_file_enable_tools rust

cat <<EOF >rust-toolchain.toml
[toolchain]
channel = "1.81.0"
EOF

assert_contains "pakro x -- rustc --version" "rustc 1.81.0"
