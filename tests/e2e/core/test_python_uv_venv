#!/usr/bin/env bash

set -euo pipefail

export PAKRO_EXPERIMENTAL=1
export PAKRO_PYTHON_GITHUB_ATTESTATIONS=0

# Test uv is used for manually defined venv
cat >pakro.toml <<EOF
[env._.python]
venv = {path = "my_venv", create=true}

[tools]
python = "3.12.3"
uv = "0.5.4"
EOF

pakro i
assert "pakro x -- python --version" "Python 3.12.3"
assert_contains "pakro x -- uv --version" "uv 0.5.4"
assert "pakro env -s bash | grep VIRTUAL_ENV" "export VIRTUAL_ENV=$PWD/my_venv"
assert "pakro x -- which python" "$PWD/my_venv/bin/python"
assert_not_contains "ls $PWD/my_venv/" "include" # stdlib virtual venv has an "include" folder while uv doesn't

# Test "source" mode - only sources existing venv, doesn't create
rm -rf .venv
rm -f uv.lock

cat >pakro.toml <<EOF
[tools]
python = "3.12.3"
uv = "0.5.4"

[settings]
python.uv_venv_auto = "source"
EOF

touch uv.lock

# Without a .venv, should use system python path (not .venv)
assert_not_contains "pakro env -s bash" "VIRTUAL_ENV"

# Create venv manually
pakro x -- uv venv

# Now it should source the existing venv
assert_contains "pakro env -s bash" "VIRTUAL_ENV=$PWD/.venv"
assert "pakro x -- which python" "$PWD/.venv/bin/python"
# source mode should NOT set UV_PYTHON
assert_not_contains "pakro env -s bash" "UV_PYTHON"

# Test "create|source" mode - creates venv if missing, sources it
rm -rf .venv

cat >pakro.toml <<EOF
[tools]
python = "3.12.3"
uv = "0.5.4"

[settings]
python.uv_venv_auto = "create|source"
EOF

# Should create venv automatically and source it
assert_contains "pakro env -s bash" "VIRTUAL_ENV=$PWD/.venv"
assert "pakro x -- which python" "$PWD/.venv/bin/python"
# create|source mode should NOT set UV_PYTHON (unlike legacy true)
assert_not_contains "pakro env -s bash" "UV_PYTHON"

# Test legacy "true" mode - should set UV_PYTHON
# this will be deprecated in future releases
rm -rf .venv

cat >pakro.toml <<EOF
[tools]
python = "3.12.3"
uv = "0.5.4"

[settings]
python.uv_venv_auto = true
EOF

# Should create venv and source it
assert_contains "pakro env -s bash" "VIRTUAL_ENV=$PWD/.venv"
assert "pakro x -- which python" "$PWD/.venv/bin/python"
# legacy true mode SHOULD set UV_PYTHON
assert_contains "pakro env -s bash" "UV_PYTHON"

# Test UV_PROJECT_ENVIRONMENT from pakro config in source mode
rm -rf .venv my.venv

cat >pakro.toml <<EOF
[tools]
python = "3.12.3"
uv = "0.5.4"

[env]
UV_PROJECT_ENVIRONMENT = "my.venv"

[settings]
python.uv_venv_auto = "source"
EOF

# Create the fixture with an explicit path so this test isolates pakro's
# UV_PROJECT_ENVIRONMENT sourcing behavior from the pinned uv version.
pakro x -- uv venv my.venv
assert_contains "pakro env -s bash" "VIRTUAL_ENV=$PWD/my.venv"
assert_directory_not_exists ".venv"

# Test create|source creates the configured environment instead of .venv
rm -rf my.venv
sed -i.bak 's/uv_venv_auto = "source"/uv_venv_auto = "create|source"/' pakro.toml
rm pakro.toml.bak
assert_contains "pakro env -s bash" "VIRTUAL_ENV=$PWD/my.venv"
assert_directory_exists "my.venv"
assert_directory_not_exists ".venv"

# Test UV_PROJECT_ENVIRONMENT from the process environment
cat >pakro.toml <<EOF
[tools]
python = "3.12.3"
uv = "0.5.4"

[settings]
python.uv_venv_auto = "source"
EOF

mkdir -p process.venv/bin absolute.venv/bin
UV_PROJECT_ENVIRONMENT=process.venv assert_contains "pakro env -s bash" "VIRTUAL_ENV=$PWD/process.venv"
UV_PROJECT_ENVIRONMENT="$PWD/absolute.venv" assert_contains "pakro env -s bash" "VIRTUAL_ENV=$PWD/absolute.venv"

# Explicitly removing the config value must not fall back to the process environment
cat >>pakro.toml <<EOF

[env]
UV_PROJECT_ENVIRONMENT = false
EOF
mkdir -p .venv/bin
UV_PROJECT_ENVIRONMENT=process.venv assert_contains "pakro env -s bash" "VIRTUAL_ENV=$PWD/.venv"

# Test boolean parsing from env vars - "true","1", "yes",  should all work
rm -rf .venv my.venv process.venv absolute.venv

cat >pakro.toml <<EOF
[tools]
python = "3.12.3"
uv = "0.5.4"
EOF

PAKRO_PYTHON_UV_VENV_AUTO=true assert_contains "pakro env -s bash" "VIRTUAL_ENV=$PWD/.venv"
rm -rf .venv
PAKRO_PYTHON_UV_VENV_AUTO=yes assert_contains "pakro env -s bash" "VIRTUAL_ENV=$PWD/.venv"
rm -rf .venv
PAKRO_PYTHON_UV_VENV_AUTO=1 assert_contains "pakro env -s bash" "VIRTUAL_ENV=$PWD/.venv"

# Test "0", "no", "false" should disable
PAKRO_PYTHON_UV_VENV_AUTO=false assert_not_contains "pakro env -s bash" "VIRTUAL_ENV"
PAKRO_PYTHON_UV_VENV_AUTO=no assert_not_contains "pakro env -s bash" "VIRTUAL_ENV"
PAKRO_PYTHON_UV_VENV_AUTO=0 assert_not_contains "pakro env -s bash" "VIRTUAL_ENV"

# Test shim exclusion: the pakro uv shim must NOT be called internally when creating
# a venv via uv_venv_auto — doing so would trigger `pakro exec`, which re-enters
# env resolution and causes infinite subprocess recursion.
rm -rf .venv uv.lock
mkdir -p "$PAKRO_DATA_DIR/shims"
rm -f "$PAKRO_DATA_DIR/shims/uv"
cat >"$PAKRO_DATA_DIR/shims/uv" <<'SHIM'
#!/bin/bash
echo "ERROR: pakro uv shim was invoked during venv creation" >&2
exit 99
SHIM
chmod +x "$PAKRO_DATA_DIR/shims/uv"
ORIG_PATH="$PATH"
export PATH="$PAKRO_DATA_DIR/shims:$PATH"
cat >pakro.toml <<EOF
[settings]
python.uv_venv_auto = "create|source"
EOF
touch uv.lock
# which_no_shims() skips $PAKRO_DATA_DIR/shims, so the fake shim is never called;
# since no real uv is available either, venv creation is silently skipped.
output=$(pakro env -s bash 2>&1 || true)
assert_not_contains "printf '%s' \"$output\"" "ERROR: pakro uv shim was invoked during venv creation"
rm -f "$PAKRO_DATA_DIR/shims/uv" uv.lock
export PATH="$ORIG_PATH"

