#!/usr/bin/env bash

assert "pakro use erlang@27.2"
assert_contains "pakro x -- erl -eval 'erlang:display(erlang:system_info(otp_release)), halt().' -noshell" "27"
assert_contains "pakro x elixir@1.17.3 -- elixir --version 2>&1" "Elixir 1.17.3"
assert_contains "pakro x elixir@1.17.3 -- mix --version 2>&1" "Mix 1.17.3"

assert_not_contains "pakro env" "MIX_HOME"
assert_not_contains "pakro env" "MIX_ARCHIVES"
assert "pakro use elixir@1.17.3"
assert_contains "pakro env" "MIX_HOME"
assert_contains "pakro env" "MIX_ARCHIVES"

# Test that MIX_HOME is not overridden when set via pakro set
assert "pakro set MIX_HOME=/pakro/set/mix/home"
assert_contains "pakro env" "MIX_HOME=/pakro/set/mix/home"
assert "pakro unset MIX_HOME"

# Test that MIX_ARCHIVES is not overridden when set via pakro set
assert "pakro set MIX_ARCHIVES=/pakro/set/mix/archives"
assert_contains "pakro env" "MIX_ARCHIVES=/pakro/set/mix/archives"
assert "pakro unset MIX_ARCHIVES"

# Test that MIX_HOME is not overridden when set in pristine environment
# When env var is already set, pakro won't set it, so it won't appear in pakro env output
assert_not_contains "MIX_HOME=/custom/mix/home pakro env" "MIX_HOME="

# Test that MIX_ARCHIVES is not overridden when set in pristine environment
# When env var is already set, pakro won't set it, so it won't appear in pakro env output
assert_not_contains "MIX_ARCHIVES=/custom/mix/archives pakro env" "MIX_ARCHIVES="
