#!/usr/bin/env bash

# Test that precompiled Ruby binaries from jdx/ruby are the default
assert_contains "pakro use ruby@3.4.1 2>&1" "ruby@3.4.1"
assert_contains "pakro x -- ruby --version" "ruby 3.4.1"

# Verify the installation works
assert_succeed "pakro x -- gem --version"

# Clean up
rm pakro.toml
pakro rm ruby@3.4.1
