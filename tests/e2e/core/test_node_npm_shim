#!/usr/bin/env bash

# Tests the node.npm_shim setting plumbing (config + PAKRO_NODE_NPM_SHIM env).
# The install-time behavior is covered by test_node_npm_shim_slow.

# Defaults to true (preserves the historical npm wrapper behavior).
assert "pakro settings get node.npm_shim" "true"

# Configurable via `pakro settings set` / pakro.toml.
pakro settings set node.npm_shim false
assert "pakro settings get node.npm_shim" "false"
pakro settings unset node.npm_shim
assert "pakro settings get node.npm_shim" "true"

# Overridable via the PAKRO_NODE_NPM_SHIM env var.
PAKRO_NODE_NPM_SHIM=0 assert "pakro settings get node.npm_shim" "false"
PAKRO_NODE_NPM_SHIM=1 assert "pakro settings get node.npm_shim" "true"
