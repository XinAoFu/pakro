#!/usr/bin/env bash

echo "golang 1.20" >.tool-versions
mkdir 21
echo "golang 1.21" >21/.tool-versions

export PAKRO_GO_SET_GOPATH=1

eval "$(pakro activate bash)"
_pakro_hook

GO_20=$(pakro latest golang@1.20)
GO_21=$(pakro latest golang@1.21)

pakro i golang@1.20 golang@1.21 && _pakro_hook

assert "go env GOPATH" "$PAKRO_DATA_DIR/installs/go/$GO_20/packages"
cd 21 && _pakro_hook
assert "go env GOPATH" "$PAKRO_DATA_DIR/installs/go/$GO_21/packages"
cd .. && _pakro_hook
assert "go env GOPATH" "$PAKRO_DATA_DIR/installs/go/$GO_20/packages"
