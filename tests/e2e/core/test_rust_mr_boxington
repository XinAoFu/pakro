#!/usr/bin/env bash

set -euo pipefail

unset PAKRO_CARGO_HOME PAKRO_RUSTUP_HOME
export PAKRO_OFFLINE=1
export PAKRO_ENV_CACHE=1

CONFIG_CARGO_HOME="$PWD/config-cargo"
CONFIG_RUSTUP_HOME="$PWD/config-rustup"
mkdir -p "$CONFIG_CARGO_HOME/bin" "$CONFIG_RUSTUP_HOME"
touch "$CONFIG_RUSTUP_HOME/settings.toml"

cat >"$CONFIG_CARGO_HOME/bin/cargo" <<'EOF'
#!/usr/bin/env bash
echo "cargo:$RUSTUP_TOOLCHAIN:$*"
EOF

cat >"$CONFIG_CARGO_HOME/bin/rustc" <<'EOF'
#!/usr/bin/env bash
echo "rustc ${RUSTUP_TOOLCHAIN:-unknown}"
EOF

cat >"$CONFIG_CARGO_HOME/bin/rustup" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

echo "$*" >>"$CARGO_HOME/rustup.log"

case "$1 $2" in
	"show profile")
		echo minimal
		;;
	"component list")
		echo rustfmt
		;;
	"toolchain install")
		mkdir -p "$RUSTUP_HOME/toolchains/$3"
		;;
	"toolchain uninstall")
		;;
	*)
		echo "unexpected rustup args: $*" >&2
		exit 1
		;;
esac
EOF

chmod +x "$CONFIG_CARGO_HOME/bin/cargo" "$CONFIG_CARGO_HOME/bin/rustc" "$CONFIG_CARGO_HOME/bin/rustup"

mkdir -p "$PWD/mbx/bin"
cat >"$PWD/mbx/bin/mbx" <<'EOF'
#!/usr/bin/env bash
printf 'mbx:%s\n' "$MBX_CARGO_SHIM_MODE"
exec cargo "$@"
EOF
chmod +x "$PWD/mbx/bin/mbx"

cat >pakro.toml <<EOF
[env]
PAKRO_CARGO_HOME = "$CONFIG_CARGO_HOME"
PAKRO_RUSTUP_HOME = "$CONFIG_RUSTUP_HOME"
[tools]
rust = { version = "1.81.0", components = ["rustfmt"] }
[tasks.check]
run = "cargo check"
[tasks.unwrapped]
tools = { rust = { version = "1.81.0", mr_boxington = false } }
run = "cargo check"
EOF

pakro use --tool-option mr_boxington=true rust@1.81.0 "mr-boxington@path:$PWD/mbx"
assert "pakro config get tools.rust.mr_boxington" "true"
assert_contains "cat pakro.toml" 'mr_boxington = true'
assert_contains "cat pakro.toml" 'components = ["rustfmt"]'
assert "pakro exec -- cargo check" "mbx:1
cargo:1.81.0:check"
assert "pakro run check 2>/dev/null" "mbx:1
cargo:1.81.0:check"
assert_contains "pakro hook-env -s bash --force" "$PAKRO_DATA_DIR/command-wrappers/bin"
assert "'$PAKRO_DATA_DIR/shims/cargo' check" "mbx:1
cargo:1.81.0:check"
(
  eval "$(pakro activate bash --shims)"
  assert "cargo check" "mbx:1
cargo:1.81.0:check"
)

assert "pakro exec 'rust[mr_boxington=false]@1.81.0' -- cargo check" "cargo:1.81.0:check"
assert "pakro run unwrapped 2>/dev/null" "cargo:1.81.0:check"

# Safe mode ignores project-provided wrapping.
assert "PAKRO_CARGO_HOME='$CONFIG_CARGO_HOME' PAKRO_RUSTUP_HOME='$CONFIG_RUSTUP_HOME' PAKRO_SAFE=1 pakro exec -- cargo check" "cargo:1.81.0:check"

# Project overrides turn off a global/parent default.
mkdir child
(
  cd child
  printf '[tools]\nrust = { version = "1.81.0", mr_boxington = false }\n' >pakro.toml
  assert "pakro exec -- cargo check" "cargo:1.81.0:check"
  assert "'$PAKRO_DATA_DIR/shims/cargo' check" "cargo:1.81.0:check"
  printf '[tools]\nrust = "1.81.0"\n' >pakro.toml
  assert "pakro exec -- cargo check" "cargo:1.81.0:check"
)

# Task and exec opt-ins work without a previously generated wrapper.
pakro use --tool-option mr_boxington=false rust@1.81.0
pakro reshim
assert_fail "test -e '$PAKRO_DATA_DIR/command-wrappers/bin/cargo'"
cat >>pakro.toml <<'EOF'
[tasks.wrapped]
tools = { rust = { version = "1.81.0", mr_boxington = true } }
run = "cargo check"
EOF
assert "pakro run wrapped 2>/dev/null" "mbx:1
cargo:1.81.0:check"
assert "pakro run check 2>/dev/null" "cargo:1.81.0:check"
# A Windows exe- or file-mode shim runs `pakro x -- cargo` with __PAKRO_SHIM_PATH
# set, and must still see the task's tools to find its wrapper (#13671).
cat >>pakro.toml <<'EOF'
[tasks.wrapped-native]
tools = { rust = { version = "1.81.0", mr_boxington = true } }
run = '__PAKRO_SHIM_PATH="$PAKRO_DATA_DIR/command-wrappers/bin/cargo" pakro x -- cargo check'
EOF
assert "pakro run wrapped-native 2>/dev/null" "mbx:1
cargo:1.81.0:check"
assert "pakro run wrapped 2>/dev/null" "mbx:1
cargo:1.81.0:check"
pakro reshim
assert "pakro exec 'rust[mr_boxington=true]@1.81.0' -- cargo check" "mbx:1
cargo:1.81.0:check"

# Explicit wrappers take precedence.
cat >>pakro.toml <<'EOF'
[wrappers.cargo]
command = "echo"
args = ["custom"]
EOF
assert "pakro exec -- cargo check" "custom check"

# Missing dependencies produce actionable errors, not accidental PATH fallbacks.
cat >pakro.toml <<EOF
[env]
PAKRO_CARGO_HOME = "$CONFIG_CARGO_HOME"
PAKRO_RUSTUP_HOME = "$CONFIG_RUSTUP_HOME"
[tools]
rust = { version = "1.81.0", mr_boxington = true }
EOF
assert_fail_contains "pakro exec -- cargo check 2>&1" "requires mr-boxington in [tools]"
cat >>pakro.toml <<'EOF'
[wrappers.cargo]
command = "echo"
args = ["custom"]
EOF
assert "pakro exec -- cargo check" "custom check"

: >pakro.toml
pakro reshim
assert_fail "test -e '$PAKRO_DATA_DIR/command-wrappers/bin/cargo'"
