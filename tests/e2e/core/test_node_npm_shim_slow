#!/usr/bin/env bash

# Tests the node.npm_shim setting (PAKRO_NODE_NPM_SHIM).
# By default pakro installs a bash wrapper at bin/npm that runs `pakro reshim`
# after global installs. Setting node.npm_shim=false skips that wrapper so
# bin/npm stays node's own npm (letting corepack or `npm i -g npm@x` manage it).

node_version="$(pakro latest node@22)"

# Default: the npm shim is installed, so bin/npm is the pakro bash wrapper.
pakro i -f "node@$node_version"
node_path="$(pakro where "node@$node_version")"
assert_succeed "grep -q 'pakro reshim' '$node_path/bin/npm'"
assert_succeed "test ! -L '$node_path/bin/npm'"
assert_contains "pakro x node@$node_version -- npm --version" "."

# Opt out: bin/npm is node's own npm (a symlink), not the pakro wrapper.
export PAKRO_NODE_NPM_SHIM=0
pakro i -f "node@$node_version"
node_path="$(pakro where "node@$node_version")"
assert_fail "grep -q 'pakro reshim' '$node_path/bin/npm'"
assert_succeed "test -L '$node_path/bin/npm'"
assert_contains "pakro x node@$node_version -- npm --version" "."

# Corepack: ensure npm is managed by corepack, when node.corepack=true and node.npm_shim=false.
export PAKRO_NODE_NPM_SHIM=0
export PAKRO_NODE_COREPACK=1
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
pakro i -y -f "node@$node_version"
node_path="$(pakro where "node@$node_version")"
assert_fail "grep -q 'pakro reshim' '$node_path/bin/npm'"
assert_succeed "test -L '$node_path/bin/npm'"
assert_contains "realpath '$node_path/bin/npm'" "/corepack/"
assert_contains "pakro x node@$node_version -- npm --version" "."
