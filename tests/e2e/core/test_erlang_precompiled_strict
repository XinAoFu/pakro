#!/usr/bin/env bash

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "Skipping Linux-specific test on non-Linux OS"
  exit 0
fi

cat <<'EOF' >pakro.toml
[settings.erlang]
compile = false
EOF

if output="$(PAKRO_FRIENDLY_ERROR=1 RUST_BACKTRACE=0 ImageOS=nobara-43 pakro install erlang@28.5 2>&1)"; then
  fail "expected erlang install to fail when precompiled binaries are unavailable"
fi

[[ $output == *"precompiled erlang is not available: unsupported OS version: nobara-43"* ]] ||
  fail "expected unsupported OS error, got: $output"

[[ $output != *"build-install"* ]] ||
  fail "erlang.compile=false should not fall back to kerl build-install: $output"

export PAKRO_LOCKFILE=1
detect_platform

cat <<'EOF' >pakro.toml
[tools]
erlang = "28.5"

[settings.erlang]
compile = false
precompiled_os = "ubuntu-22.04"
EOF

pakro lock --platform "$PAKRO_PLATFORM"
assert_contains "cat pakro.lock" 'precompiled_os = "ubuntu-22.04"'
assert_matches "cat pakro.lock" 'url = "https://builds\.hex\.pm/builds/otp/(amd64|arm64)/ubuntu-22\.04/OTP-28\.5\.tar\.gz"'

rm -f pakro.lock
sed -i 's/ubuntu-22\.04/ubuntu-26.04/' pakro.toml
pakro lock --platform "$PAKRO_PLATFORM"
assert_contains "cat pakro.lock" 'precompiled_os = "ubuntu-26.04"'
assert_matches "cat pakro.lock" 'url = "https://builds\.hex\.pm/builds/otp/(amd64|arm64)/ubuntu-26\.04/OTP-28\.5\.tar\.gz"'
