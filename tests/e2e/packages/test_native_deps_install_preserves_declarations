#!/usr/bin/env bash
source "$TEST_DIR/f3_shared_wheel_helpers.sh"
f3_setup
mkdir -p project
cat >project/pakro.toml <<'TOML'
[tools]
python = "3.13.16"
[packages."python@3.13.16"]
z-root = "1.0"
TOML
cat >project/pyproject.toml <<'TOML'
[project]
name = "cli-fixture"
version = "1.0"
requires-python = ">=99"
dependencies = ["never-requested==999"]
TOML
printf 'another-unobserved-package==999\n' >project/requirements.txt
cat >project/pakro.lock <<'TOML'
lockfile_version = 3
# Unrelated lock bytes and comments must remain exactly intact.
[tools]
[future]
value = 'preserved-native-value'
TOML
cd project
before="$(cksum pakro.toml pyproject.toml requirements.txt)"
pakro deps install python
[[ $(cksum pakro.toml pyproject.toml requirements.txt) == "$before" ]] || fail "deps install edited developer files"
grep -Fq '# Unrelated lock bytes and comments must remain exactly intact.' pakro.lock || fail 'deps install removed native lock comments'
grep -Fq "value = 'preserved-native-value'" pakro.lock || fail 'deps install removed unknown native lock content'
grep -Fq '[python]' pakro.lock || fail 'deps install did not generate the exact Python graph'
lock_after_install="$(cksum pakro.lock)"
requests_before="$(f3_request_count)"
printf 'not valid TOML after installation\n' >pyproject.toml
printf 'not a supported requirements declaration\n' >requirements.txt
before="$(cksum pakro.toml pyproject.toml requirements.txt)"
pakro deps install python
[[ $(f3_request_count) == "$requests_before" ]] || fail "repeated deps install fetched a complete existing closure"
[[ $(cksum pakro.lock) == "$lock_after_install" ]] || fail 'repeated deps install rewrote the exact lock'
eval "$(pakro activate bash)"
eval "$(pakro hook-env -s bash --force)"
assert "python -m z_root" 'shared-dependency:pth-visible'
assert "z-root-cli" 'shared-dependency:pth-visible'
[[ $(cksum pakro.toml pyproject.toml requirements.txt) == "$before" && $(cksum pakro.lock) == "$lock_after_install" ]] || fail "directory selection edited developer files or the exact lock"
[[ ! -d .venv && ! -d .pakro/venvs ]] || fail "deps install created a project runtime copy"
f3_assert_no_manager
