#!/usr/bin/env bash
set -euo pipefail

# End-to-end: go runtime with GOMODCACHE pointed at the pakro store. A
# stdlib-only project (no network needed for modules) verifies the env var
# and that builds work through the store.

cat >pakro.toml <<'EOF'
[tools]
go = "1.23.4"
EOF

cat >go.mod <<'EOF'
module example.com/e2e

go 1.23
EOF

cat >main.go <<'EOF'
package main

import "fmt"

func main() {
  fmt.Println("hello from pakro store")
}
EOF

pakro i

# GOMODCACHE points at the pakro store
assert "pakro x -- go env GOMODCACHE" "${PAKRO_DATA_DIR}/store/go/mod"

# builds work through the store
assert "pakro x -- go run main.go" "hello from pakro store"

# a second project shares the same cache
mkdir -p proj2
cat >proj2/pakro.toml <<'EOF'
[tools]
go = "1.23.4"
EOF

cat >proj2/go.mod <<'EOF'
module example.com/e2e2

go 1.23
EOF

(
  cd proj2
  pakro i
  assert "pakro x -- go env GOMODCACHE" "${PAKRO_DATA_DIR}/store/go/mod"
)
