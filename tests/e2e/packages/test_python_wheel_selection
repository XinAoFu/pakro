#!/usr/bin/env bash
export NO_PROXY=127.0.0.1,localhost,::1
export no_proxy="$NO_PROXY"
set -euo pipefail
export PAKRO_EXPERIMENTAL=0
export PAKRO_PYTHON_GITHUB_ATTESTATIONS=0
FIXTURE="$TEST_ROOT/fixtures/native_python_context.py"
RUNTIME="$PAKRO_DATA_DIR/installs/python/3.10.14"
mkdir -p wheels request-log
python3 "$FIXTURE" "$RUNTIME" "$PWD/wheels" 14 cpython missing-winning-hash
start_http_server --headers-log "$PWD/request-log" --handler "$FIXTURE" "$PWD/wheels"
export PAKRO_PYPI_URL="http://127.0.0.1:$HTTP_PORT"
cat >pakro.packages.lock <<'LOCK'
[groups]
"python@3.10.14" = [{name="demo",version="1.0",digest=""}]
LOCK
cp pakro.packages.lock before.lock
assert_fail_contains "pakro install python@3.10.14+demo@1.0 2>&1" 'SHA256'
assert "cmp before.lock pakro.packages.lock && echo unchanged" 'unchanged'
assert_directory_not_exists "$PAKRO_DATA_DIR/store"
assert_directory_not_exists .pakro/venvs
python3 - "$PWD/request-log" <<'PYCODE'
import json
import sys
from pathlib import Path

requests = list(Path(sys.argv[1]).glob("request_*.json"))
assert requests, "expected metadata requests"
for path in requests:
    entry = json.loads(path.read_text())
    request_path = entry["path"]
    assert isinstance(request_path, str), path
    assert not request_path.endswith((".whl", ".tar.gz")), path
PYCODE
