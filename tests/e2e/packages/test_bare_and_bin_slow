#!/usr/bin/env bash
set -euo pipefail

# End-to-end: bare package names bind to the sole package runtime, and
# package bin entries land in node_modules/.bin and actually run.

export PAKRO_PYTHON_GITHUB_ATTESTATIONS=0

# python: bare name after declaring the runtime
cat >pakro.toml <<'EOF'
[tools]
python = "3.10.14"
EOF
pakro i
pakro i six@1.17.0
assert ".pakro/venvs/python-3.10.14/bin/python -c 'import six; print(six.__version__)'" "1.17.0"

# node: bare name plus .bin execution
cat >pakro.toml <<'EOF'
[tools]
node = "22.14.0"
EOF
pakro i
pakro i typescript@5.8.2
test -f node_modules/.bin/tsc
assert "pakro x -- node -e \"console.log(require('typescript').version)\"" "5.8.2"
assert "pakro x -- node_modules/.bin/tsc --version" "Version 5.8.2"
