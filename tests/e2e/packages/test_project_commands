#!/usr/bin/env bash
set -euo pipefail

# Project command family: init scaffolds config with runtime+package pins,
# attach brings existing code under management, ls/status report state.

pakro project init proj --python 3.10.14 --package python+six@1.17.0
test -f proj/pakro.toml
assert_contains "cat proj/pakro.toml" 'python = "3.10.14"'
assert_contains "cat proj/pakro.toml" 'six = "1.17.0"'
assert_contains "cat proj/pakro.toml" '[packages."python@3.10.14"]'

# attach in a directory with code but no config
mkdir -p code
echo 'print("hello")' >code/main.py
(
  cd code
  pakro project attach
  test -f pakro.toml
  # code untouched
  assert "cat main.py" 'print("hello")'
)

# ls lists both, status reports the group
pakro project ls
assert_contains "pakro project ls" "proj"
(cd proj && pakro project status)
assert_contains "cd proj && pakro project status" "python@3.10.14 six 1.17.0"
