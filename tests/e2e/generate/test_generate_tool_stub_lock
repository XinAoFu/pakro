#!/usr/bin/env bash
# shellcheck disable=SC2103

# Test pakro generate tool-stub --lock functionality

# Disable GPG verification to avoid test failures
export PAKRO_GPG_VERIFY=false

# Create test project directory; the stub's lock data goes into its pakro.lock
mkdir -p generate_tool_stub_lock_test/bin
cd generate_tool_stub_lock_test
echo '[tools]' >pakro.toml

# Test 1: Lock a non-HTTP tool stub (github:jdx/tiny)
cat >bin/tiny <<'EOF'
#!/usr/bin/env -S pakro tool-stub

tool = "github:jdx/tiny"
version = "1"
bin = "bin/tiny"
os = ["macos", "linux"]
EOF
chmod +x bin/tiny

assert_succeed "pakro generate tool-stub bin/tiny --lock"

# The stub keeps its version request; pakro.lock records the exact version
assert_contains "cat bin/tiny" 'version = "1"'
assert_not_contains "cat bin/tiny" "[lock"
assert_contains "cat pakro.lock" 'tool-stubs = ["bin/tiny"]'
assert_contains "cat pakro.lock" 'version = "1.'
assert_contains "cat pakro.lock" 'specifiers = ["1"]'
assert_contains "cat pakro.lock" "url ="
assert_contains "cat pakro.lock" "checksum ="

# Verify the shebang and tool field are preserved
assert_contains "cat bin/tiny" "#!/usr/bin/env -S pakro tool-stub"
assert_contains "cat bin/tiny" 'tool = "github:jdx/tiny"'

# The stub's OS selector is the support boundary. Lock coverage only controls which artifacts are
# pre-resolved, so a missing lock platform alone must not decide whether a launcher is written.
assert_fail "test -f bin/tiny.cmd"

# Test 2: Bump version with --lock --version
assert_succeed "pakro generate tool-stub bin/tiny --lock --version 2"
assert_contains "cat bin/tiny" 'version = "2"'
assert_contains "cat pakro.lock" 'version = "2.'
assert_contains "cat pakro.lock" 'specifiers = ["2"]'

# Test 3: Execute the locked stub to verify it works
if pakro version | grep -q "windows-"; then
  echo "Skipping locked stub execution on Windows because jdx/tiny has no Windows release asset"
else
  assert_contains "pakro tool-stub bin/tiny" "tiny v2."
fi

# Test 4: A new lockfile respects lockfile_platforms
rm pakro.lock
export PAKRO_LOCKFILE_PLATFORMS=macos-arm64,linux-x64
export PAKRO_OS=macos
export PAKRO_ARCH=x64
assert_succeed "pakro generate tool-stub bin/tiny --lock"
assert_contains "cat pakro.lock" "platforms.macos-arm64"
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_contains "cat pakro.lock" "platforms.macos-x64"
assert_not_contains "cat pakro.lock" "platforms.windows-x64"
unset PAKRO_LOCKFILE_PLATFORMS PAKRO_OS PAKRO_ARCH

# Test 5: Lock fails on nonexistent file
assert_fail "pakro generate tool-stub bin/nonexistent --lock"

echo "All tool-stub lock tests passed!"
