#!/usr/bin/env bash
# shellcheck disable=SC2016

cat <<EOF >pakro.toml
[tasks.test]
run = "echo 'running test task'"
description = "This is a test task"
[tasks.another_task]
run = "echo 'running another task'"
alias = ["alias1", "alias2"]
EOF

cat <<EOF >task_docs.md
hello world

<!-- pakro-tasks -->
## \`test\`

- **Usage:** \`test\`

This is a test task.

## \`another_task\`

- **Usage:** \`another_task\`
- **Aliases:** \`alias1\`, \`alias2\`
<!-- /pakro-tasks -->

hello world
EOF

pakro generate task-docs --inject --output task_docs.md

# --inject writes too, so it says so. Run before the content assertion below, which re-runs the
# command anyway; the injection is idempotent between the two.
assert_contains "pakro generate task-docs --inject --output task_docs.md" "task_docs.md"

assert "cat task_docs.md" 'hello world

<!-- pakro-tasks -->
## `another_task`

- **Usage:** `another_task`
- **Aliases:** `alias1`, `alias2`

## `test`

- **Usage:** `test`

This is a test task
<!-- /pakro-tasks -->

hello world'
