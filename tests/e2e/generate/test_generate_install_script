#!/usr/bin/env bash

# Installer generation must not embed or download the predecessor's binary.
assert_fail_contains "pakro generate install-script -w" "pakro release repository is not configured"
assert_fail "test -e ./bin/pakro"
assert_fail_contains "pakro generate install-script --version 2026.9.15 -w --windows" "pakro release repository is not configured"
assert_fail "test -e ./bin/pakro.cmd"

# An explicit repository does not supply a pakro verification identity.
assert_fail_contains "PAKRO_SELF_UPDATE_REPOSITORY=example/pakro pakro generate install-script --version 2026.9.15 -w" "pakro release verification is not configured"
assert_fail "test -e ./bin/pakro"

# CLI validation still rejects a Windows launcher without an output destination.
assert_fail "pakro generate install-script --windows"
