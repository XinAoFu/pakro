#!/usr/bin/env bash

assert_contains "pakro generate config -n" '_.file = ".env"'
assert_contains "pakro generate config -n" '_.path = "./node_modules/.bin"'
assert_not_contains "pakro generate config -n" 'pakro.file = ".env"'
assert_not_contains "pakro generate config -n" 'pakro.path = "./node_modules/.bin"'

cat <<EOF >.tool-versions
node 22
python 3.9 3.10 3.11
EOF

# Use -n (dry-run) to print to stdout instead of writing to file
assert "pakro generate config -n --tool-versions .tool-versions" '[tools]
node = "22"
python = ["3.9", "3.10", "3.11"]'

# The command as reported in discussion #11046, without -n. Every assertion above is a
# dry-run, so the write itself had no coverage: `pakro generate config --global` is often the
# first thing to touch ~/.config/pakro on a fresh install, and it did not create that
# directory before writing into it.
export PAKRO_GLOBAL_CONFIG_FILE="$PWD/fresh/pakro/config.toml"
assert_succeed "pakro generate config --global"
assert_contains "cat fresh/pakro/config.toml" "pakro config files are hierarchical"
