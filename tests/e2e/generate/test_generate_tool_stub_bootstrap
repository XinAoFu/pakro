#!/usr/bin/env bash
set -euo pipefail

# Plain tool stubs still work without pakro publishing facilities.
assert_succeed "pakro generate tool-stub test-jq --platform-url linux-x64:https://example.com/jq --skip-download"
assert_contains "head -1 test-jq" "pakro tool-stub"
cp test-jq test-jq.original

# Adding bootstrap cannot write a wrapper that installs the predecessor's binary.
assert_fail_contains "pakro generate tool-stub test-jq --platform-url macos-arm64:https://example.com/jq --skip-download --bootstrap" "pakro release repository is not configured"
assert_succeed "cmp test-jq test-jq.original"

# A version pin or custom repository does not bypass the missing trust identity.
assert_fail_contains "PAKRO_SELF_UPDATE_REPOSITORY=example/pakro pakro generate tool-stub another-jq --platform-url linux-x64:https://example.com/jq --skip-download --bootstrap --bootstrap-version 2026.9.15" "pakro release verification is not configured"
assert_fail "test -e another-jq"
