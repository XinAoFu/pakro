#!/usr/bin/env bash
# shellcheck disable=SC2016

# A default published Pakro image/feature/extension has not been established.
assert_fail_contains "pakro generate devcontainer" "pakro devcontainer image is not configured"
assert_fail_contains "pakro generate devcontainer --write" "pakro devcontainer image is not configured"
assert_fail "test -e .devcontainer/devcontainer.json"

# With custom name and image
assert_json_partial_object "pakro generate devcontainer --name test --image testimage:latest" "name,description" '
  {
    "name": "test",
    "image": "testimage:latest"
  }
'

# With mount
assert_json_partial_object "pakro generate devcontainer --image pakro-dev:latest --mount-pakro-data" "name,description,features,mounts,containerEnv,postCreateCommand" '
  {
    "name": "pakro",
    "image": "pakro-dev:latest",
    "features": {},
    "mounts": [
      {
        "source": "pakro-data-volume",
        "target": "/mnt/pakro-data",
        "type": "volume"
      }
    ],
    "containerEnv": {
      "PAKRO_DATA_DIR": "/mnt/pakro-data"
    },
    "remoteEnv": {
      "PATH": "${containerEnv:PATH}:/mnt/pakro-data/shims"
    },
    "postCreateCommand": "sudo chown -R vscode:vscode /mnt/pakro-data"
  }
'
