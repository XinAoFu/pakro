#!/usr/bin/env bash
# A registry shorthand and the explicit backend it resolves to are one
# installation under the identity install layout (jdx/mise#13678): whichever
# spelling asked first made it, the other finds it instead of downloading and
# installing a second copy. Each spelling keeps its own version links, and
# removing the installation through either spelling removes the links of both.
export PAKRO_EXPERIMENTAL=1
export PAKRO_INSTALL_LAYOUT=identity

installs="$PAKRO_DATA_DIR/installs"

assert "pakro install tiny@3.1.0"
dir="$(pakro where tiny@3.1.0)"
name="$(basename "$dir")"
assert_matches "pakro where tiny@3.1.0" "^$installs/tiny-[a-z2-7]{8}\$"

echo "=== the explicit backend finds the installation the shorthand made ==="
assert_contains "pakro install asdf:tiny@3.1.0 2>&1" "already installed"
assert "pakro where asdf:tiny@3.1.0" "$dir"
assert "test \"\$(ls -d '$installs'/tiny-* | wc -l)\" -eq 1"
assert_contains "cat '$dir/.pakro-install.toml'" 'backend = "asdf:tiny"'

echo "=== each spelling keeps its own version links ==="
assert "readlink '$installs/tiny/3.1.0'" "../$name"
assert "readlink '$installs/asdf-tiny/3.1.0'" "../$name"
assert "readlink '$installs/tiny/latest'" "./3.1.0"
assert "readlink '$installs/asdf-tiny/latest'" "./3.1.0"
assert_contains "pakro x asdf:tiny@3.1.0 -- rtx-tiny" "3.1.0"
assert_contains "pakro x tiny@3.1.0 -- rtx-tiny" "3.1.0"

echo "=== removing it through the other spelling removes every link ==="
assert "pakro uninstall asdf:tiny@3.1.0"
assert "test ! -e '$dir'"
assert "test ! -L '$installs/tiny/3.1.0' && test ! -e '$installs/tiny/3.1.0'"
assert "test ! -L '$installs/tiny/latest' && test ! -L '$installs/tiny/3'"
assert "test ! -L '$installs/asdf-tiny/3.1.0' && test ! -e '$installs/asdf-tiny/3.1.0'"
assert_empty "find -L '$installs' -maxdepth 2 -type l"
assert_empty "pakro ls --installed tiny"

echo "=== the other order: explicit backend first, then the shorthand ==="
assert "pakro install asdf:tiny@3.1.0"
assert "pakro where asdf:tiny@3.1.0" "$dir"
assert_contains "pakro install tiny@3.1.0 2>&1" "already installed"
assert "pakro where tiny@3.1.0" "$dir"
assert "test \"\$(ls -d '$installs'/tiny-* | wc -l)\" -eq 1"
assert "readlink '$installs/tiny/3.1.0'" "../$name"
assert "readlink '$installs/asdf-tiny/3.1.0'" "../$name"
