#!/usr/bin/env bash

pakro i dummy@1.0.0

assert_contains "pakro use dummy" "dummy@1.0.0"
assert "pakro current dummy" "1.0.0"

assert_contains "pakro use dummy@2" "dummy@2."
assert "pakro current dummy" "2.0.0"

assert_contains "pakro use --rm dummy" "removed: dummy"
assert "pakro current dummy" ""

assert_contains "pakro use --env local dummy@2" "dummy@2."
assert "cat pakro.local.toml" '[tools]
dummy = "2"'
assert "pakro current dummy" "2.0.0"
rm pakro.local.toml

assert_contains "pakro use --env local dummy@1" "dummy@1."
assert "cat pakro.local.toml" '[tools]
dummy = "1"'
mv pakro.local.toml .pakro.local.toml
assert_contains "pakro use --env local dummy@2" "dummy@2."
assert_fail "test -f pakro.local.toml"
assert "cat .pakro.local.toml" '[tools]
dummy = "2"'
rm .pakro.local.toml

pakro use dummy@1 dummy@2
assert "pakro current dummy" "1.0.0 2.0.0"

# Multiple additions should preserve an already-sorted [tools] table.
rm pakro.toml
ln -s "$ROOT/tests/support/data/plugins/tiny" "$PAKRO_DATA_DIR/plugins/tiny"
ln -s "$ROOT/tests/support/data/plugins/tiny" "$PAKRO_DATA_DIR/plugins/tiny-local"
ln -s "$ROOT/tests/support/data/plugins/tiny" "$PAKRO_DATA_DIR/plugins/tiny-ref"
pakro use tiny-ref@1
pakro use dummy@1 tiny-local@1 tiny@1
assert "cat pakro.toml" '[tools]
dummy = "1"
tiny = "1"
tiny-local = "1"
tiny-ref = "1"'
rm pakro.toml

pakro use --pin dummy@1
assert "cat pakro.toml" '[tools]
dummy = "1.0.0"'

assert_fail "pakro use dummy@--version" "must not start with '-'"
assert "cat pakro.toml" '[tools]
dummy = "1.0.0"'

PAKRO_PIN=1 pakro use --fuzzy dummy@1
assert "cat pakro.toml" '[tools]
dummy = "1"'

PAKRO_PIN=1 pakro use dummy@1 --path pakro.local.toml
assert "cat pakro.local.toml" '[tools]
dummy = "1.0.0"'

assert_fail "pakro use --dry-run --path package.json dummy@1" "cannot update idiomatic version file"

pakro use --rm dummy --path pakro.local.toml
assert "cat pakro.local.toml" ""

# `nodejs` is an alias for `node`, so --rm has to match the key however it is spelled.
# It used to only look for the short name, leaving the entry in the file.
cat >pakro.local.toml <<EOF
[tools]
dummy = "1"
nodejs = "20.0.0"
EOF
pakro use --rm nodejs --path pakro.local.toml
assert "cat pakro.local.toml" '[tools]
dummy = "1"'
rm -f pakro.local.toml

pakro use dummy@1 --path .
assert "cat pakro.toml" '[tools]
dummy = "1"'

# pakro use should write to pakro.toml (lowest precedence) instead of pakro.local.toml
# See: https://github.com/jdx/mise/discussions/6475
pakro use dummy@2
assert "cat pakro.toml" '[tools]
dummy = "2"'

# When both pakro.toml and pakro.local.toml exist, pakro use should still write to pakro.toml
echo '[tools]' >pakro.local.toml
echo 'dummy = "1"' >>pakro.local.toml
pakro use dummy@3
assert "cat pakro.toml" '[tools]
dummy = "3"'
assert "cat pakro.local.toml" '[tools]
dummy = "1"'

rm -f pakro.local.toml pakro.toml

# pakro use should write to .config/pakro/config.toml instead of .config/pakro/config.local.toml
mkdir -p .config/pakro
echo '[tools]' >.config/pakro/config.toml
echo 'dummy = "1"' >>.config/pakro/config.toml
touch .config/pakro/config.local.toml
pakro use dummy@2
assert "cat .config/pakro/config.toml" '[tools]
dummy = "2"'
assert "cat .config/pakro/config.local.toml" ""
rm -rf .config

echo "dummy 1.0.0" >.tool-versions
pakro use dummy@2
assert "cat .tool-versions" "dummy 2"

# When both .tool-versions and pakro.toml exist, pakro use should prefer pakro.toml
echo '[tools]' >pakro.toml
echo 'dummy = "1"' >>pakro.toml
pakro use dummy@3
assert "cat pakro.toml" '[tools]
dummy = "3"'
assert "cat .tool-versions" "dummy 2"

rm -f .tool-versions pakro.toml

pakro use -g dummy@1
assert "cat ~/.config/pakro/config.toml" '[tools]
dummy = "1"'
rm -f ~/.config/pakro/config.toml

assert_empty "pakro use --quiet -g dummy@1 2>&1"
assert "cat ~/.config/pakro/config.toml" '[tools]
dummy = "1"'
assert_empty "pakro use --silent -g dummy@1 2>&1"
assert "cat ~/.config/pakro/config.toml" '[tools]
dummy = "1"'
rm -f ~/.config/pakro/config.toml

pakro use -g "ubi:cli/cli[exe=gh]"
assert "cat ~/.config/pakro/config.toml" '[tools]
"ubi:cli/cli" = { version = "latest", exe = "gh" }'
rm -f ~/.config/pakro/config.toml

pakro use -g gh@2
assert "cat ~/.config/pakro/config.toml" '[tools]
gh = "2"'
rm -f ~/.config/pakro/config.toml

# pakro use -g should write to config.toml instead of config.local.toml
# See: https://github.com/jdx/mise/discussions/8236
touch ~/.config/pakro/config.toml ~/.config/pakro/config.local.toml
pakro use -g dummy@1
assert "cat ~/.config/pakro/config.toml" '[tools]
dummy = "1"'
assert "cat ~/.config/pakro/config.local.toml" ""
rm -f ~/.config/pakro/config.toml ~/.config/pakro/config.local.toml

export PAKRO_ENV=test
pakro use -g dummy@1
assert "cat ~/.config/pakro/config.toml" '[tools]
dummy = "1"'
rm -f ~/.config/pakro/config.toml
unset PAKRO_ENV

pakro uninstall dummy --all
pakro use dummy@system
assert "pakro ls dummy" "dummy  system  ~/workdir/pakro.toml  system"

mkdir -p ~/workdir/mydummy
pakro use "dummy@path:~/workdir/mydummy"
assert_contains "pakro ls dummy" "dummy  path:~/workdir/mydummy  ~/workdir/pakro.toml  path:~/workdir/mydummy"

cd "$HOME" || exit 1
assert_contains "pakro use dummy@system" "pakro ~/.config/pakro/config.toml tools: dummy@system"

assert_contains "pakro use --path pakro.path.toml dummy@1" "dummy@1."
assert "cat pakro.path.toml" '[tools]
dummy = "1"'

# --path <dir> writes inside that directory, never the cwd's config. This used to resolve from
# the cwd and silently discard --path entirely.
mkdir -p "$HOME/workdir/pathtarget/from" "$HOME/workdir/pathtarget/to"
printf '[tools]\ndummy = "1"\n' >"$HOME/workdir/pathtarget/from/pakro.toml"
cd "$HOME/workdir/pathtarget/from" || exit 1

pakro use --path ../to dummy@2
assert "cat ../to/pakro.toml" '[tools]
dummy = "2"'
assert "cat pakro.toml" '[tools]
dummy = "1"'

# and with an absolute path
pakro use --path "$HOME/workdir/pathtarget/to" dummy@3
assert "cat ../to/pakro.toml" '[tools]
dummy = "3"'
assert "cat pakro.toml" '[tools]
dummy = "1"'

# a directory whose only config is .tool-versions keeps using it rather than growing a pakro.toml
mkdir -p "$HOME/workdir/pathtarget/tv"
printf 'dummy 1.0.0\n' >"$HOME/workdir/pathtarget/tv/.tool-versions"
pakro use --path ../tv dummy@2.0.0
assert "cat ../tv/.tool-versions" "dummy 2.0.0"
assert_fail "cat ../tv/pakro.toml"

# --path . still means "here"
pakro use --path . dummy@4
assert "cat pakro.toml" '[tools]
dummy = "4"'

# the same rule applies to `pakro set --file <dir>`
pakro set --file ../to PATHTARGET=yes
assert_contains "cat ../to/pakro.toml" "PATHTARGET"
assert_not_contains "cat pakro.toml" "PATHTARGET"

cd "$HOME/workdir" || exit 1

# comments around a tool survive the version being replaced
# See: https://github.com/jdx/mise/discussions/4797
mkdir -p "$HOME/workdir/comments"
cd "$HOME/workdir/comments" || exit 1
printf '[tools]\n# renovate: datasource=github-releases depName=dummy\ndummy = "1" # keep me\n' >pakro.toml
pakro use dummy@2
assert "cat pakro.toml" '[tools]
# renovate: datasource=github-releases depName=dummy
dummy = "2" # keep me'
