#!/usr/bin/env bash
# Tool aliases of one backend with different options are different installations
# of the same version, and each alias sees only its own (jdx/mise#13678).
export PAKRO_EXPERIMENTAL=1
export PAKRO_INSTALL_LAYOUT=identity
installs="$PAKRO_DATA_DIR/installs"

cat >pakro.toml <<'TOML'
[tool_alias]
dum-a = "asdf:tiny"
dum-b = "asdf:tiny"

[tools.dum-a]
version = "3.1.0"
flavor = "a"

[tools.dum-b]
version = "3.1.0"
flavor = "b"
TOML

assert "pakro install"
dir_a="$(pakro where dum-a)"
dir_b="$(pakro where dum-b)"
[[ $dir_a != "$dir_b" ]] || fail "the two aliases share the installation $dir_a"
assert_matches "pakro where dum-a" "^$installs/tiny-[a-z2-7]{8}\$"
assert_matches "pakro where dum-b" "^$installs/tiny-[a-z2-7]{8}\$"

# each alias links its own installation
assert "readlink '$installs/dum-a/3.1.0'" "../$(basename "$dir_a")"
assert "readlink '$installs/dum-b/3.1.0'" "../$(basename "$dir_b")"

# and lists only that one: one row per alias, no directory marker needed
assert_not_contains "pakro ls dum-a" "["
assert_not_contains "pakro ls dum-b" "["
assert "pakro ls --json dum-a | jq -r '.[0].install_path'" "$dir_a"
assert "pakro ls --json dum-b | jq -r '.[0].install_path'" "$dir_b"

# uninstalling the aliases removes one installation each
assert "pakro uninstall dum-a dum-b"
assert "test ! -e '$dir_a'"
assert "test ! -e '$dir_b'"
