#!/usr/bin/env bash

# shellcheck disable=SC2016

export PAKRO_SHIMS_DIR="$HOME/.local/share/pakro/user-shims"

# The environment `pakro env` prints places the shim farms on PATH for lazy
# declarations, and the eval'd shell that consumes it has no command-not-found
# handler to fall back on (discussion #12678). Evaluating the printed env must
# therefore leave working bootstrap shims behind, exactly like the env pakro
# builds for tasks and `pakro x`.
case ":$PATH:" in
  *":$PAKRO_SHIMS_DIR:"*) fail "expected user shims to be absent from PATH: $PATH" ;;
esac
cat >pakro.toml <<'EOF'
[tools]
dummy = { version = "1.0.0", lazy = true, lazy_bins = ["dummy"] }
EOF
assert_fail "test -e '$PAKRO_SHIMS_DIR/dummy'"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/1.0.0'"

pakro_path="$(PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro env -s bash | sed -n 's/^export PATH=//p' | tr -d "'\"")"
case "$pakro_path" in
  *"$PAKRO_SHIMS_DIR:"*) ;;
  *) fail "expected the shim farm in the printed PATH: $pakro_path" ;;
esac
# printing the env must not install lazy tools eagerly; the install must
# happen only when the evaluated shell actually runs one of their commands
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/1.0.0'"

# Evaluating the printed env installs the lazy tool the first time one of its
# commands runs, the same way it does in a task or `pakro x` child.
assert_contains 'eval "$(PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro env -s bash)" && dummy --version' "This is Dummy 1.0.0"
assert_succeed "test -e '$PAKRO_SHIMS_DIR/dummy'"
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/1.0.0"
