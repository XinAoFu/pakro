#!/usr/bin/env bash

# A shims dir the user cannot write, such as a root-owned /usr/local/bin, gets a
# bootstrap shim from nobody. Warning about it on every `pakro env`, `pakro x` and
# `pakro run` would only be noise, so the failure is logged at debug level.
if [ "$(id -u)" = 0 ]; then
  echo "skipping: root can write to any shims dir"
  exit 0
fi

export PAKRO_SHIMS_DIR="$HOME/.local/share/pakro/readonly-shims"
mkdir -p "$PAKRO_SHIMS_DIR"
chmod 555 "$PAKRO_SHIMS_DIR"
cat >pakro.toml <<'TOML'
[tools]
dummy = { version = "1.0.0", lazy = true, lazy_bins = ["dummy"] }

[tasks.check]
run = "echo ran"
TOML

assert_not_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro env -s bash 2>&1" "failed to create shims"
assert_not_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro x -- echo ran 2>&1" "failed to create shims"
assert_not_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro run check 2>&1" "failed to create shims"
assert_contains "PAKRO_DEBUG=1 PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro x -- echo ran 2>&1" "skipping bootstrap shims"
assert_fail "test -e '$PAKRO_SHIMS_DIR/dummy'"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/1.0.0'"

# Permission failures outside the target farm must remain actionable.
readonly_cache="$HOME/.cache/pakro-readonly"
mkdir -p "$readonly_cache/lockfiles"
chmod 555 "$readonly_cache/lockfiles"
assert_contains "PAKRO_CACHE_DIR='$readonly_cache' PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro x -- echo ran 2>&1" "Permission denied"

# Once the farm is writable again the next child environment writes the shim.
chmod 755 "$PAKRO_SHIMS_DIR"
assert_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro x -- echo ran" "ran"
assert_succeed "test -e '$PAKRO_SHIMS_DIR/dummy'"
