#!/usr/bin/env bash

export PAKRO_TRUSTED_CONFIG_PATHS=""

mkdir -p project_a project_b

cat <<EOF >project_a/.pakro.toml
[env]
PROJECT = "a"
EOF

cat <<EOF >project_b/.pakro.toml
[env]
PROJECT = "b"
EOF

DIR_A="$(cd project_a && pwd)"
DIR_B="$(cd project_b && pwd)"

# Single trusted path: config in DIR_A is loaded
cd project_a
assert_contains "PAKRO_TRUSTED_CONFIG_PATHS=$DIR_A pakro env" "PROJECT=a"

# Multiple colon-separated paths: both configs are loaded
assert_contains "PAKRO_TRUSTED_CONFIG_PATHS=$DIR_A:$DIR_B pakro env" "PROJECT=a"
cd ../project_b
assert_contains "PAKRO_TRUSTED_CONFIG_PATHS=$DIR_A:$DIR_B pakro env" "PROJECT=b"
