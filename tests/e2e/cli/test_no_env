#!/usr/bin/env bash

# Test that --no-env flag prevents loading environment variables from config files

# Create a config file with environment variables
cat <<EOF >pakro.toml
[env]
TEST_FOO_VAR = "FOO"
EOF

# Test if it works with env
assert_contains "pakro env" "TEST_FOO_VAR"
assert_not_contains "pakro --no-env env" "TEST_FOO_VAR"

# Test with exec as well
assert_contains "pakro exec -- env | grep TEST_FOO_VAR" "TEST_FOO_VAR=FOO"
assert_not_contains "pakro --no-env exec -- env" "TEST_FOO_VAR"

# Test that PAKRO_NO_ENV=1 environment variable works the same way
assert_not_contains "PAKRO_NO_ENV=1 pakro env" "TEST_FOO_VAR"
assert_not_contains "PAKRO_NO_ENV=1 pakro exec -- env" "TEST_FOO_VAR"

cat <<EOF >pakro.toml
[settings]
no_env = true

[env]
TEST_FOO_VAR = "FOO"
EOF

assert_not_contains "pakro env" "TEST_FOO_VAR"
