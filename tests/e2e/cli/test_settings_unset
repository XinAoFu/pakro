#!/usr/bin/env bash

pakro settings set python.compile true
assert "pakro settings get python.compile" "true"
pakro settings unset python.compile
assert_fail "pakro settings get python.compile" "pakro ERROR Setting [python.compile] is not set"

# Optional settings with an effective default should report that default after unset.
pakro settings set all_compile true
assert "pakro settings get all_compile" "true"
pakro settings unset all_compile
assert "pakro settings get all_compile" "false"

# regression: a parent key stored as an inline table must not panic on unset
settings_config="$PAKRO_CONFIG_DIR/config.toml"
printf '[settings]\npython = { compile = true }\n' >"$settings_config"
pakro settings unset python.compile
assert_fail "pakro settings get python.compile" "pakro ERROR Setting [python.compile] is not set"
