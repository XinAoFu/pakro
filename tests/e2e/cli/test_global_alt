#!/usr/bin/env bash

assert_contains "PAKRO_GLOBAL_CONFIG_FILE=~/.pakro.global.toml pakro global dummy@latest" "~/.pakro.global.toml"
assert "cat ~/.pakro.global.toml" '[tools]
dummy = "latest"'

assert_contains "PAKRO_GLOBAL_CONFIG_FILE=~/.config/pakro/.tool-versions pakro global dummy@latest" "~/.config/pakro/.tool-versions"
assert "cat ~/.config/pakro/.tool-versions" 'dummy latest'

assert_contains "PAKRO_ASDF_COMPAT=1 pakro global dummy@3" "~/.tool-versions"
assert "cat ~/.tool-versions" 'dummy 3'
