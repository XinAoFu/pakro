#!/usr/bin/env bash

# e2e:writable-rootfs — installing a deb writes to /var and /usr, which the
# e2e Docker sandbox mounts read-only by default

# requires a Debian-ish Linux running as root (the CI container case);
# elsewhere this test is a no-op
if [[ "$(uname)" != "Linux" ]] || ! command -v apt-get >/dev/null || [[ "$(id -u)" != 0 ]]; then
  exit 0
fi

cat <<EOF >pakro.toml
[bootstrap.packages]
"apt:bc" = "latest"
EOF

apt-get remove -y bc >/dev/null 2>&1 || true

assert_contains "pakro bootstrap packages status" "missing"
assert_fail "pakro bootstrap packages status --missing"

# dry-run prints the command without installing
assert_contains "pakro bootstrap packages apply --dry-run" "apt-get install -y -- bc"
assert_contains "pakro bootstrap packages status" "missing"

# explicit manager:package specs work, configured or not
assert_contains "pakro bootstrap packages apply apt:bc --dry-run" "apt-get install -y -- bc"

pakro bootstrap packages apply --yes
assert_contains "pakro bootstrap packages status" "installed"
assert_succeed "pakro bootstrap packages status --missing"
assert_succeed "bc --version"

# second install is a no-op
assert_contains "pakro bootstrap packages apply --yes 2>&1" "already installed"

# upgrade refreshes lists and only touches installed packages
assert_contains "pakro bootstrap packages upgrade --dry-run" "apt-get update"
assert_contains "pakro bootstrap packages upgrade --dry-run" "apt-get install -y --only-upgrade -- bc"
assert_succeed "pakro bootstrap packages upgrade --yes"

# the lists exist now: installing only refreshes them when a requested package
# has no install candidate in them
apt-get remove -y bc >/dev/null 2>&1 || true
assert_not_contains "pakro bootstrap packages apply --dry-run" "apt-get update"
assert_contains "pakro bootstrap packages apply apt:bc apt:pakro-nonexistent-pkg-xyz --dry-run" "apt-get update"

# a real install recovers when the lists exist but lack the package: drop the
# lists for the component that ships bc and keep the rest, so this exercises
# the refresh for incomplete lists rather than the one for no lists at all
rm -f /var/lib/apt/lists/*_main_binary-*_Packages*
assert_succeed "ls /var/lib/apt/lists/ | grep -q _Packages"
assert_fail "apt-get --simulate -q install -y -- bc"
assert_succeed "pakro bootstrap packages apply --yes"
assert_succeed "bc --version"

# `use` writes the config entry and installs in one step
rm pakro.toml
apt-get remove -y bc >/dev/null 2>&1 || true
assert_succeed "pakro bootstrap packages use --yes apt:bc"
assert_contains "cat pakro.toml" '"apt:bc" = "latest"'
assert_contains "pakro bootstrap packages status" "installed"
assert_succeed "bc --version"
