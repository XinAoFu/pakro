#!/usr/bin/env bash

# Test that `pakro lock` creates separate lockfiles for env-specific configs

export PAKRO_LOCKFILE=1

echo "=== Testing pakro lock creates separate env lockfile ==="

cat >pakro.toml <<'EOF'
[tools]
tiny = "1"
EOF

cat >pakro.test.toml <<'EOF'
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

rm -f pakro.lock pakro.test.lock

# Install tiny so it's available
assert "pakro install tiny@1.0.1"

# Run pakro lock with PAKRO_ENV=test so pakro.test.toml is loaded
assert "PAKRO_ENV=test pakro lock --platform linux-x64"

# The base tool should be in pakro.lock
assert_contains "cat pakro.lock" '[[tools.tiny]]'
assert_contains "cat pakro.lock" 'version = "1.0.1"'
# pakro.lock should NOT contain the env-specific tool
assert_not_contains "cat pakro.lock" 'jqlang/jq'
# pakro.lock should NOT have any env field
assert_not_contains "cat pakro.lock" 'env = '

# The env-specific tool should be in pakro.test.lock
assert_contains "cat pakro.test.lock" 'jqlang/jq'
# pakro.test.lock should NOT have env field (env is encoded in filename now)
assert_not_contains "cat pakro.test.lock" 'env = '

echo "=== Testing pakro lock without PAKRO_ENV creates only pakro.lock ==="

rm -f pakro.lock pakro.test.lock pakro.test.toml

# With only pakro.toml and no PAKRO_ENV, there should be only pakro.lock
assert "pakro lock --platform linux-x64"
assert_contains "cat pakro.lock" 'version = "1.0.1"'
assert_not_contains "cat pakro.lock" 'env = '
# No env-specific lockfile should be created
assert_fail "test -f pakro.test.lock"

echo "=== Cleanup ==="
rm -f pakro.lock pakro.test.lock pakro.toml pakro.test.toml

echo "pakro lock env tests passed!"
