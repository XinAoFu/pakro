#!/usr/bin/env bash

cat >pakro.toml <<'EOF'
[tools]
node = "22"

[tasks.build]
run = "make"
EOF

cat >other.toml <<'EOF'
[tools]
bun = "1"
EOF

settings="$(pakro __complete_word__ --shell fish --line 'pakro config set settings.jo')"
assert_contains_text "$settings" $'settings.jobs\tHow many jobs to run concurrently'
assert_not_contains_text "$settings" $'\001files'

zsh_settings="$(pakro __complete_word__ --shell zsh --line 'pakro config set settings.jo')"
assert_contains_text "$zsh_settings" $'settings.jobs\tHow many jobs to run concurrently such as tool installs. Values below 1 are treated as 1.\tsettings.jobs'
assert_not_contains_text "$zsh_settings" $'\001files'

pwsh_settings="$(pakro __complete_word__ --shell powershell --line 'pakro config set settings.jo')"
assert_contains_text "$pwsh_settings" $'settings.jobs\tHow many jobs to run concurrently such as tool installs. Values below 1 are treated as 1.\tsettings.jobs\tvalue'
assert_not_contains_text "$pwsh_settings" $'\001files'

tools="$(pakro __complete_word__ --shell fish --line 'pakro cfg get tools.')"
assert_contains_text "$tools" 'tools.node'
assert_not_contains_text "$tools" 'tools.bun'

other_tools="$(pakro __complete_word__ --shell fish --line 'pakro config set --file other.toml tools.')"
assert_contains_text "$other_tools" 'tools.bun'
assert_not_contains_text "$other_tools" 'tools.node'

tool_options="$(pakro __complete_word__ --shell fish --line 'pakro config set tools.node.ver')"
assert_contains_text "$tool_options" $'tools.node.version\tversion of the tool to install'

task_options="$(pakro __complete_word__ --shell fish --line 'pakro config set tasks.build.dep')"
assert_contains_text "$task_options" 'tasks.build.depends'

# The run= the usage spec carries for this argument, as a usage-generated script calls it.
spec_run="$(pakro __complete_word__ --candidates key '--line=pakro config set settings.jo')"
assert_contains_text "$spec_run" 'settings.jobs'
