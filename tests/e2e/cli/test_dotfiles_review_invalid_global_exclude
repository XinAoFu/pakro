#!/usr/bin/env bash
# An exclusion that cannot be compiled is not read as no exclusion: the
# capture refuses, naming the rule and the file that declares it, rather
# than storing the very files the rule was written to leave out.
require_cmd git
repo="$PAKRO_STATE_DIR/history/repo.git"
mkdir -p ~/.codex/sessions
echo 'model = "x"' >~/.codex/config.toml
echo 'a transcript' >~/.codex/sessions/session.json
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'TOML'
[dotfiles]
"~/.codex" = { mode = "track" }

[history]
exclude = ["sessions/**"]
TOML
assert_succeed 'pakro dot save'
assert_fail "git --git-dir=$repo cat-file -e HEAD:home/.codex/sessions/session.json"
before=$(git --git-dir="$repo" rev-parse HEAD)

# the same list with one rule the matcher cannot compile
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'TOML'
[dotfiles]
"~/.codex" = { mode = "track" }

[history]
exclude = ["["]
TOML
echo 'changed' >~/.codex/config.toml
assert_fail 'pakro dot save' 'cannot be applied'
assert_fail 'pakro dot save' '"[" in ~/.config/pakro/config.toml'
assert "git --git-dir=$repo rev-parse HEAD" "$before"
assert_fail "git --git-dir=$repo cat-file -e HEAD:home/.codex/sessions/session.json"

# but only writing refuses. The command the refusal sends the user to has
# to work, or the rule cannot be found and fixed: listing, previewing and
# starting the watcher all succeed and report the same rule.
assert_succeed 'pakro dot paths'
assert_contains 'pakro dot paths 2>&1' 'cannot be applied'
assert_contains 'pakro dot paths 2>&1' '"[" in ~/.config/pakro/config.toml'
assert_contains 'pakro dot paths' '~/.codex'
assert_succeed 'pakro dot status'
assert_succeed 'pakro dot track --dry-run ~/.codex'
# the watcher gets all the way up — it builds its watch set from the same
# walk — and then declines to capture, rather than failing before it can
# watch or report anything
assert_fail 'pakro dot watch --once' 'nothing was saved'
assert_fail 'pakro dot watch --once' 'cannot be applied'
assert_fail 'pakro dot watch --once' '"[" in ~/.config/pakro/config.toml'
assert "git --git-dir=$repo rev-parse HEAD" "$before"

# fixing the rule lets the capture through again
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'TOML'
[dotfiles]
"~/.codex" = { mode = "track" }

[history]
exclude = ["sessions/**"]
TOML
assert_succeed 'pakro dot save'
assert "git --git-dir=$repo show HEAD:home/.codex/config.toml" 'changed'
assert_fail "git --git-dir=$repo cat-file -e HEAD:home/.codex/sessions/session.json"

# And pakro never writes a rule pakro would then refuse. `pakro dot untrack`
# of a covered path writes that path into the same list, and a path is a
# literal, not a glob: written as-is, a name holding `[` is an unclosed
# character class that would disable every later capture.
echo 'one' >"$HOME/.codex/cache[1]"
echo 'other' >~/.codex/cacheX
assert_succeed 'pakro dot save'
assert_succeed "pakro dot untrack '$HOME/.codex/cache[1]'"
# the rule that was written is the escaped one
assert_contains "pakro dot paths --json | jq -r '.exclude[]'" 'cache[[]1[]]'
# and it is usable: a later capture still runs, and the rule names that
# one path — the sibling the unescaped form would have swallowed is
# still captured
echo 'edited' >~/.codex/cacheX
assert_succeed 'pakro dot save'
assert_contains "git --git-dir=$repo ls-tree -r --name-only HEAD" 'home/.codex/cacheX'
assert_not_contains "git --git-dir=$repo ls-tree -r --name-only HEAD" 'cache[1]'

# `$` has no escape in this pattern language, so such a path is reported
# rather than written: the configuration stays loadable either way.
# and the escape does not break the undo: `pakro dot include` takes the
# rule out whichever spelling it was written in, and the path is captured
# again. Asserted on the capture, since the message was the thing that
# was wrong.
# the rule is stored as the path is displayed, so the message has to
# name the spelling that undoes it
assert_contains "pakro dot untrack '$HOME/.codex/cacheX' 2>&1" "pakro dot include '~/.codex/cacheX'"
# a plain file, and a file whose name holds a glob metacharacter
assert_succeed "pakro dot include '~/.codex/cacheX'"
assert_succeed "pakro dot include '~/.codex/cache[1]'"
echo 'back' >"$HOME/.codex/cache[1]"
assert_succeed 'pakro dot save'
assert_contains "git --git-dir=$repo ls-tree -r --name-only HEAD" 'cache[1]'
assert_contains "git --git-dir=$repo ls-tree -r --name-only HEAD" 'cacheX'
assert_not_contains "pakro dot paths --json | jq -r '.exclude[]'" 'cache'

# a directory, whose rule carries the `/**` the message does not
mkdir -p "$HOME/.codex/logs[a]"
echo 'noise' >"$HOME/.codex/logs[a]/today.log"
assert_succeed 'pakro dot save'
assert_succeed "pakro dot untrack '$HOME/.codex/logs[a]'"
assert_contains "pakro dot paths --json | jq -r '.exclude[]'" 'logs[[]a[]]/**'
assert_succeed 'pakro dot save'
assert_not_contains "git --git-dir=$repo ls-tree -r --name-only HEAD" 'today.log'
assert_succeed "pakro dot include '~/.codex/logs[a]'"
assert_not_contains "pakro dot paths --json | jq -r '.exclude[]'" 'logs'
echo 'kept after all' >"$HOME/.codex/logs[a]/today.log"
assert_succeed 'pakro dot save'
assert_contains "git --git-dir=$repo ls-tree -r --name-only HEAD" 'today.log'

# `foo*` and `foo[*]` are two different rules that happen to be each
# other's escaping. Including one must not take the other with it.
count() { echo "pakro dot paths --json | jq '[.exclude[] | select(. == \"$1\")] | length'"; }
assert_succeed "pakro dot exclude 'foo*'"
assert_succeed "pakro dot exclude 'foo[*]'"
assert "$(count 'foo*')" 1
assert "$(count 'foo[*]')" 1
assert_succeed "pakro dot include 'foo*'"
assert "$(count 'foo*')" 0
assert "$(count 'foo[*]')" 1

# and the same two rules in rooted form, where the argument is both a
# glob a user typed and a path `untrack` could have escaped. Taking the
# glob back must leave the rule for the file actually named `foo*`.
assert_succeed "pakro dot exclude '~/.codex/bar*'"
echo 'literal' >"$HOME/.codex/bar*"
assert_succeed 'pakro dot save'
assert_succeed "pakro dot untrack '$HOME/.codex/bar*'"
assert "$(count '~/.codex/bar*')" 1
assert "$(count '~/.codex/bar[*]')" 1
# and it says so rather than claiming the path is captured again: the
# rule for the file named `bar*` is still in force. Run once and assert
# on the captured output — each assertion would otherwise run the
# command again, against a list the first one already changed.
pakro dot include '~/.codex/bar*' >include-bar.log 2>&1
assert_contains 'cat include-bar.log' 'still excludes it'
assert_contains 'cat include-bar.log' '~/.codex/bar[*]'
assert "$(count '~/.codex/bar*')" 0
assert "$(count '~/.codex/bar[*]')" 1
# the escaped rule is still the one that undoes the untrack, once
# nothing in the list spells the argument
assert_succeed "pakro dot include '~/.codex/bar*'"
assert "$(count '~/.codex/bar[*]')" 0
# with nothing left to exclude it, the claim is the plain one again
assert_contains "pakro dot exclude '~/.codex/solo' 2>&1" 'excluded from capture'
assert_contains "pakro dot include '~/.codex/solo' 2>&1" 'removed exclusion rule'

# the $ is the point: it stays literal
# shellcheck disable=SC2016
dollar='~/.codex/price$x'
echo 'dear' >"$HOME/.codex/price\$x"
assert_fail "pakro dot untrack '$dollar'" 'environment variables are not supported'
# A later invalid rule must not change an earlier child or declaration.
cp "$PAKRO_CONFIG_DIR/config.toml" before-untrack.toml
before_untrack=$(git --git-dir="$repo" rev-parse HEAD)
for earlier in '~/.codex/cacheX' '~/.codex'; do
  assert_fail "pakro dot untrack '$earlier' '$dollar'" 'environment variables are not supported'
  assert_succeed "cmp before-untrack.toml '$PAKRO_CONFIG_DIR/config.toml'"
  assert "git --git-dir=$repo rev-parse HEAD" "$before_untrack"
done
assert_not_contains "pakro dot paths --json | jq -r '.exclude[]'" 'price'
assert_succeed 'pakro dot save'

# Nothing acts on a rule set it could not fully build. A pull would
# delete, so it refuses with the same diagnostic rather than proceeding
# with the rules it managed to compile — while the command the refusal
# names keeps working.
origin="$PWD/refusal-origin.git"
git init -q --bare -b main "$origin"
assert_succeed "pakro dot origin set file://$origin --sync manual --yes"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'TOML'
[dotfiles]
"~/.codex" = { mode = "track" }

[history]
exclude = ["["]
TOML
assert_fail 'pakro dot pull --yes' 'cannot be applied'
assert_fail 'pakro dot sync' 'cannot be applied'
assert_fail 'pakro dot rollback ~/.codex/config.toml --yes' 'cannot be applied'
assert "cat ~/.codex/config.toml" 'changed'
assert_succeed 'pakro dot paths'
assert_contains 'pakro dot paths 2>&1' '"[" in ~/.config/pakro/config.toml'

# Removing a specific rule does not promise inclusion under a broader rule.
pakro dot exclude '~/.codex/**'
pakro dot exclude '~/.codex/solo'
assert_contains "pakro dot include '~/.codex/solo' 2>&1" 'removed exclusion rule'
assert_contains 'pakro dot paths' 'exclude: ~/.codex/**'
