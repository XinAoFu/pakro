#!/usr/bin/env bash

mkdir -p bundles/a bundles/b bundles/empty

cat <<'EOF' >pakro.toml
[bootstrap]
config_roots = ["bundles/*"]
EOF

cat <<'EOF' >bundles/a/pakro.toml
[bootstrap.packages]
"apt:jq" = "latest"
"brew:ripgrep" = "latest"

[bootstrap.repos."~/src/example"]
url = "https://example.com/example.git"

[bootstrap.users.example]

[bootstrap.groups.example]

[bootstrap.hooks.pre-packages]
run = "exit 99"
EOF

cat <<'EOF' >bundles/a/pakro.dev.toml
[bootstrap.packages]
"apt:curl" = "latest"

[bootstrap.hooks.final]
run = ["exit 98", "exit 97"]
EOF

cat <<'EOF' >bundles/a/pakro.prod.toml
[bootstrap.repos."~/src/inactive"]
url = "https://example.com/inactive.git"
EOF

cat <<'EOF' >bundles/b/pakro.toml
[bootstrap.repos]
"~/src/one" = { url = "https://example.com/one.git" }
"~/src/two" = { url = "https://example.com/two.git" }
EOF

cat <<'EOF' >bundles/empty/pakro.toml
[tools]
tiny = "1"
EOF

assert_contains "PAKRO_ENV=dev pakro bootstrap config-roots --json 2>&1" "deprecated [bootstrap.config_roots]"
assert_contains "PAKRO_ENV=dev pakro bootstrap config-roots --json 2>&1" "configuration.html#conf-d-folders"
assert_contains "PAKRO_ENV=dev pakro bootstrap config-roots --json 2>&1" "removed in pakro 2027.3.3"
assert_succeed "PAKRO_ENV=dev pakro bootstrap config-roots --json | jq -e '.roots | length == 3'"
assert_succeed "PAKRO_ENV=dev pakro bootstrap config-roots --json | jq -e '.roots[0].config_root == \"$PWD/bundles/a\"'"
assert_succeed "PAKRO_ENV=dev pakro bootstrap config-roots --json | jq -e '.roots[0].environments == [\"dev\"]'"
assert_succeed "PAKRO_ENV=dev pakro bootstrap config-roots --json | jq -e '.roots[0].declares.packages.count == 3'"
assert_succeed "PAKRO_ENV=dev pakro bootstrap config-roots --json | jq -e '.roots[0].declares.repos.count == 1'"
assert_succeed "PAKRO_ENV=dev pakro bootstrap config-roots --json | jq -e '.roots[0].declares.accounts.count == 2'"
assert_succeed "PAKRO_ENV=dev pakro bootstrap config-roots --json | jq -e '.roots[0].declares.hooks.count == 2'"
assert_succeed "PAKRO_ENV=dev pakro bootstrap config-roots --json | jq -e '.roots[0].declares.hooks.phases == [\"pre-packages\", \"final\"]'"
assert_succeed "PAKRO_ENV=dev pakro bootstrap config-roots --json | jq -e '.roots[0].declares.packages.provenance | map(.config) | index(\"$PWD/bundles/a/pakro.dev.toml\")'"
assert_not_contains "PAKRO_ENV=dev pakro bootstrap config-roots --json" "pakro.prod.toml"
assert_succeed "PAKRO_ENV=dev pakro bootstrap config-roots --json | jq -e '.roots[1].declares.repos.count == 2'"
assert_succeed "PAKRO_ENV=dev pakro bootstrap config-roots --json | jq -e '.roots[2].declares.packages.count == 0 and .roots[2].declares.hooks.phases == []'"
assert_not_contains "PAKRO_ENV=dev pakro bootstrap config-roots" "exit 99"
assert_contains "PAKRO_ENV=dev pakro bootstrap config-roots" "bundles/a"
assert_contains "PAKRO_ENV=dev pakro bootstrap config-roots" "2  pre-packages, final"

cat <<'EOF' >pakro.toml
[tools]
tiny = "1"
EOF
assert_succeed "pakro bootstrap config-roots --json | jq -e '.roots == []'"
