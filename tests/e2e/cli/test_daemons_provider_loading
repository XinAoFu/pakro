#!/usr/bin/env bash
mkdir -p "$PAKRO_CONFIG_DIR" project
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'TOML'
[daemon_providers.broken]
preset = "not-a-preset"
version = "18"
[daemon_providers.pg]
preset = "postgres"
version = "18"
port = 54321
TOML
cd project
cat >pakro.toml <<'TOML'
[env]
LOADING_OK = "yes"
[tasks.probe]
run = "true"
TOML
export PAKRO_EXPERIMENTAL=1
assert_contains 'pakro env --json' 'LOADING_OK'
pakro run probe
cat >>pakro.toml <<'TOML'
[daemons.db]
provider = "pg"
TOML
assert_contains 'pakro env --json' '54321'
cat >pakro.local.toml <<'TOML'
[daemons.db]
provider = "broken"
TOML
PAKRO_EXPERIMENTAL=0 assert_contains 'pakro env --json' 'LOADING_OK'
PAKRO_SAFE=1 pakro env --json >/dev/null
assert_fail 'pakro env --json'
assert "test ! -d '$PAKRO_STATE_DIR/daemon-providers'"
