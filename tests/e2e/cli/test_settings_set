#!/usr/bin/env bash

pakro settings set legacy_version_file 0
assert "pakro settings get legacy_version_file" "false"
pakro settings set always_keep_download y
assert "pakro settings get always_keep_download" "true"
pakro settings set status.missing_tools never
assert "pakro settings get status.missing_tools" 'never'
pakro settings set disable_tools "node,, rust,node"
assert "pakro settings get disable_tools" '["node", "rust"]'
pakro settings set disable_tools " [] "
assert "pakro settings get disable_tools" "[]"
pakro settings set plugin_autoupdate_last_check_duration 1
assert "pakro settings get plugin_autoupdate_last_check_duration" '1'
pakro settings set all_compile 1
assert_contains "pakro settings -T" "all_compile = true"
pakro settings unset all_compile
assert "pakro settings get all_compile" "false"
assert_fail "pakro settings get abcdefg" "pakro ERROR Unknown setting: abcdefg"
assert_fail "pakro settings get python.compyle" "pakro ERROR Unknown setting: python.compyle"
assert_fail "pakro settings get python.compile" "pakro ERROR Setting [python.compile] is not set"
assert_fail "pakro settings get cargo.registry_name" "pakro ERROR Setting [cargo.registry_name] is not set"
assert "pakro settings all_compile" "false"
assert "pakro settings all_compile=1"
assert "pakro settings all_compile" "true"
assert "pakro settings all_compile=0"
assert "pakro settings all_compile" "false"
assert "pakro settings -l" ""
assert "pakro settings -l all_compile=1"
assert "pakro settings -l" "all_compile  true ~/workdir/pakro.toml"
assert "pakro settings all_compile" "true"
assert "pakro settings all_compile=0"
assert "pakro settings all_compile" "true"
assert "pakro settings -l set all_compile 0"
assert "pakro settings all_compile" "false"

# test "settings set key=value" format
pakro settings -l unset all_compile
assert "pakro settings set all_compile=1"
assert "pakro settings all_compile" "true"
assert "pakro settings set all_compile=0"
assert "pakro settings all_compile" "false"

# dotted-only settings should not emit an empty parent table
settings_config="$PAKRO_CONFIG_DIR/config.toml"
rm -f "$settings_config"
pakro settings set status.missing_tools=always
assert "pakro settings get status.missing_tools" "always"
assert_not_contains "cat $settings_config" "[settings]"

# regression: setting a child when the parent key is an inline table must not panic
printf '[settings]\npython = { compile = true }\n' >"$settings_config"
pakro settings set python.compile false
assert "pakro settings get python.compile" "false"

# test "settings set" with no value and no = fails
assert_fail "pakro settings set all_compile"
