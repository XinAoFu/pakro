#!/usr/bin/env bash

# `pakro x` should only touch the project lockfile when the install resolves
# the same version specifier as the config. CLI overrides
# (`pakro x tool@<version>`) carry a different specifier, so pairing the
# config's request with their installed version would produce a nonsensical
# lockfile entry.

export PAKRO_LOCKFILE=1

cat <<EOF >pakro.toml
[tools]
dummy = "1"
EOF

pakro uninstall dummy --all
pakro install dummy@1.0.0
touch pakro.lock
pakro lock --platform linux-x64
assert_contains "cat pakro.lock" "1.0.0"

# `pakro x dummy@2.0.0` resolves to 2.0.0 — an explicit CLI override that
# doesn't satisfy `dummy = "1"`. Lockfile must stay at 1.0.0.
pakro x dummy@2.0.0 -- dummy
assert_contains "cat pakro.lock" "1.0.0"
assert_not_contains "cat pakro.lock" "2.0.0"

# Same for `pakro x dummy@latest` — the latest is 2.0.0, and the lockfile
# must not adopt it under the `"1"` request.
pakro x dummy@latest -- dummy
assert_contains "cat pakro.lock" "1.0.0"
assert_not_contains "cat pakro.lock" "2.0.0"

# `pakro x dummy` (no version) carries the config's `"1"` specifier, so it
# isn't an override. Verify it still resolves and runs against the locked
# 1.0.0 (and would be allowed to populate the lockfile entry — exercised by
# the empty-lockfile case below).
pakro x dummy -- dummy
assert_contains "cat pakro.lock" "1.0.0"

# Env-var overrides (`PAKRO_<TOOL>_VERSION=...`) are the same class of
# override as CLI args — they carry a `ToolSource::Environment` and a
# version specifier that may not match the config's. The version-match
# check covers them too: with pakro.toml `dummy = "1"`, setting
# `PAKRO_DUMMY_VERSION=2` must not pair the "1" request with a 2.x install.
PAKRO_DUMMY_VERSION=2 pakro install
assert_contains "cat pakro.lock" "1.0.0"
assert_not_contains "cat pakro.lock" "2.0.0"

# `pakro upgrade` is the supported way to explicitly bump the lockfile and
# *should* update it (it remaps Argument → PakroToml before update_lockfiles).
pakro upgrade dummy@1.1.0
assert_contains "cat pakro.lock" "1.1.0"
assert_not_contains "cat pakro.lock" "1.0.0"

# `pakro x dummy` against an empty (but existing) lockfile must populate the
# entry — the install satisfies the config's `"1"` request, so propagation
# is correct.
pakro uninstall dummy --all
echo "" >pakro.lock
pakro x dummy -- dummy
assert_contains "cat pakro.lock" "dummy"
assert_contains "cat pakro.lock" "1.1.0"
