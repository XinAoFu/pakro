#!/usr/bin/env bash

set -euo pipefail

# Test that `pakro help` works even when no tasks are defined
# This validates the fix for https://github.com/jdx/mise/discussions/6947

echo "Testing 'pakro help' command without tasks defined..."

# Test in a temporary directory without any pakro config
TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR"

# Test 1: `pakro help` should work without tasks
echo "Test 1: pakro help (without tasks)"
assert_contains "pakro help" "Usage: pakro"

# Test 2: `pakro --help` should work (baseline)
echo "Test 2: pakro --help"
assert_contains "pakro --help" "Usage: pakro"

# Test 3: `pakro -h` should work (baseline)
echo "Test 3: pakro -h"
assert_contains "pakro -h" "Usage: pakro"

# Test 4: All three should produce similar output
echo "Test 4: Verify all help variants work consistently"
if pakro help >/dev/null 2>&1; then
  ok "pakro help succeeded"
else
  fail "pakro help failed"
fi
if pakro --help >/dev/null 2>&1; then
  ok "pakro --help succeeded"
else
  fail "pakro --help failed"
fi
if pakro -h >/dev/null 2>&1; then
  ok "pakro -h succeeded"
else
  fail "pakro -h failed"
fi

# Cleanup
cd - >/dev/null
rm -rf "$TEMP_DIR"

echo ""
echo "All help command tests passed!"
