#!/usr/bin/env bash
# Lockfile adoption under the identity install layout (jdx/mise#13678).
#
# A project whose lockfile pins the checksum of an artifact reuses an unlocked
# installation that was acquired from that very artifact: nothing is downloaded
# or installed again, and the unlocked installation is not renamed or moved.
# Because a lockfile now relies on that installation, an explicit refresh of the
# unlocked request must not replace it in place: the shared unlocked selection
# moves to a new installation and the locked project stays on the one it pinned.
export PAKRO_EXPERIMENTAL=1
export PAKRO_INSTALL_LAYOUT=identity
detect_platform

installs="$PAKRO_DATA_DIR/installs"
work="$PWD"
tool="github:jdx/mise-test-fixtures"

mkdir free pinned
cat >free/pakro.toml <<'EOF'
[tools]
"github:jdx/mise-test-fixtures" = { version = "1.0.0", asset_pattern = "hello-world-1.0.0.tar.gz", bin_path = "hello-world-1.0.0/bin" }
EOF
cp free/pakro.toml pinned/pakro.toml

echo "=== an unlocked install records the artifact it acquired ==="
assert "pakro -C $work/free install"
dir_a="$(pakro -C "$work/free" where "$tool")"
assert_matches "pakro -C $work/free where $tool" "^$installs/mise-test-fixtures-[a-z2-7]{8}\$"
checksum="$(sed -n 's/^checksum = "\(.*\)"$/\1/p' "$dir_a/.pakro-install.toml")"
[[ $checksum =~ ^sha256:[0-9a-f]{64}$ ]] || fail "the receipt records no artifact checksum: '$checksum'"
assert_contains "pakro -C $work/free x -- hello-world" "hello world"

echo "=== a lockfile pinning that artifact adopts the installation ==="
assert "cd pinned && PAKRO_LOCKFILE=1 pakro lock --platform $PAKRO_PLATFORM"
assert_contains "cat pinned/pakro.lock" "checksum = \"$checksum\""
assert_contains "cd pinned && PAKRO_LOCKFILE=1 pakro install 2>&1" "already installed"
assert "PAKRO_LOCKFILE=1 pakro -C $work/pinned where $tool" "$dir_a"
assert "test \"\$(ls -d '$installs'/mise-test-fixtures-* | wc -l)\" -eq 1"
assert_contains "PAKRO_LOCKFILE=1 pakro -C $work/pinned x -- hello-world" "hello world"
# the locked project's PATH names the installation itself, not a version link
assert_contains "PAKRO_LOCKFILE=1 pakro -C $work/pinned bin-paths $tool" "$dir_a/hello-world-1.0.0/bin"

echo "=== routine use keeps the unlocked selection where it is ==="
assert "pakro -C $work/free where $tool" "$dir_a"
assert_contains "pakro -C $work/free install 2>&1" "already installed"
assert "pakro -C $work/free where $tool" "$dir_a"
assert "test \"\$(ls -d '$installs'/mise-test-fixtures-* | wc -l)\" -eq 1"

echo "=== an explicit refresh does not replace the pinned installation in place ==="
touch "$dir_a/adopted-by-a-lockfile"
assert "pakro -C $work/free install --force"
dir_b="$(pakro -C "$work/free" where "$tool")"
[[ $dir_b != "$dir_a" ]] || fail "the refresh replaced the pinned installation $dir_a in place"
assert_matches "pakro -C $work/free where $tool" "^$installs/mise-test-fixtures-[a-z2-7]{8}\$"
assert "test -f '$dir_a/adopted-by-a-lockfile'"
assert "test -f '$dir_a/.pakro-install.toml'"
assert "test -f '$dir_b/.pakro-install.toml'"
assert "test ! -e '$dir_b/adopted-by-a-lockfile'"
assert "test \"\$(ls -d '$installs'/mise-test-fixtures-* | wc -l)\" -eq 2"
# the locked project stays on what it pinned, the unlocked one moved on
assert "PAKRO_LOCKFILE=1 pakro -C $work/pinned where $tool" "$dir_a"
assert "pakro -C $work/free where $tool" "$dir_b"
assert_contains "PAKRO_LOCKFILE=1 pakro -C $work/pinned x -- hello-world" "hello world"
assert_contains "pakro -C $work/free x -- hello-world" "hello world"
# and the selection is sticky again: using it does not move it back
assert "pakro -C $work/free where $tool" "$dir_b"
assert_contains "pakro -C $work/free install 2>&1" "already installed"
assert "pakro -C $work/free where $tool" "$dir_b"

echo "=== neither installation is pruned while a tracked config needs it ==="
cd "$(mktemp -d)" || exit 1
assert_succeed "pakro prune --dry-run-code --tools"
assert "test -f '$dir_a/.pakro-install.toml' && test -f '$dir_b/.pakro-install.toml'"
