#!/usr/bin/env bash
# Settings the config loader consumes before any config file is read cannot be set in one.
# Writing them used to succeed and then be ignored, and `pakro settings get` echoed the stored
# value back as if it were live.
#
# See: https://github.com/jdx/mise/discussions/5791

# the write is refused, and the message names the variable that does work
assert_fail "pakro settings set default_config_filename .pakro.toml" "PAKRO_DEFAULT_CONFIG_FILENAME"
assert_fail "pakro settings add default_config_filename .pakro.toml" "PAKRO_DEFAULT_CONFIG_FILENAME"
assert_fail "pakro settings set global_config_file /tmp/elsewhere.toml" "PAKRO_GLOBAL_CONFIG_FILE"

# hand-writing it into a config is dropped at load rather than reported as active — this is the
# half that matters, since `settings get` returning the value is what convinced the reporter it
# had taken effect
cat <<'EOF' >"$PAKRO_CONFIG_DIR/config.toml"
[settings]
default_config_filename = ".pakro.toml"
EOF
assert_not_contains "pakro settings get default_config_filename" ".pakro.toml"
assert "pakro settings get default_config_filename" "pakro.toml"

# the env var is the supported route and is untouched. The config above is left in place on
# purpose: its value is dropped at load, so this also covers the env var still working while a
# config file names the same setting.
mkdir -p envonly
cd envonly || exit 1
PAKRO_DEFAULT_CONFIG_FILENAME=.pakro.toml pakro use dummy@1
assert_contains "cat .pakro.toml" 'dummy = "1"'
assert_fail "test -f pakro.toml"
cd .. || exit 1
