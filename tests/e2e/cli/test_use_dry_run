#!/usr/bin/env bash
# Test use --dry-run functionality

set -euo pipefail

# Create a temporary directory for testing
TEST_DIR=$(mktemp -d)
cd "$TEST_DIR"

# Test: Dry-run should show what would be added without actually modifying the file
assert_contains "pakro use tiny@3.1.0 --dry-run 2>&1" "would update"
assert_contains "pakro use tiny@3.1.0 --dry-run 2>&1" "add: tiny@3.1.0"
# Config file should not exist after dry-run
assert_fail "test -f pakro.toml"

# Test: Tool should not be installed after dry-run
assert_fail "pakro which tiny"

# Test: Regular use should actually add the tool
pakro use tiny@3.1.0
assert_contains "cat pakro.toml" "tiny"

# Test: Dry-run for removing a tool
assert_contains "pakro use --remove tiny --dry-run 2>&1" "would update"
assert_contains "pakro use --remove tiny --dry-run 2>&1" "remove: tiny"
assert_contains "cat pakro.toml" "tiny" # Should still be there

# Test: Actually remove the tool
pakro use --remove tiny
assert_not_contains "cat pakro.toml" "tiny"

# Test: Dry-run with multiple tools
rm -f pakro.toml # Start fresh
output=$(pakro use jq@latest shfmt@3.10.0 --dry-run 2>&1)
assert_contains "echo '$output'" "would update"
assert_contains "echo '$output'" "jq@"
assert_contains "echo '$output'" "shfmt@"
assert_fail "test -f pakro.toml" # File should not be created

# Test: --dry-run-code should exit non-zero when there are changes to make
rm -f pakro.toml
assert_fail_contains "pakro use tiny@3.1.0 --dry-run-code 2>&1" "would update"
assert_fail "test -f pakro.toml" # File should not be created

# Test: --dry-run-code for removing a tool should exit non-zero
pakro use tiny@3.1.0
assert_fail_contains "pakro use --remove tiny --dry-run-code 2>&1" "would update"
assert_contains "cat pakro.toml" "tiny" # Should still be there
