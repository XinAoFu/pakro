#!/usr/bin/env bash

cat <<EOF >pakro.toml
[settings]
experimental = true
[tools]
dummy = 'latest'
[hooks]
preinstall = 'echo PREINSTALL'
EOF

assert_contains "pakro i dummy 2>&1" "PREINSTALL"
assert_not_contains "pakro --no-hooks i dummy 2>&1" "PREINSTALL"

assert_not_contains "PAKRO_NO_HOOKS=1 pakro --no-hooks i dummy 2>&1" "PREINSTALL"

cat <<EOF >pakro.toml
[settings]
experimental = true
no_hooks = true
[tools]
dummy = 'latest'
[hooks]
preinstall = 'echo PREINSTALL'
EOF

assert_not_contains "pakro i dummy 2>&1" "PREINSTALL"
