#!/usr/bin/env bash

pakro use -g watchexec@latest

cat <<'EOF' >pakro.dev.toml
[tasks.watch-env]
run = 'echo "PAKRO_ENV=$PAKRO_ENV"'
EOF

LOG_FILE=$(mktemp)
pakro --env dev watch watch-env >"$LOG_FILE" 2>&1 &
WATCH_PID=$!

trap 'kill "$WATCH_PID" 2>/dev/null || true' EXIT

for _ in $(seq 1 40); do
  grep -q "PAKRO_ENV=dev" "$LOG_FILE" && break
  sleep 0.5
done

if ! grep -q "PAKRO_ENV=dev" "$LOG_FILE"; then
  fail "Expected watched task to inherit PAKRO_ENV=dev, got: $(tr -d '\0' <"$LOG_FILE")"
fi

ok "pakro watch propagates --env to watched tasks"
