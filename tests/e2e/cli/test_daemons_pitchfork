#!/usr/bin/env bash

# Set PAKRO_TEST_PITCHFORK to test a local build instead of the released version.
if [[ -z ${PAKRO_TEST_PITCHFORK:-} ]]; then
  # Exercise this exact release even during the default release-age delay.
  pakro install pitchfork@2.25.0 --minimum-release-age 0s
  PAKRO_TEST_PITCHFORK="$(pakro which pitchfork --tool pitchfork@2.25.0)"
fi
export PITCHFORK_STATE_DIR="$TMPDIR/pf"
export PITCHFORK_CONFIG_DIR="$TMPDIR/pf-config"
export PITCHFORK_AUTOSTOP_DELAY=0s
export PITCHFORK_INTERVAL=100ms
export PITCHFORK_PROXY_ENABLE=false
mkdir -p "$PITCHFORK_STATE_DIR" "$PITCHFORK_CONFIG_DIR"
# Keep the fixture executable available when testing pakro prune.
cp "$PAKRO_TEST_PITCHFORK" ~/bin/pitchfork
export PATH="$HOME/bin:$PATH"
trap 'pitchfork supervisor stop >/dev/null 2>&1 || true' EXIT

mkdir -p project other
cd project
project_dir="$PWD"
cat >pakro.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.api]
run = "exec sleep 600"
ready_delay = 0
auto = ["start", "stop"]
TOML
assert "test ! -f '$PITCHFORK_CONFIG_DIR/config.toml'"
assert_contains "pakro daemons ls --json" '"status": "available"'
assert "test ! -f '$PITCHFORK_CONFIG_DIR/config.toml'"
pakro daemons start api
assert_contains "pakro daemons ls --json" '"status": "running"'
# A second profile cannot overwrite a running project.
assert_contains "PAKRO_ENV=alternate pakro daemons start 2>&1 || true" 'another daemon profile is active'
pakro daemons stop

# A namespace change lists each daemon once and preserves active IDs until stopped.
cp pakro.toml original.toml
cat >>pakro.toml <<'TOML'
[daemons_settings]
namespace = "renamed"
TOML
assert "test $(pakro daemons ls --json | jq length) -eq 1"
assert_contains "pakro daemons ls --json" '"id": "renamed/api"'
# An ordinary activation must update registration even if daemon definitions match.
pakro hook-env -s bash --shell-pid $$ >/dev/null
assert_contains "pitchfork config list --json" '"namespace": "renamed"'
pakro daemons start
cp original.toml pakro.toml
cat >>pakro.toml <<'TOML'
[daemons_settings]
namespace = "next"
[daemons.extra]
run = "exec sleep 600"
TOML
assert "test $(pakro daemons ls --json | jq length) -eq 2"
assert_contains "pakro daemons ls --json" '"id": "renamed/api"'
assert_contains "pakro daemons ls --json" '"id": "next/extra"'
assert_contains "pakro daemons ls --json" '"status": "running"'
pakro daemons stop api
assert_contains "pakro daemons ls --json" '"id": "next/api"'
cp original.toml pakro.toml
assert "test $(pakro daemons ls --json | jq length) -eq 1"
pakro daemons start
pakro daemons stop

# An explicit start restores a registration removed outside pakro.
registration=$(pitchfork config list --json | jq -r '.[0].config[0]')
pitchfork config remove "$registration"
assert "test $(pitchfork config list --json | jq length) -eq 0"
pakro daemons start
assert_contains "pakro daemons ls --json" '"status": "running"'
assert "test $(pitchfork config list --json | jq length) -eq 1"
pakro daemons stop

# Evaluate the activation output, preserving each simulated shell's environment.
hook_session() {
  local key="daemon_session_$1"
  export __PAKRO_DAEMON_SESSIONS="${!key-}"
  eval "$(pakro hook-env --shell-pid "$1" --force -s bash)"
  printf -v "$key" '%s' "${__PAKRO_DAEMON_SESSIONS:-}"
}
# Each shell owns an independent session. Explicit --force also exercises retry paths.
sleep 600 &
second_pid=$!
trap 'if [[ -n ${activation_pid:-} ]]; then kill "$activation_pid" 2>/dev/null || true; fi; kill "$second_pid" 2>/dev/null || true; pitchfork supervisor stop >/dev/null 2>&1 || true' EXIT
hook_session $$
hook_session "$second_pid"
for _ in {1..100}; do
  sessions=$(pitchfork project list --json)
  [[ $(jq 'length' <<<"$sessions") == 2 ]] && break
  sleep 0.1
done
assert "test $(pitchfork project list --json | jq length) -eq 2"
# Tool/shim writes from initial startup may invalidate one prompt. Once stable,
# unchanged prompts must not register configs or emit session commands.
sleep 1
for _ in {1..5}; do
  hook_output=$(pakro hook-env --shell-pid "$second_pid" -s bash)
  eval "$hook_output"
done
assert "test ${#hook_output} -eq 0"

# A new activated shell must enter even when it inherits an up-to-date hook cache.
cat >"$TMPDIR/activation.fish" <<'FISH'
pakro activate fish | source
jobs -p >"$CHILD_JOBS"
while not test -f "$CHILD_DONE"
  sleep 0.1
end
FISH
cat >"$TMPDIR/activation.sh" <<'SH'
eval "$(pakro activate "$1")"
jobs -p >"$CHILD_JOBS"
while [[ ! -f "$CHILD_DONE" ]]; do sleep 0.1; done
SH
for activation_shell in bash zsh fish; do
  export CHILD_DONE="$TMPDIR/$activation_shell.done"
  export CHILD_JOBS="$TMPDIR/$activation_shell.jobs"
  if [[ $activation_shell == fish ]]; then
    fish "$TMPDIR/activation.fish" &
  else
    "$activation_shell" "$TMPDIR/activation.sh" "$activation_shell" &
  fi
  activation_pid=$!
  for _ in {1..100}; do
    [[ $(pitchfork project list --json | jq length) == 3 ]] && break
    sleep 0.1
  done
  assert "test $(pitchfork project list --json | jq length) -eq 3"
  assert "test ! -s '$CHILD_JOBS'"
  touch "$CHILD_DONE"
  wait "$activation_pid"
  unset activation_pid
  for _ in {1..100}; do
    [[ $(pitchfork project list --json | jq length) == 2 ]] && break
    sleep 0.1
  done
  assert "test $(pitchfork project list --json | jq length) -eq 2"
done

pakro daemons stop
assert_contains "PAKRO_ENV=alternate pakro daemons start 2>&1 || true" "another daemon profile is active"
pakro daemons start
cd ../other
# A failed leave must retain enough shell state for a later forced hook to retry.
mv ~/bin/pitchfork ~/bin/pitchfork.real
cat >~/bin/pitchfork <<'SH'
#!/bin/sh
exit 1
SH
chmod +x ~/bin/pitchfork
hook_session $$
sleep 0.2
assert "test $(~/bin/pitchfork.real project list --json | jq length) -eq 2"
mv ~/bin/pitchfork.real ~/bin/pitchfork
hook_session $$
for _ in {1..100}; do
  [[ $(pitchfork project list --json | jq length) == 1 ]] && break
  sleep 0.1
done
assert "test $(pitchfork project list --json | jq length) -eq 1"
cd "$project_dir"
assert_contains "pakro daemons ls --json" '"status": "running"'
cd ../other
hook_session "$second_pid"
for _ in {1..100}; do
  [[ $(pitchfork project list --json | jq length) == 0 ]] && break
  sleep 0.1
done
assert "test $(pitchfork project list --json | jq length) -eq 0"
cd "$project_dir"
pakro daemons stop

# Leaving while readiness is pending must not strand a shell session.
cat >pakro.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.api]
run = "exec sleep 600"
ready_delay = 4
auto = ["start", "stop"]
TOML
hook_session $$
sleep 0.2
assert "test ! -d '$PAKRO_STATE_DIR/daemons/sessions'"
cd ../other
hook_session $$
sleep 5
for _ in {1..100}; do
  [[ $(pitchfork project list --json | jq length) == 0 ]] && break
  sleep 0.1
done
assert "test $(pitchfork project list --json | jq length) -eq 0"
cd "$project_dir"
pakro daemons stop

# Empty declarations detach the generated file and keep stopped IDs inspectable.
cat >pakro.toml <<'TOML'
[tools]
pitchfork = "system"
TOML
pakro daemons stop
assert "test $(pitchfork config list --json | jq length) -eq 1"
# Synchronization belongs to start, even when there are no remaining daemons.
pakro daemons start 2>/dev/null || true
assert "test $(pitchfork config list --json | jq length) -eq 0"

# A named start prepares imported dependencies in their owning environment.
mkdir -p ../import-app ../import-owner
cat >../import-owner/pakro.toml <<'TOML'
[tools]
pitchfork = "system"
node = "system"
[daemons_settings]
namespace = "remote"
[daemons.worker]
preset = "redis"
version = "1"
tool = "node"
TOML
cat >../import-app/pakro.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons_settings]
namespace = "app"
[daemons.api]
run = "exec sleep 600"
ready_delay = 0
depends = ["pipeline"]
[daemons.pipeline]
project = "../import-owner"
name = "worker"
[daemons.worker]
run = "exec sleep 600"
ready_delay = 0
TOML
cd ../import-app
# The local worker must not select or validate the imported worker.
pakro daemons start worker
assert_contains "pitchfork status app/worker --json" '"status": "running"'
pakro daemons stop worker
assert_contains "pakro daemons start api 2>&1 || true" 'daemon worker requires node@1'
assert "test $(pitchfork status app/api --json | jq -r .status) != running"
# Register the owner's full dependency chain before starting the app.
cat >../import-owner/pakro.toml <<'TOML'
[tools]
pitchfork = "system"
node = "system"
[daemons_settings]
namespace = "remote"
[daemons.worker]
run = "exec sleep 600"
ready_delay = 0
depends = ["helper"]
[daemons.helper]
run = "exec sleep 600"
ready_delay = 0
[daemons.idle]
run = "exec sleep 600"
ready_delay = 0
# This unimported namesake must not be selected for tool validation.
[daemons.api]
preset = "redis"
version = "1"
tool = "node"
TOML
pakro daemons start api
assert_contains "pitchfork status app/api --json" '"status": "running"'
assert_contains "pitchfork status remote/worker --json" '"status": "running"'
assert_contains "pitchfork status remote/helper --json" '"status": "running"'
assert "test $(pitchfork status remote/idle --json | jq -r .status) != running"
pakro daemons stop
cd ../import-owner
pakro daemons stop

# `--all` covers every daemon in the project, including ones a `default` group
# leaves out, and never reaches another project. Pitchfork rejects its own `--all`
# next to the IDs pakro passes, so pakro must not forward the flag.
mkdir -p ../all-bystander ../all-project
cd ../all-bystander
cat >pakro.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons_settings]
namespace = "bystander"
[daemons.other]
run = "exec sleep 600"
ready_delay = 0
TOML
pakro daemons start
cd ../all-project
cat >pakro.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons_settings]
namespace = "allproj"
[daemons.web]
run = "exec sleep 600"
ready_delay = 0
[daemons.extra]
run = "exec sleep 600"
ready_delay = 0
[daemon_groups]
default = ["web"]
TOML
pakro daemons start
assert_contains "pitchfork status allproj/web --json" '"status": "running"'
assert "test $(pitchfork status allproj/extra --json | jq -r .status) != running"
pakro daemons stop
pakro daemons start --all
assert_contains "pitchfork status allproj/web --json" '"status": "running"'
assert_contains "pitchfork status allproj/extra --json" '"status": "running"'
assert_fail_contains "pakro daemons stop --all web" "--all selects every daemon"
pakro daemons stop --all
assert "test $(pitchfork status allproj/web --json | jq -r .status) != running"
assert "test $(pitchfork status allproj/extra --json | jq -r .status) != running"
assert_contains "pitchfork status bystander/other --json" '"status": "running"'
cd ../all-bystander
pakro daemons stop
