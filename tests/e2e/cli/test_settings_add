#!/usr/bin/env bash

# pakro should ignore identical values which have been passed using `add`
assert "pakro settings add disable_hints a" ""
assert "pakro settings add disable_hints b" ""
assert "pakro settings get disable_hints" '["a", "b"]'
assert "pakro settings add disable_hints a" ""
assert "grep disable_hints ~/.config/pakro/config.toml" 'disable_hints = ["a", "b"]'

assert "pakro settings add idiomatic_version_file_enable_tools=python" ""
assert "pakro settings add idiomatic_version_file_enable_tools rust" ""
assert "pakro settings get idiomatic_version_file_enable_tools" '["python", "rust"]'
assert "pakro settings add idiomatic_version_file_enable_tools=python,rust,zig" ""
assert "grep idiomatic_version_file_enable_tools ~/.config/pakro/config.toml" 'idiomatic_version_file_enable_tools = ["python", "rust", "zig"]'

# test "settings add key=value" format
assert "pakro settings add disable_hints=c" ""
assert "pakro settings get disable_hints" '["a", "b", "c"]'

# test adding to a list setting
assert "pakro settings set aqua.registries https://example.com/first" ""
assert "pakro settings add aqua.registries https://example.com/second" ""
assert "pakro settings get aqua.registries" '["https://example.com/first", "https://example.com/second"]'

# test "settings add" with no value and no = fails
assert_fail "pakro settings add disable_hints"
