#!/usr/bin/env bash

export CLICOLOR=0

echo "dummy latest" >.tool-versions

assert_contains "pakro ls dummy" "2.0.0 (missing)"

pakro i dummy@{1.0.0,1.1.0,2.0.0}
assert_contains "pakro ls dummy" "1.0.0"
assert_contains "pakro ls dummy" "1.1.0"
assert_contains "pakro ls dummy" "2.0.0"

pakro uninstall -a dummy@1
assert_not_contains "pakro ls dummy" "1.0.0"
assert_not_contains "pakro ls dummy" "1.1.0"
assert_contains "pakro ls dummy" "2.0.0"

pakro uninstall -a dummy
assert_not_contains "pakro ls dummy" "1.1.0"
assert_not_contains "pakro ls dummy" "2.0.1"
assert_not_contains "pakro ls dummy" "2.1.0"

# Test: --dry-run-code should exit non-zero when there are tools to uninstall
pakro i dummy@1.0.0
assert_fail_contains "pakro uninstall dummy@1.0.0 --dry-run-code 2>&1" "uninstalled (dry-run)"
# Verify the tool was NOT actually uninstalled
assert_contains "pakro ls --installed dummy" "1.0.0"

# Test: --dry-run-code should exit 0 when the tool is not installed
pakro uninstall dummy@1.0.0
assert_succeed "pakro uninstall dummy@1.0.0 --dry-run-code 2>&1"
