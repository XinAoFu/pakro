#!/usr/bin/env bash
export PAKRO_EXPERIMENTAL=1
export PAKRO_LOCKFILE=1

assert "pakro use dummy@3.1.0"
assert "pakro where dummy" "$PAKRO_DATA_DIR/installs/dummy/3.1.0"
assert "pakro install dummy@2"
assert "pakro where dummy@2" "$PAKRO_DATA_DIR/installs/dummy/2.0.0"
assert "pakro where dummy@3" "$PAKRO_DATA_DIR/installs/dummy/3.1.0"
assert "pakro alias set dummy my/dummy 3"
assert "pakro install dummy@my/dummy"
assert "pakro where dummy@my/dummy" "$PAKRO_DATA_DIR/installs/dummy/3"
assert "pakro uninstall dummy@my/dummy"
assert_fail "pakro where dummy@1111" "dummy@1111 not installed"

echo 'tools.dummy = "latest"' >pakro.toml
cat <<EOF >pakro.lock
[[tools.dummy]]
version = "3.0.0"
backend = "asdf:dummy"
EOF
assert "pakro i"
assert "pakro where dummy" "$PAKRO_DATA_DIR/installs/dummy/3.0.0"
