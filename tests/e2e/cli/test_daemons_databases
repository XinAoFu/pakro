#!/usr/bin/env bash
# e2e:non-root

if [[ -z ${PAKRO_TEST_PITCHFORK:-} ]]; then
  # Exercise this exact release even during the default release-age delay.
  pakro install pitchfork@2.25.0 --minimum-release-age 0s
  PAKRO_TEST_PITCHFORK="$(pakro which pitchfork --tool pitchfork@2.25.0)"
fi
export PITCHFORK_STATE_DIR="$TMPDIR/pf"
export PITCHFORK_CONFIG_DIR="$TMPDIR/pf-config"
export PITCHFORK_PROXY_ENABLE=false
# Keep the fixture executable available when testing pakro prune.
cp "$PAKRO_TEST_PITCHFORK" ~/bin/pitchfork
export PATH="$HOME/bin:$PATH"
trap 'pitchfork supervisor stop >/dev/null 2>&1 || true' EXIT
pg_port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
redis_port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
# A compound override must initialize first and leave the database as the tracked PID.
cat >start-postgres <<'SH'
#!/bin/sh
data="$PWD/.data/my postgres"
test -f "$data/PG_VERSION" || exit 1
exec postgres -D "$data" -p "$PGPORT" -h 127.0.0.1 -k ''
SH
cat >pakro.toml <<TOML
[tools]
pitchfork = "system"
postgres = "18"
[daemons.postgres]
preset = "postgres"
data_dir = ".data/my postgres"
version = "18"
port = $pg_port
options.database = "integration"
run = "echo starting && exec sh ./start-postgres"
[daemons.redis]
preset = "redis"
version = "8"
port = $redis_port
TOML
# Lock both explicit postgres and implicit redis under this config before enforcing it.
export PAKRO_LOCKFILE=1
pakro lock --platform linux-x64
assert_contains "cat pakro.lock" '[[tools.redis]]'
cat >>pakro.toml <<'TOML'
[tool_config]
locked = true
TOML
pakro daemons start
assert "test -f '.data/my postgres/PG_VERSION'"
assert_contains "pakro daemons ls --json | jq -r '.[] | select(.name == \"postgres\") | .data_dir'" "$PWD/.data/my postgres"
pg_pid=$(pakro daemons ls --json | jq -r '.[] | select(.name == "postgres") | .pid')
assert_contains "ps -p '$pg_pid' -o comm=" postgres
assert_contains "pakro daemons ls --json" '"status": "running"'
pakro exec -- psql -h 127.0.0.1 -p "$pg_port" -U postgres -d integration -c 'CREATE TABLE proof (value integer); INSERT INTO proof VALUES (42);'
assert_contains "pakro exec -- redis-cli -h 127.0.0.1 -p '$redis_port' SET proof retained" OK
pakro daemons stop
assert_fail "kill -0 '$pg_pid'"
pakro daemons start
assert_contains "pakro exec -- psql -h 127.0.0.1 -p '$pg_port' -U postgres -d integration -Atc 'SELECT value FROM proof'" 42
assert_contains "pakro exec -- redis-cli -h 127.0.0.1 -p '$redis_port' GET proof" retained
pakro daemons stop
pg_install=$(pakro where postgres)
pakro unuse redis
pakro prune --tools
assert "test -x '$pg_install/bin/psql'"
assert_contains "pakro exec -- psql --version" "18."

# Incompatible metadata fails without deleting existing contents.
data_dir=$(find "$PAKRO_STATE_DIR/daemons" -path '*/data/redis' -type d -print -quit)
echo redis:0 >"$data_dir/.pakro-daemon-version"
assert_contains "pakro daemons start redis 2>&1 || true" 'incompatible redis data'
assert "test -d '$data_dir/appendonlydir'"

# Incomplete data is not mistaken for a successfully initialized instance.
mkdir -p "$TMPDIR/incomplete"
echo preserved >"$TMPDIR/incomplete/user-data"
assert_contains "pakro exec -- pakro daemons __init redis '$TMPDIR/incomplete' 2>&1 || true" "daemon data was not initialized completely"
assert_contains "cat '$TMPDIR/incomplete/user-data'" preserved

# A missing PostgreSQL marker reports incomplete initialization clearly.
pg_data="$PWD/.data/my postgres"
mv "$pg_data/PG_VERSION" "$pg_data/PG_VERSION.saved"
assert_contains "pakro exec -- pakro daemons __init postgres '$pg_data' --context '{\"database\":\"integration\"}' 2>&1 || true" 'daemon data was not initialized completely'
mv "$pg_data/PG_VERSION.saved" "$pg_data/PG_VERSION"
