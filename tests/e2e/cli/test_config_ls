#!/usr/bin/env bash

assert "pakro set FOO=bar"
assert "pakro env"
assert "pakro cfg --tracked-configs" "$PWD/pakro.toml"

# env files from PAKRO_ENV_FILE setting appear in config ls output
echo "MY_VAR=hello" >.test-env
assert_contains "PAKRO_ENV_FILE=.test-env pakro cfg ls" ".test-env"
assert_contains "PAKRO_ENV_FILE=.test-env pakro cfg ls" "(none)"

# -v shows the env var keys set by the env file
assert_contains "PAKRO_ENV_FILE=.test-env pakro cfg ls -v" "MY_VAR"

# env files from pakro.toml [env] directive also appear
cat <<EOF >pakro.toml
[env]
_.file = '.test-env'
EOF
assert_contains "pakro cfg ls" ".test-env"
