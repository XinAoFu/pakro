#!/usr/bin/env bash

# When a newer pakro is available, the warning must always be followed by a way
# to act on it. Installs that disable self-update without shipping an
# instructions file (Homebrew, Arch, the AUR pakro-bin package) previously got
# "pakro version X available" and nothing else.

# show_latest() returns early under ci_info::is_ci(), so clear the CI markers
unset CI GITHUB_ACTIONS GITHUB_ACTION 2>/dev/null || true

# Seed a newer release with an old publication date, so the default 24h policy
# permits it without a network request.
printf "9999.0.0\t946684800\n" >"$PAKRO_CACHE_DIR/latest-version.releases-v1"

# self-update disabled, no packager instructions → generic hint
assert_contains 'PAKRO_SELF_UPDATE_AVAILABLE=false pakro version 2>&1' '9999.0.0 available'
assert_contains 'PAKRO_SELF_UPDATE_AVAILABLE=false pakro version 2>&1' 'self-update is disabled for this install'

# packager instructions win over the generic hint
cat >instructions.toml <<'TOML'
message = "To update, run brew upgrade pakro"
TOML

assert_contains 'PAKRO_SELF_UPDATE_AVAILABLE=false PAKRO_SELF_UPDATE_INSTRUCTIONS=./instructions.toml pakro version 2>&1' 'brew upgrade pakro'
assert_not_contains 'PAKRO_SELF_UPDATE_AVAILABLE=false PAKRO_SELF_UPDATE_INSTRUCTIONS=./instructions.toml pakro version 2>&1' 'self-update is disabled for this install'

# self-update available → unchanged advice
assert_contains 'PAKRO_SELF_UPDATE_AVAILABLE=true pakro version 2>&1' 'pakro self-update'
assert_not_contains 'PAKRO_SELF_UPDATE_AVAILABLE=true pakro version 2>&1' 'self-update is disabled for this install'

# Suppression is independent of self-update availability and packager instructions.
export PAKRO_DISABLE_UPDATE_WARNING=true
assert_not_contains 'PAKRO_SELF_UPDATE_AVAILABLE=true pakro version 2>&1' 'pakro WARN'
assert_not_contains 'PAKRO_SELF_UPDATE_AVAILABLE=false PAKRO_SELF_UPDATE_INSTRUCTIONS=./instructions.toml pakro --version 2>&1' 'pakro WARN'
assert_contains 'pakro version --json' '9999.0.0'
unset PAKRO_DISABLE_UPDATE_WARNING

# The setting also works in configuration and both doctor output formats.
cat >pakro.toml <<'TOML'
[settings]
disable_update_warning = true
TOML
pakro trust
assert_not_contains 'pakro version 2>&1' 'pakro WARN'
eval "$(pakro activate bash)"
assert_not_contains 'pakro doctor 2>&1' '9999.0.0 available'
assert_succeed "set -o pipefail; pakro doctor --json | jq -e '(.warnings // []) | map(contains(\"9999.0.0 available\")) | any | not'"
assert_contains 'PAKRO_DISABLE_UPDATE_WARNING=false pakro version 2>&1' '9999.0.0 available'

# Suppressing warnings still permits an explicit self-update. Requesting the
# current version takes the up-to-date path without downloading anything.
version="$(pakro version | tail -n1 | awk '{print $1}' | sed 's/-DEBUG$//')"
assert_contains "PAKRO_SELF_UPDATE_AVAILABLE=true pakro self-update $version --no-plugins 2>&1" 'pakro is already up to date'

# A package-local instructions file is found next to the actual binary, even
# when launched through a symlink like node_modules/.bin/pakro.
mkdir -p package/bin package/lib node_modules/.bin
cp "$(type -P pakro)" package/bin/pakro
cat >package/lib/pakro-self-update-instructions.toml <<'TOML'
message = "Update pakro using the package manager that installed it (npm, pnpm, or yarn)."
TOML
ln -s "$PWD/package/bin/pakro" node_modules/.bin/pakro
assert_contains 'PAKRO_DISABLE_UPDATE_WARNING=false node_modules/.bin/pakro version 2>&1' 'npm, pnpm, or yarn'
assert_fail 'node_modules/.bin/pakro self-update --no-plugins' 'npm, pnpm, or yarn'
