#!/usr/bin/env bash

pakro use dummy@latest
pakro use -g watchexec@latest

pakro tasks add example -- echo 'running example'

test_pakro_watch() {
  local pakro_path="$1"
  output_file=.watch_output

  rm -f "${output_file}"

  $pakro_path watch example -e '.aaa' >"${output_file}" &
  PID_TO_KILL=$!

  while ! grep -q "running example" "${output_file}"; do
    sleep 0.5
  done

  kill -SIGINT $PID_TO_KILL

  assert_contains "cat ${output_file}" "running example"
}

# Test with original pakro
test_pakro_watch "pakro"

# Test when pakro is not in PATH by temporarily removing its directory from PATH
original_pakro="$(which pakro)"
pakro_dir="$(dirname "$original_pakro")"
mkdir -p ./bin && cp "$original_pakro" ./bin/pakro
OLD_PATH="$PATH"
PATH="$(echo "$PATH" | tr ':' '\n' | grep -v "^${pakro_dir}$" | tr '\n' ':')"
PATH="${PATH%:}" # remove trailing colon
test_pakro_watch "./bin/pakro"
PATH="$OLD_PATH"
