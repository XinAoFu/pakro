#!/usr/bin/env bash

# Test that `pakro lock` writes tools to the correct lockfile based on their source config.
# Tools from pakro.toml should go to pakro.lock, tools from pakro.local.toml to pakro.local.lock.

export PAKRO_LOCKFILE=1
export PAKRO_EXPERIMENTAL=1

echo "=== Test: tools only in pakro.toml, pakro.local.toml has only env ==="
rm -f pakro.toml pakro.local.toml pakro.lock pakro.local.lock

cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

cat <<EOF >pakro.local.toml
[env]
FOO = "bar"
EOF

pakro lock --platform linux-x64
# Tools should go to pakro.lock, not pakro.local.lock
assert "test -f pakro.lock"
assert "test ! -f pakro.local.lock"
assert_contains "cat pakro.lock" "jqlang/jq"
assert_contains "cat pakro.lock" "1.7.1"

echo "=== Test: tools in both configs go to separate lockfiles ==="
rm -f pakro.toml pakro.local.toml pakro.lock pakro.local.lock

cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

cat <<EOF >pakro.local.toml
[tools]
"aqua:mikefarah/yq" = "4.44.6"
EOF

pakro lock --platform linux-x64
# jq (from pakro.toml) should be in pakro.lock
assert "test -f pakro.lock"
assert_contains "cat pakro.lock" "jqlang/jq"
assert_not_contains "cat pakro.lock" "mikefarah/yq"

# yq (from pakro.local.toml) should be in pakro.local.lock
assert "test -f pakro.local.lock"
assert_contains "cat pakro.local.lock" "mikefarah/yq"
assert_not_contains "cat pakro.local.lock" "jqlang/jq"

echo "=== Test: --local flag only writes pakro.local.lock ==="
rm -f pakro.lock pakro.local.lock

pakro lock --local --platform linux-x64
# Only pakro.local.lock should be created
assert "test -f pakro.local.lock"
assert "test ! -f pakro.lock"
assert_contains "cat pakro.local.lock" "mikefarah/yq"

echo "=== Cleanup ==="
rm -f pakro.toml pakro.local.toml pakro.lock pakro.local.lock

echo "pakro lock local config tests passed!"
