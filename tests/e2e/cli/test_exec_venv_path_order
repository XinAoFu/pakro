#!/usr/bin/env bash

# Regression test: `pakro x -- tool` should respect PATH order when a
# virtualenv (or similar) directory is prepended to PATH by pakro config.
# Previously, `which_bin` pre-resolution bypassed PATH entirely for
# pakro-managed tools, so a venv binary would be ignored even though
# pakro itself added it to PATH.
# See: https://github.com/jdx/mise/discussions/8340

# Create a fake "venv" with a dummy override that prints a distinct marker
venvdir="$HOME/fake_venv/bin"
mkdir -p "$venvdir"
cat >"$venvdir/dummy" <<'SCRIPT'
#!/bin/sh
echo VENV_DUMMY
SCRIPT
chmod +x "$venvdir/dummy"

# Configure pakro with the dummy tool and prepend the venv dir to PATH
# (this simulates what _.python.venv does)
cat >pakro.toml <<EOF
[tools]
dummy = "latest"

[env]
_.path = ["$venvdir"]
EOF

pakro i

# pakro x -- which dummy should find the venv binary first
assert "pakro x -- which dummy" "$venvdir/dummy"

# pakro x -- dummy should actually execute the venv binary, not the pakro-managed one
assert "pakro x -- dummy" "VENV_DUMMY"
