#!/usr/bin/env bash

assert "pakro i tiny@1.0.0"
assert "pakro i dummy@1.0.0"

assert "pakro use dummy tiny"
assert "pakro tool dummy --requested" "latest"
assert "pakro tool dummy --active" "1.0.0"
assert "pakro tool tiny --active" "1.0.0"

assert "pakro use dummy@latest"
assert "pakro tool dummy --active" "2.0.0"
assert "pakro tool tiny --active" "1.0.0"
assert "pakro tool dummy --requested" "latest"
assert "pakro tool tiny --requested" "latest"

touch pakro.lock
assert "pakro use dummy@1 tiny@1"
assert "cat pakro.lock" "$LOCKFILE_HEADER

lockfile_version = 3

[[tools.dummy]]
version = \"1.0.0\"
backend = \"asdf:dummy\"
specifiers = [\"1\"]

[[tools.tiny]]
version = \"1.0.0\"
backend = \"asdf:tiny\"
specifiers = [\"1\"]"
assert "pakro tool dummy --requested" "1"
assert "pakro tool tiny --requested" "1"
assert "pakro tool dummy --active" "1.0.0"
assert "pakro tool tiny --active" "1.0.0"

assert "pakro use dummy@latest"
assert "cat pakro.lock" "$LOCKFILE_HEADER

lockfile_version = 3

[[tools.dummy]]
version = \"2.0.0\"
backend = \"asdf:dummy\"
specifiers = [\"latest\"]

[[tools.tiny]]
version = \"1.0.0\"
backend = \"asdf:tiny\"
specifiers = [\"1\"]"
assert "pakro tool dummy --requested" "latest"
assert "pakro tool tiny --requested" "1"
assert "pakro tool dummy --active" "2.0.0"
assert "pakro tool tiny --active" "1.0.0"
