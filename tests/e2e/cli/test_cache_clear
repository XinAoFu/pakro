#!/usr/bin/env bash

# Test cache clear with simple plugin name
mkdir -p "$PAKRO_CACHE_DIR/tiny"
echo "test" >"$PAKRO_CACHE_DIR/tiny/data"
assert_directory_exists "$PAKRO_CACHE_DIR/tiny"
assert "pakro cache clear tiny"
assert_directory_not_exists "$PAKRO_CACHE_DIR/tiny"

# Test cache clear with github:owner/repo style name
# The cache dir uses kebab-case: github:owner/repo -> github-owner-repo
mkdir -p "$PAKRO_CACHE_DIR/github-test-repo"
echo "test" >"$PAKRO_CACHE_DIR/github-test-repo/data"
assert_directory_exists "$PAKRO_CACHE_DIR/github-test-repo"
assert "pakro cache clear github:test/repo"
assert_directory_not_exists "$PAKRO_CACHE_DIR/github-test-repo"

# Test cache clear all
mkdir -p "$PAKRO_CACHE_DIR/foo"
echo "test" >"$PAKRO_CACHE_DIR/foo/data"
assert_directory_exists "$PAKRO_CACHE_DIR/foo"
assert "pakro cache clear"
assert_directory_not_exists "$PAKRO_CACHE_DIR/foo"
