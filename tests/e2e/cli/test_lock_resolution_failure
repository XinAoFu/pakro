#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

cat <<EOF >pakro.toml
[tools]
dummy = "3.0.0"
EOF

cat <<EOF >pakro.lock
$LOCKFILE_HEADER

[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"

[tools.dummy.platforms.linux-x64]
checksum = "sha256:old"
EOF

pakro cache clear dummy

assert_fail_contains "RTX_FAILURE=1 pakro lock dummy --platform linux-x64 2>&1" "failed to resolve"
assert_contains "cat pakro.lock" 'version = "1.0.0"'
assert_not_contains "cat pakro.lock" 'version = "3.0.0"'

assert_fail_contains "RTX_FAILURE=1 pakro lock --platform linux-x64 2>&1" "failed to resolve"
assert_contains "cat pakro.lock" 'version = "1.0.0"'
assert_not_contains "cat pakro.lock" 'version = "3.0.0"'

cat <<EOF >pakro.toml
[tools]
dummy = "3.0.0"
jq = "1.7.1"
EOF

cat <<EOF >pakro.lock
$LOCKFILE_HEADER

[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"

[tools.dummy.platforms.linux-x64]
checksum = "sha256:old"
EOF

output=$(RTX_FAILURE=1 pakro lock jq --platform linux-x64 2>&1)
assert_contains "echo '$output'" "Processing 1 tool(s)"
assert_not_contains "echo '$output'" "failed to resolve dummy@3.0.0"
assert_contains "cat pakro.lock" 'version = "1.7.1"'
assert_not_contains "cat pakro.lock" 'version = "3.0.0"'
