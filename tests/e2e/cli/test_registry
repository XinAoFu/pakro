#!/usr/bin/env bash

assert "pakro registry gh" "aqua:cli/cli asdf:bartlomiejdanek/asdf-github-cli"
assert_contains "pakro registry" "gh                            aqua:cli/cli asdf:bartlomiejdanek/asdf-github-cli"

# --json flag tests
assert "pakro registry gh --json | jq -r '.short'" "gh"
assert "pakro registry gh --json | jq -r '.backends[0]'" "aqua:cli/cli"
assert_contains "pakro registry --json | jq -r '.[].short'" "gh"
assert "pakro registry --json | jq -r '.[] | select(.short == \"gh\") | .backends[0]'" "aqua:cli/cli"
# A registry url is included when set and omitted otherwise.
assert "pakro registry dart --json | jq -r '.url'" "https://dart.dev"
assert "pakro registry gh --json | jq -r 'has(\"url\")'" "false"

# --security requires JSON output and adds a security array per tool.
assert "pakro registry bun --json --security | jq -r 'if .security then \"has\" else \"none\" end'" "has"
# Without --security the field should be absent.
assert "pakro registry bun --json | jq -r 'has(\"security\")'" "false"
