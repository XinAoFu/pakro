#!/usr/bin/env bash

assert_contains "pakro outdated --help" "-b, --bump"
assert_not_contains "pakro outdated --help" "-l, --bump"

assert "pakro outdated --json" "{}"
assert "pakro outdated" ""

echo 'dummy 1' >.tool-versions
pakro install dummy@1.0.0

assert_contains "pakro ls --installed dummy" "1.0.0"
assert_not_contains "pakro ls --installed dummy" "1.1.0"

#pakro outdated dummy
#assert_contains "pakro ls --installed dummy" "1.1.0"
#assert_not_contains "pakro ls --installed dummy" "1.0.0"

assert "pakro outdated dummy" "dummy  1  1.0.0  1.1.0 ~/workdir/.tool-versions"
assert "pakro outdated dummy --bump" "dummy  1  1.0.0  2  2.0.0 ~/workdir/.tool-versions"
assert_contains "pakro outdated dummy -l 2>&1" "deprecated [cli.outdated.bump-l]"
assert_contains "pakro outdated dummy -l 2>&1" "2.0.0"
pakro install dummy@1.1.0
assert_contains "pakro outdated dummy 2>&1" "Newer versions are available outside the configured version ranges"

# Test: --local should only show outdated tools from local config, not global
cat <<EOF >pakro.toml
[tools]
dummy = "1"
EOF
cat >"$PAKRO_CONFIG_DIR/config.toml" <<EOF
[tools]
tiny = "1"
EOF
pakro uninstall dummy tiny --all
pakro install dummy@1.0.0 tiny@1.0.0
# --local should only show dummy (local), not tiny (global)
assert_contains "pakro outdated --local" "dummy"
assert_not_contains "pakro outdated --local" "tiny"
# without --local, both should appear
assert_contains "pakro outdated" "dummy"
assert_contains "pakro outdated" "tiny"

# if tiny is installed but no longer active in config, --inactive should still show it
rm -f "$PAKRO_CONFIG_DIR/config.toml"
assert_not_contains "pakro outdated" "tiny"
assert_contains "pakro outdated --inactive" "tiny"

rm -f .tool-versions

echo 'dummy 1' >.tool-versions
pakro uninstall dummy --all
pakro install dummy@1.0.0

assert "pakro outdated dummy --json | jq -r '.dummy.latest'" "1.1.0"
assert "pakro outdated dummy -b --json | jq -r '.dummy.latest'" "2.0.0"

# Most backends publish no release page, and those entries must not grow a
# `"release_url": null`. `has` rather than a `//` default, which cannot tell an
# absent key from a null one -- absent is the thing being asserted.
assert "pakro outdated dummy --json | jq -r '.dummy | has(\"release_url\")'" "false"
