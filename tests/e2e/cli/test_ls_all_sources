#!/usr/bin/env bash

mkdir -p project-a project-b

echo "tools.dummy = '1'" >project-a/pakro.toml
echo "tools.dummy = '1'" >project-b/pakro.toml

assert_succeed "cd project-a && pakro ls dummy"
assert_succeed "cd project-b && pakro ls dummy"

assert_contains "pakro ls dummy --all-sources" "dummy  1.1.0 (missing)  ~/workdir/project-a/pakro.toml  1"
assert_contains "pakro ls dummy --all-sources" "~/workdir/project-b/pakro.toml  1"

assert "pakro ls dummy --all-sources --json | jq -r '.[0].sources | length'" "2"
assert_contains "pakro ls dummy --all-sources --json" "project-a/pakro.toml"
assert_contains "pakro ls dummy --all-sources --json" "project-b/pakro.toml"
