#!/usr/bin/env bash
# This uses only local metadata; a package query must never install a plugin.
export PAKRO_OFFLINE=0 PAKRO_AUTO_UPDATE=0 PAKRO_CACHE_PRUNE_AGE=0
export NO_PROXY=127.0.0.1,localhost,::1
export no_proxy="$NO_PROXY"
requests="$TMPDIR/remote-package-requests"
mkdir -p "$requests"
start_http_server --headers-log "$requests" --handler - <<'PY'
import json

class Handler(TestHandler):
    def do_GET(self):
        self.log_headers()
        if self.path == "/simple/remote-package/":
            body = json.dumps({"meta": {"api-version": "1.1"},
                "name": "remote-package", "versions": ["1.10", "1.9", "2.0"],
                "files": []}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/vnd.pypi.simple.v1+json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        else:
            self.send_error(404)
PY
export PAKRO_URL_REPLACEMENTS="{\"https://pypi.org\":\"http://127.0.0.1:$HTTP_PORT\"}"
assert "pakro ls-remote --package remote-package --source pypi" $'1.9\n1.10\n2.0'
assert "pakro ls-remote --package remote-package --source pypi --json" '[{"version":"1.9"},{"version":"1.10"},{"version":"2.0"}]'
assert_fail_contains "pakro ls-remote --package remote-package" '--package requires --source'
assert_fail_contains "pakro ls-remote --package remote-package --source pypi --channel conda-forge" '--channel is only supported for Conda'
assert_fail_contains "pakro ls-remote --package remote-package --source unknown" '--source must be pypi or conda'
assert_fail_contains "pakro ls-remote --package remote-package --source conda --channel not-configured" 'not in the configured channel list'
python3 -B - "$requests" <<'PY'
import json
import pathlib
import sys
records = [json.loads(path.read_text()) for path in pathlib.Path(sys.argv[1]).glob('request_*.json')]
assert len(records) == 2, records
assert all(record['path'] == '/simple/remote-package/' and record['method'] == 'GET' for record in records), records
PY
[[ ! -e "$PAKRO_DATA_DIR/plugins/remote-package" ]] || fail 'package query installed a plugin'
[[ ! -e "$PAKRO_DATA_DIR/projects" ]] || fail 'package query created project data'
