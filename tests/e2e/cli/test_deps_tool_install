#!/usr/bin/env bash

# Test that tools from [tools] are installed BEFORE prepare steps run
# Regression test: prepare steps that depend on pakro-managed tools
# should not fail because the tool hasn't been installed yet.

cat <<'EOF' >pakro.toml
[tools]
tiny = "1"

[deps.needs_tool]
auto = true
sources = ["input.txt"]
outputs = ["output.txt"]
run = "rtx-tiny > output.txt"
EOF

touch input.txt

# Remove tiny if installed so we test the install-before-prepare path
rm -rf "${PAKRO_DATA_DIR}/installs/tiny/1"* 2>/dev/null || true

# Dry-run previews both the missing tool and provider without installing either.
output="$(pakro deps --only needs_tool --dry-run 2>&1)"
echo "$output"
assert_contains_text "$output" "tiny@1"
assert_contains_text "$output" "Would install: needs_tool"
assert_fail "compgen -G '$PAKRO_DATA_DIR/installs/tiny/1*'"
assert_fail "test -f output.txt"

# pakro deps should install tiny THEN run the prepare step (which uses tiny)
assert_contains "pakro deps --only needs_tool 2>&1" "Installed: needs_tool"
assert_contains "cat output.txt" "rtx-tiny"

# Clean up
rm -f pakro.toml input.txt output.txt
