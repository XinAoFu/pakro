#!/usr/bin/env bash

# Test: pakro lock with @version should lock specific version
export PAKRO_LOCKFILE=1

cat <<'EOF' >pakro.toml
[tools]
tiny = "latest"
EOF
pakro uninstall tiny --all 2>/dev/null || true
pakro install tiny@3.0.0
touch pakro.lock
pakro lock tiny --platform linux-x64
assert_contains "cat pakro.lock" "3.0.0"
# Now lock a different specific version
pakro lock tiny@3.0.1 --platform linux-x64
assert_contains "cat pakro.lock" "3.0.1"
assert_not_contains "cat pakro.lock" "3.0.0"
# pakro.toml should still say "latest"
assert_contains "cat pakro.toml" '"latest"'
rm -f pakro.toml pakro.lock

# Test: lock with version that doesn't match prefix should update config
cat <<'EOF' >pakro.toml
[tools]
tiny = "2"
EOF
pakro uninstall tiny --all 2>/dev/null || true
pakro install tiny@2.0.0
touch pakro.lock
pakro lock tiny --platform linux-x64
assert_contains "cat pakro.lock" "2.0.0"
pakro lock tiny@3.0.1 --platform linux-x64
# Config should be updated to match new prefix
assert_contains "cat pakro.toml" '"3"'
# Lockfile should have 3.0.1
assert_contains "cat pakro.lock" "3.0.1"
assert_not_contains "cat pakro.lock" "2.0.0"
rm -f pakro.toml pakro.lock
unset PAKRO_LOCKFILE
