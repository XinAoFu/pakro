#!/usr/bin/env bash
# Native tracking and source-managed files work without experimental opt-in.
export PAKRO_EXPERIMENTAL=0
mkdir -p "$PAKRO_CONFIG_DIR/dotfiles"
echo original >"$HOME/.native"
echo copied >"$PAKRO_CONFIG_DIR/dotfiles/source"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[dotfiles]
"~/.copied" = { mode = "copy", source = "dotfiles/source" }
EOF
assert_succeed "pakro bootstrap dotfiles track ~/.native --no-autosave"
assert_succeed "pakro bootstrap dotfiles save"
assert_succeed "pakro bootstrap dotfiles history"
assert_succeed "pakro bootstrap dotfiles paths"
assert_succeed "pakro bootstrap dotfiles apply --yes"
assert "cat ~/.copied" copied
assert "cat ~/.native" original
assert_succeed "pakro bootstrap dotfiles status"

# Disabled history does not open an unavailable store merely to report status.
touch "$PWD/not-a-state-directory"
assert_contains "PAKRO_STATE_DIR=$PWD/not-a-state-directory PAKRO_HISTORY_ENABLED=0 pakro bootstrap dotfiles status" "History: disabled"
