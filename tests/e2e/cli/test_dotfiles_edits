#!/usr/bin/env bash
# the single-quoted activate lines are intentionally literal
# shellcheck disable=SC2016

cat <<'EOF' >pakro.toml
[dotfiles]
"~/.zshrc/activate" = { block = 'eval "$(pakro activate zsh)"' }
"~/.zshrc/aliases" = { block = '''
alias ll='ls -l'
alias la='ls -la'
''' }
"~/hosts/dev" = { line = "127.0.0.1 dev.local" }
"~/prepend.conf/first" = { line = "managed first", position = "prepend" }
"~/bom-existing.conf/existing" = { line = "already there", position = "prepend" }
"~/bom-only.conf/append" = { line = "appended" }
"~/init.lua/pakro" = { block = "require('pakro')" }
"~/rendered.conf/sum" = { block = "sum = {{ 1 + 1 }}", template = "tera" }
"~/execd.conf/execd" = { block = '{{ exec(command="touch $HOME/exec-ran") }}ok', template = "tera" }
EOF

# everything is missing before applying
assert_contains "pakro dotfiles status" "missing"
assert_contains "pakro dotfiles status" "block:activate"
assert_contains "pakro dotfiles status" "line:dev"
assert_fail "pakro dotfiles status --missing"

# dry-run prints actions without writing anything; template blocks are not
# rendered (exec() must not run) and are listed as "(if changed)".
# status, by contrast, renders templates by design — clear its exec traces
rm -f ~/exec-ran
dry_out="$(pakro dotfiles apply --dry-run 2>&1)"
assert_contains_text "$dry_out" "block:activate"
assert_contains_text "$dry_out" "(if changed)"
assert_fail "cat ~/.zshrc"
assert_fail "cat ~/exec-ran"

# line edits append to existing files without touching other content
echo "preexisting content" >~/hosts
printf 'untouched first\r\nuntouched last\r\n' >~/prepend.conf
printf '\357\273\277already there\n' >~/bom-existing.conf
printf '\357\273\277' >~/bom-only.conf

assert_succeed "pakro dotfiles apply --yes"

# two blocks coexist in one file, delimited by id'd markers; multiline
# block content lands verbatim
assert_contains "cat ~/.zshrc" ">>> pakro:activate >>>"
assert_contains "cat ~/.zshrc" 'eval "$(pakro activate zsh)"'
assert_contains "cat ~/.zshrc" ">>> pakro:aliases >>>"
assert_contains "cat ~/.zshrc" "alias ll='ls -l'"
assert_contains "cat ~/.zshrc" "alias la='ls -la'"
# line was appended, existing content kept
assert "head -1 ~/hosts" "preexisting content"
assert_contains "cat ~/hosts" "127.0.0.1 dev.local"
# prepending preserves every existing byte, including CRLF line endings
printf 'managed first\r\nuntouched first\r\nuntouched last\r\n' >expected-prepend.conf
assert_succeed "cmp expected-prepend.conf ~/prepend.conf"
# a BOM is not part of the first logical line and remains at byte zero
printf '\357\273\277appended\n' >expected-bom.conf
assert_succeed "cmp expected-bom.conf ~/bom-only.conf"
assert "grep -c 'already there' ~/bom-existing.conf" "1"
# comment prefix inferred from extension
assert_contains "cat ~/init.lua" "-- >>> pakro:pakro >>>"
# template rendered
assert_contains "cat ~/rendered.conf" "sum = 2"
# a real install does render templates — exec() ran this time
assert_contains "cat ~/execd.conf" "ok"
assert_succeed "test -f ~/exec-ran"
assert_contains "pakro dotfiles status ~/hosts/dev" "line:dev"
echo "preexisting content" >~/hosts
assert_succeed "pakro dotfiles apply ~/hosts/dev --yes"
assert_contains "cat ~/hosts" "127.0.0.1 dev.local"
assert "grep -c 'pakro:activate >>>' ~/.zshrc" "1"
assert_fail "pakro dotfiles add ~/.zshrc --yes" "already managed by [dotfiles] edits"
assert_fail "EDITOR=true pakro dotfiles edit ~/.zshrc" "multiple [dotfiles] edit entries match"

# idempotent: re-running changes nothing
assert_succeed "pakro dotfiles status --missing"
assert_contains "pakro dotfiles apply --yes 2>&1" "all edits are applied"
assert_contains "pakro bootstrap dotfiles diff ~/rendered.conf/sum 2>&1" "all edits are applied"
assert_not_contains "pakro bootstrap dotfiles diff ~/rendered.conf/sum 2>&1" "(if changed)"
assert "grep -c 'dev.local' ~/hosts" "1"
assert "grep -c 'managed first' ~/prepend.conf" "1"
assert "grep -c 'pakro:activate >>>' ~/.zshrc" "1"

# content changes are detected and replace only the block, preserving
# everything around it
echo "# user content at the end" >>~/.zshrc
cat <<'EOF' >pakro.toml
[dotfiles]
"~/.zshrc/activate" = { block = 'eval "$(pakro activate zsh --shims)"' }
"~/.zshrc/aliases" = { block = "alias ll='ls -l'" }
EOF
assert_contains "pakro dotfiles status" "differs (block content differs)"
diff_out="$(pakro bootstrap dotfiles diff ~/.zshrc/activate 2>&1)"
assert_contains_text "$diff_out" "edit differs: ~/.zshrc (block:activate)"
assert_contains_text "$diff_out" '+eval "$(pakro activate zsh --shims)"'
assert_not_contains "cat ~/.zshrc" "--shims"
assert_succeed "pakro dotfiles apply --yes"
assert_contains "cat ~/.zshrc" "--shims"
assert_not_contains "cat ~/.zshrc" 'eval "$(pakro activate zsh)"'
assert_contains "cat ~/.zshrc" "alias ll='ls -l'"
assert_contains "cat ~/.zshrc" "# user content at the end"

# content that merely mentions a marker is not treated as one
cat <<'EOF' >pakro.toml
[dotfiles]
"~/.zshrc/activate" = { block = 'echo "keep the >>> pakro:activate >>> line intact"' }
"~/.zshrc/aliases" = { block = "alias ll='ls -l'" }
EOF
assert_succeed "pakro dotfiles apply --yes"
assert_succeed "pakro dotfiles status --missing"
cat <<'EOF' >pakro.toml
[dotfiles]
"~/.zshrc/activate" = { block = 'eval "$(pakro activate zsh --shims)"' }
"~/.zshrc/aliases" = { block = "alias ll='ls -l'" }
EOF
assert_succeed "pakro dotfiles apply --yes"

# corrupted markers are an error, not a guess
sed -i.bak '/<<< pakro:activate <<</d' ~/.zshrc
cat <<'EOF' >>pakro.toml
"~/other.conf/new" = { line = "new line" }
EOF
assert_contains "pakro dotfiles status" "differs (begin marker without end marker)"
if diff_out="$(pakro bootstrap dotfiles diff 2>&1)"; then
  fail "[pakro bootstrap dotfiles diff] expected failure"
fi
assert_contains_text "$diff_out" "edit differs: ~/other.conf (line:new)"
assert_contains_text "$diff_out" "begin marker without end marker"
assert_fail "pakro dotfiles apply --yes"
rm ~/.zshrc ~/.zshrc.bak

# symlink targets are refused — edits would write through the link
echo "real file" >real.conf
ln -s "$PWD/real.conf" ~/linked.conf
cat <<'EOF' >pakro.toml
[dotfiles]
"~/linked.conf/added" = { line = "added" }
EOF
assert_contains "pakro dotfiles status" "differs (target is a symlink"
assert_fail "pakro dotfiles apply --yes"
assert "cat real.conf" "real file"

# block content can come from a source file
echo "source content" >snippet.txt
cat <<'EOF' >pakro.toml
[dotfiles]
"~/fromfile.conf/snippet" = { source = "snippet.txt", template = "tera" }
EOF
assert_succeed "pakro dotfiles apply --yes"
assert_contains "cat ~/fromfile.conf" "source content"
# missing sources are visible and error on install
rm snippet.txt
assert_contains "pakro dotfiles status" "source missing"
assert_fail "pakro dotfiles apply --yes"

# two entries with different ids but identical line text don't write the
# line twice in one batch
cat <<'EOF' >pakro.toml
[dotfiles]
"~/dup.conf/a" = { line = "same line" }
"~/dup.conf/b" = { line = "same line" }
EOF
assert_succeed "pakro dotfiles apply --yes"
assert "grep -c 'same line' ~/dup.conf" "1"
assert_succeed "pakro dotfiles status --missing"

# all problems are reported in one pass: a broken template doesn't hide a
# missing source
cat <<'EOF' >pakro.toml
[dotfiles]
"~/broken.conf/tmpl" = { block = "{{ not_a_real_function() }}", template = "tera" }
"~/missing.conf/snippet" = { source = "no-such-snippet.txt", template = "tera" }
EOF
if install_out="$(pakro dotfiles apply --yes 2>&1)"; then
  fail "[pakro dotfiles apply --yes] expected failure"
fi
assert_contains_text "$install_out" "failed to render"
assert_contains_text "$install_out" "source does not exist"

# invalid entries warn but don't fail (forward compatibility)
cat <<'EOF' >pakro.toml
[dotfiles]
"~/x.conf/noop" = { something_else = true }
EOF
assert_succeed "pakro dotfiles status"
assert_contains "pakro dotfiles status 2>&1" "no recognized operation"

cat <<'EOF' >pakro.toml
[dotfiles]
"~/x.conf/both" = { block = "a", line = "b" }
EOF
assert_succeed "pakro dotfiles status"
assert_contains "pakro dotfiles status 2>&1" "mutually exclusive"

# ids are restricted to marker-safe characters
cat <<'EOF' >pakro.toml
[dotfiles]
"~/x.conf/bad id!" = { block = "content" }
EOF
assert_succeed "pakro dotfiles status"
assert_contains "pakro dotfiles status 2>&1" "ids may only contain"

# unknown template engines warn but don't fail (forward compatibility)
cat <<'EOF' >pakro.toml
[dotfiles]
"~/x.conf/tmpl" = { block = "a", template = "jinja" }
EOF
assert_succeed "pakro dotfiles status"
assert_contains "pakro dotfiles status 2>&1" "unknown template engine"

# a multi-line line value can never converge — rejected, use a block instead
cat <<'EOF' >pakro.toml
[dotfiles]
"~/x.conf/multi" = { line = "first\nsecond" }
EOF
assert_succeed "pakro dotfiles status"
assert_contains "pakro dotfiles status 2>&1" "line may not contain a newline"

cat <<'EOF' >pakro.toml
[dotfiles]
"~/x.conf/position" = { line = "x", position = "middle" }
EOF
assert_succeed "pakro dotfiles status"
assert_contains "pakro dotfiles status 2>&1" "unknown line position"

cat <<'EOF' >pakro.toml
[dotfiles]
"~/x.conf/position" = { block = "x", position = "prepend" }
EOF
assert_succeed "pakro dotfiles status"
assert_contains "pakro dotfiles status 2>&1" "position is only valid with line"

cat <<'EOF' >pakro.toml
[dotfiles]
"~/x.conf" = true
EOF
assert_succeed "pakro dotfiles status"
assert_contains "pakro dotfiles status 2>&1" "expected string or table entry"

cat <<'EOF' >pakro.toml
[dotfiles]
"~/x.conf/id" = { line = "x" }
EOF
assert_fail "pakro dotfiles apply ~/missing/id --yes" "no dotfiles matched target filter"
