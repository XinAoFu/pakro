#!/usr/bin/env bash

export PAKRO_GITHUB_TOKEN=credential-test-token
export GIT_TERMINAL_PROMPT=0
export GIT_CONFIG_NOSYSTEM=1
export GIT_CONFIG_GLOBAL=/dev/null

assert_contains "printf 'protocol=https\nhost=github.com\n\n' | git -c credential.helper= -c 'credential.https://github.com.helper=!pakro token github --git-credential' credential fill" "password=credential-test-token"
assert_contains "printf 'protocol=https\nhost=github.com\n\n' | pakro token github --git-credential get" "username=x-access-token"
assert_contains "printf 'protocol=https\nhost=github.com:443\n\n' | git -c credential.helper= -c 'credential.https://github.com:443.helper=!pakro token github --git-credential' credential fill" "password=credential-test-token"

# Unrelated malformed project files must not prevent authentication.
printf '[invalid' >.pakrorc.toml
printf '[invalid' >pakro.toml
assert_contains "printf 'protocol=https\nhost=github.com\n\n' | pakro token github --git-credential get" "password=credential-test-token"
printf '' >.pakrorc.toml
printf '' >pakro.toml
for host in github.com.evil.example example.com github.com:8443; do
  assert_not_contains "printf 'protocol=https\nhost=$host\n\n' | pakro token github --git-credential get" "credential-test-token"
done
assert_not_contains "printf 'protocol=http\nhost=github.com\n\n' | pakro token github --git-credential get" "credential-test-token"
assert_not_contains "printf 'protocol=https\nhost=github.com\n\n' | pakro token github --git-credential store" "credential-test-token"
assert_not_contains "printf 'protocol=https\nhost=github.com\n\n' | pakro token github --git-credential erase" "credential-test-token"

# Broken operator-owned pakrorc files must not block an environment token.
export PAKRO_SYSTEM_CONFIG_DIR="$HOME/system-pakro"
mkdir -p "$PAKRO_CONFIG_DIR" "$PAKRO_SYSTEM_CONFIG_DIR"
printf '[invalid' >"$PAKRO_CONFIG_DIR/pakrorc.toml"
printf '[invalid' >"$PAKRO_SYSTEM_CONFIG_DIR/pakrorc.toml"
assert_contains "printf 'protocol=https\nhost=github.com\n\n' | pakro token github --git-credential get" "password=credential-test-token"
printf '' >"$PAKRO_CONFIG_DIR/pakrorc.toml"
printf '' >"$PAKRO_SYSTEM_CONFIG_DIR/pakrorc.toml"

# The helper must not invoke Git's helpers again when no pakro token exists.
unset PAKRO_GITHUB_TOKEN GITHUB_TOKEN GITHUB_API_TOKEN
assert_not_contains "printf 'protocol=https\nhost=github.com\n\n' | pakro token github --git-credential get" "password="

export PAKRO_GITHUB_USE_GIT_CREDENTIALS=1
export GIT_CONFIG_GLOBAL="$PWD/gitconfig"
git config --file "$GIT_CONFIG_GLOBAL" credential.helper '!echo password=recursive-helper-token'
assert_not_contains "printf 'protocol=https\nhost=github.com\n\n' | pakro token github --git-credential get" "recursive-helper-token"

# A credential command that calls Git must not reenter the helper either.
export PAKRO_GITHUB_CREDENTIAL_COMMAND='echo invoked > credential-command-invoked; git credential fill'
assert_not_contains "printf 'protocol=https\nhost=github.com\n\n' | pakro token github --git-credential get" "password="
assert "test ! -e credential-command-invoked"

# OAuth configured in operator-owned files must also work from a broken project.
unset PAKRO_GITHUB_CREDENTIAL_COMMAND
start_http_server --handler "$ROOT/tests/e2e/fixtures/mock-github-oauth.py"
MOCK_PORT=$HTTP_PORT
mkdir -p "$PAKRO_CONFIG_DIR"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<EOF
[settings.github]
oauth_client_id = "Iv1.mock"
oauth_auth_url = "http://127.0.0.1:$MOCK_PORT/login"
oauth_open_browser = false
EOF
assert_contains "pakro token github --oauth --raw" "ghu-native-oauth-token"
printf '[invalid' >.pakrorc.toml
printf '[invalid' >pakro.toml
assert_contains "printf 'protocol=https\nhost=github.com\n\n' | pakro token github --git-credential get" "password=ghu-native-oauth-token"

# Operator-owned pakrorc may select an environment-specific global auth config.
mv "$PAKRO_CONFIG_DIR/config.toml" "$PAKRO_CONFIG_DIR/config.work.toml"
printf 'env = ["work"]\n' >"$PAKRO_CONFIG_DIR/pakrorc.toml"
assert_contains "printf 'protocol=https\nhost=github.com\n\n' | pakro token github --git-credential get" "password=ghu-native-oauth-token"

# Ignore a broken system layer while preserving valid global environment selection.
printf '[invalid' >"$PAKRO_SYSTEM_CONFIG_DIR/pakrorc.toml"
assert_contains "printf 'protocol=https\nhost=github.com\n\n' | pakro token github --git-credential get" "password=ghu-native-oauth-token"
# Also preserve valid system selection when the higher-priority global file is broken.
printf 'env = ["work"]\n' >"$PAKRO_SYSTEM_CONFIG_DIR/pakrorc.toml"
printf '[invalid' >"$PAKRO_CONFIG_DIR/pakrorc.toml"
assert_contains "printf 'protocol=https\nhost=github.com\n\n' | pakro token github --git-credential get" "password=ghu-native-oauth-token"
