#!/usr/bin/env bash

pakro use dummy@latest

eval "$(pakro activate bash)" && _pakro_hook
assert "PATH="" $(which pakro) doctor --json"

# Test PATH ordering warning when non-pakro paths precede pakro tool paths
assert_not_contains "pakro doctor" "pakro tool paths are not first in PATH"
export PATH="/tmp/fake-system-bin:$PATH"
assert_contains "pakro doctor" "pakro tool paths are not first in PATH"
assert_contains "pakro doctor" "/tmp/fake-system-bin"
# Restore PATH for remaining tests
export PATH="${PATH#/tmp/fake-system-bin:}"

pakro p add uv
pakro use uv
assert_contains "pakro doctor" "asdf:uv@"
assert_contains "pakro doctor" "self_update_available"
assert_contains "pakro doctor -J" "dummy"
assert_contains "pakro doctor -J" "self_update_available"
assert_contains "pakro doctor -J" "aqua"
assert_contains "pakro doctor" "aqua"

# env_files section is present in both text and JSON output
assert_contains "pakro doctor" "env_files"
assert_contains "pakro doctor -J" "env_files"

# when no env files are configured, text output shows (none)
assert_contains "pakro doctor" "(none)"

# when an env file is configured, it appears in doctor output
echo "DOCTOR_VAR=1" >.doctor-test-env
assert_contains "PAKRO_ENV_FILE=.doctor-test-env pakro doctor" ".doctor-test-env"
assert_contains "PAKRO_ENV_FILE=.doctor-test-env pakro doctor -J" ".doctor-test-env"

# Both outputs render the same warnings, so a check that only one path runs is a hole in the other.
# Seed the release index with an old publication date so it satisfies the default 24h age.
# This makes the check deterministic: no network, and no waiting for a release.
# Asked of pakro rather than assembled here, so the file is written wherever the version check
# will look for it.
# Kept last — the seeded version adds a warning to every doctor run after this point.
cache_dir="$(pakro cache path)"
mkdir -p "$cache_dir"
printf "2099.1.0\t946684800\n" >"$cache_dir/latest-version.releases-v1"
assert_contains "pakro doctor" "new pakro version 2099.1.0 available"
# Structure rather than substring on the JSON side: what this PR is about is the warning reaching
# `warnings`, not the text appearing somewhere in the document. `pipefail` because the helper runs
# this through its own `bash -c`, where the pipeline's status is jq's alone — a `pakro doctor` that
# printed the right JSON and then exited non-zero would pass unnoticed.
assert_succeed "set -o pipefail; pakro doctor -J | jq -e '.warnings | map(contains(\"new pakro version 2099.1.0 available\")) | any'"
