#!/usr/bin/env bash

assert "pakro set FOO=bar" ""
assert "pakro set FOO" "bar"
assert "pakro set" "FOO  bar ~/workdir/pakro.toml"
assert "pakro set --rm FOO" ""
assert_fail "pakro set FOO" "Environment variable FOO not found"

assert "pakro set --file .test.pakro.toml FOO=bar" ""
assert "pakro set --file .test.pakro.toml FOO" "bar"

# Test -E flag for environment-specific config files
assert "pakro set -E staging STAGING_VAR=staging_value" ""
assert "pakro set -E staging STAGING_VAR" "staging_value"
assert "pakro set -E staging" "STAGING_VAR  staging_value ~/workdir/pakro.staging.toml"

# Test that -E flag only shows vars from that environment file
assert "pakro set -E production PROD_VAR=prod_value" ""
assert "pakro set -E production" "PROD_VAR  prod_value ~/workdir/pakro.production.toml"
# STAGING_VAR should not appear when reading production env
assert_not_contains "pakro set -E production" "STAGING_VAR"

# Test that regular set doesn't show env-specific vars
assert_not_contains "pakro set" "STAGING_VAR"
assert_not_contains "pakro set" "PROD_VAR"

# Test that pakro set writes to pakro.toml (lowest precedence) instead of pakro.local.toml
# when both exist. See: https://github.com/jdx/mise/discussions/6475
rm -f pakro.toml pakro.local.toml
echo '[env]' >pakro.toml
echo 'BASE_VAR = "base"' >>pakro.toml
echo '[env]' >pakro.local.toml
echo 'LOCAL_VAR = "local"' >>pakro.local.toml
assert "pakro set NEW_VAR=new_value" ""
assert_contains "cat pakro.toml" "NEW_VAR"
assert_not_contains "cat pakro.local.toml" "NEW_VAR"

# Test that pakro set writes to the nearest config directory, not the lowest
# precedence TOML file across the entire hierarchy.
rm -rf parent
mkdir -p parent/myproject/inner
touch parent/pakro.toml parent/myproject/pakro.toml
assert "cd parent/myproject/inner && pakro set SOMETHING=from_inner" ""
assert_contains "cat parent/myproject/pakro.toml" "SOMETHING"
assert_not_contains "cat parent/pakro.toml" "SOMETHING"

# Test that ignored config directories are not selected as write targets.
ignored_child="$(pwd)/parent/myproject"
assert "cd parent/myproject/inner && PAKRO_IGNORED_CONFIG_PATHS=$ignored_child pakro set IGNORED_CHILD=skipped" ""
assert_contains "cat parent/pakro.toml" "IGNORED_CHILD"
assert_not_contains "cat parent/myproject/pakro.toml" "IGNORED_CHILD"
rm -rf parent

# Test --stdin reads multiline value
assert "printf 'line1\nline2' | pakro set --stdin MULTI_LINE" ""
assert "pakro set MULTI_LINE" "line1
line2"
assert "pakro set --rm MULTI_LINE" ""

# Test --stdin strips trailing newline
assert "printf 'hello\n' | pakro set --stdin TRAILING_NL" ""
assert "pakro set TRAILING_NL" "hello"
assert "pakro set --rm TRAILING_NL" ""

# Test --stdin fails with multiple keys
assert_fail "printf 'val' | pakro set --stdin KEY1 KEY2"

# Test --stdin fails with KEY=VALUE syntax
assert_fail "printf 'val' | pakro set --stdin KEY1=value"

# Test that `pakro set` redacts values marked with redact=true
rm -f pakro.toml
cat <<EOF >pakro.toml
[env]
SECRET = {value = "my_secret_value", redact = true}
NORMAL = "normal_value"
EOF
assert_contains "pakro set" "[redacted]"
assert_not_contains "pakro set" "my_secret_value"
assert_contains "pakro set" "normal_value"

# Test --no-redact shows raw values
assert_contains "pakro set --no-redact" "my_secret_value"
assert_not_contains "pakro set --no-redact" "[redacted]"

# Test redactions array with pakro set
rm -f pakro.toml
cat <<EOF >pakro.toml
redactions = ["DB_*"]
[env]
DB_PASSWORD = "super_secret"
USERNAME = "john"
EOF
assert_contains "pakro set" "[redacted]"
assert_not_contains "pakro set" "super_secret"
assert_contains "pakro set" "john"
assert_contains "pakro set --no-redact" "super_secret"

# Test that redact=false overrides inherited redaction patterns
rm -f pakro.toml
cat <<EOF >global.pakro.toml
redactions = ["*TOKEN*"]
[env]
SECRET_TOKEN = "secret value"
EOF
cat <<EOF >pakro.toml
[env]
TEST_TOKEN = { value = "e", redact = false }
EOF
assert_contains "PAKRO_GLOBAL_CONFIG_FILE=$PWD/global.pakro.toml pakro set" "SECRET_TOKEN  [redacted]"
assert_contains "PAKRO_GLOBAL_CONFIG_FILE=$PWD/global.pakro.toml pakro set" "TEST_TOKEN    e"
assert_not_contains "PAKRO_GLOBAL_CONFIG_FILE=$PWD/global.pakro.toml pakro set" "s[redacted]cr[redacted]t"

# Test redaction with --file flag
rm -f pakro.toml
cat <<EOF >pakro.toml
[env]
FILE_SECRET = {value = "file_secret_val", redact = true}
EOF
assert_contains "pakro set --file pakro.toml" "[redacted]"
assert_not_contains "pakro set --file pakro.toml" "file_secret_val"
assert_contains "pakro set --file pakro.toml --no-redact" "file_secret_val"

# Test redaction with --file pointing outside config hierarchy
tmpfile="$(mktemp)"
cat <<EOF >"$tmpfile"
[env]
OUT_SECRET = {value = "out_of_hierarchy_secret", redact = true}
OUT_NORMAL = "out_normal"
EOF
assert_contains "pakro set --file $tmpfile" "[redacted]"
assert_not_contains "pakro set --file $tmpfile" "out_of_hierarchy_secret"
assert_contains "pakro set --file $tmpfile" "out_normal"
assert_contains "pakro set --file $tmpfile --no-redact" "out_of_hierarchy_secret"
rm -f "$tmpfile"

# comments around an env var survive the value being replaced
# See: https://github.com/jdx/mise/discussions/4797
rm -f pakro.toml pakro.local.toml
printf '[env]\n# keep this comment\nFOO = "bar" # keep me\n' >pakro.toml
assert "pakro set FOO=baz" ""
assert "cat pakro.toml" '[env]
# keep this comment
FOO = "baz" # keep me'
