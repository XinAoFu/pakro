#!/usr/bin/env bash
# Test that `pakro install` warns when installing tools not in any config file

set -euo pipefail
export RUST_BACKTRACE=0
export PAKRO_FRIENDLY_ERROR=1

# Test: Installing a tool not in config should show a "pakro use" hint
assert_contains "pakro install tiny@3.1.0 2>&1" "not activated"
assert_contains "pakro install tiny@3.1.0 2>&1" "pakro use tiny"

# Test: Installing a tool that IS in config should NOT show the hint
pakro use dummy@1.0.0
assert_not_contains "pakro install dummy 2>&1" "not activated"

# Test: Installing TOOL@VERSION for a tool that IS in config should NOT show
# the hint (regression test for #9501 — CLI args were overriding the config
# source in the merged tool request set, falsely flagging configured tools as
# inactive).
assert_not_contains "pakro install dummy@1.0.0 2>&1" "not activated"
assert_not_contains "pakro install dummy@latest 2>&1" "not activated"

# Clean up
pakro use --rm dummy

# Test: Installing a tool that's only configured via PAKRO_<TOOL>_VERSION env
# var should NOT show the hint (regression test for #9522 review feedback —
# the config-files-only check was missing env-var-configured tools).
INSTALL_ENV_LOG="$TMPDIR/pakro-install-env.log"
PAKRO_DUMMY_VERSION=1.0.0 pakro install dummy 2>&1 | tee "$INSTALL_ENV_LOG"
assert_not_contains "cat '$INSTALL_ENV_LOG'" "not activated"
PAKRO_DUMMY_VERSION=1.0.0 pakro install dummy@1.0.0 2>&1 | tee "$INSTALL_ENV_LOG"
assert_not_contains "cat '$INSTALL_ENV_LOG'" "not activated"
# (Backend-alias coverage for env-var-configured tools — e.g. that
# PAKRO_NODEJS_VERSION matches `node` — lives in the tool_env_vars unit test
# in src/toolset/tool_request_set.rs; we don't repeat it here because
# installing node in e2e is expensive and `--dry-run` returns before the
# inactive-tool warning would fire.)

# Test: a tool whose install FAILS must NOT be reported as "installed but not
# activated". The failure is surfaced on its own; also claiming it installed
# is misleading (discussion #11224). `dummy@other-dummy` fails on purpose.
INSTALL_FAIL_LOG="$TMPDIR/pakro-install-fail.log"
pakro install dummy@other-dummy >"$INSTALL_FAIL_LOG" 2>&1 || true
assert_contains "cat '$INSTALL_FAIL_LOG'" "on purpose"
assert_not_contains_text "$(cat "$INSTALL_FAIL_LOG")" "not activated"
