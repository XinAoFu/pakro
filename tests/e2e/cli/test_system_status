#!/usr/bin/env bash

cat <<EOF >pakro.toml
[bootstrap.packages]
"apt:bc" = "latest"
"apk:bc" = { state = "absent" }
"brew:jq" = "latest"
"dnf:bc" = "latest"
"mas:497799835" = "latest"
"pacman:bc" = "latest"
"zypper:bc" = "latest"
EOF

# status renders on any platform; unavailable managers are skipped, not errors
assert_succeed "pakro bootstrap packages status"
assert_succeed "PAKRO_EXPERIMENTAL=0 pakro bootstrap packages status"
assert_contains "pakro bootstrap packages status" "bc"
assert_contains "pakro bootstrap packages status" "497799835"
assert_contains "pakro bootstrap packages status --json" '"apt"'
assert_contains "pakro bootstrap packages status --json" '"apk"'
assert \
  "pakro bootstrap packages status --json | jq -r '.apk.packages[] | select(.package == \"bc\") | [.package, .desired_state] | @tsv'" \
  $'bc\tabsent'
assert_contains "pakro bootstrap packages status --json" '"mas"'
assert_contains "pakro bootstrap packages status --json" '"zypper"'
if ! command -v zypper >/dev/null || ! command -v rpm >/dev/null; then
  assert_fail_contains "pakro bootstrap packages apply --manager zypper --dry-run --yes" "zypper is not available"
fi
if ! command -v apk >/dev/null; then
  assert \
    "pakro bootstrap packages status --json | jq -r '.apk.packages[] | select(.package == \"bc\") | .state'" \
    "skipped"
  assert_fail_contains "pakro bootstrap packages apply --manager apk --dry-run --yes" "apk is not available"
fi
if [[ "$(uname)" == "Darwin" ]] && command -v mas >/dev/null; then
  assert_succeed "pakro bootstrap packages apply --manager mas --dry-run --yes"
else
  assert_fail "pakro bootstrap packages apply --manager mas --dry-run --yes"
fi

# A configured pakro tool does not need to be activated in the parent shell.
if [[ "$(uname)" == "Darwin" ]]; then
  mkdir -p mas-tool/bin
  cat <<'EOF' >mas-tool/bin/mas
#!/bin/sh
printf '[]\n'
EOF
  chmod +x mas-tool/bin/mas
  cat <<EOF >pakro.toml
[tools]
mas = "path:./mas-tool"

[bootstrap.packages]
"mas:497799835" = "latest"
EOF
  assert_contains \
    "pakro bootstrap packages apply --manager mas --dry-run --yes" \
    "mas install 497799835"
fi

# unknown managers warn but don't fail
cat <<EOF >pakro.toml
[bootstrap.packages]
"not-a-real-manager:whatever" = "latest"
EOF
assert_succeed "pakro bootstrap packages status"
assert_contains "pakro bootstrap packages status 2>&1" "unknown bootstrap package manager"

# the manager prefix is required; entries without one warn but don't fail
cat <<EOF >pakro.toml
[bootstrap.packages]
"noprefix" = "latest"
EOF
assert_succeed "pakro bootstrap packages status"
assert_contains "pakro bootstrap packages status 2>&1" "invalid system package spec"

# package-level OS selectors are applied before manager resolution
case "$(uname)" in
  Darwin)
    active_os=macos
    inactive_os=linux
    ;;
  *)
    active_os=linux
    inactive_os=macos
    ;;
esac
cat <<EOF >pakro.toml
[bootstrap.packages]
"apt:active" = { os = "$active_os" }
"not-a-real-manager:inactive" = { version = "latest", os = ["$inactive_os"] }
EOF
assert_contains "pakro bootstrap packages status" "active"
assert_not_contains "pakro bootstrap packages status 2>&1" "unknown bootstrap package manager"

# empty [bootstrap.packages] section
cat <<EOF >pakro.toml
[bootstrap.packages]
EOF
assert_succeed "pakro bootstrap packages status"

# no [system] section at all
cat <<EOF >pakro.toml
[tools]
EOF
assert_succeed "pakro bootstrap packages status"
