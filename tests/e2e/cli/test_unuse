#!/usr/bin/env bash

assert "pakro install dummy@1.0.0"
assert "ls $PAKRO_DATA_DIR/installs/dummy" "1
1.0
1.0.0
latest"
assert "pakro rm dummy"
assert_empty "pakro ls"
assert_fail "ls $PAKRO_DATA_DIR/installs/dummy"

assert "pakro use dummy@1.0.0"
assert_contains "pakro ls dummy" "1.0.0"
# Unuse has already committed its configuration edit before optional pruning.
# If nobody can answer the prune prompt, finish unuse without removing the install.
assert "PAKRO_YES=0 pakro unuse dummy@1.0.0"
assert_empty "cat pakro.toml"
assert_contains "pakro ls dummy" "1.0.0"
assert "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"

assert "pakro use dummy@1.0.0"
mkdir subdir
cd subdir || exit 1
assert "pakro use -p pakro.toml dummy@1.0.0"
assert "pakro ls dummy" "dummy  1.0.0  ~/workdir/subdir/pakro.toml  1.0.0"
assert "pakro unuse dummy@1.0.0"
# version is not pruned because it's in ~/workdir/pakro.toml
assert "pakro ls dummy" "dummy  1.0.0  ~/workdir/pakro.toml  1.0.0"
assert "pakro unuse dummy@1.0.0"
assert_empty "pakro ls dummy"
cd - || exit 1

assert "pakro use -g dummy@1.0.0"
assert "pakro ls dummy" "dummy  1.0.0  ~/.config/pakro/config.toml  1.0.0"
assert "pakro use dummy@1.0.0"
assert "pakro ls dummy" "dummy  1.0.0  ~/workdir/pakro.toml  1.0.0"
assert "pakro unuse dummy@1.0.0"
assert "pakro ls dummy" "dummy  1.0.0  ~/.config/pakro/config.toml  1.0.0"
assert "pakro unuse -g dummy@1.0.0"
assert_empty "pakro ls dummy"

assert "pakro use -e test dummy@1.0.0"
assert "pakro ls -E test dummy" "dummy  1.0.0  ~/workdir/pakro.test.toml  1.0.0"
assert "pakro unuse -e test dummy@1.0.0"
assert_empty "pakro ls -E test dummy"
rm ~/workdir/pakro.test.toml

assert "pakro use dummy@2.0.0"
assert "pakro ls dummy" "dummy  2.0.0  ~/workdir/pakro.toml  2.0.0"
# tool is not removed because version does not match
assert "pakro unuse dummy@1.0.0"
assert "pakro ls dummy" "dummy  2.0.0  ~/workdir/pakro.toml  2.0.0"

# not specifying version means it will remove any version
assert "pakro use dummy@2"
assert "pakro ls dummy" "dummy  2.0.0  ~/workdir/pakro.toml  2"
assert "pakro unuse dummy"
assert_empty "pakro ls dummy"

# removing a specific version preserves the other configured versions
cat >pakro.toml <<'EOF'
[tools]
dummy = ["1.0.0", "2.0.0", "3.0.0"]
EOF
assert "pakro unuse --no-prune dummy@1.0.0 dummy@1.0.0 2>&1" \
  "pakro removed: dummy@1.0.0 from ~/workdir/pakro.toml"
assert_not_contains "cat pakro.toml" '"1.0.0"'
assert_contains "cat pakro.toml" '"2.0.0"'
assert_contains "cat pakro.toml" '"3.0.0"'

# multiple versions of the same tool are removed together without restoring an earlier one
assert_contains "pakro unuse --no-prune dummy@2.0.0 dummy@3.0.0 2>&1" \
  "removed: dummy@2.0.0, dummy@3.0.0"
assert_not_contains "cat pakro.toml" "dummy"

# options on an unselected structured entry are preserved
cat >pakro.toml <<'EOF'
[tools]
dummy = [
  { version = "1.0.0", install_env = { REMOVE = "yes" } },
  { version = "2.0.0", install_env = { KEEP = "yes" } },
]
EOF
assert "pakro unuse --no-prune dummy@1.0.0"
assert_not_contains "cat pakro.toml" "REMOVE"
assert_contains "cat pakro.toml" 'version = "2.0.0"'
assert_contains "cat pakro.toml" 'install_env = { KEEP = "yes" }'

# .tool-versions keeps the other versions, tools, and trailing comment
cat >.tool-versions <<'EOF'
dummy 1.0.0 2.0.0 # keep me
tiny 3.1.0
EOF
assert "pakro unuse --no-prune --path .tool-versions dummy@1.0.0"
assert "cat .tool-versions" "dummy 2.0.0 # keep me
tiny  3.1.0"

# --path <dir> removes from a config inside that directory and leaves the cwd's alone. This used
# to resolve from the cwd, so `unuse --path <elsewhere>` deleted the tool from the wrong file.
mkdir -p "$HOME/unusepath/from" "$HOME/unusepath/to"
printf '[tools]\ndummy = "1.0.0"\n' >"$HOME/unusepath/from/pakro.toml"
printf '[tools]\ndummy = "1.0.0"\n' >"$HOME/unusepath/to/pakro.toml"
cd "$HOME/unusepath/from" || exit 1

assert "pakro unuse --no-prune --path ../to dummy@1.0.0"
assert "cat pakro.toml" '[tools]
dummy = "1.0.0"'
# removing the only tool empties the file, as it does everywhere else
assert "cat ../to/pakro.toml" ""

cd "$HOME/workdir" || exit 1
