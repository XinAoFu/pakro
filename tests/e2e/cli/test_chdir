#!/usr/bin/env bash

mkdir -p ./test
cat <<EOF >./test/pakro.toml
[settings]
experimental = true

[tasks.hello]
run = 'echo "Hello, World!"'
EOF

assert_contains "pakro config --cd $PWD/test ls" "test/pakro.toml"

unset PAKRO_EXPERIMENTAL
assert "pakro -C $PWD/test settings get experimental" "true"

assert_contains "pakro run --cd $PWD/test hello" "Hello, World!"
assert_contains "pakro run --cd ./test hello" "Hello, World!"
assert_contains "pakro run --cd test hello" "Hello, World!"
