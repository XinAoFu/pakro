#!/usr/bin/env bash
# `pakro upgrade` keeps the version it upgraded away from in place for a grace
# period. This protects long-running processes that may keep loading files from
# the old install tree after the new version is selected.
#
# See: https://github.com/jdx/mise/discussions/5840

cat <<'EOF' >pakro.toml
[tools]
dummy = "1"
EOF

pakro uninstall dummy --all
pakro install dummy@1.0.0

# --dry-run announces deferred pruning, and --no-prune withdraws it while still
# reporting the install.
assert_contains "pakro up dummy -n" "Would schedule dummy@1.0.0 for pruning after 24h"
assert_not_contains "pakro up dummy -n --no-prune" "Would schedule"
assert_contains "pakro up dummy -n --no-prune" "Would install dummy@1.1.0"

pakro upgrade dummy --no-prune
assert_contains "pakro ls --installed dummy" "1.1.0"
assert_contains "pakro ls --installed dummy" "1.0.0"
assert_fail "test -f '$PAKRO_STATE_DIR/tool-purgatory.json'"
# the install directory itself has to survive — that is what an outside
# reference resolves through
assert "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"

# The default schedules the old version but leaves its path intact.
pakro uninstall dummy --all
pakro install dummy@1.0.0
pakro upgrade dummy >upgrade.log 2>&1
assert_not_contains "cat upgrade.log" "will be pruned after"
assert_contains "pakro ls --installed dummy" "1.1.0"
assert_contains "pakro ls --installed dummy" "1.0.0 (pruned in"
assert "pakro ls --installed dummy -J | jq -r '.[] | select(.version == \"1.0.0\") | .scheduled_for_pruning'" "true"
assert "pakro ls --installed dummy -J | jq -r '.[] | select(.version == \"1.0.0\") | .prune_after | test(\"^[0-9]{4}-\")'" "true"
assert "pakro ls --installed dummy -J | jq -r '.[] | select(.version == \"1.1.0\") | has(\"scheduled_for_pruning\")'" "false"
assert "test -f '$PAKRO_STATE_DIR/tool-purgatory.json'"

# Explicit prune ignores the grace period and clears the receipt.
PAKRO_YES=1 pakro prune
assert_fail "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"
assert_fail "test -f '$PAKRO_STATE_DIR/tool-purgatory.json'"

# --bump rewrites the config and still honors the flag
pakro uninstall dummy --all
pakro install dummy@1.0.0
pakro upgrade dummy --bump --no-prune
assert_contains "pakro ls --installed dummy" "2.0.0"
assert_contains "pakro ls --installed dummy" "1.0.0"
assert_contains "cat pakro.toml" 'dummy = "2"'

# `upgrade.auto_prune = false` makes that the default without a flag. Written through
# pakro.toml rather than the env var, since being settable there is the point of the setting.
cat <<'EOF' >pakro.toml
[tools]
dummy = "1"

[settings]
upgrade.auto_prune = false
EOF

pakro uninstall dummy --all
pakro install dummy@1.0.0
pakro upgrade dummy
assert_contains "pakro ls --installed dummy" "1.1.0"
assert_contains "pakro ls --installed dummy" "1.0.0"

# The dry-run listing follows the setting, not only the flags.
pakro uninstall dummy --all
pakro install dummy@1.0.0
assert_not_contains "pakro up dummy -n" "Would schedule"
assert_contains "pakro up dummy -n" "Would install dummy@1.1.0"

# --prune overrides the setting for a single run
pakro upgrade dummy --prune
assert_contains "pakro ls --installed dummy" "1.1.0"
assert_not_contains "pakro ls --installed dummy" "1.0.0"

# A zero grace period still leaves the install intact until the next pakro
# invocation, then opportunistic cleanup removes it.
cat <<'EOF' >pakro.toml
[tools]
dummy = "1"

[settings]
upgrade.prune_after = "0s"
EOF

pakro uninstall dummy --all
pakro install dummy@1.0.0
pakro upgrade dummy
assert "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"

# Commands that promise not to mutate state must not run opportunistic cleanup.
pakro upgrade dummy -nq >/dev/null
assert "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"
pakro prune --dry-run >/dev/null
assert "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"
pakro cache prune --dry-run >/dev/null
assert "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"
pakro --version >/dev/null
assert "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"

# A due receipt remains pending while a config reselects the old version.
sed -i.bak 's/dummy = "1"/dummy = "1.0.0"/' pakro.toml
assert_contains "PAKRO_DEBUG=1 pakro current 2>&1" "dummy@1.0.0 because it is still in use"
assert "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"
assert "test -f '$PAKRO_STATE_DIR/tool-purgatory.json'"

# Deciding that loads every tracked config, so the kept receipt is not due
# again for a day instead of being re-evaluated by every command.
assert "jq '[.entries[].remove_after] | min > (now + 23 * 3600)' '$PAKRO_STATE_DIR/tool-purgatory.json'" "true"
assert_not_contains "PAKRO_DEBUG=1 pakro current 2>&1" "keeping deferred"

# Once the reference goes away and the receipt is due again, the next
# invocation can remove it.
sed -i.bak 's/dummy = "1.0.0"/dummy = "1.1.0"/' pakro.toml
jq '.entries[].remove_after = 0' "$PAKRO_STATE_DIR/tool-purgatory.json" >purgatory.json
mv purgatory.json "$PAKRO_STATE_DIR/tool-purgatory.json"
ln -s ./1.0.0 "$PAKRO_DATA_DIR/installs/dummy/retired"
touch "$PAKRO_DATA_DIR/shims/deferred-prune-orphan"
chmod +x "$PAKRO_DATA_DIR/shims/deferred-prune-orphan"
pakro current >/dev/null
assert_fail "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"
assert_fail "test -L '$PAKRO_DATA_DIR/installs/dummy/retired'"
assert_fail "test -e '$PAKRO_DATA_DIR/shims/deferred-prune-orphan'"
assert_fail "test -f '$PAKRO_STATE_DIR/tool-purgatory.json'"

# Recreate a due receipt and verify that prompt-critical shell integration
# leaves it for an ordinary command. Loading every tracked project from a
# prompt hook can otherwise freeze every newly opened terminal.
cat <<'EOF' >pakro.toml
[tools]
dummy = "1"

[settings]
upgrade.prune_after = "0s"
EOF
pakro uninstall dummy --all
pakro install dummy@1.0.0
pakro upgrade dummy
pakro hook-env >/dev/null
assert "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"
assert "test -f '$PAKRO_STATE_DIR/tool-purgatory.json'"

# Tracked config resolution may execute a template that invokes pakro. The
# nested process must skip the cleanup already in progress instead of starting
# the same tracked-config scan recursively.
cat <<'EOF' >nested-pakro-version
#!/usr/bin/env bash
echo invocation >>"$PAKRO_STATE_DIR/deferred-prune-invocations"
pakro completion bash >/dev/null
echo 1.1.0
EOF
cat <<'EOF' >pakro.toml
[tools]
dummy = "{{ exec(command='bash nested-pakro-version') }}"

[settings]
upgrade.prune_after = "0s"
EOF

# --no-config must not make automatic cleanup load this tracked config.
pakro --no-config config ls >/dev/null
assert_fail "test -f '$PAKRO_STATE_DIR/deferred-prune-invocations'"
assert "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"

timeout 15 pakro config ls >/dev/null
assert "awk 'END { print (NR < 10) }' '$PAKRO_STATE_DIR/deferred-prune-invocations'" "1"
assert_fail "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"
assert_fail "test -f '$PAKRO_STATE_DIR/tool-purgatory.json'"

rm -f pakro.toml
