#!/usr/bin/env bash
# Test that PAKRO_CONFIG_DIR properly overrides the default config location
# When PAKRO_CONFIG_DIR is set to a custom location, configs from the default
# location (~/.config/pakro) should NOT be loaded during directory traversal.
# See: https://github.com/jdx/mise/discussions/7015

# Create a custom config directory
CUSTOM_CONFIG_DIR="$HOME/.pakro-custom"
mkdir -p "$CUSTOM_CONFIG_DIR"

# Create config in the custom location
cat >"$CUSTOM_CONFIG_DIR/config.toml" <<'EOF'
[tools]
dummy = "1.0.0"
EOF

# Create config in the DEFAULT location (~/.config/pakro) which should be ignored
# when PAKRO_CONFIG_DIR is overridden
mkdir -p "$HOME/.config/pakro"
cat >"$HOME/.config/pakro/config.toml" <<'EOF'
[tools]
dummy = "2.0.0"
EOF

# Set PAKRO_CONFIG_DIR to custom location and verify only custom config is loaded
export PAKRO_CONFIG_DIR="$CUSTOM_CONFIG_DIR"

# The config list should show ONLY the custom config, not the default location
# Note: pakro uses ~ shorthand in output, so check for that
assert_contains "pakro config ls" ".pakro-custom/config.toml"

# Should NOT contain the default config location
assert_not_contains "pakro config ls" ".config/pakro/config.toml"

# Verify the correct tool version is used (1.0.0 from custom, not 2.0.0 from default)
pakro install
assert_contains "pakro x -- dummy" "1.0.0"

# The write target has to respect the same exclusion. `pakro use` used to pick
# ~/.config/pakro/config.toml here -- the very file the assertions above prove is not
# loaded -- so the tool landed somewhere pakro would never read it back.
mkdir -p "$HOME/writetarget"
cd "$HOME/writetarget" || exit 1

pakro use dummy@1.0.0
assert "cat pakro.toml" '[tools]
dummy = "1.0.0"'
assert "cat $HOME/.config/pakro/config.toml" '[tools]
dummy = "2.0.0"'

# `pakro set` already resolved this correctly; it shares the resolver now, so pin it.
pakro set WRITE_TARGET=local
assert_contains "cat pakro.toml" "WRITE_TARGET"
assert_not_contains "cat $HOME/.config/pakro/config.toml" "WRITE_TARGET"
