#!/usr/bin/env bash
# Existing deployments do not depend on tracking or its capture size limits.
printf '[dotfiles]\n"~/.large-config" = { mode = "copy", source = "replacement" }\n' >pakro.toml
printf 'replacement\n' >replacement
dd if=/dev/zero of=~/.large-config bs=1048576 count=9 2>/dev/null
assert_succeed 'pakro dot apply --yes'
assert_succeed 'cmp replacement ~/.large-config'
assert_succeed 'pakro dotfiles status'

# The setup-repository path must retain the existing checkout-origin guard,
# before probing or connecting a different repository.
require_cmd git
mkdir -p checkout
git -C checkout init -q
git -C checkout remote add origin file://old-origin.git
assert_fail "PAKRO_CONFIG_DIR='$PWD/checkout' pakro bootstrap --adopt file://different-origin.git --yes" 'has origin'
assert_fail "PAKRO_CONFIG_DIR='$PWD/checkout' pakro bootstrap --adopt file://different-origin.git --dry-run" 'has origin'

# Unsetting machine-local sync also removes a value in the shared global
# layer, rather than silently exposing that value again.
assert_succeed "PAKRO_GLOBAL_CONFIG_FILE='$PAKRO_CONFIG_DIR/config.toml' pakro settings set history.sync manual"
assert 'pakro settings get history.sync' 'manual'
assert_succeed 'pakro settings unset history.sync'
assert 'pakro settings get history.sync' 'sync'
assert_succeed "PAKRO_GLOBAL_CONFIG_FILE='$PAKRO_CONFIG_DIR/config.toml' pakro settings set history.sync manual"
assert_succeed 'pakro settings set history.sync sync'
assert_succeed 'pakro settings unset history.sync'
assert 'pakro settings get history.sync' 'sync'

# Disabling recording avoids creating or opening the history repository.
printf 'next replacement\n' >replacement
assert_succeed "PAKRO_HISTORY_ENABLED=0 PAKRO_STATE_DIR='$PWD/disabled-state' pakro bootstrap dotfiles apply --yes"
assert_succeed 'cmp replacement ~/.large-config'
assert_fail 'test -e disabled-state/history'

mkdir -p disabled-state/history/repo.git
printf 'invalid repository\n' >disabled-state/history/repo.git/HEAD
printf 'final replacement\n' >replacement
assert_succeed "PAKRO_HISTORY_ENABLED=0 PAKRO_STATE_DIR='$PWD/disabled-state' pakro bootstrap dotfiles apply --yes"
assert_succeed 'cmp replacement ~/.large-config'
