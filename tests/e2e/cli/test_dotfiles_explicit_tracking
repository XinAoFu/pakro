#!/usr/bin/env bash
# shellcheck disable=SC2016
# Deployment and referencing a source never enroll either path in history.
require_cmd git

mkdir -p "$PAKRO_CONFIG_DIR/dotfiles" ~/templates/nested
echo source >"$PAKRO_CONFIG_DIR/dotfiles/source"
echo template >~/templates/nested/gitconfig.tera
echo native >~/.native
echo target >~/.link-target
ln -s "$HOME/.link-target" ~/.observed-link
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'TOML'
[dotfiles]
"~/.generated" = { mode = "copy", source = "dotfiles/source" }
TOML

assert "pakro bootstrap dotfiles paths --json | jq '.entries | length'" "0"
assert_succeed "pakro bootstrap dotfiles track ~/.native ~/templates ~/.observed-link"
assert "pakro bootstrap dotfiles paths --json | jq '.entries | length'" "3"
assert "pakro bootstrap dotfiles paths --json | jq '[.entries[] | select(.path == \"~/.generated\" or .mode == \"implicit\" or .mode == \"source\" or .mode == \"derived\")] | length'" "0"

echo added >~/templates/nested/new.tera
echo excluded >~/templates/nested/config.local.toml
echo excluded >~/templates/nested/credentials.json
assert_succeed "pakro bootstrap dotfiles save"
assert "git --git-dir=$PAKRO_STATE_DIR/history/repo.git rev-list --count refs/heads/main" "2"
assert "git --git-dir=$PAKRO_STATE_DIR/history/repo.git show HEAD:home/.native" "native"
assert "git --git-dir=$PAKRO_STATE_DIR/history/repo.git for-each-ref --format='%(refname)' refs/checkpoints refs/promoted refs/pakro-history" ""
assert_fail "git --git-dir=$PAKRO_STATE_DIR/history/repo.git cat-file -e HEAD:home/.config/pakro/config.toml"
assert "pakro bootstrap dotfiles paths --json | jq '.entries[] | select(.path == \"~/templates\") | .files'" "2"
assert "cat ~/.link-target" "target"
assert_succeed "test -L ~/.observed-link"
assert_fail "test -e ~/.git"
assert_fail "test -e ~/templates/.git"

# Exact managed outputs and referenced sources can be observed independently.
echo live-output >~/.generated
assert_succeed "pakro bootstrap dotfiles track ~/.generated $PAKRO_CONFIG_DIR/dotfiles/source"
assert "cat ~/.generated" "live-output"
assert_contains "cat $PAKRO_CONFIG_DIR/config.toml" 'mode = "copy"'
assert "git --git-dir=$PAKRO_STATE_DIR/history/repo.git show HEAD:home/.generated" "live-output"
assert "git --git-dir=$PAKRO_STATE_DIR/history/repo.git show HEAD:config/dotfiles/source" "source"
assert_succeed "pakro bootstrap dotfiles untrack ~/.generated"
assert "cat ~/.generated" "live-output"
assert_contains "cat $PAKRO_CONFIG_DIR/config.toml" 'mode = "copy"'
assert_fail "git --git-dir=$PAKRO_STATE_DIR/history/repo.git cat-file -e HEAD:home/.generated"
