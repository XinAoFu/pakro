#!/usr/bin/env bash

export PAKRO_TRUSTED_CONFIG_PATHS=""
unset CI GITHUB_ACTIONS GITHUB_ACTION 2>/dev/null || true

pakro_bin_dir="$(dirname "$(type -P pakro)")"
base_path="$pakro_bin_dir:/usr/bin:/bin"
fish_bin="$(type -P fish || true)"

cat >pakro.toml <<'EOF'
[env]
FROM_PROJECT = "{{ exec(command='touch project-config-ran') }}"
EOF

# Built-in completion generation does not invoke an ambient usage binary or
# consult project configuration.
cat >"$HOME/bin/usage" <<'EOF'
#!/usr/bin/env bash
echo '# path-usage-completion'
EOF
chmod +x "$HOME/bin/usage"
path_output="$(PATH="$HOME/bin:$base_path" PAKRO_YES=0 pakro completion fish 2>&1)"
assert_contains_text "$path_output" "# @generated by usage-argv"
assert_not_contains_text "$path_output" "path-usage-completion"
assert_not_contains_text "$path_output" "trust"
assert_fail "test -e project-config-ran"

# A globally configured usage tool is also ignored. Build a local asdf fixture
# before making the project config unsafe so the test still proves completion
# does not load either global or project tool configuration.
rm "$HOME/bin/usage"
cp -RL "$PAKRO_DATA_DIR/plugins/dummy" "$HOME/usage-plugin"

cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools]
"asdf:usage" = "1.0.0"
EOF
mv pakro.toml pakro.toml.untrusted
PATH="$base_path" pakro plugin link -f usage "$HOME/usage-plugin"
mkdir -p "$PAKRO_DATA_DIR/installs/asdf-usage/1.0.0/bin"
cat >"$PAKRO_DATA_DIR/installs/asdf-usage/1.0.0/bin/usage" <<'EOF'
#!/usr/bin/env bash
echo '# global-usage-completion'
EOF
chmod +x "$PAKRO_DATA_DIR/installs/asdf-usage/1.0.0/bin/usage"
mv pakro.toml.untrusted pakro.toml

global_output="$(PATH="$base_path" PAKRO_YES=0 pakro completion fish 2>&1)"
assert_contains_text "$global_output" "# @generated by usage-argv"
assert_not_contains_text "$global_output" "global-usage-completion"
assert_not_contains_text "$global_output" "trust"
assert_fail "test -e project-config-ran"

# Without either usage source, the built-in completion remains available. On
# macOS, exercise the same command in a real PTY under fish, matching fish's
# lazy completion bootstrap.
mv "$PAKRO_CONFIG_DIR/config.toml" "$PAKRO_CONFIG_DIR/config.toml.disabled"
fallback="$(PATH="$base_path" PAKRO_YES=0 pakro completion fish)"
assert_contains_text "$fallback" "# @generated by usage-argv"
assert_fail "test -e project-config-ran"

trust_markers="$(find "$PAKRO_STATE_DIR/trusted-configs" -mindepth 1 \( -type f -o -type l \) 2>/dev/null || true)"
[[ -z $trust_markers ]] || fail "completion unexpectedly trusted or ignored the project config"

if [[ $(uname -s) == Darwin && -n $fish_bin ]]; then
  pty_output="$(PATH="$base_path" PAKRO_YES=0 script -q /dev/null "$fish_bin" --no-config -c \
    'pakro completion fish | source; complete -C "pakro "')"
  assert_not_contains_text "$pty_output" "trust"
  assert_fail "test -e project-config-ran"
fi
