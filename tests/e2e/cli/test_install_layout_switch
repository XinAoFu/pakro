#!/usr/bin/env bash
# `pakro backends switch` under the identity install layout: the new backend's
# installation is a different one from the old backend's, so the switch installs
# it (instead of finding the version "already installed"), and the version link
# moves to it. hk moved from Aqua to Packslip at 1.58.1.
export PAKRO_EXPERIMENTAL=1
export PAKRO_INSTALL_LAYOUT=identity
export PAKRO_LOCKFILE=1
export PAKRO_MINIMUM_RELEASE_AGE=0
detect_platform
installs="$PAKRO_DATA_DIR/installs"

cat <<'EOF2' >pakro.toml
[tools]
hk = "1"
EOF2
cat <<'EOF2' >pakro.lock
lockfile_version = 2

[[tools.hk]]
version = "1.58.1"
backend = "aqua:jdx/hk"
specifiers = ["1"]
EOF2

assert_contains "pakro install 2>&1" "pakro backends switch hk"
old_dir="$(pakro where hk)"
assert_contains "cat '$old_dir/.pakro-install.toml'" 'backend = "aqua:jdx/hk"'

pakro backends switch hk
assert_contains "cat pakro.lock" 'backend = "packslip:github.com/jdx/hk"'
new_dir="$(pakro where hk)"
[[ $new_dir != "$old_dir" ]] || fail "the switch kept the aqua installation $old_dir"
assert_contains "cat '$new_dir/.pakro-install.toml'" 'backend = "packslip:github.com/jdx/hk"'
assert "readlink '$installs/hk/1.58.1'" "../$(basename "$new_dir")"
assert_contains "pakro exec -- hk --version" "hk 1.58.1"
# the old backend's installation is left for prune, not deleted
assert "test -f '$old_dir/.pakro-install.toml'"
