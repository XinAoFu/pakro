#!/usr/bin/env bash
# `pakro installs migrate` reinstalls legacy installations (made before the
# identity install layout was turned on) into their own hashed directories, and
# leaves the version link where the old directory was.
export PAKRO_EXPERIMENTAL=1
installs="$PAKRO_DATA_DIR/installs"

echo "=== legacy installations, made with the layout off ==="
assert "pakro install dummy@1.0.0 dummy@1.1.0 tiny@3.1.0"
for v in 1.0.0 1.1.0; do
  assert "test -d '$installs/dummy/$v' && test ! -L '$installs/dummy/$v'"
done
# something only the old copy has, to tell a reinstall from a move
echo old >"$installs/dummy/1.1.0/marker"

export PAKRO_INSTALL_LAYOUT=identity

echo "=== a dry run lists what would move and changes nothing ==="
assert_contains "pakro installs migrate --dry-run" "would migrate dummy@1.1.0"
assert_contains "pakro installs migrate --dry-run" "would migrate tiny@3.1.0"
assert "test ! -L '$installs/dummy/1.1.0' && test -f '$installs/dummy/1.1.0/marker'"
# a version names the installed versions it matches, as it does for uninstall
assert_contains "pakro installs migrate --dry-run dummy@1.1" "would migrate dummy@1.1.0"
assert_not_contains "pakro installs migrate --dry-run dummy@1.1" "dummy@1.0.0"
assert_contains "pakro installs migrate --dry-run dummy@latest" "would migrate dummy@1.1.0"
assert_contains "pakro installs migrate --dry-run dummy@1 2>&1" "would migrate dummy@1.0.0"
assert_not_contains "pakro installs migrate --dry-run dummy@1.0 2>&1" "dummy@1.1.0"
assert_not_contains "pakro installs migrate --dry-run dummy@latest" "dummy@1.0.0"

echo "=== one version moves; the version link takes its place ==="
assert_contains "pakro installs migrate dummy@1.1.0" "migrated dummy@1.1.0"
new="$(pakro where dummy@1.1.0)"
assert_matches "pakro where dummy@1.1.0" "^$installs/dummy-[a-z2-7]{8}\$"
assert "test -f '$new/.pakro-install.toml'"
assert "test ! -e '$new/marker'"
assert "readlink '$installs/dummy/1.1.0'" "../$(basename "$new")"
assert_contains "$installs/dummy/1.1.0/bin/dummy" "This is Dummy 1.1.0!"
# the runtime alias made for the legacy install still resolves, through the link
assert "readlink '$installs/dummy/1.1'" "./1.1.0"
assert_contains "$installs/dummy/1.1/bin/dummy" "This is Dummy 1.1.0!"
assert_empty "find '$installs/dummy' -maxdepth 1 -name '.*pakro-migrating'"
# the version that was not named is still legacy
assert "test -d '$installs/dummy/1.0.0' && test ! -L '$installs/dummy/1.0.0'"

echo "=== a failed reinstall puts the legacy directory back ==="
# the dummy plugin refuses to install this version
mkdir -p "$installs/dummy/other-dummy/bin"
echo kept >"$installs/dummy/other-dummy/marker"
assert_fail "pakro installs migrate dummy@other-dummy"
assert "test -d '$installs/dummy/other-dummy' && test ! -L '$installs/dummy/other-dummy'"
assert_contains "cat '$installs/dummy/other-dummy/marker'" "kept"
assert_empty "find '$installs/dummy' -maxdepth 1 -name '.*pakro-migrating'"
rm -rf "$installs/dummy/other-dummy"

echo "=== with no arguments, every remaining legacy installation moves ==="
assert "pakro installs migrate"
assert "test -L '$installs/dummy/1.0.0'"
assert "test -L '$installs/tiny/3.1.0'"
assert_matches "pakro where tiny@3.1.0" "^$installs/tiny-[a-z2-7]{8}\$"
assert_contains "pakro x tiny@3.1.0 -- rtx-tiny" "3.1.0"
assert_contains "pakro installs migrate" "no legacy installations to migrate"
assert "pakro installs ls --json | jq length" "3"

echo "=== an interrupted migration is finished or undone on the next run ==="
backend="$(pakro installs ls dummy --json | jq -r 'first(.[].backend)')"
# what a run records before it moves the old directory aside
journal() { # <version> <finished> [installation directories its install wrote into...]
  local v="$1" finished="$2" made=""
  shift 2
  for dir in "$@"; do made="$made\"$dir\","; done
  mkdir -p "$installs/.pakro/migrations"
  cat >"$installs/.pakro/migrations/dummy@$v.toml" <<EOF
tool = "dummy"
legacy = "$installs/dummy/$v"
backend = "$backend"
version = "$v"
made = [${made%,}]
finished = $finished
EOF
}
assert "PAKRO_INSTALL_LAYOUT=legacy PAKRO_EXPERIMENTAL=0 pakro install dummy@2.0.0"
assert "test -d '$installs/dummy/2.0.0' && test ! -L '$installs/dummy/2.0.0'"
# as if a run stopped right after moving the directory aside
journal 2.0.0 false
mv "$installs/dummy/2.0.0" "$installs/dummy/.2.0.0.pakro-migrating"
assert_contains "pakro installs migrate --dry-run 2>&1" "then migrate it"
assert_contains "pakro installs migrate dummy@2.0.0 2>&1" "restored"
assert "test -L '$installs/dummy/2.0.0'"
assert_empty "find '$installs/dummy' -maxdepth 1 -name '.*pakro-migrating'"
assert_empty "ls '$installs/.pakro/migrations'"
# as if a run stopped after the reinstall wrote its receipt and version link,
# but before it finished: neither proves the postinstall ran
assert "pakro uninstall dummy@2.0.0"
assert "PAKRO_INSTALL_LAYOUT=legacy PAKRO_EXPERIMENTAL=0 pakro install dummy@2.0.0"
echo old >"$installs/dummy/2.0.0/marker"
mv "$installs/dummy/2.0.0" "$installs/dummy/.2.0.0.pakro-migrating"
assert "pakro install dummy@2.0.0"
assert "test -L '$installs/dummy/2.0.0'"
journal 2.0.0 false "$(pakro where dummy@2.0.0)"
assert_contains "pakro installs migrate --dry-run 2>&1" "installs/dummy/2.0.0 from an interrupted migration, then migrate it"
assert_contains "pakro installs migrate dummy@2.0.0 2>&1" "restored"
assert "test -f '$(pakro where dummy@2.0.0)/.pakro-install.toml'"
assert "test ! -e '$installs/dummy/2.0.0/marker'"
assert_empty "find '$installs/dummy' -maxdepth 1 -name '.*pakro-migrating'"
# as if a run stopped after recording the migration finished, before removing
# the old directory
made="$(basename "$(pakro where dummy@2.0.0)")"
journal 2.0.0 true
mkdir "$installs/dummy/.2.0.0.pakro-migrating"
assert_contains "pakro installs migrate 2>&1" "removed"
assert "test -f '$installs/$made/.pakro-install.toml'"
assert "test -L '$installs/dummy/2.0.0'"
assert_empty "find '$installs/dummy' -maxdepth 1 -name '.*pakro-migrating'"
assert_empty "ls '$installs/.pakro/migrations'"
# an installation the interrupted run did not write into is left alone
journal 2.0.0 false
mkdir "$installs/dummy/.2.0.0.pakro-migrating"
assert_contains "pakro installs migrate 2>&1" "restored"
assert "test -f '$installs/$made/.pakro-install.toml'"
rm -rf "$installs/dummy/2.0.0"
assert "pakro install dummy@2.0.0"
# a journal that cannot be read does not block the next run
echo "not a journal [" >"$installs/.pakro/migrations/dummy@2.0.0.toml"
assert_contains "pakro installs migrate 2>&1" "cannot be read"
assert_empty "ls '$installs/.pakro/migrations'"
# ...and an old directory left beside the version link, which may be a finished
# migration's, is kept rather than put back over it
echo "not a journal [" >"$installs/.pakro/migrations/dummy@2.0.0.toml"
mkdir "$installs/dummy/.2.0.0.pakro-migrating"
assert_contains "pakro installs migrate 2>&1" "is kept"
assert "test -L '$installs/dummy/2.0.0'"
assert "test -d '$installs/dummy/.2.0.0.pakro-kept'"
assert_empty "find '$installs/dummy' -maxdepth 1 -name '.*pakro-migrating'"
rm -rf "$installs/dummy/.2.0.0.pakro-kept"

echo "=== a legacy version with an installation already in the new layout keeps its path ==="
assert "PAKRO_INSTALL_LAYOUT=legacy PAKRO_EXPERIMENTAL=0 pakro install tiny@3.0.0"
assert "pakro install asdf:tiny@3.0.0"
assert "test -d '$installs/tiny/3.0.0' && test ! -L '$installs/tiny/3.0.0'"
assert "pakro installs migrate tiny@3.0.0"
assert "test -L '$installs/tiny/3.0.0'"
assert "realpath '$installs/tiny/3.0.0'" "$(realpath "$(pakro where asdf:tiny@3.0.0)")"
