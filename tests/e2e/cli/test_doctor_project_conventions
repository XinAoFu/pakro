#!/usr/bin/env bash

# Inert safe-mode projects and excluded checks succeed without evaluating tools.
assert_succeed "PAKRO_SAFE=1 pakro doctor project --json | jq -e '.checks == [] and .errors == []'"
cat >pakro.toml <<'TOML'
[doctor.checks.skipped]
run = "touch should-not-run"
os = "win"
TOML
assert_succeed "PAKRO_SAFE=1 PAKRO_DUMMY_VERSION=-1 pakro doctor project --json | jq -e '.checks[0].status == \"skipped\" and .errors == []'"

# Toolset build failures preserve the configured checks and platform skips.
cat >>pakro.toml <<'TOML'
[doctor.checks.configuration]
run = "touch should-not-run"
TOML
assert_fail "PAKRO_DUMMY_VERSION=-1 pakro doctor project --json > build-error.json"
assert_succeed "jq -e '.errors == [] and [.checks[].status] == [\"error\", \"skipped\"]' build-error.json"
assert_succeed "test ! -e should-not-run"
assert_fail "PAKRO_SAFE=1 pakro doctor project --json > safe.json"
assert_succeed "jq -e '[.checks[].status] == [\"error\", \"skipped\"]' safe.json"
assert_contains "cat safe.json" "PAKRO_SAFE=1"
assert_succeed "pakro doctor project --json | jq -e '.errors == [] and .checks[0].name == \"configuration\" and .checks[0].status == \"pass\"'"

# Unknown container options remain forward compatible; leaf typos still fail.
cat >pakro.toml <<'TOML'
[doctor.settings]
future = true
TOML
assert_succeed "pakro env >/dev/null"
assert_succeed "pakro doctor project --json | jq -e '.checks == []'"
cat >pakro.toml <<'TOML'
[doctor.checks.empty_os]
run = "true"
os = []
TOML
assert_fail "pakro doctor project --json > empty-os.json"
assert_succeed "jq -e '.checks == [] and (.errors | length == 1)' empty-os.json"

# Project checks use their declaring root; global checks use invocation cwd.
mkdir -p project/nested global
cat >global/config.toml <<'TOML'
[doctor.checks.global]
run = "test -f invocation-marker"
[doctor.checks.global_relative]
run = "test -f project-marker"
dir = ".."
TOML
cat >project/pakro.toml <<'TOML'
[doctor.checks.project]
run = "test -f project-marker"
shell = "sh -c"
[doctor.checks.tilde_dir]
run = "test -f home-marker"
dir = "~/home-dir"
TOML
# Clear the parent invalid config before testing nested projects.
cat >pakro.toml <<'TOML'
TOML
touch project/project-marker project/nested/invocation-marker
mkdir -p "$HOME/home-dir" && touch "$HOME/home-dir/home-marker"
assert_succeed "PAKRO_GLOBAL_CONFIG_FILE=$PWD/global/config.toml pakro --cd project/nested doctor project --json > directories.json"
assert_succeed "jq -e '[.checks[].status] == [\"pass\", \"pass\", \"pass\", \"pass\"]' directories.json"

# A pakro.toml directly in $HOME is project configuration rooted at $HOME.
cat >"$HOME/pakro.toml" <<'TOML'
[doctor.checks.home]
run = "test -f home-dir/home-marker"
TOML
assert_succeed "pakro --cd project/nested doctor project --json | jq -e '[.checks[] | select(.name == \"home\") | .status] == [\"pass\"]'"
rm "$HOME/pakro.toml"

# OS aliases and architecture selectors use the same matcher as tools.
cat >pakro.toml <<TOML
[doctor.checks.platform]
run = "true"
os = "$(uname -s | tr '[:upper:]' '[:lower:]')/$(uname -m)"
[doctor.checks.other_arch]
run = "false"
os = ["linux/impossible", "darwin/impossible"]
TOML
assert_succeed "pakro doctor project --json | jq -e '[.checks[].status] == [\"skipped\", \"pass\"]'"

# Both probes must start concurrently, while reporting stays in name order.
cat >pakro.toml <<'TOML'
[doctor.checks.a]
run = "touch a-started; until test -f b-started; do sleep 0.05; done"
timeout = "3s"
[doctor.checks.b]
run = "touch b-started; until test -f a-started; do sleep 0.05; done"
timeout = "3s"
TOML
assert_succeed "PAKRO_JOBS=2 pakro doctor project --json | jq -e '[.checks[].name] == [\"a\", \"b\"] and [.checks[].status] == [\"pass\", \"pass\"]'"
# A one-job budget must serialize probes; zero is normalized to one too.
cat >pakro.toml <<'TOML'
[doctor.checks.a]
run = "mkdir exclusive && sleep 0.1 && rmdir exclusive"
[doctor.checks.b]
run = "mkdir exclusive && sleep 0.1 && rmdir exclusive"
TOML
assert_succeed "PAKRO_JOBS=1 pakro doctor project"
assert_succeed "PAKRO_JOBS=0 pakro doctor project"

# Explicit shell strings preserve parsing errors instead of falling back.
cat >pakro.toml <<'TOML'
[doctor.checks.empty]
run = "touch invalid-shell-ran"
shell = " "
[doctor.checks.quoted]
run = "touch invalid-shell-ran"
shell = '"unterminated -c'
TOML
assert_fail "pakro doctor project --json > shells.json"
assert_succeed "jq -e '[.checks[].status] == [\"error\", \"error\"]' shells.json"
assert_succeed "test ! -e invalid-shell-ran"
