#!/usr/bin/env bash

pakro use --tool-option enabled=true --tool-option count=2 --tool-option label=hello dummy@1.0.0
assert_contains "cat pakro.toml" 'enabled = "true"'
assert_contains "cat pakro.toml" 'count = "2"'
assert_contains "cat pakro.toml" 'label = "hello"'

# Versionless updates also preserve options from the existing inline table.
pakro use --tool-option label=updated dummy
assert "pakro config get tools.dummy.count" "2"
assert "pakro config get tools.dummy.enabled" "true"
assert "pakro config get tools.dummy.label" "updated"

pakro use --tool-option enabled=false dummy@1.0.0 --tool-option label=second tiny@2.0.0
assert "pakro config get tools.dummy.enabled" "false"
assert "pakro config get tools.tiny.label" "second"
assert_fail "pakro config get tools.tiny.enabled"
assert "pakro config get tools.dummy.count" "2"

pakro use --tool-option 'items=["one", "two"]' --postinstall 'touch installed' 'dummy[inline=yes]@2.0.0'
assert_contains "cat pakro.toml" 'items = ["one", "two"]'
assert "pakro config get tools.dummy.inline" "yes"
assert "test -f installed" ""

assert_fail_contains "pakro use --tool-option missing dummy 2>&1" "expects KEY=VALUE"
assert_fail_contains "pakro use --tool-option '=value' dummy 2>&1" "non-empty key"
assert_fail_contains "pakro use --tool-option enabled=true --tool-option enabled=false dummy 2>&1" "specified more than once"
assert_fail_contains "pakro use --tool-option enabled=true 'dummy[enabled=false]' 2>&1" "inline enabled option"
assert_fail_contains "pakro use --postinstall one --tool-option postinstall=two dummy 2>&1" "specified more than once"
assert_fail_contains "pakro use --tool-option enabled=true 2>&1" "TOOL@VERSION"

pakro use --dry-run --tool-option enabled=true dummy@3.0.0
assert "pakro config get tools.dummy.version" "2.0.0"

mkdir legacy
(
  cd legacy
  printf 'dummy 1.0.0\n' >.tool-versions
  pakro use --tool-option enabled=true dummy@1.0.0
  assert_contains "cat pakro.toml" 'enabled = "true"'
  assert "cat .tool-versions" "dummy 1.0.0"
  assert_fail_contains "pakro use --path .tool-versions --tool-option enabled=true dummy 2>&1" "--tool-option requires a TOML config file"
)
