#!/usr/bin/env bash

# Test cache path command and its alias

# Test `pakro cache` shows cache directory
assert_contains "pakro cache" "$PAKRO_CACHE_DIR"

# Test `pakro cache path` shows cache directory
assert_contains "pakro cache path" "$PAKRO_CACHE_DIR"

# Test `pakro cache dir` alias shows cache directory
assert_contains "pakro cache dir" "$PAKRO_CACHE_DIR"

# Test with custom cache directory
export PAKRO_CACHE_DIR=/tmp/test-pakro-cache
assert_contains "pakro cache path" "/tmp/test-pakro-cache"
assert_contains "pakro cache dir" "/tmp/test-pakro-cache"
