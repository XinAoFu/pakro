#!/usr/bin/env bash

echo '[tools.node]
version = "latest"' >pakro.toml

assert "cat pakro.toml" '[tools.node]
version = "latest"'

pakro config set tools.node.postinstall 'corepack enable'
assert "pakro config get tools.node.postinstall" "corepack enable"
assert "pakro config get tools.node.version" "latest"
pakro config set env._.python.venv.path '.venv'
assert "pakro config get env._.python.venv.path" ".venv"
pakro config set env._.python.venv.create true
assert "pakro config get env._.python.venv.create" "true"
pakro config set settings.disable_tools node,rust,node
assert "pakro config get settings.disable_tools" '["node", "rust"]'
assert_contains "cat pakro.toml" 'disable_tools = ["node", "rust"]'
pakro config set settings.disable_tools ""
assert "pakro config get settings.disable_tools" "[]"
pakro config set settings.disable_tools node
pakro config set settings.disable_tools "[]"
assert "pakro config get settings.disable_tools" "[]"
pakro config set settings.disable_tools node
pakro config set settings.disable_tools " [] "
assert "pakro config get settings.disable_tools" "[]"
pakro config set settings.disable_tools "node,, rust,"
assert "pakro config get settings.disable_tools" '["node", "rust"]'
pakro config set settings.task.skip build,test,build
assert "pakro config get settings.task.skip" '["build", "test"]'

# Collection updates preserve existing values, avoid duplicates, and remove
# only the requested member.
printf '# keep me\n[env]\n_.path = "bin"\n' >pakro.toml
pakro config set --append env._.path tools
pakro config set --append env._.path tools
assert "pakro config get env._.path" '["bin", "tools"]'
assert_contains "cat pakro.toml" "# keep me"
pakro config set --remove env._.path bin
assert "pakro config get env._.path" '["tools"]'
pakro config set --remove env._.path tools
assert_fail "pakro config get env._.path" "Key not found"

# Global targeting is explicit and cannot be combined with a file target.
mkdir -p "$PAKRO_CONFIG_DIR"
rm -f "$PAKRO_CONFIG_DIR/config.toml"
pakro config set --global --append env._.path global-bin
pakro config set --global --append env._.path global-tools
assert "pakro config get --file \"$PAKRO_CONFIG_DIR/config.toml\" env._.path" '["global-bin", "global-tools"]'
assert "pakro config get --global env._.path" '["global-bin", "global-tools"]'
mkdir scoped
printf '[env]\n_.path = ["file-bin"]\n' >scoped/pakro.toml
pakro config set --file scoped/pakro.toml --append env._.path file-tools
assert "pakro config get --file scoped/pakro.toml env._.path" '["file-bin", "file-tools"]'
assert_fail "pakro config set --global --file pakro.toml env.TEST nope"

# System targeting follows PAKRO_SYSTEM_CONFIG_FILE and is exclusive with the
# other explicit targets.
system_config="$PWD/system.toml"
PAKRO_SYSTEM_CONFIG_FILE="$system_config" pakro config set --system --append env._.path system-bin
assert "pakro config get --file \"$system_config\" env._.path" '["system-bin"]'
assert "PAKRO_SYSTEM_CONFIG_FILE=\"$system_config\" pakro config get --system env._.path" '["system-bin"]'
assert_fail "pakro config set --system --global env.TEST nope"
assert_fail "pakro config set --system --file pakro.toml env.TEST nope"

# TOML mutations reject legacy global formats with a useful error.
printf 'node 20\n' >.tool-versions
assert_fail "PAKRO_GLOBAL_CONFIG_FILE=$PWD/.tool-versions pakro config set --global env.TEST nope" \
  "config set requires a TOML config file"

# test "config set key=value" format
pakro config set env._.python.venv.path=.venv2
assert "pakro config get env._.python.venv.path" ".venv2"

# test "config set" with no value and no = fails
assert_fail "pakro config set tools.node"

# regression test for https://github.com/jdx/mise/discussions/3820:
# descending into a key whose value is already a non-table scalar must fail
# cleanly instead of panicking (>=2 levels) or silently doing nothing (1 level).
printf '[env]\nFOO = "bar"\n' >pakro.toml
assert_fail "pakro config set env.FOO.BAZ.QUX hello" "non-table value"
assert_fail "pakro config set env.FOO.BAZ hello" "non-table value"

# descending into a pre-existing inline table updates the field and keeps siblings.
printf '[env]\n_.python.venv = { path = ".venv", create = true }\n' >pakro.toml
pakro config set env._.python.venv.path .venv2
assert "pakro config get env._.python.venv.path" ".venv2"
assert "pakro config get env._.python.venv.create" "true"
