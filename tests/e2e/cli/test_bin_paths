#!/usr/bin/env bash

pakro use dummy@latest tiny@latest
assert "pakro bin-paths dummy" "$PAKRO_DATA_DIR/installs/dummy/latest/bin"
assert "pakro bin-paths tiny" "$PAKRO_DATA_DIR/installs/tiny/latest/bin"
assert "pakro bin-paths" "$PAKRO_DATA_DIR/installs/dummy/latest/bin
$PAKRO_DATA_DIR/installs/tiny/latest/bin"

dummy_bin="$PAKRO_DATA_DIR/installs/dummy/latest/bin"
ln -s dummy "$dummy_bin/dummy-link"
touch "$dummy_bin/not-executable"
mkdir "$dummy_bin/dir-target"
ln -s dir-target "$dummy_bin/dir-link"

assert "pakro bin-paths dummy --bin-names" "dummy
dummy-exec-tiny
dummy-link"
assert "pakro bin-paths tiny --bin-names" "rtx-tiny"
assert "pakro bin-paths dummy --json | jq -r '.[].name'" "dummy
dummy-exec-tiny
dummy-link"
assert "pakro bin-paths tiny --json | jq -r '.[].name'" "rtx-tiny"
assert "pakro bin-paths dummy --json | jq -r '.[] | select(.name == \"dummy\") | .path'" "$dummy_bin/dummy"
assert "pakro bin-paths dummy --json | jq -r '.[] | select(.name == \"dummy\") | .symlink'" "false"
assert "pakro bin-paths dummy --json | jq -r '.[] | select(.name == \"dummy-link\") | .path'" "$dummy_bin/dummy-link"
assert "pakro bin-paths dummy --json | jq -r '.[] | select(.name == \"dummy-link\") | .symlink'" "true"
assert "pakro bin-paths tiny --json | jq -r 'map(select(.name == \"dummy\")) | length'" "0"
assert "pakro bin-paths dummy --json | jq -r 'map(select(.name == \"not-executable\")) | length'" "0"
assert "pakro bin-paths dummy --json | jq -r 'map(select(.name == \"dir-link\")) | length'" "0"
