#!/usr/bin/env bash
export PAKRO_USE_VERSIONS_HOST=1

# verify that cache is reused for `pakro ls`
# see https://github.com/jdx/mise/discussions/6736

assert_contains "pakro -v use bat 2>&1" "GET https://mise-versions.jdx.dev/api/github/repos/sharkdp/bat/releases/latest 200 OK"
find "$PAKRO_CACHE_DIR" -type f -exec touch -t 202001010000 {} +

output="$(pakro -v ls bat 2>&1)"
if [[ $output == *"GET https://api.github.com/repos/sharkdp/bat/releases/latest"* ]]; then
  fail "[pakro -v ls bat] unexpectedly fetched the GitHub latest release"
fi
if [[ $output == *"GET https://mise-versions.jdx.dev/api/github/repos/sharkdp/bat/releases/latest"* ]]; then
  fail "[pakro -v ls bat] unexpectedly fetched the GitHub latest release from pakro-versions"
fi
if [[ $output == *"GET https://mise-versions.jdx.dev/data/bat.toml"* ]]; then
  fail "[pakro -v ls bat] unexpectedly fetched the versions host"
fi
ok "[pakro -v ls bat] reused cached metadata"
