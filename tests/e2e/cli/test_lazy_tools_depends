#!/usr/bin/env bash

export PAKRO_SHIMS_DIR="$HOME/.local/share/pakro/user-shims"
export PATH="$PAKRO_SHIMS_DIR:$PATH"

# A lazy tool's dependency is commonly lazy itself, so `pakro install` never
# materializes it. First-use dispatch must install the whole missing dependency
# closure: the needs-dummy install script fails unless dummy is already on disk.
mkdir -p "$PAKRO_CONFIG_DIR"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools.dummy]
lazy = true
lazy_bins = ["dummy"]
version = "2.0.0"

[tools.needs-dummy]
depends = ["dummy"]
lazy = true
lazy_bins = ["needs-dummy"]
version = "1.0.0"
EOF

pakro reshim
pakro install
assert_fail "test -d '$PAKRO_DATA_DIR/installs/needs-dummy/1.0.0'"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/2.0.0'"

assert_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 needs-dummy --version" "needs-dummy v1.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/2.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/needs-dummy/1.0.0"

# `pakro x` dispatches through the same lazy provider path.
pakro uninstall --all needs-dummy
pakro uninstall --all dummy
assert_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro x -- needs-dummy --version" "needs-dummy v1.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/2.0.0"

# An already-installed dependency is not reinstalled or duplicated.
pakro uninstall --all needs-dummy
assert_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 needs-dummy --version" "needs-dummy v1.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/2.0.0"

# The dependency preflight requires every configured version of a dependency, so
# all of them have to be installed, not just the first one that matches.
pakro uninstall --all needs-dummy
pakro uninstall --all dummy
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools]
dummy = [
  { version = "1.0.0", lazy = true, lazy_bins = ["dummy"] },
  { version = "2.0.0", lazy = true, lazy_bins = ["dummy"] },
]
needs-dummy = { version = "1.0.0", depends = ["dummy"], lazy = true, lazy_bins = ["needs-dummy"] }
EOF

pakro reshim
assert_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 needs-dummy --version" "needs-dummy v1.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/1.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/2.0.0"
