#!/usr/bin/env bash

export PAKRO_USE_TOML=0

assert "pakro i dummy@{1,2} tiny@3"

assert "pakro local dummy@2 -vv"
assert "pakro local" "dummy 2"
assert "pakro local --path" "$PWD/.tool-versions"

assert_contains "pakro x -- dummy" "2.0.0"

pakro local --pin dummy@1
assert "pakro local" "dummy 1.1.0"

assert_contains "pakro x -- dummy" "1.1.0"

mkdir subdir
(
  cd subdir || exit
  pakro local --parent dummy@2
  assert "pakro local --parent --path" "$HOME/workdir/.tool-versions"
  assert "pakro local --parent" "dummy 2"

  assert_contains "pakro x -- dummy" "2.0.0"
)

(
  cd subdir || exit
  pakro local tiny@3
  assert "pakro local --path" "$PWD/.tool-versions"
  assert "pakro local" "tiny 3"

  assert_contains "pakro x -- dummy" "2.0.0"
  assert_contains "pakro x -- rtx-tiny" "3.1.0"
)
assert_fail "rtx-tiny"

PAKRO_ASDF_COMPAT=1 pakro local dummy@2
assert "pakro local" "dummy 2.0.0"

PAKRO_ASDF_COMPAT=1 pakro local --fuzzy dummy@2
assert "pakro local" "dummy 2"
