#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

echo "=== Testing lockfile creation with aqua tool ==="
# Create a pakro.toml with an aqua tool (which supports cross-platform resolution)
cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

rm -f pakro.lock

# Test that lock command creates lockfile
output=$(pakro lock --platform linux-x64 2>&1)
assert_contains "echo '$output'" "Processing 1 tool(s)"
assert_contains "echo '$output'" "Updated"
assert_contains "echo '$output'" "Lockfile written"

# Verify lockfile was created
assert "test -f pakro.lock"
assert_contains "cat pakro.lock" "jqlang/jq"
assert_contains "cat pakro.lock" "1.7.1"
assert_contains "cat pakro.lock" "platforms.linux-x64"

echo "=== Testing lockfile update (adding platforms) ==="
# Now add another platform - it should update the existing lockfile
output=$(pakro lock --platform macos-arm64 2>&1)
assert_contains "echo '$output'" "Updated"

# Should now have both platforms
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_contains "cat pakro.lock" "platforms.macos-arm64"

echo "=== Testing lockfile with multiple tools ==="
rm -f pakro.lock
cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
"aqua:sharkdp/fd" = "10.2.0"
EOF

output=$(pakro lock --platform linux-x64 2>&1)
assert_contains "echo '$output'" "Processing 2 tool(s)"
assert_contains "cat pakro.lock" "jqlang/jq"
assert_contains "cat pakro.lock" "sharkdp/fd"

echo "=== Testing lockfile retains existing data ==="
# Create a lockfile with existing data
rm -f pakro.lock
pakro lock --platform linux-x64

# Now add more platforms
pakro lock --platform macos-arm64

# Original platform data should still exist
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_contains "cat pakro.lock" "platforms.macos-arm64"

echo "=== Cleanup ==="
rm -f pakro.toml pakro.lock

echo "pakro lock creation tests passed!"
