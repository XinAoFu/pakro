#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

echo "=== Testing pakro lock only targets configs from the current project root ==="
rm -rf scope-root
mkdir -p scope-root/app/.config

cat >scope-root/pakro.toml <<'EOF'
[tools]
"aqua:cli/cli" = "2.65.0"
EOF

cat >scope-root/app/pakro.toml <<'EOF'
[tools]
"aqua:mikefarah/yq" = "4.44.6"
EOF

cat >scope-root/app/pakro.local.toml <<'EOF'
[tools]
"aqua:BurntSushi/ripgrep" = "14.1.1"
EOF

cat >scope-root/app/pakro.test.toml <<'EOF'
[tools]
"aqua:sharkdp/fd" = "10.2.0"
EOF

cat >scope-root/app/.config/pakro.toml <<'EOF'
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

output=$(cd scope-root/app && env PAKRO_ENV=test pakro lock --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "mikefarah/yq"
assert_contains "echo '$output'" "BurntSushi/ripgrep"
assert_contains "echo '$output'" "sharkdp/fd"
assert_contains "echo '$output'" "jqlang/jq"
assert_contains "echo '$output'" ".config/pakro.lock"
assert_not_contains "echo '$output'" "cli/cli"

echo "=== Testing [monorepo] lockfile = true uses full-view lock scope ==="
mkdir -p monorepo-root/packages/api

cat >monorepo-root/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
lockfile = true
config_roots = ["packages/*"]

[tools]
"aqua:cli/cli" = "2.65.0"
EOF

cat >monorepo-root/packages/api/pakro.toml <<'EOF'
[tools]
"aqua:mikefarah/yq" = "4.44.6"
EOF

output=$(cd monorepo-root/packages/api && env PAKRO_EXPERIMENTAL=1 pakro lock --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "mikefarah/yq"
assert_contains "echo '$output'" "cli/cli"

output=$(cd monorepo-root && env PAKRO_EXPERIMENTAL=1 pakro lock --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "cli/cli"
assert_contains "echo '$output'" "mikefarah/yq"

echo "=== Testing unset [monorepo].lockfile keeps active config root scope during rollout ==="
mkdir -p monorepo-unset/packages/api

cat >monorepo-unset/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
config_roots = ["packages/*"]

[tools]
"aqua:cli/cli" = "2.65.0"
EOF

cat >monorepo-unset/packages/api/pakro.toml <<'EOF'
[tools]
"aqua:mikefarah/yq" = "4.44.6"
EOF

output=$(cd monorepo-unset/packages/api && env PAKRO_EXPERIMENTAL=1 pakro lock --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "mikefarah/yq"
assert_not_contains "echo '$output'" "cli/cli"

output=$(cd monorepo-unset && env PAKRO_EXPERIMENTAL=1 pakro lock --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "cli/cli"
assert_not_contains "echo '$output'" "mikefarah/yq"

echo "=== Testing [monorepo] lockfile = false keeps active config root scope ==="
mkdir -p monorepo-optout/packages/api

cat >monorepo-optout/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
lockfile = false
config_roots = ["packages/*"]

[tools]
"aqua:cli/cli" = "2.65.0"
EOF

cat >monorepo-optout/packages/api/pakro.toml <<'EOF'
[tools]
"aqua:mikefarah/yq" = "4.44.6"
EOF

output=$(cd monorepo-optout/packages/api && env PAKRO_EXPERIMENTAL=1 pakro lock --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "mikefarah/yq"
assert_not_contains "echo '$output'" "cli/cli"

output=$(cd monorepo-optout && env PAKRO_EXPERIMENTAL=1 pakro lock --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "cli/cli"
assert_not_contains "echo '$output'" "mikefarah/yq"

echo "=== Testing pakro lock --global only targets the global config ==="
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools]
"aqua:cli/cli" = "2.65.0"
EOF
mkdir -p system-config
cat >system-config/config.toml <<'EOF'
[tools]
"aqua:sharkdp/bat" = "0.25.0"
EOF
export PAKRO_SYSTEM_CONFIG_FILE="$PWD/system-config/config.toml"

output=$(cd scope-root/app && pakro lock --global --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "cli/cli"
assert_contains "echo '$output'" "sharkdp/bat"
assert_not_contains "echo '$output'" "mikefarah/yq"
assert_not_contains "echo '$output'" "jqlang/jq"

mkdir -p global-only
output=$(cd global-only && pakro lock --global --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "cli/cli"
assert_contains "echo '$output'" "sharkdp/bat"

echo "=== Testing scoped explicit locks do not bump parent configs ==="
rm -rf bump-root
mkdir -p bump-root/app

cat >bump-root/pakro.toml <<'EOF'
[tools]
"aqua:cli/cli" = "1"
EOF

cat >bump-root/app/pakro.toml <<'EOF'
[tools]
"aqua:mikefarah/yq" = "3"
EOF

output=$(cd bump-root/app && pakro lock "aqua:mikefarah/yq@4.44.6" --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "Would update aqua:mikefarah/yq from 3 to 4"
assert_contains "echo '$output'" "app/pakro.toml"
assert_not_contains "echo '$output'" "cli/cli"

output=$(cd bump-root/app && pakro lock "aqua:cli/cli@2.65.0" --platform linux-x64 --dry-run 2>&1)
assert_not_contains "echo '$output'" "Would update"
assert_not_contains "echo '$output'" "cli/cli"

echo "=== Cleanup ==="
rm -rf scope-root monorepo-root monorepo-unset monorepo-optout bump-root global-only system-config "$PAKRO_CONFIG_DIR/config.toml"

echo "pakro lock project root scope tests passed!"
