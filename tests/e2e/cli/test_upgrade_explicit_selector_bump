#!/usr/bin/env bash

# An explicit fuzzy version must not prevent --bump from updating the config.
cat <<'EOF' >pakro.toml
[tools]
dummy = "1.0.0"
EOF
pakro install dummy@1.0.0
pakro install dummy@2.0.0

output=$(pakro up --bump dummy@latest --dry-run)
assert_contains "echo '$output'" "Would bump dummy@latest"
assert_contains "cat pakro.toml" 'dummy = "1.0.0"'

pakro up --bump dummy@latest --prune
assert_contains "pakro ls dummy" "dummy  2.0.0  ~/workdir/pakro.toml  latest"
assert_contains "cat pakro.toml" 'dummy = "latest"'

# Subsequent bumps retain the latest selector and a concrete lockfile version.
PAKRO_LOCKFILE=1 pakro lock
PAKRO_LOCKFILE=1 pakro up --bump dummy --prune
assert_contains "cat pakro.toml" 'dummy = "latest"'
assert_contains "cat pakro.lock" 'version = "2.0.0"'

# Pinning saves the resolved version, including when already installed.
output=$(PAKRO_PIN=1 pakro up --bump dummy@latest --dry-run)
assert_contains "echo '$output'" "Would bump dummy@2.0.0"
PAKRO_PIN=1 pakro up --bump dummy@latest --prune
assert_contains "cat pakro.toml" 'dummy = "2.0.0"'

# Explicit selectors constrain resolution and are persisted verbatim.
cat <<'EOF' >pakro.toml
[tools]
dummy = "1.0.0"
EOF
pakro install dummy@3.1.0

output=$(pakro up --bump dummy@3 --dry-run)
assert_contains "echo '$output'" "Would bump dummy@3"
assert_contains "cat pakro.toml" 'dummy = "1.0.0"'

# An already-installed explicit selector is still persisted when another tool
# needs a regular upgrade.
cat <<'EOF' >pakro.toml
[tools]
dummy = "1.0.0"
tiny-local = "1.0.0"
EOF
ln -s "$ROOT/tests/support/data/plugins/tiny" "$PAKRO_DATA_DIR/plugins/tiny-local"
pakro install dummy@3.1.0
pakro install tiny-local@1.0.0
pakro up --bump dummy@3 tiny-local --prune
assert_contains "cat pakro.toml" 'dummy = "3"'
assert_contains "cat pakro.toml" 'tiny-local = "3.1.0"'

# An unresolved explicit selector must not prevent a successful sibling bump.
cat <<'EOF' >pakro.toml
[tools]
dummy = "1.0.0"
tiny-local = "1.0.0"
EOF
pakro install tiny-local@1.0.0

# Dry runs omit failed selectors, including when another selector for the same
# backend succeeds, but retain installed selectors and pending explicit installs.
pakro uninstall tiny-local@3.1.0
output=$(pakro up --bump dummy@path:/does-not-exist dummy@3 tiny-local@3.1 --dry-run 2>&1)
assert_not_contains_text "$output" "Would bump dummy@path:/does-not-exist"
assert_not_contains_text "$output" "Would bump dummy@1.0.0"
assert_contains_text "$output" "Would bump dummy@3"
assert_contains_text "$output" "Would bump tiny-local@3.1"
assert_contains "cat pakro.toml" 'dummy = "1.0.0"'
assert_contains "cat pakro.toml" 'tiny-local = "1.0.0"'

pakro up --bump dummy@path:/does-not-exist tiny-local --prune >/dev/null 2>&1 || :
assert_contains "cat pakro.toml" 'dummy = "1.0.0"'
assert_contains "cat pakro.toml" 'tiny-local = "3.1.0"'

pakro up --bump dummy@3 --prune
assert_contains "cat pakro.toml" 'dummy = "3"'

# An explicit selector must constrain the installed version instead of merely
# changing the selector that gets persisted.
cat <<'EOF' >pakro.toml
[tools]
tiny-local = "1.0.0"
EOF
pakro install tiny-local@1.0.0
PAKRO_LOCKFILE=1 pakro lock
output=$(PAKRO_LOCKFILE=1 pakro up --bump tiny-local@2 --dry-run 2>&1)
assert_contains_text "$output" "Would install tiny-local@2.1.0"
assert_contains_text "$output" "Would bump tiny-local@2"
assert_contains "cat pakro.toml" 'tiny-local = "1.0.0"'
PAKRO_LOCKFILE=1 pakro up --bump tiny-local@2 --prune
assert_contains "cat pakro.toml" 'tiny-local = "2"'
assert_contains "pakro ls tiny-local" "2.1.0"
assert_contains "cat pakro.lock" '2.1.0'

# A config-only explicit bump must also refresh an existing lockfile.
cat <<'EOF' >pakro.toml
[tools]
tiny-local = "1.0.0"
EOF
PAKRO_LOCKFILE=1 pakro lock
output=$(PAKRO_LOCKFILE=1 pakro up --bump tiny-local@3 --prune 2>&1)
assert_not_contains_text "$output" "All tools are up to date"
assert_not_contains_text "$output" "Newer versions are available but do not match"
assert_contains "cat pakro.toml" 'tiny-local = "3"'
assert_contains "cat pakro.lock" '3.1.0'

# Excluded explicit bumps must not update the configuration, whether they are
# the only requested tool or run alongside another upgrade.
cat <<'EOF' >pakro.toml
[tools]
dummy = "1.0.0"
EOF
pakro install dummy@3.1.0
pakro up --bump dummy@3 --exclude dummy --prune
assert_contains "cat pakro.toml" 'dummy = "1.0.0"'

cat <<'EOF' >pakro.toml
[tools]
dummy = "1.0.0"
tiny-local = "1.0.0"
EOF
pakro install dummy@3.1.0
pakro install tiny-local@1.0.0
pakro up --bump dummy@3 tiny-local --exclude dummy --prune
assert_contains "cat pakro.toml" 'dummy = "1.0.0"'
assert_contains "cat pakro.toml" 'tiny-local = "3.1.0"'

cat <<'EOF' >pakro.toml
[tools]
dummy = "1.0.0"
EOF
pakro up --bump dummy@3.1 --prune
assert_contains "cat pakro.toml" 'dummy = "3.1"'

# A higher-precedence environment request is not a writable config source.
cat <<'EOF' >pakro.toml
[tools]
dummy = "1.0.0"
EOF
PAKRO_DUMMY_VERSION=1.0.0 pakro up --bump dummy@latest --prune
assert_contains "cat pakro.toml" 'dummy = "1.0.0"'

# An unresolved explicit selector must not overwrite a working configuration.
cat <<'EOF' >pakro.toml
[tools]
dummy = "1.0.0"
EOF
pakro up --bump dummy@path:/does-not-exist --prune >/dev/null 2>&1 || :
assert_contains "cat pakro.toml" 'dummy = "1.0.0"'

# Concrete selectors and successful typed selectors persist their own request.
cat <<'EOF2' >pakro.toml
[tools]
dummy = "1.0.0"
EOF2
pakro install dummy@3.1.0
pakro up --bump dummy@3.1.0 --prune
assert_contains "cat pakro.toml" 'dummy = "3.1.0"'

cat <<'EOF2' >pakro.toml
[tools]
dummy = "1.0.0"
EOF2
pakro install dummy@3.1.0
pakro up --bump dummy@prefix:3 --prune
assert_contains "cat pakro.toml" 'dummy = "prefix:3"'

# A failed selector for the same backend must not be retained when its sibling succeeds.
cat <<'EOF2' >pakro.toml
[tools]
dummy = "1.0.0"
EOF2
pakro up --bump dummy@3 dummy@path:/does-not-exist --prune >/dev/null 2>&1 || :
assert_contains "cat pakro.toml" 'dummy = "3"'

# Pinning also applies uniformly to other version selectors.
PAKRO_PIN=1 pakro up --bump dummy@3 --prune
assert_contains "cat pakro.toml" 'dummy = "3.1.0"'

# Exercise the install path with a fully qualified backend request.
ln -s "$ROOT/tests/support/data/plugins/tiny" "$PAKRO_DATA_DIR/plugins/asdf-tiny-local"
cat <<'EOF' >pakro.toml
[tools]
tiny-local = "1.0.0"
EOF
pakro uninstall tiny-local@3.1.0
pakro up --bump asdf:tiny-local@latest --prune
assert_contains "cat pakro.toml" 'tiny-local = "latest"'
pakro uninstall asdf:tiny-local@3.1.0
PAKRO_PIN=1 pakro up --bump asdf:tiny-local@latest --prune
assert_contains "cat pakro.toml" 'tiny-local = "3.1.0"'
pakro up --bump asdf:tiny-local@latest --prune
assert_contains "cat pakro.toml" 'tiny-local = "latest"'

# Explicit ref, branch, and revision selectors are persisted verbatim.
for selector in ref:master branch:master rev:master; do
  cat <<'EOF2' >pakro.toml
[tools]
dummy = "1.0.0"
EOF2
  pakro install "dummy@$selector"
  pakro up --bump "dummy@$selector" --prune
  assert_contains "cat pakro.toml" "dummy = \"$selector\""
done

# A system selector is persisted when the system executable is available.
mkdir -p bin
cat <<'EOF2' >bin/dummy
#!/usr/bin/env bash
exit 0
EOF2
chmod +x bin/dummy
cat <<'EOF2' >pakro.toml
[tools]
dummy = "1.0.0"
EOF2
PATH="$PWD/bin:$PATH" pakro up --bump dummy@system --prune
assert_contains "cat pakro.toml" 'dummy = "system"'

# A failed typed selector must not overwrite a working configuration.
cat <<'EOF2' >pakro.toml
[tools]
dummy = "1.0.0"
EOF2
pakro up --bump dummy@path:/does-not-exist --prune >/dev/null 2>&1 || :
assert_contains "cat pakro.toml" 'dummy = "1.0.0"'
