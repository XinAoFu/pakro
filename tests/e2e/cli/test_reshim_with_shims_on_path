#!/usr/bin/env bash

# Regression test: when shims are on PATH and a "pakro" shim exists (e.g. because
# core:rust is managed and ~/.cargo/bin contains the pakro binary),
# `pakro reshim` should still create shims pointing to the real pakro binary,
# not to the pakro shim itself (which would create a circular symlink).
# Similarly, `pakro doctor` should not report shims as missing.

shimdir="$PAKRO_DATA_DIR/shims"
pakro_bin="$(which pakro)"

# Install a tool so there are shims to create
pakro i dummy@latest

# Reshim without shims on PATH — baseline
pakro reshim

# Verify shim was created and points to the real binary
assert "readlink $shimdir/dummy" "$pakro_bin"

# Simulate what happens when core:rust is in the toolset: the pakro binary
# itself ends up with a shim because ~/.cargo/bin (containing pakro) is scanned
# as a tool bin directory. Create a pakro shim pointing to the real binary.
ln -sf "$pakro_bin" "$shimdir/pakro"

# Now put shims on PATH (as pakro activate --shims does in non-interactive shells)
export PATH="$shimdir:$PATH"

# Reshim WITH shims on PATH and a pakro shim present.
# Previously this caused file::which("pakro") to find the shim, leading to
# circular symlinks (shim pointing to itself) and broken doctor output.
pakro reshim

# Shim should still point to the real pakro binary, not to the shim directory
assert "readlink $shimdir/dummy" "$pakro_bin"
assert_not_contains "readlink $shimdir/dummy" "$shimdir"

# The pakro shim itself must not be circular
if [ -L "$shimdir/pakro" ]; then
  assert_not_contains "readlink $shimdir/pakro" "$shimdir"
fi

# Doctor should not report missing shims
assert_not_contains "pakro doctor" "shims are missing"

# Simulate Snap's revision-specific payload and refresh-stable `current` link. The public
# /snap/bin/pakro command is a snapd dispatcher and cannot be used as the target of another
# argv[0]-based symlink shim.
snap_mount="$(mktemp -d)/pakro"
snap_revision="$snap_mount/189"
mkdir -p "$snap_revision/bin"
ln -s "$pakro_bin" "$snap_revision/bin/pakro"
ln -s 189 "$snap_mount/current"

SNAP="$snap_revision" __PAKRO_BIN="$snap_revision/bin/pakro" "$pakro_bin" reshim --force

# Shims should use the refresh-stable payload path, and doctor must agree with reshim.
assert "readlink $shimdir/dummy" "$snap_mount/current/bin/pakro"
assert_not_contains \
  "SNAP=$snap_revision __PAKRO_BIN=$snap_revision/bin/pakro $pakro_bin doctor" \
  "shims are missing"
