#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

echo "=== Testing pakro lock skips global config by default ==="
# Set up a tool in the global config
cat >"$PAKRO_CONFIG_DIR/config.toml" <<EOF
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

mkdir -p system-config
cat >system-config/config.toml <<EOF
[tools]
"aqua:cli/cli" = "2.65.0"
EOF
export PAKRO_SYSTEM_CONFIG_FILE="$PWD/system-config/config.toml"

# Set up a tool in the local project config
cat >pakro.toml <<EOF
[tools]
"aqua:mikefarah/yq" = "4.44.6"
EOF

rm -f pakro.lock "$PAKRO_CONFIG_DIR/pakro.lock" system-config/pakro.lock

# Running pakro lock should only create the project lockfile, not the global one
output=$(pakro lock --platform linux-x64 2>&1)
assert_contains "echo '$output'" "Processing 1 tool(s)"
assert_contains "echo '$output'" "mikefarah/yq"
assert "test -f pakro.lock"
assert "test ! -f $PAKRO_CONFIG_DIR/pakro.lock"
assert "test ! -f system-config/pakro.lock"

echo "=== Testing pakro lock --global targets only global config ==="
rm -f pakro.lock "$PAKRO_CONFIG_DIR/pakro.lock" system-config/pakro.lock

output=$(pakro lock --global --platform linux-x64 2>&1)
# Should process only tools from global configs
assert "test ! -f pakro.lock"
assert "test -f $PAKRO_CONFIG_DIR/pakro.lock"
assert "test -f system-config/pakro.lock"
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" "jqlang/jq"
assert_contains "cat system-config/pakro.lock" "cli/cli"

echo "=== Testing pakro lock points at --global when only global config has tools ==="
rm -rf pakro.toml pakro.lock "$PAKRO_CONFIG_DIR/pakro.lock" system-config

# jq is still declared in the global config, so `pakro lock` has nothing in project
# scope but `pakro lock --global` does. Say so instead of "No tools configured".
output=$(pakro lock 2>&1)
assert_contains "echo '$output'" "pakro lock --global"
assert "test ! -f pakro.lock"

echo "=== Testing the dotfiles layout that symlinks the global config to a project config ==="
# A config reached through both the global path and the project path is merged into
# a single global entry, so plain `pakro lock` finds no project-scoped tools.
mkdir -p dotfiles
cat >dotfiles/pakro.toml <<EOF
[tools]
"aqua:mikefarah/yq" = "4.44.6"
EOF
ln -sf "$PWD/dotfiles/pakro.toml" "$PAKRO_CONFIG_DIR/config.toml"

( # subshell to avoid cd'ing back (SC2103)
  cd dotfiles

  output=$(pakro lock 2>&1)
  assert_contains "echo '$output'" "pakro lock --global"
  assert "test ! -f pakro.lock"

  # --global locks it, writing the lockfile beside the symlink target
  assert "pakro lock --global --platform linux-x64"
  assert_contains "cat pakro.lock" "mikefarah/yq"
)

echo "=== Testing the hint honors tool selectors ==="
# Drop the symlink before its target, so the global config path is a real file again
rm -f "$PAKRO_CONFIG_DIR/config.toml"
rm -rf dotfiles
# Global declares jq; a project config with no tools keeps project scope empty.
cat >"$PAKRO_CONFIG_DIR/config.toml" <<EOF
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF
cat >pakro.toml <<EOF
[env]
FOO = "bar"
EOF

# A selector naming a tool that is not in global config must not point at --global
output=$(pakro lock "aqua:mikefarah/yq" 2>&1)
assert_contains "echo '$output'" "No tools configured to lock"
assert_not_contains "echo '$output'" "pakro lock --global"

# A selector naming a tool that *is* in global config should
output=$(pakro lock "aqua:jqlang/jq" 2>&1)
assert_contains "echo '$output'" "pakro lock --global"

echo "=== Testing the hint stays out of --local runs ==="
# --local asks for pakro.local.lock; there is no global equivalent to point at
output=$(pakro lock --local 2>&1)
assert_contains "echo '$output'" "No tools configured to lock"
assert_not_contains "echo '$output'" "pakro lock --global"

echo "=== Testing pakro lock with nothing configured anywhere ==="
rm -f "$PAKRO_CONFIG_DIR/config.toml" pakro.toml
rm -rf dotfiles

output=$(pakro lock 2>&1)
assert_contains "echo '$output'" "No tools configured to lock"
assert_not_contains "echo '$output'" "pakro lock --global"

echo "=== Cleanup ==="
rm -rf pakro.toml pakro.lock "$PAKRO_CONFIG_DIR/config.toml" "$PAKRO_CONFIG_DIR/pakro.lock" system-config

echo "pakro lock global tests passed!"
