#!/usr/bin/env bash

export PAKRO_SHIMS_DIR="$HOME/.local/share/pakro/user-shims"
export PAKRO_SYSTEM_SHIMS_DIR="$HOME/.local/share/pakro/system-shims"
export PATH="$PAKRO_SHIMS_DIR:$PAKRO_SYSTEM_SHIMS_DIR:$PATH"

# Non-registry tools must declare their command names. Implicit install skips
# them, while invoking the bootstrap shim installs and executes the tool even
# when general not-found auto-install is disabled.
mkdir -p "$PAKRO_CONFIG_DIR"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools]
dummy = { version = "1.0.0", lazy = true, lazy_bins = ["dummy"] }
EOF

# An uninstalled lazy declaration is intentional and must not be reported as
# missing, even when ordinary missing-tool warnings are set to always show.
assert_not_contains "PAKRO_STATUS_MESSAGE_MISSING_TOOLS=always pakro hook-env --shell bash --force 2>&1" "missing: dummy@1.0.0"

# Ordinary missing tools still use the configured warning policy.
cat >>"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
tiny = "1.0.0"
EOF
missing_warning=$(PAKRO_STATUS_MESSAGE_MISSING_TOOLS=always pakro hook-env --shell bash --force 2>&1)
assert_contains_text "$missing_warning" "missing: tiny@1.0.0"
assert_not_contains_text "$missing_warning" "dummy@1.0.0"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools]
dummy = { version = "1.0.0", lazy = true, lazy_bins = ["dummy"] }
EOF

pakro reshim
assert_succeed "test -e '$PAKRO_SHIMS_DIR/dummy'"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/1.0.0'"
pakro install
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/1.0.0'"
assert_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 dummy --version" "This is Dummy 1.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/1.0.0"

# Provisioning can opt into installing every configured lazy declaration.
pakro uninstall --all dummy
pakro install --include-lazy
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/1.0.0"

# An explicit install request still installs a lazy declaration.
pakro uninstall --all dummy
pakro install dummy
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/1.0.0"

# Registry shorthands derive bootstrap commands from registry bin metadata.
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools]
tiny = { version = "1.0.0", lazy = true }
EOF
pakro reshim
assert_succeed "test -e '$PAKRO_SHIMS_DIR/rtx-tiny'"
assert_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 rtx-tiny --version" "rtx-tiny: v1.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/tiny/1.0.0"

# Explicit backends cannot borrow bin metadata from a similarly named registry
# entry and must declare lazy_bins.
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools]
"aqua:tinygo-org/tinygo" = { version = "0.39.0", lazy = true }
EOF
assert_fail_contains "pakro reshim --force 2>&1" "set lazy_bins explicitly"
# A failed forced rebuild must leave the previously working farm intact.
assert_succeed "test -e '$PAKRO_SHIMS_DIR/rtx-tiny'"

# Fail after desired-set validation while materializing a replacement shim.
# The staged rebuild must still leave the live farm intact.
long_bin="$(printf 'x%.0s' {1..300})"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<EOF
[tools]
dummy = { version = "1.0.0", lazy = true, lazy_bins = ["$long_bin"] }
EOF
assert_fail "pakro reshim --force"
assert_succeed "test -e '$PAKRO_SHIMS_DIR/rtx-tiny'"

# A higher-precedence project selection blocks a global lazy fallback, even
# when the selected project version is missing.
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools]
dummy = { version = "1.0.0", lazy = true, lazy_bins = ["dummy"] }
EOF
cat >pakro.toml <<'EOF'
[tools]
dummy = { version = "2.0.0", lazy = false }
EOF
pakro uninstall --all dummy
pakro reshim
assert_fail "PAKRO_NOT_FOUND_AUTO_INSTALL=0 dummy --version"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/1.0.0'"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/2.0.0'"
