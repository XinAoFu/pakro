#!/usr/bin/env bash

# Create an initial pakro.toml file to reproduce the issue
echo '[tools]
node = "20"' >pakro.toml

# This should create pakro.pp.toml (environment-specific) instead of modifying pakro.toml
# Currently this fails because the -E flag doesn't exist
if pakro set -E pp NODE_ENV=production 2>/dev/null; then
  # If the command succeeded, check if it created the environment-specific file
  if [[ -f "pakro.pp.toml" ]]; then
    assert "cat pakro.pp.toml" '[env]
NODE_ENV = "production"'
    # Ensure original pakro.toml wasn't modified
    assert "cat pakro.toml" '[tools]
node = "20"'
  else
    echo "ERROR: pakro set -E pp should create pakro.pp.toml but it doesn't exist"
    exit 1
  fi
else
  echo "Expected: pakro set -E flag should exist and work"
  echo "Actual: pakro set command doesn't support -E flag"
  exit 1
fi
