#!/usr/bin/env bash

eval "$(pakro activate bash)"
pakro use dummy@1.0.0

pakro settings status.show_env=1
assert "pakro set FOO=1"
assert "pakro hook-env 2>&1 >/dev/null" "pakro +FOO" && _pakro_hook
assert "pakro set FOO=2"
assert "pakro hook-env 2>&1 >/dev/null" "pakro ~FOO" && _pakro_hook
assert "pakro set --rm FOO"
assert "pakro hook-env 2>&1 >/dev/null" "pakro -FOO" && _pakro_hook
echo "FOO=3" >.env
assert "pakro set _.file=.env"
assert "pakro hook-env 2>&1 >/dev/null" "pakro +FOO" && _pakro_hook
assert "pakro set _.path=./node_modules/.bin"
assert "pakro hook-env 2>&1 >/dev/null" "pakro +./node_modules/.bin" && _pakro_hook

pakro settings status.show_tools=1
assert "pakro hook-env 2>&1 >/dev/null" "pakro +dummy@1.0.0" && _pakro_hook
pakro use --rm dummy
assert "pakro hook-env 2>&1 >/dev/null" "pakro -dummy@1.0.0" && _pakro_hook
