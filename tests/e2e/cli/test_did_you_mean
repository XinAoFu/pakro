#!/usr/bin/env bash
# Test "Did you mean?" suggestions for unknown tools

set -euo pipefail
export RUST_BACKTRACE=0
export PAKRO_FRIENDLY_ERROR=1

# Test: Typo of a known pakro registry tool should suggest the correct name
assert_fail "pakro use nod" "Did you mean?"
assert_fail "pakro use nod" "node"

# Test: Typo of python should suggest python
assert_fail "pakro use pythn" "python"

# Test: Aqua Cargo and GoInstall packages should use runnable backend suggestions
assert_not_contains "pakro use wasmi_cli 2>&1 || true" "aqua:crates.io/wasmi_cli"
assert_fail "pakro use wasmi_cli" "cargo:wasmi_cli"
assert_not_contains "pakro use benchstat 2>&1 || true" "aqua:golang.org/x/perf/cmd/benchstat"
assert_fail "pakro use benchstat" "go:golang.org/x/perf/cmd/benchstat"
assert_fail "pakro use mapotf" "go:github.com/Azure/mapotf"
assert_fail "pakro use ifacemaker" "go:github.com/vburenin/ifacemaker"

# Test: Aqua GoBuild packages should not appear in suggestions
assert_not_contains "pakro use ycat 2>&1 || true" "aqua:goccy/go-yaml/ycat"
assert_not_contains "pakro use ycat 2>&1 || true" "go:github.com/goccy/go-yaml"
assert_not_contains "pakro use kics 2>&1 || true" "aqua:Checkmarx/kics"

# Test: Completely unrelated name should not show suggestions
assert_fail "pakro use somethingnonexistent" "not found in pakro tool registry"
