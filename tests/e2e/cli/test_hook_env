#!/usr/bin/env bash

pakro i dummy@{1.0.0,1.1.0,2.0.0}

eval "$(pakro activate bash --status)"

pakro use dummy@2.0.0
pushd .. && popd
assert_contains "dummy" "2.0.0"

pakro shell dummy@1.0.0
pushd .. && popd
assert_contains "dummy" "1.0.0"

# TODO: make "v" prefixes optional
export PAKRO_DUMMY_VERSION=1.1.0
pushd .. && popd
assert_contains "dummy" "1.1.0"

ln -s "$ROOT/tests/support/data/plugins/dummy" "$PAKRO_DATA_DIR/plugins/hyphen-tool"
pakro install hyphen-tool@1.0.0
pakro shell hyphen-tool@1.0.0
assert "echo $PAKRO_HYPHEN_TOOL_VERSION" "1.0.0"
pushd .. && popd
assert_contains "pakro current hyphen-tool" "1.0.0"

pakro shell --unset hyphen-tool
assert "echo ${PAKRO_HYPHEN_TOOL_VERSION+set}" ""

# With nothing to detect from, pakro has to say so rather than abort. `SHELL=""` is the only way
# to reach that on unix -- unset it and pakro falls back to "sh" -- but it is the *default* path on
# Windows, where the value read is COMSPEC. Unsetting PAKRO_SHELL too: an activated session sets it,
# and it would satisfy detection on its own.
assert_fail "env -u PAKRO_SHELL SHELL= pakro hook-env" "could not tell which shell"
# The control: the same invocation with a shell named still works, so the assertion above is about
# detection and not about hook-env being broken.
assert_succeed "env -u PAKRO_SHELL SHELL= pakro hook-env --shell bash"

# `pakro shell` and `pakro deactivate` take no shell argument, so detection is all they have. Both
# check `__PAKRO_DIFF` first and report "not activated" without it, so reaching the detection error
# needs a session that looks activated with nothing to detect from. The value does not have to be a
# real diff -- pakro warns that it could not deserialize it and carries on -- which is exactly how
# these two used to abort rather than report anything.
assert_fail "env -u PAKRO_SHELL __PAKRO_DIFF=x SHELL= pakro deactivate" "could not tell which shell"
assert_fail "env -u PAKRO_SHELL __PAKRO_DIFF=x SHELL= pakro shell tiny@1" "could not tell which shell"
# The control for the guard itself: without `__PAKRO_DIFF` neither reaches detection at all, so the
# two assertions above would pass for the wrong reason if the guard stopped working. It has to be
# unset explicitly -- this script activates pakro at the top, so the shell running these assertions
# has one. Asserted on the exit status rather than the message, which goes to stderr and is not
# what `assert_contains` reads.
assert_succeed "env -u PAKRO_SHELL -u __PAKRO_DIFF SHELL= pakro deactivate"
