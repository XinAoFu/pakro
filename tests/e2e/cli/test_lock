#!/usr/bin/env bash

export PAKRO_LOCKFILE=1

echo "=== Testing basic lock command with no tools ==="
# Test basic lock command with no tools configured - should show no tools message
rm -f pakro.toml pakro.lock
assert_contains "pakro lock" "No tools configured to lock"

echo "=== Testing lock command generates cross-platform lockfile ==="
# Create a pakro.toml with an aqua tool (which supports cross-platform resolution)
cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

rm -f pakro.lock

# Test that lock command generates lockfile for all 7 default platforms (including musl variants)
output=$(pakro lock 2>&1)
assert_contains "echo '$output'" "Targeting 7 platform(s)"
assert_contains "echo '$output'" "Processing 1 tool(s)"
assert_contains "echo '$output'" "Updated"
assert_contains "echo '$output'" "Lockfile written to"

# Verify lockfile was created with platform data
assert "test -f pakro.lock"
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_contains "cat pakro.lock" "platforms.linux-arm64"
assert_contains "cat pakro.lock" "platforms.macos-x64"
assert_contains "cat pakro.lock" "platforms.macos-arm64"
assert_contains "cat pakro.lock" "platforms.windows-x64"
assert_contains "cat pakro.lock" "jqlang/jq"
assert_contains "cat pakro.lock" "1.7.1"
# URLs should be github release URLs for jq
assert_contains "cat pakro.lock" "github.com/jqlang/jq/releases"

echo "=== Testing dry-run mode ==="
rm -f pakro.lock
output=$(pakro lock --dry-run 2>&1)
assert_contains "echo '$output'" "Dry run - would update"
assert_contains "echo '$output'" "aqua:jqlang/jq@1.7.1 for linux-x64"
# Lockfile should NOT be created in dry-run mode
assert "test ! -f pakro.lock"

echo "=== Testing platform filtering ==="
rm -f pakro.lock
# Test filtering to specific platforms
output=$(pakro lock --platform linux-x64,macos-arm64 2>&1)
assert_contains "echo '$output'" "Targeting 2 platform(s)"
assert_contains "echo '$output'" "linux-x64"
assert_contains "echo '$output'" "macos-arm64"

# Verify lockfile only has the requested platforms
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_contains "cat pakro.lock" "platforms.macos-arm64"
assert_not_contains "cat pakro.lock" "platforms.windows-x64"

echo "=== Testing multiple tools ==="
rm -f pakro.lock
cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
"aqua:mikefarah/yq" = "4.44.6"
EOF

output=$(pakro lock --platform linux-x64 2>&1)
assert_contains "echo '$output'" "Processing 2 tool(s)"
assert_contains "cat pakro.lock" "jqlang/jq"
assert_contains "cat pakro.lock" "mikefarah/yq"

echo "=== Testing tool filtering ==="
rm -f pakro.lock
# Filter to only jq
output=$(pakro lock "aqua:jqlang/jq" --platform linux-x64 2>&1)
assert_contains "echo '$output'" "Processing 1 tool(s)"
assert_contains "cat pakro.lock" "jqlang/jq"
assert_not_contains "cat pakro.lock" "mikefarah/yq"

echo "=== Testing aqua github_content lock URLs ==="
rm -f pakro.lock
cat <<EOF >pakro.toml
[tools]
"aqua:awslabs/git-secrets" = "1.3.0"
EOF

pakro lock --platform macos-arm64
assert_contains "cat pakro.lock" 'url = "https://raw.githubusercontent.com/awslabs/git-secrets/1.3.0/git-secrets"'
assert_not_contains "cat pakro.lock" "archive/refs/tags/1.3.0.tar.gz"

echo "=== Testing minimum release age filtering ==="
rm -f pakro.lock
cat <<EOF >pakro.toml
[tools]
jq = "latest"
EOF

cat <<EOF >pakro.lock
[[tools.jq]]
version = "1.7.1"
backend = "aqua:jqlang/jq"
EOF

output=$(pakro lock --minimum-release-age 2019-01-01 --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "jq@1.7.1 for linux-x64"
assert_not_contains "echo '$output'" "jq@1.6"

output=$(pakro lock --before 2019-01-01 --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "jq@1.7.1 for linux-x64"

rm -f pakro.lock
mkdir -p "$PAKRO_DATA_DIR/installs/jq/1.7.1"
cat <<EOF >pakro.toml
[settings]
install_before = "2019-01-01"

[tools]
jq = "latest"
EOF

output=$(pakro lock --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "jq@1.6 for linux-x64"
assert_not_contains "echo '$output'" "jq@1.7.1"

cat <<EOF >pakro.toml
[tools]
jq = { version = "latest", install_before = "2019-01-01" }
EOF

output=$(pakro lock --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "jq@1.6 for linux-x64"
assert_not_contains "echo '$output'" "jq@1.7.1"

cat <<EOF >pakro.toml
[tools]
jq = { version = "latest", install_before = "2024-01-01" }
EOF

output=$(pakro lock --minimum-release-age 2019-01-01 --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "jq@1.6 for linux-x64"
assert_not_contains "echo '$output'" "jq@1.7.1"

output=$(pakro lock --minimum-release-age 2019-01-01 --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "jq@1.6 for linux-x64"
assert_not_contains "echo '$output'" "jq@1.7.1"

output=$(pakro lock --minimum-release-age 2019-01-01 --platform linux-x64 --dry-run jq@latest 2>&1)
assert_contains "echo '$output'" "jq@1.6 for linux-x64"
assert_not_contains "echo '$output'" "jq@1.7.1"

output=$(pakro lock --minimum-release-age 2019-01-01 --platform linux-x64 --dry-run jq@1 2>&1)
assert_contains "echo '$output'" "jq@1.6 for linux-x64"
assert_not_contains "echo '$output'" "jq@1.7.1"

output=$(pakro lock --minimum-release-age 1d --platform linux-x64 --dry-run jq@latest 2>&1)
assert_contains "echo '$output'" "jq@"
assert_contains "echo '$output'" "for linux-x64"
rm -rf "$PAKRO_DATA_DIR/installs/jq/1.7.1"

echo "=== Testing minimum release age filtering respects active lock scope ==="
rm -rf subdir pakro.lock
cat <<EOF >pakro.toml
[tools]
jq = { version = "latest", install_before = "2019-01-01" }
EOF

mkdir subdir
cat <<EOF >subdir/pakro.toml
[tools]
jq = "1.7.1"
EOF

output=$(cd subdir && pakro lock --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "jq@1.7.1 for linux-x64"
assert_not_contains "echo '$output'" "jq@1.6 for linux-x64"

rm -rf subdir pakro.lock
cat <<EOF >pakro.toml
[tools]
jq = { version = "latest", install_before = "2019-01-01" }
EOF

mkdir subdir
cat <<EOF >subdir/pakro.toml
[tools]
jq = { version = "latest", install_before = "2024-01-01" }
EOF

output=$(cd subdir && pakro lock --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "jq@1.7.1 for linux-x64"
assert_not_contains "echo '$output'" "jq@1.6 for linux-x64"
assert_not_contains "echo '$output'" "Processing 2 tool(s)"

echo "=== Testing filtered dry-run skips prune lockfile read ==="
cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
"aqua:mikefarah/yq" = "4.44.6"
EOF

cat <<'EOF' >pakro.lock
[[tools.jq]]
version = "1.7.1"
backend = "aqua:jqlang/jq"
"platforms.linux-x64" = { checksum = "sha256:jq" }

[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
"platforms.linux-x64" = { checksum = "sha256:dummy" }
EOF

# With an explicit tool filter, dry-run should not show prune preview.
output=$(pakro lock "aqua:jqlang/jq" --platform linux-x64 --dry-run 2>&1)
assert_contains "echo '$output'" "Dry run - would update"
assert_not_contains "echo '$output'" "Dry run - would prune"

echo "=== Testing help output ==="
assert_contains "pakro lock --help" "Create or refresh lockfile versions, checksums, and download URLs"
assert_contains "pakro lock --help" "--platform"
assert_contains "pakro lock --help" "--dry-run"
assert_contains "pakro lock --help" "--jobs"
assert_contains "pakro lock --help" "--minimum-release-age"

echo "=== Cleanup ==="
rm -f pakro.lock pakro.toml

echo "pakro lock tests passed!"
