#!/usr/bin/env bash

# `usage complete-word` is invoked by the generated shell completion script.
# Resolving its pakro shim must not consult GitHub for a configured `usage@latest`.
credential_marker="$HOME/github-credential-command-called"
credential_command="$HOME/fake-github-credential-command"
cat >"$credential_command" <<'EOF'
#!/usr/bin/env bash
touch "$HOME/github-credential-command-called"
echo fake-token
EOF
chmod +x "$credential_command"

mkdir -p "$PAKRO_CONFIG_DIR" "$PAKRO_DATA_DIR/shims"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<EOF
[settings]
github.credential_command = "$credential_command"
EOF
cat >pakro.toml <<'EOF'
[tools]
usage = { version = "latest", lazy = true }
EOF

ln -s "$(which pakro)" "$PAKRO_DATA_DIR/shims/usage"
export PATH="$PAKRO_DATA_DIR/shims:$PATH"

assert_fail "usage complete-word --shell zsh -- pakro activate"
assert_fail "test -f '$credential_marker'"
