#!/usr/bin/env bash

export PAKRO_EXPERIMENTAL=1
export PAKRO_IDIOMATIC_VERSION_FILE_ENABLE_TOOLS=dummy

rm -rf "$PAKRO_DATA_DIR/plugins/tiny"
ln -s "$ROOT/tests/support/data/plugins/tiny" "$PAKRO_DATA_DIR/plugins/tiny"

echo "=== install --monorepo installs every configured root ==="
mkdir -p monorepo/packages/a monorepo/packages/b monorepo/packages/c
cat >monorepo/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
config_roots = ["packages/*"]
EOF
cat >monorepo/packages/a/pakro.toml <<'EOF'
[tools]
tiny = "1.0.0"

[tasks.prepare]
tools.tiny = "3.1.0"
run = "touch task-ran"
EOF
cat >monorepo/packages/b/pakro.toml <<'EOF'
[tools]
tiny = "2.1.0"
dummy = "1.0.0"

[tasks.prepare]
tools.dummy = "2.0.0"
run = "touch task-ran"
EOF
echo "2" >monorepo/packages/c/.dummy-version

assert "cd monorepo && pakro install --monorepo"
assert "test -d '$PAKRO_DATA_DIR/installs/tiny/1.0.0'"
assert "test -d '$PAKRO_DATA_DIR/installs/tiny/2.1.0'"
assert "test -d '$PAKRO_DATA_DIR/installs/dummy/1.0.0'"
assert "test -d '$PAKRO_DATA_DIR/installs/dummy/2.0.0'"

echo "=== install --monorepo --force reinstalls every configured root ==="
touch "$PAKRO_DATA_DIR/installs/tiny/1.0.0/force-marker"
touch "$PAKRO_DATA_DIR/installs/tiny/2.1.0/force-marker"
touch "$PAKRO_DATA_DIR/installs/dummy/1.0.0/force-marker"
touch "$PAKRO_DATA_DIR/installs/dummy/2.0.0/force-marker"
assert "cd monorepo && pakro install --monorepo --force"
assert_fail "test -f '$PAKRO_DATA_DIR/installs/tiny/1.0.0/force-marker'"
assert_fail "test -f '$PAKRO_DATA_DIR/installs/tiny/2.1.0/force-marker'"
assert_fail "test -f '$PAKRO_DATA_DIR/installs/dummy/1.0.0/force-marker'"
assert_fail "test -f '$PAKRO_DATA_DIR/installs/dummy/2.0.0/force-marker'"

echo "=== install --monorepo TOOL filters across roots ==="
rm -rf "$PAKRO_DATA_DIR/installs/tiny" "$PAKRO_DATA_DIR/installs/dummy"
assert "cd monorepo && pakro install --monorepo tiny"
assert "test -d '$PAKRO_DATA_DIR/installs/tiny/1.0.0'"
assert "test -d '$PAKRO_DATA_DIR/installs/tiny/2.1.0'"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/tiny/3.1.0'"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/1.0.0'"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/2.0.0'"

echo "=== install --monorepo --include-task-tools includes every root task ==="
assert "cd monorepo && pakro install --monorepo --include-task-tools"
assert "test -d '$PAKRO_DATA_DIR/installs/tiny/3.1.0'"
assert "test -d '$PAKRO_DATA_DIR/installs/dummy/2.0.0'"
assert_fail "test -e monorepo/packages/a/task-ran"
assert_fail "test -e monorepo/packages/b/task-ran"

echo "=== ls --monorepo includes every configured root ==="
output=$(cd monorepo && pakro ls --monorepo 2>&1)
assert_contains "echo '$output'" "tiny"
assert_contains "echo '$output'" "1.0.0"
assert_contains "echo '$output'" "2.1.0"
assert_contains "echo '$output'" "dummy"
assert_contains "echo '$output'" "2.0.0"

echo "=== ls --monorepo rejects modes that bypass monorepo union ==="
assert_fail_contains "cd monorepo && pakro ls --monorepo --prunable 2>&1" "cannot be used with"
assert_fail_contains "cd monorepo && pakro ls --monorepo --all-sources 2>&1" "cannot be used with"

echo "=== --monorepo requires monorepo_root and explicit config_roots ==="
mkdir -p outside no-roots empty-roots
cat >no-roots/pakro.toml <<'EOF'
monorepo_root = true
EOF
cat >empty-roots/pakro.toml <<'EOF'
monorepo_root = true

[monorepo]
config_roots = ["packages/*"]
EOF
assert_fail_contains "cd outside && pakro install --monorepo 2>&1" "monorepo_root = true"
assert_fail_contains "cd no-roots && pakro install --monorepo 2>&1" "[monorepo].config_roots is required"
assert_fail_contains "cd empty-roots && pakro install --monorepo 2>&1" "did not match any config roots"

echo "=== deferred --monorepo commands are explicit stubs ==="
assert_fail_contains "cd monorepo && pakro upgrade --monorepo 2>&1" "not implemented"
assert_fail_contains "cd monorepo && pakro prune --monorepo 2>&1" "not implemented"
assert_fail_contains "cd monorepo && pakro outdated --monorepo 2>&1" "not implemented"
