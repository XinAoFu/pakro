#!/usr/bin/env bash

# Regression test for discussion #4407: `pakro install <tool>` writes to no config
# file, so the tool's bin dir never joins the PATH `pakro exec` builds and the bin
# fails to resolve. That failure used to surface as a bare ENOENT ("couldn't exec
# process") with no hint that pakro had just installed the tool.

pakro install dummy@1.0.0

# Installed, but activated nowhere, so this still fails -- it should now say why.
assert_fail_contains "pakro exec -- dummy" "installed but not activated"
assert_fail_contains "pakro exec -- dummy" "pakro use dummy"
assert_fail_contains "pakro exec -- dummy" "pakro exec dummy -- dummy"

# The command the hint suggests has to actually work.
assert_contains "pakro exec dummy -- dummy" "1.0.0"

# A bin belonging to no installed tool keeps the original error untouched: the
# hint is only added when pakro can name the tool providing it.
unknown_out="$(pakro exec -- not-a-tool-4407 2>&1 || true)"
assert_contains_text "$unknown_out" "couldn't exec process"
assert_not_contains_text "$unknown_out" "installed but not activated"
