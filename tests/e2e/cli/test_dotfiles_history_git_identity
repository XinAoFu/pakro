#!/usr/bin/env bash
# History commits use an optional Git email shared across machines.
require_cmd git
require_cmd hostname

repo="$PAKRO_STATE_DIR/history/repo.git"
echo one >~/.history-identity
assert_succeed 'pakro dot track ~/.history-identity'
assert "git --git-dir=$repo log -1 --format='%an <%ae> | %cn <%ce>'" \
  'pakro <pakro@localhost> | pakro <pakro@localhost>'

cat >>"$PAKRO_CONFIG_DIR/config.toml" <<'TOML'
[history]
git_email = "pakro@{hostname}"
TOML

echo two >~/.history-identity
assert_succeed 'pakro dot save'
host=$(hostname)
assert "git --git-dir=$repo log -1 --format='%an <%ae> | %cn <%ce>'" \
  "pakro <pakro@$host> | pakro <pakro@$host>"

echo three >~/.history-identity
before_watch=$(git --git-dir="$repo" rev-parse HEAD)
assert_succeed 'pakro dot watch --once'
after_watch=$(git --git-dir="$repo" rev-parse HEAD)
assert_fail "test $before_watch = $after_watch"
assert "git --git-dir=$repo log -1 --format='%an <%ae> | %cn <%ce>'" \
  "pakro <pakro@$host> | pakro <pakro@$host>"
