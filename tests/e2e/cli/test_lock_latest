#!/usr/bin/env bash

# Tests for `pakro lock` with `tool@latest` and poisoned "latest" lockfiles.
# Regression coverage for bugs where:
#   - `pakro lock tool@latest` wrote the literal string "latest" to the lockfile
#     instead of resolving it to a concrete installed version.
#   - `pakro lock tool` (or `pakro lock`) with a lockfile that already held
#     `version = "latest"` produced a duplicate entry alongside the concrete
#     installed version.

export PAKRO_LOCKFILE=1

cat <<'EOF' >pakro.toml
[tools]
tiny = "latest"
EOF
pakro uninstall tiny --all 2>/dev/null || true
pakro install tiny@3.0.0
pakro install tiny@3.1.0

# ------------------------------------------------------------------
# `pakro lock tool@latest` must resolve to the newest installed
# concrete version, never write the literal "latest".
# ------------------------------------------------------------------
cat <<'EOF' >pakro.lock
# @generated
[[tools.tiny]]
version = "3.0.0"
EOF
pakro lock tiny@latest --platform linux-x64
assert_contains "cat pakro.lock" 'version = "3.1.0"'
assert_not_contains "cat pakro.lock" 'version = "latest"'
assert_not_contains "cat pakro.lock" 'version = "3.0.0"'

# ------------------------------------------------------------------
# A poisoned lockfile containing `version = "latest"` must be cleaned up
# on a single `pakro lock` run and replaced with the concrete version,
# never producing a duplicate entry.
# ------------------------------------------------------------------
cat <<'EOF' >pakro.lock
# @generated
[[tools.tiny]]
version = "latest"
EOF
pakro lock tiny --platform linux-x64
assert_contains "cat pakro.lock" 'version = "3.1.0"'
assert_not_contains "cat pakro.lock" 'version = "latest"'
# There should be exactly one [[tools.tiny]] entry.
assert "[ \"$(grep -c '^\[\[tools.tiny\]\]' pakro.lock)\" = \"1\" ]"

# ------------------------------------------------------------------
# Refresh semantics: `pakro lock tool` with a valid lockfile must
# preserve the current version (not introduce a newer one via the
# "latest" fallback).
# ------------------------------------------------------------------
cat <<'EOF' >pakro.lock
# @generated
[[tools.tiny]]
version = "3.0.0"
EOF
pakro lock tiny --platform linux-x64
assert_contains "cat pakro.lock" 'version = "3.0.0"'
assert_not_contains "cat pakro.lock" 'version = "3.1.0"'
assert "[ \"$(grep -c '^\[\[tools.tiny\]\]' pakro.lock)\" = \"1\" ]"

rm -f pakro.toml pakro.lock
unset PAKRO_LOCKFILE
