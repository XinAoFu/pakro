#!/usr/bin/env bash

export PAKRO_SYSTEM_CONFIG_FILE="$HOME/system-pakro.toml"
export PAKRO_SYSTEM_INSTALLS_DIR="$HOME/system-installs"
export PAKRO_SHIMS_DIR="$HOME/user-shims"
export PAKRO_SYSTEM_SHIMS_DIR="$HOME/system-shims"
export PATH="$PAKRO_SHIMS_DIR:$PAKRO_SYSTEM_SHIMS_DIR:$PATH"

cat >"$PAKRO_SYSTEM_CONFIG_FILE" <<'EOF'
[tools]
dummy = { version = "1.0.0", lazy = true, lazy_bins = ["dummy"] }
EOF

pakro reshim --system
assert_succeed "test -e '$PAKRO_SYSTEM_SHIMS_DIR/dummy'"
assert_fail "test -e '$PAKRO_SHIMS_DIR/dummy'"
# If only the user farm is already on PATH, the missing system farm follows it
# at the same fallback boundary rather than being promoted ahead of it.
path_without_farms="${PATH#"$PAKRO_SHIMS_DIR:$PAKRO_SYSTEM_SHIMS_DIR:"}"
pakro_path="$(PATH="$PAKRO_SHIMS_DIR:$path_without_farms" pakro env -s bash | sed -n 's/^export PATH=//p' | tr -d "'\"")"
case "$pakro_path" in
  *"$PAKRO_SHIMS_DIR:$PAKRO_SYSTEM_SHIMS_DIR:"*) ;;
  *) fail "expected user shims before system shims: $pakro_path" ;;
esac
assert_contains "dummy --version" "This is Dummy 1.0.0"
assert_directory_exists "$PAKRO_SYSTEM_INSTALLS_DIR/dummy/1.0.0"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/1.0.0'"

# A lazy provider installs its missing dependencies too, and each tool is stored
# in the scope of the config that declares it. A system provider must not drag a
# user-scoped dependency into the system installs directory.
cat >"$PAKRO_SYSTEM_CONFIG_FILE" <<'EOF'
[tools]
dummy = { version = "2.0.0", depends = ["pitchfork"], lazy = true, lazy_bins = ["dummy"] }
EOF
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools]
pitchfork = { version = "0.1.5", lazy = true, lazy_bins = ["pitchfork"] }
EOF
pakro reshim
pakro reshim --system
assert_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 dummy --version" "This is Dummy 2.0.0"
assert_directory_exists "$PAKRO_SYSTEM_INSTALLS_DIR/dummy/2.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/pitchfork/0.1.5"
assert_fail "test -d '$PAKRO_SYSTEM_INSTALLS_DIR/pitchfork'"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
EOF
pakro uninstall --all pitchfork
pakro uninstall dummy@2.0.0

# Upgrades preserve an existing system install's storage scope.
cat >"$PAKRO_SYSTEM_CONFIG_FILE" <<'EOF'
[tools]
dummy = "1"
EOF
pakro upgrade dummy
assert_directory_exists "$PAKRO_SYSTEM_INSTALLS_DIR/dummy/1.1.0"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/1.1.0'"

# Removing a non-lazy system install reconciles the system farm rather than
# leaving a stale dispatcher behind or touching the distinct user farm.
cat >"$PAKRO_SYSTEM_CONFIG_FILE" <<'EOF'
[tools]
dummy = "1"
pitchfork = "0.1.5"
EOF
pakro install --system pitchfork
assert_succeed "test -e '$PAKRO_SYSTEM_SHIMS_DIR/pitchfork'"
user_shims_dir="$PAKRO_SHIMS_DIR"
export PAKRO_SHIMS_DIR="/proc/pakro-user-shims"
pakro uninstall pitchfork@0.1.5
export PAKRO_SHIMS_DIR="$user_shims_dir"
assert_fail "test -e '$PAKRO_SYSTEM_SHIMS_DIR/pitchfork'"

# Removing a lazy declaration from system config reconciles the system farm,
# including with --no-prune.
cat >"$PAKRO_SYSTEM_CONFIG_FILE" <<'EOF'
[tools]
dummy = "1"
pitchfork = { version = "0.1.5", lazy = true, lazy_bins = ["pitchfork"] }
EOF
pakro reshim --system
pakro unuse --path "$PAKRO_SYSTEM_CONFIG_FILE" --no-prune pitchfork
assert_fail "test -e '$PAKRO_SYSTEM_SHIMS_DIR/pitchfork'"

cat >"$PAKRO_SYSTEM_CONFIG_FILE" <<'EOF'
[tools]
dummy = "1"
EOF

# When both farms are collocated, either selector reconciles the same union and
# cannot remove shims required by the other scope.
export PAKRO_SHIMS_DIR="$HOME/collocated-shims"
export PAKRO_SYSTEM_SHIMS_DIR="$PAKRO_SHIMS_DIR"
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
[tools]
pitchfork = { version = "0.1.5", lazy = true, lazy_bins = ["pitchfork"] }
EOF
pakro reshim
pakro reshim --system
assert_succeed "test -e '$PAKRO_SHIMS_DIR/dummy'"
assert_succeed "test -e '$PAKRO_SHIMS_DIR/pitchfork'"

# Different configured paths that resolve to one physical directory are also
# one union farm. A scoped rebuild must not remove the other scope's shims.
export PAKRO_SHIMS_DIR="$HOME/physical-shims"
export PAKRO_SYSTEM_SHIMS_DIR="$HOME/physical-system-shims"
mkdir -p "$PAKRO_SHIMS_DIR"
ln -s "$PAKRO_SHIMS_DIR" "$PAKRO_SYSTEM_SHIMS_DIR"
pakro reshim
pakro reshim --system
assert_succeed "test -e '$PAKRO_SHIMS_DIR/dummy'"
assert_succeed "test -e '$PAKRO_SHIMS_DIR/pitchfork'"

# Equal install roots are local storage. Rebuilding either distinct farm sees
# the same installs, so neither scope loses ordinary installed-tool shims.
cat >"$PAKRO_SYSTEM_CONFIG_FILE" <<'EOF'
EOF
cat >"$PAKRO_CONFIG_DIR/config.toml" <<'EOF'
EOF
export PAKRO_SYSTEM_INSTALLS_DIR="$PAKRO_DATA_DIR/installs"
export PAKRO_SHIMS_DIR="$HOME/equal-root-user-shims"
export PAKRO_SYSTEM_SHIMS_DIR="$HOME/equal-root-system-shims"
pakro install dummy@2.0.0
assert_succeed "test -e '$PAKRO_SHIMS_DIR/dummy'"
assert_succeed "test -e '$PAKRO_SYSTEM_SHIMS_DIR/dummy'"

# Lazy dispatch never elevates an unwritable system destination and explains
# both supported recovery paths.
export PAKRO_SYSTEM_INSTALLS_DIR="/proc/pakro-installs"
export PAKRO_SYSTEM_SHIMS_DIR="$HOME/permission-system-shims"
cat >"$PAKRO_SYSTEM_CONFIG_FILE" <<'EOF'
[tools]
dummy = { version = "3.0.0", lazy = true, lazy_bins = ["dummy"] }
EOF
pakro reshim --system
assert_fail_contains "'$PAKRO_SYSTEM_SHIMS_DIR/dummy' --version 2>&1" "appropriate privileges or set system_installs_dir"
