#!/usr/bin/env bash

# Non-interactive config generation preserves target selection, imports and parent creation.

export PAKRO_GLOBAL_CONFIG_FILE="$PWD/global-config.toml"

assert_contains "pakro generate config --global --dry-run 2>&1" "global-config.toml"
assert_contains "pakro generate config -g -n 2>&1" "global-config.toml"

# A positional path and --global are contradictory -- "edit the global config file, namely
# ./custom.toml" has no meaning -- so the combination is rejected rather than resolved in the
# positional's favour. Matched on a fragment rather than clap's whole message, which spells the
# positional out in a way that is not worth pinning here.
assert_fail_contains "pakro generate config --global custom.toml" "cannot be used with"
assert_fail_contains "pakro generate config custom.toml --global" "cannot be used with"

# A conflicting positional file must not be written, even without --dry-run.
assert_fail_contains "pakro generate config config --global" "cannot be used with"
assert_succeed "test ! -e config"
assert_succeed "test ! -e custom.toml"
# The other half of what was reported: the global config was not written either. Everything
# above this point is a dry run or a rejection, so this file should not exist yet.
assert_succeed "test ! -e global-config.toml"

# Either on its own is unchanged.
assert_contains "pakro generate config custom.toml --dry-run 2>&1" "custom.toml"
assert_not_contains "pakro generate config custom.toml --dry-run 2>&1" "global-config.toml"

# Without --global, the default config filename is used (regression guard).
assert_contains "pakro generate config --dry-run 2>&1" "pakro.toml"
assert_not_contains "pakro generate config --dry-run 2>&1" "global-config.toml"

# --tool-versions merges into the resolved target file, not the local pakro.toml.
cat >preexisting.toml <<EOF
[tools]
go = "1.22"
EOF
cat >.tool-versions <<EOF
node 22
EOF
assert_contains "pakro generate config preexisting.toml --tool-versions .tool-versions --dry-run 2>&1" 'go = "1.22"'
assert_contains "pakro generate config preexisting.toml --tool-versions .tool-versions --dry-run 2>&1" 'node = "22"'

# --tool-versions is a flag, not the positional, so it still combines with --global. Worth
# pinning: it is the one way to reach the global config with another file named on the command
# line, and the rule above is easy to over-apply to it.
assert_contains "pakro generate config --global --tool-versions .tool-versions --dry-run 2>&1" "global-config.toml"
assert_contains "pakro generate config --global --tool-versions .tool-versions --dry-run 2>&1" 'node = "22"'

# Everything above is --dry-run, so nothing here reached the write at all. The global config
# lives at ~/.config/pakro/config.toml and nothing creates that directory ahead of time, so on
# a fresh install this reported "writing to ..." and then failed with a bare "no such file or
# directory", leaving nothing behind.
export PAKRO_GLOBAL_CONFIG_FILE="$PWD/fresh/pakro/config.toml"
assert_succeed "pakro generate config --global"
# Asserting on the content, not just existence: a file that exists but is empty would mean
# the directory got made and the write still went wrong.
assert_contains "cat fresh/pakro/config.toml" "pakro config files are hierarchical"

# Same for --tool-versions, which writes through a different branch.
export PAKRO_GLOBAL_CONFIG_FILE="$PWD/fresh-tv/pakro/config.toml"
assert_succeed "pakro generate config --global --tool-versions .tool-versions"
assert_contains "cat fresh-tv/pakro/config.toml" 'node = "22"'

# Control: with the directory already there both were always fine, so on their own the two
# assertions above do not show that creating it is what changed.
export PAKRO_GLOBAL_CONFIG_FILE="$PWD/existing/config.toml"
mkdir -p existing
assert_succeed "pakro generate config --global"
assert_contains "cat existing/config.toml" "pakro config files are hierarchical"
