#!/usr/bin/env bash

assert "pakro use dummy@2.0.0 tiny@2.0.0"
assert "pakro use dummy@3.0.0 tiny@3.0.0"
cd "$(mktemp -d)" || exit 1 # pakro should not prune these files even though they're from some other directory

assert_contains "pakro prune --dry-run 2>&1" "pakro dummy@2.0.0 [dryrun]"
assert_contains "pakro prune --dry-run 2>&1" "pakro tiny@2.0.0 [dryrun]"

# Dry-run must not perform runtime-symlink cleanup.
ln -s ./missing "$PAKRO_DATA_DIR/installs/dummy/latest"
assert "pakro prune --dry-run"
assert "test -L '$PAKRO_DATA_DIR/installs/dummy/latest'"

# Test: --dry-run-code should exit non-zero when there are tools to prune
assert_fail_contains "pakro prune --dry-run-code 2>&1" "[dryrun]"
# Verify nothing was actually pruned
assert "ls $PAKRO_DATA_DIR/installs/dummy/2.0.0"
assert "ls $PAKRO_DATA_DIR/installs/tiny/2.0.0"
assert "test -L '$PAKRO_DATA_DIR/installs/dummy/latest'"
# Without a terminal or --yes, prune must not silently treat an unavailable
# confirmation prompt as a decline and report success.
assert_fail_contains "PAKRO_YES=0 pakro prune tiny 2>&1" \
  "pakro prune requires confirmation but there was nobody to ask; pass --yes to prune non-interactively"
assert "ls $PAKRO_DATA_DIR/installs/tiny/2.0.0"
PAKRO_YES=1 assert "pakro prune tiny"
assert "ls $PAKRO_DATA_DIR/installs/dummy/2.0.0"
assert_fail "ls $PAKRO_DATA_DIR/installs/tiny/2.0.0"
PAKRO_YES=1 assert "pakro prune"
assert_fail "ls $PAKRO_DATA_DIR/installs/dummy/2.0.0"
assert "test \"\$(readlink '$PAKRO_DATA_DIR/installs/dummy/latest')\" = ./3.0.0"
assert "ls $PAKRO_DATA_DIR/installs/dummy/3.0.0"
assert "ls $PAKRO_DATA_DIR/installs/tiny/3.0.0"

# Test: --dry-run-code should exit 0 when there is nothing to prune
assert_succeed "pakro prune --dry-run-code 2>&1"

echo "=== prune keeps lockfile-pinned versions ==="
locked_project="$(mktemp -d)"
cd "$locked_project" || exit 1
export PAKRO_LOCKFILE=1
cat >pakro.toml <<'EOF'
[tools]
dummy = "latest"
EOF
cat >pakro.lock <<'EOF'
# @generated

[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
EOF
assert "pakro install"
cd "$(mktemp -d)" || exit 1
PAKRO_YES=1 assert "pakro prune --tools"
assert "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"
cd "$locked_project" || exit 1
assert_contains "pakro install 2>&1" "all tools are installed"
