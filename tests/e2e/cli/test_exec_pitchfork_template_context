#!/usr/bin/env bash

# Pitchfork passes a daemon command it cannot render to `pakro x`, with its own
# template variables as JSON.
cat >pakro.toml <<'TOML'
[env]
FROM_PAKRO = "from_pakro"
SHARED = "pakro"
[vars]
greeting = "it's"
TOML

export PITCHFORK_TEMPLATE_CONTEXT='{"name":"api","env":{"SHARED":"daemon"},"daemons":{"redis":{"port":6379}}}'
assert "pakro x -- sh -c 'echo {{ vars.greeting | quote }} {{ env.FROM_PAKRO }} {{ env.SHARED }} {{ name }} {{ daemons.redis.port }}'" "it's from_pakro daemon api 6379"
# The variable is for that command only, not for anything it starts.
assert "pakro x -- sh -c 'echo \${PITCHFORK_TEMPLATE_CONTEXT:-unset}'" "unset"
assert_fail_contains "pakro x -- sh -c 'echo {{ vars.missing }}'" "failed to render daemon command"
# Without it, a command's braces are left alone.
unset PITCHFORK_TEMPLATE_CONTEXT
assert "pakro x -- sh -c 'echo {{ vars.greeting }}'" "{{ vars.greeting }}"
