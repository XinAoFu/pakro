#!/usr/bin/env bash

# A completion driver that cancels an in-flight completion closes the read end
# of pakro's stdout. pakro must exit quietly instead of panicking on EPIPE.

cat >pakro.toml <<'EOF_TOML'
[tasks.build]
run = 'true'
EOF_TOML

# pakro starts only after the reader has closed its stdin (signalled through the
# FIFO), so its first write always hits EPIPE. Under pipefail the pipeline's
# status is pakro's, since the reader succeeds.
mkfifo reader_closed
status=0
{
  read -r _ <reader_closed
  exec pakro __complete_word__ --shell bash --line 'pakro run ' --bash-word '' 2>stderr.txt
} | {
  exec 0<&-
  echo >reader_closed
} || status=$?
[[ $status == 0 ]] || fail "completion exited $status on a closed stdout: $(cat stderr.txt)"
assert_not_contains "cat stderr.txt" "panicked"
assert_not_contains "cat stderr.txt" "Broken pipe"

# A reader that stays open still receives the candidates.
assert_contains "pakro __complete_word__ --shell bash --line 'pakro run ' --bash-word ''" "build"

# An unreadable completion spec is reported as an error, not a panic.
assert_fail "pakro __usage_complete_word bogus" "pakro ERROR"
