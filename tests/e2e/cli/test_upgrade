#!/usr/bin/env bash

assert_contains "pakro upgrade --help" "-b, --bump"
assert_not_contains "pakro upgrade --help" "-l, --bump"

echo 'dummy 1' >.tool-versions
pakro install dummy@1.0.0

assert_contains "pakro ls --installed dummy" "1.0.0"
assert_not_contains "pakro ls --installed dummy" "1.1.0"

pakro upgrade dummy --prune

assert_contains "pakro ls --installed dummy" "1.1.0"
assert_not_contains "pakro ls --installed dummy" "1.0.0"
assert_contains "pakro upgrade dummy 2>&1" 'Newer versions are available but do not match the configured version ranges'
assert_contains "pakro upgrade dummy 2>&1" 'dummy 1.1.0 → 2.0.0'
assert_contains "pakro upgrade dummy 2>&1" 'pakro outdated --bump'
assert_contains "pakro upgrade dummy 2>&1" "to update the configuration and upgrade"
assert_not_contains "pakro upgrade dummy 2>&1" "All tools are up to date"
assert_contains "pakro upgrade dummy -l --dry-run 2>&1" "deprecated [cli.upgrade.bump-l]"
assert_contains "pakro upgrade dummy -l --dry-run 2>&1" "Would install dummy@2.0.0"

pakro upgrade dummy -b --prune
assert_contains "pakro ls --installed dummy" "2.0.0"
assert_not_contains "pakro ls --installed dummy" "1.1.0"
rm .tool-versions

# Test: --local should only upgrade tools in local config, not global config
cat <<EOF >pakro.toml
[tools]
dummy = "1"
EOF
cat >"$PAKRO_CONFIG_DIR/config.toml" <<EOF
[tools]
tiny = "1"
EOF
pakro uninstall dummy tiny --all
pakro install dummy@1.0.0 tiny@1.0.0
assert_contains "pakro ls --installed dummy" "1.0.0"
assert_contains "pakro ls --installed tiny" "1.0.0"
# Dry-run should only show the local tool (dummy)
assert_contains "pakro upgrade --local -n" "Would install dummy@1.1.0"
assert_not_contains "pakro upgrade --local -n" "tiny"
# Actual upgrade should only upgrade dummy
pakro upgrade --local --prune
assert_contains "pakro ls --installed dummy" "1.1.0"
assert_not_contains "pakro ls --installed dummy" "1.0.0"
# tiny should remain at 1.0.0 since it's in global config
assert_contains "pakro ls --installed tiny" "1.0.0"
assert_not_contains "pakro ls --installed tiny" "1.1.0"
rm -f "$PAKRO_CONFIG_DIR/config.toml"
rm -f pakro.toml

# if tiny is installed but no longer active in config, --inactive with a tool arg
# should still upgrade it
cat >"$PAKRO_CONFIG_DIR/config.toml" <<EOF
[tools]
tiny = "1"
EOF
pakro uninstall tiny --all
pakro install tiny@1.0.0
rm -f "$PAKRO_CONFIG_DIR/config.toml"
latest_tiny=$(pakro latest tiny)
pakro upgrade tiny --inactive
assert_contains "pakro ls --installed tiny" "$latest_tiny"

# ensure options are retained
pakro use "ubi:bazelbuild/buildtools[exe=buildifier,matching=buildifier]@7.1.2"
assert "cat pakro.toml" '[tools]
"ubi:bazelbuild/buildtools" = { version = "7.1.2", exe = "buildifier", matching = "buildifier" }'
bazelbuild_latest=$(pakro latest ubi:bazelbuild/buildtools)
pakro up --bump ubi:bazelbuild/buildtools
assert "cat pakro.toml" "[tools]
\"ubi:bazelbuild/buildtools\" = { version = \"$bazelbuild_latest\", exe = \"buildifier\", matching = \"buildifier\" }"

rm -f .tool-versions
echo "tools.dummy = 'prefix:1'" >pakro.toml
pakro uninstall dummy --all
mkdir -p "$PAKRO_DATA_DIR/installs/dummy/1.0.0"
assert "pakro ls dummy --outdated" "dummy  1.0.0 (outdated)  ~/workdir/pakro.toml  prefix:1"
assert "pakro up -n --prune" "Would uninstall dummy@1.0.0
Would install dummy@1.1.0"
pakro up --prune
assert "pakro ls dummy" "dummy  1.1.0  ~/workdir/pakro.toml  prefix:1"
assert "pakro up dummy -n --bump --prune" "Would uninstall dummy@1.1.0
Would install dummy@2.0.0
Would bump dummy@prefix:2 in ~/workdir/pakro.toml"
pakro up dummy --bump --prune
assert "pakro ls dummy" "dummy  2.0.0  ~/workdir/pakro.toml  prefix:2"
echo "tools.dummy = 'prefix:1'" >pakro.toml
pakro uninstall dummy --all
pakro i dummy@1.0.0
assert "pakro up dummy -n --bump --prune" "Would uninstall dummy@1.0.0
Would install dummy@2.0.0
Would bump dummy@prefix:2 in ~/workdir/pakro.toml"
pakro up dummy --bump --prune
assert "pakro ls dummy" "dummy  2.0.0  ~/workdir/pakro.toml  prefix:2"

cat <<EOF >pakro.toml
[tools]
dummy = "latest"
EOF
assert "pakro uninstall dummy --all"
assert "pakro i dummy@1.0.0"
assert "pakro up --bump"
assert "cat pakro.toml" '[tools]
dummy = "latest"'

# Test: --dry-run-code should exit non-zero when there are outdated tools
echo "tools.dummy = 'prefix:1'" >pakro.toml
pakro uninstall dummy --all
mkdir -p "$PAKRO_DATA_DIR/installs/dummy/1.0.0"
assert_fail_contains "pakro up --dry-run-code 2>&1" "Would install"
# Verify nothing was actually upgraded
assert "ls $PAKRO_DATA_DIR/installs/dummy/1.0.0"

# Test: --dry-run-code should exit 0 when the configured range is up to date
pakro up
assert_contains "pakro up --dry-run-code 2>&1" "do not match the configured version ranges"

# Test: upgrade should not re-download a version that is already installed
# This verifies the fix for https://github.com/jdx/mise/discussions/8260
cat <<EOF >pakro.toml
[tools]
dummy = "1"
EOF
pakro uninstall dummy --all
# Install 1.0.0 first (old version), then also install 1.1.0 (the latest 1.x)
pakro install dummy@1.0.0
pakro install dummy@1.1.0
assert_contains "pakro ls --installed dummy" "1.0.0"
assert_contains "pakro ls --installed dummy" "1.1.0"
# upgrade should report the newer release outside the configured range
assert_contains "pakro up 2>&1" "dummy 1.1.0 → 2.0.0"

# Test: upgrade with lockfile should update the lockfile to the new version
cat <<EOF >pakro.toml
[tools]
dummy = "1"
EOF
pakro uninstall dummy --all
pakro install dummy@1.0.0
# Write a lockfile pinning to 1.0.0
cat <<EOF >pakro.lock
[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
EOF
# Verify the lockfile pins to 1.0.0
assert "pakro ls dummy" "dummy  1.0.0  ~/workdir/pakro.toml  1"
# Upgrade should install 1.1.0 and update the lockfile
output="$(pakro up --prune 2>&1)"
assert_contains "echo '$output'" "  dummy 1.0.0 → 1.1.0"
assert "pakro ls dummy" "dummy  1.1.0  ~/workdir/pakro.toml  1"
# Verify the lockfile was updated to 1.1.0
assert_contains "cat pakro.lock" "1.1.0"
assert_not_contains "cat pakro.lock" "1.0.0"
rm -f pakro.lock

# Test that upgrading a specific tool doesn't check other tools
# This verifies the fix for https://github.com/jdx/mise/discussions/7328
cat <<EOF >pakro.toml
[tools]
dummy = "1"
tiny = "1"
EOF
pakro uninstall dummy tiny --all
pakro install dummy@1.0.0 tiny@1.0.0

# Upgrade only dummy, should not see any warnings about tiny
output=$(pakro upgrade dummy --bump --prune 2>&1)
assert_not_contains "echo '$output'" "Error getting latest version for tiny"
assert_not_contains "echo '$output'" "WARN.*tiny"
assert_contains "pakro ls --installed dummy" "2.0.0"
# dummy 1.0.0 should have been uninstalled since we upgraded it
assert_not_contains "pakro ls --installed dummy" "1.0.0"
# tiny should still be at 1.0.0 since we didn't upgrade it
assert_contains "pakro ls --installed tiny" "1.0.0"
assert_not_contains "pakro ls --installed tiny" "1.1.0"

# Test: upgrade with specific version should update lockfile
export PAKRO_LOCKFILE=1
cat <<'EOF' >pakro.toml
[tools]
tiny = "latest"
EOF
pakro uninstall tiny --all
pakro install tiny@3.0.0
touch pakro.lock
pakro lock --platform linux-x64
assert_contains "cat pakro.lock" "3.0.0"
# Upgrade to specific version - lockfile should be updated
pakro upgrade tiny@3.0.1
assert_contains "cat pakro.lock" "3.0.1"
assert_not_contains "cat pakro.lock" "3.0.0"
# pakro.toml should still say "latest"
assert_contains "cat pakro.toml" '"latest"'
rm -f pakro.toml pakro.lock

# Test: upgrade with version that doesn't match prefix should update config
cat <<'EOF' >pakro.toml
[tools]
tiny = "2"
EOF
pakro uninstall tiny --all
pakro install tiny@2.0.0
touch pakro.lock
pakro lock --platform linux-x64
assert_contains "cat pakro.lock" "2.0.0"
pakro upgrade tiny@3.0.1
# Config should be updated to match new prefix
assert_contains "cat pakro.toml" '"3"'
# Lockfile should have 3.0.1
assert_contains "cat pakro.lock" "3.0.1"
assert_not_contains "cat pakro.lock" "2.0.0"
rm -f pakro.toml pakro.lock

# Test: upgrading one tracked project should preserve versions pinned by another tracked lockfile
rm -rf tracked-upgrade
mkdir -p tracked-upgrade/foo tracked-upgrade/bar
pakro uninstall dummy --all || true
for project in tracked-upgrade/foo tracked-upgrade/bar; do
  cat <<'EOF' >"$project/pakro.toml"
[tools]
dummy = "latest"
EOF
  cat <<'EOF' >"$project/pakro.lock"
[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
EOF
done
pakro install dummy@1.0.0
(cd tracked-upgrade/foo && pakro ls dummy >/dev/null)
(cd tracked-upgrade/bar && pakro ls dummy >/dev/null)
(cd tracked-upgrade/bar && pakro upgrade dummy@2.0.0 --prune)
assert_contains "pakro ls --installed dummy" "1.0.0"
assert_contains "pakro ls --installed dummy" "2.0.0"
assert_contains "cd tracked-upgrade/foo && pakro ls dummy" "1.0.0"
assert_not_contains "cd tracked-upgrade/foo && pakro ls dummy" "missing"
assert_contains "cat tracked-upgrade/foo/pakro.lock" "1.0.0"
assert_contains "cat tracked-upgrade/bar/pakro.lock" "2.0.0"
assert_not_contains "cat tracked-upgrade/bar/pakro.lock" "1.0.0"
rm -rf tracked-upgrade

# Test: upgrading a global fuzzy version should update the global lockfile
cat <<'EOF' >"$PAKRO_CONFIG_DIR/config.toml"
[tools]
dummy = "latest"
EOF
pakro uninstall dummy --all
pakro install dummy@1.0.0
touch "$PAKRO_CONFIG_DIR/pakro.lock"
pakro lock --global --platform linux-x64
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" "1.0.0"
pakro upgrade dummy@2.0.0
assert_contains "cat $PAKRO_CONFIG_DIR/config.toml" '"latest"'
assert_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" "2.0.0"
assert_not_contains "cat $PAKRO_CONFIG_DIR/pakro.lock" "1.0.0"
rm -f "$PAKRO_CONFIG_DIR/config.toml" "$PAKRO_CONFIG_DIR/pakro.lock"
unset PAKRO_LOCKFILE

# Test: upgrade removes old version when minimum_release_age is set and "latest" resolves
# to a version not yet installed on disk.
# Regression test for https://github.com/jdx/mise/issues/7991
pakro settings set minimum_release_age "7d"
pakro uninstall dummy --all
cat <<'EOF' >pakro.toml
[tools]
dummy = "latest"
EOF
pakro install dummy@1.0.0
assert_contains "pakro ls --installed dummy" "1.0.0"
# upgrade should install 2.0.0 and uninstall 1.0.0
pakro upgrade dummy --prune
assert_contains "pakro ls --installed dummy" "2.0.0"
assert_not_contains "pakro ls --installed dummy" "1.0.0"
rm -f pakro.toml
pakro settings unset minimum_release_age

plugin_dir="$PAKRO_DATA_DIR/plugins/patch-release"
mkdir -p "$plugin_dir/bin"
cat <<'LISTALL' >"$plugin_dir/bin/list-all"
#!/usr/bin/env bash
echo 29.1 29.1.1
LISTALL
cat <<'INSTALL' >"$plugin_dir/bin/install"
#!/usr/bin/env bash
mkdir -p "$ASDF_INSTALL_PATH"
touch "$ASDF_INSTALL_PATH/version-$ASDF_INSTALL_VERSION"
INSTALL
chmod +x "$plugin_dir/bin/list-all" "$plugin_dir/bin/install"

cat <<'CONFIG' >pakro.toml
[tools]
patch-release = "29.1"
CONFIG
pakro install
pakro upgrade --bump
assert_contains "pakro ls --current patch-release" "29.1.1"
assert_contains "cat pakro.toml" 'patch-release = "29.1.1"'

cat <<'CONFIG' >pakro.toml
[tools]
patch-release = "29"
CONFIG
pakro uninstall --all patch-release
pakro install patch-release@29.1
pakro upgrade --bump
assert_contains "pakro ls --current patch-release" "29.1.1"
assert_contains "cat pakro.toml" 'patch-release = "29"'
