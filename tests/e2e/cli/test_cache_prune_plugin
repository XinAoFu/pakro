#!/usr/bin/env bash

mkdir -p "$PAKRO_CACHE_DIR/node" "$PAKRO_CACHE_DIR/python"
printf node >"$PAKRO_CACHE_DIR/node/old"
printf python >"$PAKRO_CACHE_DIR/python/old"
touch -t 202001010000 "$PAKRO_CACHE_DIR/node/old" "$PAKRO_CACHE_DIR/python/old"

PAKRO_CACHE_PRUNE_AGE=1s pakro cache prune node

if [[ -e $PAKRO_CACHE_DIR/node/old ]]; then
  fail "node cache was not pruned"
fi

if [[ ! -e $PAKRO_CACHE_DIR/python/old ]]; then
  fail "python cache was pruned"
fi

ok "cache prune only pruned the requested tool"
