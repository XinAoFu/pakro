#!/usr/bin/env bash
# Sharing works without experimental opt-in.
export PAKRO_EXPERIMENTAL=0
git init -q --bare -b main "$PWD/origin.git"
echo original >"$HOME/.native"
assert_succeed "pakro bootstrap dotfiles track ~/.native --no-autosave"
assert_succeed "pakro bootstrap dotfiles origin set file://$PWD/origin.git --sync manual --yes"
assert_succeed "pakro bootstrap dotfiles sync"
assert_succeed "pakro bootstrap dotfiles status"
assert_succeed "pakro bootstrap dotfiles pull --yes"
assert_succeed "pakro bootstrap dotfiles watch --once"
assert_not_contains "pakro doctor 2>&1 || true" 'tracking is experimental and disabled'
