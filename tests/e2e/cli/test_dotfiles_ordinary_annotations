#!/usr/bin/env bash
# Descriptions live in ordinary ancestry and survive a clone without Git notes.
require_cmd git
export PAKRO_HISTORY_NOTIFY=false
echo native >~/.native
assert_succeed "pakro bootstrap dotfiles track ~/.native"
original=$(pakro bootstrap dotfiles history show latest --json | jq -r .uuid)
repo="$PAKRO_STATE_DIR/history/repo.git"
tree=$(git --git-dir="$repo" rev-parse 'main^{tree}')
assert_succeed "pakro bootstrap dotfiles history describe $original 'configure native shell'"
assert "pakro bootstrap dotfiles history show $original --json | jq -r .description" 'configure native shell'
assert "git --git-dir=$repo rev-parse main^{tree}" "$tree"
assert "git --git-dir=$repo for-each-ref --format='%(refname)' refs/notes/" ''
assert_succeed "git --git-dir=$repo merge-base --is-ancestor $original main"

origin="$PWD/setup.git"
git init -q --bare -b main "$origin"
assert_succeed "pakro bootstrap dotfiles origin set file://$origin --sync manual --yes"
assert "git --git-dir=$origin rev-parse main" "$(git --git-dir="$repo" rev-parse main)"
second="$(dirname "$HOME")/annotation-machine"
mkdir -p "$second/.local/state/pakro/history"
git clone -q --bare "$origin" "$second/.local/state/pakro/history/repo.git"
b() {
  (
    cd "$second" || exit
    env HOME="$second" XDG_CONFIG_HOME="$second/.config" PAKRO_CONFIG_DIR="$second/.config/pakro" \
      PAKRO_STATE_DIR="$second/.local/state/pakro" PAKRO_DATA_DIR="$second/.local/share/pakro" \
      PAKRO_CACHE_DIR="$second/.cache/pakro" PAKRO_TRUSTED_CONFIG_PATHS="$second" pakro "$@"
  )
}
export second
export -f b
assert "b bootstrap dotfiles history show $original --json | jq -r .description" 'configure native shell'
assert "git --git-dir=$second/.local/state/pakro/history/repo.git for-each-ref --format='%(refname)' refs/notes/" ''
