#!/usr/bin/env bash
# The unreleased backup/local-only model is removed, not silently downgraded.
require_cmd git
echo tracked >~/.tracked
assert_fail 'pakro bootstrap dotfiles track ~/.tracked --private'
assert_fail 'pakro bootstrap dotfiles track ~/.tracked --no-share'
assert_fail 'pakro bootstrap dotfiles track ~/.tracked --no-backup'
assert_fail 'pakro bootstrap dotfiles origin set owner/repo --encrypt-backups --yes'
assert_fail 'pakro bootstrap dotfiles origin set owner/repo --include-existing --yes'
assert_fail 'pakro bootstrap dotfiles machines'
assert_fail 'pakro bootstrap dotfiles history purge'
assert_succeed 'pakro bootstrap dotfiles track ~/.tracked'
repository="$PAKRO_STATE_DIR/history/repo.git"
assert "git --git-dir=$repository for-each-ref --format='%(refname)' refs/pakro-history refs/machines refs/setup refs/promoted refs/checkpoints" ''
assert_not_contains 'pakro bootstrap dotfiles status' 'backup'
