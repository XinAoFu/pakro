#!/usr/bin/env bash

mkdir -p "$HOME/.config/pakro"
cat >"$HOME/.config/pakro/config.toml" <<'TOML'
[env]
LOCAL_ONLY = "true"
TOML
cat >"$HOME/.config/pakro/config-global.toml" <<'TOML'
[env]
GLOBAL_ONLY = "true"
TOML
export PAKRO_GLOBAL_CONFIG_FILE="$HOME/.config/pakro/config-global.toml"

cd "$HOME" || exit 1

assert "pakro set FOO=bar" ""
assert_contains "cat $HOME/.config/pakro/config-global.toml" 'FOO = "bar"'
assert_not_contains "cat $HOME/.config/pakro/config.toml" "FOO"

assert "pakro unset FOO" ""
assert_not_contains "cat $HOME/.config/pakro/config-global.toml" "FOO"

assert_contains "pakro use dummy@system" "pakro ~/.config/pakro/config-global.toml tools: dummy@system"
assert_contains "cat $HOME/.config/pakro/config-global.toml" 'dummy = "system"'
assert_not_contains "cat $HOME/.config/pakro/config.toml" "dummy"

assert_contains "pakro unuse -y dummy 2>&1" "pakro removed: dummy from ~/.config/pakro/config-global.toml"
assert_not_contains "cat $HOME/.config/pakro/config-global.toml" "dummy"
