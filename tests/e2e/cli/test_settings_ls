#!/usr/bin/env bash

echo "settings.all_compile = false" >pakro.toml
echo 'settings.disable_backends = ["rust", "java"]' >>pakro.toml

assert_contains "pakro settings" 'all_compile       false            ~/workdir/pakro.toml
disable_backends  ["rust", "java"] ~/workdir/pakro.toml'

assert_contains "pakro settings --json" '{
  "all_compile": false,
  "disable_backends": [
    "rust",
    "java"
  ]
}'

assert_contains "pakro settings --toml" 'all_compile = false
disable_backends = ["rust", "java"]'

assert_contains "pakro settings --json-extended" "{
  \"all_compile\": {
    \"value\": false,
    \"type\": \"boolean\",
    \"description\": \"do not use precompiled binaries for any tool\",
    \"source\": \"$HOME/workdir/pakro.toml\"
  },
  \"disable_backends\": {
    \"value\": [
      \"rust\",
      \"java\"
    ],
    \"type\": \"array\",
    \"description\": \"Backends to exclude from tool resolution and new installs, such as \`asdf\` or \`cargo\`. Existing installations are left on disk and become available again if the backend is re-enabled.\",
    \"source\": \"$HOME/workdir/pakro.toml\"
  }
}"

assert_contains "pakro settings ls -T" "all_compile = false"

cat >>pakro.toml <<'EOF'

[settings.task.cache]
remote_mode = "read-only"
remote_url = "https://cache.example.test"
EOF

assert_contains "pakro settings ls task.cache" "task.cache.remote_mode"
assert_contains "pakro settings ls task.cache" "task.cache.remote_url"
assert "pakro settings ls task.cache --json | jq -r '.task.cache.remote_url'" \
  "https://cache.example.test"
assert "pakro settings ls task.cache --json-extended | jq -r '.task.cache.remote_mode.value'" \
  "read-only"
assert_contains "pakro settings ls task.cache --toml" "[task.cache]"
