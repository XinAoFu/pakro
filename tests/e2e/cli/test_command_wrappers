#!/usr/bin/env bash

fake_bin="$HOME/wrapper-bin"
mkdir -p "$fake_bin"
cat >"$fake_bin/mbx" <<'EOF'
#!/usr/bin/env bash
printf 'mbx:%s\n' "$MBX_CARGO_SHIM_MODE"
exec cargo "$@"
EOF
cat >"$fake_bin/cargo" <<'EOF'
#!/usr/bin/env bash
echo system-cargo
EOF
chmod +x "$fake_bin/mbx" "$fake_bin/cargo"
export PATH="$fake_bin:$PATH"

cat >pakro.toml <<'EOF'
[wrappers.cargo]
command = "mbx"
env = { MBX_CARGO_SHIM_MODE = "1" }
EOF

pakro reshim
assert_contains "pakro hook-env -s bash --force" "$PAKRO_DATA_DIR/command-wrappers/bin"
assert_contains "pakro activate bash --shims" "$PAKRO_DATA_DIR/command-wrappers/bin"
eval "$(pakro activate bash --shims)"
eval "$(pakro activate bash --shims)"
assert "printf '%s\n' \"\$PATH\" | tr ':' '\n' | grep -cx '$PAKRO_DATA_DIR/command-wrappers/bin'" "1"
assert "printf '%s\n' \"\$PATH\" | tr ':' '\n' | grep -cx '$PAKRO_DATA_DIR/shims'" "1"
assert "pakro x -- cargo check" "mbx:1
system-cargo"
assert "cargo check" "mbx:1
system-cargo"

# Windows exe- and file-mode shims do not run pakro as cargo. They run
# `pakro x -- cargo` with __PAKRO_SHIM_PATH naming themselves, which used to skip
# the wrapper's own shim as the active one and run the real cargo (#13671).
assert "__PAKRO_SHIM_PATH='$PAKRO_DATA_DIR/command-wrappers/bin/cargo' pakro x -- cargo check" "mbx:1
system-cargo"
assert "__PAKRO_SHIM_PATH='$PAKRO_DATA_DIR/shims/cargo' pakro x -- cargo check" "mbx:1
system-cargo"

# Disabling tool shim activation preserves configured wrappers.
export PAKRO_ACTIVATE_SHIMS=false
eval "$(pakro activate bash --no-hook-env)"
eval "$(pakro hook-env -s bash --force)"
case ":$PATH:" in
  *":$PAKRO_DATA_DIR/shims:"*) exit 1 ;;
esac
assert "cargo check" "mbx:1
system-cargo"
unset PAKRO_ACTIVATE_SHIMS

pakro install dummy@1.0.0
managed_bin="$PAKRO_DATA_DIR/installs/dummy/1.0.0/bin"
cat >"$managed_bin/cargo" <<'EOF'
#!/usr/bin/env bash
echo managed-cargo
EOF
chmod +x "$managed_bin/cargo"
cat >>pakro.toml <<'EOF'

[tools]
dummy = "1.0.0"
EOF

pakro reshim
assert "pakro x -- cargo check" "mbx:1
managed-cargo"
assert "cargo check" "mbx:1
managed-cargo"

cat >pakro.toml <<'EOF'
[wrappers]
cargo = "mbx"
EOF
pakro reshim
assert "cargo check" "mbx:
system-cargo"

cat >pakro.toml <<'EOF'
[wrappers.cargo]
command = "mbx"
args = ["--fixed"]
EOF
cat >"$fake_bin/mbx" <<'EOF'
#!/usr/bin/env bash
echo "$*"
EOF
chmod +x "$fake_bin/mbx"
pakro reshim
assert "cargo check" "--fixed check"

cat >pakro.toml <<'EOF'
[wrappers]
other = "mbx"
EOF
pakro reshim
assert_fail "test -e '$PAKRO_DATA_DIR/command-wrappers/bin/cargo'"

cat >pakro.toml <<'EOF'
[wrappers]
cargo = " "
EOF
assert_fail "pakro reshim" "must have a non-blank command"

cat >pakro.toml <<'EOF'
[tools]
dummy = "1.0.0"
EOF
pakro reshim
assert_fail "test -e '$PAKRO_DATA_DIR/command-wrappers/bin'"
