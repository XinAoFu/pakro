#!/usr/bin/env bash

assert "pakro alias set tiny xxx 2"
assert_contains "pakro alias ls tiny" "tiny  xxx 2"
assert "pakro alias unset tiny xxx"
assert_not_contains "pakro alias ls" "tiny  xxx"

assert "pakro alias set nushell aqua:nushell/nushell"
assert "pakro x nushell -- nu --version"

# comments around an alias survive the value being replaced
# See: https://github.com/jdx/mise/discussions/4797
printf '[tool_alias.tiny.versions]\n# keep this comment\nxxx = "1" # keep me\n' >"$PAKRO_CONFIG_DIR/config.toml"
assert "pakro alias set tiny xxx 2"
assert "cat '$PAKRO_CONFIG_DIR/config.toml'" '[tool_alias.tiny.versions]
# keep this comment
xxx = "2" # keep me'
