#!/usr/bin/env bash
# PAKRO_TERM_WIDTH (and the conventional COLUMNS fallback) override the terminal
# width used to render tables/lists such as `pakro registry`. See discussion #4109.
#
# The assertions are content-independent: they check the width of the rendered
# lines rather than any specific registry entry, so they don't break when the
# registry contents change.

# awk program: emits "narrow" when the widest rendered line is <= 45 chars,
# otherwise "wide". (A narrow override caps every line; a wide one leaves the
# naturally long backends rows intact.)
maxw="awk '{ if (length > m) m = length } END { print (m <= 45 ? \"narrow\" : \"wide\") }'"

# A narrow override caps the table width.
assert "PAKRO_TERM_WIDTH=40 pakro registry | $maxw" "narrow"

# A wide override leaves long rows un-truncated, proving the override applies.
assert "PAKRO_TERM_WIDTH=400 pakro registry | $maxw" "wide"

# COLUMNS is honored as a fallback when PAKRO_TERM_WIDTH is unset.
assert "COLUMNS=40 pakro registry | $maxw" "narrow"

# PAKRO_TERM_WIDTH takes precedence over COLUMNS.
assert "PAKRO_TERM_WIDTH=400 COLUMNS=40 pakro registry | $maxw" "wide"

# Only commands that opt into truncation expose the command-local flag.
assert_fail "pakro registry --no-truncate" "unexpected argument '--no-truncate'"

cat <<'EOF' >pakro.toml
[dotfiles."~/.config/example/a-very-long-directory-name/a-very-long-file-name.toml"]
content = "example"
EOF

# Human output is compact by default. The command flag, environment setting,
# and agent detection all preserve complete table cells.
assert_contains "PAKRO_TERM_WIDTH=40 pakro bootstrap dotfiles status" "..."
assert_not_contains "PAKRO_TERM_WIDTH=40 pakro bootstrap dotfiles status --no-truncate" "..."
assert_not_contains "PAKRO_TRUNCATE=0 PAKRO_TERM_WIDTH=40 pakro bootstrap dotfiles status" "..."
assert_not_contains "AI_AGENT=test PAKRO_TERM_WIDTH=40 pakro bootstrap dotfiles status" "..."
assert_not_contains "CODEX_THREAD_ID=test PAKRO_TERM_WIDTH=40 pakro bootstrap dotfiles status" "..."

# A command-line value outranks the configured or environment value. usage-rs
# tracks whether either spelling was actually present, so an absent flag does
# not mask settings.truncate.
assert_contains "PAKRO_TRUNCATE=0 PAKRO_TERM_WIDTH=40 pakro bootstrap dotfiles status --truncate" "..."

cat <<'EOF' >>pakro.toml

[settings]
truncate = false
EOF
assert_not_contains "PAKRO_TERM_WIDTH=40 pakro bootstrap dotfiles status" "..."
assert_contains "PAKRO_TERM_WIDTH=40 pakro bootstrap dotfiles status --truncate" "..."
