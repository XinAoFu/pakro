#!/usr/bin/env bash
# Browsing and restoring ordinary Git commits, with a disposable derived index.
require_cmd git
repository="$PAKRO_STATE_DIR/history/repo.git"
echo one >~/.history-file
assert_succeed 'pakro bootstrap dotfiles track ~/.history-file'
first=$(git --git-dir="$repository" rev-parse HEAD)
assert_contains 'pakro bootstrap dotfiles save 2>&1' 'nothing changed'
echo two >~/.history-file
assert_succeed 'pakro bootstrap dotfiles save --description second'
second=$(git --git-dir="$repository" rev-parse HEAD)
assert "pakro bootstrap dotfiles history show latest --json | jq -r .uuid" "$second"
assert "pakro bootstrap dotfiles history show latest --json | jq -r .changes.since" "$first"
echo three >~/.history-file
assert_contains 'pakro bootstrap dotfiles history diff --patch --path ~/.history-file' '+three'
assert_fail 'pakro bootstrap dotfiles history diff --exit-code'
assert_contains "pakro bootstrap dotfiles history diff $first $second --patch" '+two'
assert_fail 'pakro bootstrap dotfiles history show 999999'
assert_succeed "pakro bootstrap dotfiles history describe $second 'the second version'"
assert "pakro bootstrap dotfiles history show $second --json | jq -r .description" 'the second version'
assert "git --git-dir=$repository for-each-ref --format='%(refname)' refs/notes" ''
assert_succeed "pakro bootstrap dotfiles rollback ~/.history-file --to $first --yes"
assert 'cat ~/.history-file' one
assert_succeed 'pakro bootstrap dotfiles undo --yes'
assert 'cat ~/.history-file' three
mv "$PAKRO_STATE_DIR/history/index" "$PAKRO_STATE_DIR/history/old-index"
assert "pakro bootstrap dotfiles history show $second --json | jq -r .description" 'the second version'
assert_succeed "git --git-dir=$repository merge-base --is-ancestor $first HEAD"
assert_succeed "git --git-dir=$repository fsck --no-progress"
assert_fail 'PAKRO_HISTORY_ENABLED=0 pakro bootstrap dotfiles save' 'history is disabled'
