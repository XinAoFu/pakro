#!/usr/bin/env bash

eval "$(pakro activate bash)"
export PATH="/added:$PATH"

assert "pakro hook-env -s bash --trace" "" # checking early exit functions
mkdir -p "$PAKRO_DATA_DIR/installs/dummy/1.0.0/bin"
echo "#!/usr/bin/env bash" >"$PAKRO_DATA_DIR/installs/dummy/1.0.0/bin/dummy"
chmod +x "$PAKRO_DATA_DIR/installs/dummy/1.0.0/bin/dummy"
echo "tools.dummy = '1'" >pakro.toml
assert_contains "pakro hook-env -s bash --trace" "export PATH='/added:$PAKRO_DATA_DIR/installs/dummy/1.0.0/bin:"
export PAKRO_ACTIVATE_AGGRESSIVE=1
assert_contains "pakro hook-env -s bash --trace" "export PATH='$PAKRO_DATA_DIR/installs/dummy/1.0.0/bin:$PAKRO_DATA_DIR/shims:/added:"
