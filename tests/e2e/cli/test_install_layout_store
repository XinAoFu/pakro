#!/usr/bin/env bash
# A separate install store (the default on Windows, where it is <data>\i): the
# installations live in PAKRO_INSTALL_STORE_DIR, while the version links, runtime
# aliases and the catalog stay in the installs directory.
export PAKRO_EXPERIMENTAL=1
export PAKRO_INSTALL_LAYOUT=identity
export PAKRO_INSTALL_STORE_DIR="$PAKRO_DATA_DIR/i"

installs="$PAKRO_DATA_DIR/installs"
store="$PAKRO_INSTALL_STORE_DIR"

assert "pakro install dummy@1.1.0 dummy@2.0.0"
dir_1="$(pakro where dummy@1.1.0)"
dir_2="$(pakro where dummy@2.0.0)"
name_1="$(basename "$dir_1")"
name_2="$(basename "$dir_2")"

echo "=== installations go in the store ==="
assert_matches "pakro where dummy@1.1.0" "^$store/dummy-[a-z2-7]{8}\$"
assert "test -f '$dir_1/.pakro-install.toml'"
assert "test ! -e '$installs/$name_1'"

echo "=== links, aliases and the catalog stay in the installs directory ==="
assert "readlink '$installs/dummy/1.1.0'" "../../i/$name_1"
assert "readlink '$installs/dummy/2.0.0'" "../../i/$name_2"
assert "readlink '$installs/dummy/latest'" "./2.0.0"
assert_contains "$installs/dummy/latest/bin/dummy" "This is Dummy 2.0.0!"
assert "test -f '$installs/.pakro/names/$name_1'"
assert "test ! -e '$store/.pakro'"

echo "=== listing and PATH see through the store ==="
assert_contains "pakro ls dummy" "1.1.0"
assert_contains "pakro ls dummy" "2.0.0"
assert_not_contains "pakro ls" "dummy-"
echo 'tools.dummy = "1"' >pakro.toml
assert "pakro which dummy" "$installs/dummy/1/bin/dummy"
assert_contains "pakro x -- dummy" "This is Dummy 1.1.0!"

echo "=== a lost catalog is rebuilt from the store's receipts ==="
rm -rf "$installs/.pakro"
assert_contains "pakro ls dummy" "1.1.0"
assert "test -f '$installs/.pakro/names/$name_1'"
assert "pakro where dummy@1.1.0" "$dir_1"

echo "=== uninstall and prune remove the installation and its links ==="
assert "pakro uninstall dummy@2.0.0"
assert "test ! -e '$dir_2'"
assert "test ! -L '$installs/dummy/2.0.0'"
assert "test -d '$dir_1'"
rm pakro.toml
assert "pakro prune --yes dummy"
assert "test ! -e '$dir_1'"
assert "test ! -L '$installs/dummy/1.1.0'"

echo "=== a reinstall lands in the same directory ==="
assert "pakro install dummy@1.1.0"
assert "pakro where dummy@1.1.0" "$dir_1"

echo "=== a store inside the installs directory is ignored ==="
assert "PAKRO_INSTALL_STORE_DIR='$installs/dummy/store' pakro install dummy@2.0.0"
assert_matches "PAKRO_INSTALL_STORE_DIR='$installs/dummy/store' pakro where dummy@2.0.0" "^$installs/dummy-[a-z2-7]{8}\$"
assert "test ! -e '$installs/dummy/store'"

echo "=== installs directories sharing a store share its installations ==="
other="$HOME/other-installs"
assert "PAKRO_INSTALLS_DIR='$other' pakro install dummy@1.1.0"
assert "PAKRO_INSTALLS_DIR='$other' pakro where dummy@1.1.0" "$dir_1"
assert "readlink '$other/dummy/1.1.0'" "$dir_1"

echo "=== the store written through the installs directory is still the store ==="
beside="$(PAKRO_INSTALL_STORE_DIR="$installs/../i" pakro where dummy@1.1.0)"
assert "realpath '$beside'" "$(realpath "$dir_1")"
