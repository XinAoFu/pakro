#!/usr/bin/env bash

mkdir -p fakebin source bin "bin with space" shared-target/nested "$HOME/.config/pakro" "$HOME/.local/bin"
ssh_log="$PWD/ssh.log"
remote_stage="/tmp/pakro-bootstrap.e2e-$$"
bad_remote_stage="$remote_stage invalid"
pakro_bin=$(command -v pakro)
bootstrap_marker="$PWD/bootstrap-command-ran"
installer="$PWD/install-pakro"
export SSH_LOG="$ssh_log"
export REMOTE_STAGE="$remote_stage"
export BAD_REMOTE_STAGE="$bad_remote_stage"
export BOOTSTRAP_MARKER="$bootstrap_marker"
export PAKRO_SOURCE="$pakro_bin"

cat >bin/pakro <<'EOF'
#!/bin/sh
exec "$PAKRO_SOURCE" "$@"
EOF
chmod 700 bin/pakro
cp bin/pakro "bin with space/pakro"

cat >"$HOME/.local/bin/pakro" <<'EOF'
#!/bin/sh
if test "${1:-}" = "--cd" && test "${PAKRO_ENV:-}" = "unexpected"; then
  echo "inherited remote PAKRO_ENV was not cleared" >&2
  exit 43
fi
if test "${1:-}" = "--cd" && test -e "$2/layered-secret"; then
  echo "layered remote exclude was not applied" >&2
  exit 42
fi
exec "$PAKRO_SOURCE" "$@"
EOF
chmod 700 "$HOME/.local/bin/pakro"
touch layered-secret
echo shared >shared-target/value
ln -s ../value shared-target/nested/value-link
ln -s ../shared-target source/shared

cat >fakebin/ssh <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >>"$SSH_LOG"
while test "$#" -gt 0; do
  case "$1" in
  -o | -p | -i | -S)
    shift 2
    ;;
  -tt)
    shift
    ;;
  -O)
    exit 0
    ;;
  *)
    destination=$1
    shift
    command=$1
    if test "$destination" = cross.test; then
      export PAKRO_TEST_REMOTE_ARCH=armv7l
    fi
    exec sh -c "$command"
    ;;
  esac
done
EOF
chmod +x fakebin/ssh

cat >fakebin/uname <<'EOF'
#!/bin/sh
if test "${PAKRO_TEST_REMOTE_ARCH:-}" && test "${1:-}" = -m; then
  printf '%s\n' "$PAKRO_TEST_REMOTE_ARCH"
else
  PATH=/usr/bin:/bin command uname "$@"
fi
EOF
chmod +x fakebin/uname

cat >fakebin/mktemp <<'EOF'
#!/bin/sh
# only the bootstrap staging directory is faked; other callers get real mktemp
case "${2:-}" in
/tmp/pakro-bootstrap.*) ;;
*)
  PATH=/usr/bin:/bin command mktemp "$@"
  exit $?
  ;;
esac
if test "${PAKRO_TEST_BAD_STAGE:-}" = 1; then
  mkdir -p "$BAD_REMOTE_STAGE"
  printf '%s\n' "$BAD_REMOTE_STAGE"
  exit 0
fi
mkdir -p "$REMOTE_STAGE"
printf '%s\n' "$REMOTE_STAGE"
EOF
chmod +x fakebin/mktemp
export PATH="$PWD/fakebin:$PATH"

cat >"$installer" <<'EOF'
touch "$BOOTSTRAP_MARKER"
mkdir -p "$REMOTE_STAGE/bin with space"
cp "$PAKRO_SOURCE" "$REMOTE_STAGE/bin with space/pakro"
chmod 700 "$REMOTE_STAGE/bin with space/pakro"
PATH=/usr/bin:/bin
printf 'export PATH="$PATH:%s"\n' "$REMOTE_STAGE/bin with space" >>"$HOME/.profile"
EOF

cat >source/pakro.toml <<EOF
[bootstrap.remote]
source = "."
exclude = ["generated", "layered-secret"]
pakro_env = ["default", "linux"]

[bootstrap.remote.hosts.cache]
host = "example.test"
user = "ubuntu"
tags = ["cache", "production"]
remote_pakro = "pakro"
pakro_env = ["server", "linux"]

[bootstrap.remote.hosts.relative]
host = "relative.test"
remote_pakro = "./bin/pakro"

[bootstrap.remote.hosts.installer]
host = "installer.test"
bootstrap_command = ". $installer"

[bootstrap.remote.hosts.copy-links]
host = "copy-links.test"
source = "source"
copy_link = ["shared"]
remote_pakro = "$pakro_bin"
EOF

cat >"$HOME/.config/pakro/config.toml" <<'EOF'
[bootstrap.remote.hosts.layered]
host = "layered.test"
remote_pakro = "~/.local/bin/pakro"
EOF

cp source/pakro.toml pakro.toml
assert_fail "PAKRO_TEST_BAD_STAGE=1 pakro bootstrap remote cache --dry-run --yes --skip tools"
assert_fail "test -d '$bad_remote_stage'"

assert_succeed "pakro bootstrap remote cache --dry-run --yes --skip tools"
assert_contains "cat $ssh_log" "ubuntu@example.test"
assert_contains "cat $ssh_log" "PAKRO_ENV=server,linux"
assert_contains "cat $ssh_log" "bootstrap --dry-run --yes --skip tools"
assert_fail "test -d $remote_stage"

copy_link_stage="$remote_stage-copy-link"
assert_succeed "REMOTE_STAGE=$copy_link_stage pakro bootstrap remote copy-links --dry-run --yes --keep-staging"
assert_succeed "test -d $copy_link_stage/project/shared"
assert_fail "test -L $copy_link_stage/project/shared"
assert "cat $copy_link_stage/project/shared/value" "shared"
assert_succeed "test -L $copy_link_stage/project/shared/nested/value-link"

copy_links_stage="$remote_stage-copy-links"
assert_succeed "REMOTE_STAGE=$copy_links_stage pakro bootstrap remote copy-links --copy-links --dry-run --yes --keep-staging"
assert_succeed "test -d $copy_links_stage/project/shared"
assert_fail "test -L $copy_links_stage/project/shared"
assert_succeed "test -f $copy_links_stage/project/shared/nested/value-link"
assert_fail "test -L $copy_links_stage/project/shared/nested/value-link"

: >"$ssh_log"
assert_succeed "pakro bootstrap remote relative --dry-run --yes"
assert_contains "cat $ssh_log" "$remote_stage/project/bin/pakro version"
assert_contains "cat $ssh_log" "PAKRO_ENV=default,linux"
assert_fail "test -d $remote_stage"

: >"$ssh_log"
assert_succeed "pakro bootstrap remote cache --remote-env ci,dotfiles --dry-run --yes"
assert_contains "cat $ssh_log" "PAKRO_ENV=ci,dotfiles"
assert_not_contains "cat $ssh_log" "PAKRO_ENV=server,linux"

: >"$ssh_log"
assert_succeed "pakro bootstrap remote relative --all --dry-run --yes"
assert \
  "grep \"sh -c 'set -eu\" $ssh_log | awk '{ for (i = 1; i <= NF; i++) if (\$i ~ /\\.test$/) print \$i }'" \
  $'relative.test\nubuntu@example.test\ninstaller.test\ncopy-links.test\nlayered.test'
assert_fail "test -d $remote_stage"

: >"$ssh_log"
assert_succeed "pakro bootstrap remote layered --dry-run --yes"
assert_contains "cat $ssh_log" "$HOME/.local/bin/pakro version"

: >"$ssh_log"
assert_succeed "PAKRO_ENV=unexpected pakro bootstrap remote layered --dry-run --yes"
assert_contains "cat $ssh_log" "'PAKRO_ENV=' $HOME/.local/bin/pakro --cd"
assert_not_contains "cat $ssh_log" "PAKRO_ENV=unexpected"

: >"$ssh_log"
assert_succeed "pakro bootstrap remote --host root@ad-hoc.test --source . --remote-pakro $HOME/.local/bin/pakro --dry-run --yes"
assert_contains "cat $ssh_log" "root@ad-hoc.test"
assert_contains "cat $ssh_log" "bootstrap --dry-run --yes"
assert_fail "test -d $remote_stage"

: >"$ssh_log"
assert_succeed "pakro bootstrap remote --tag cache --dry-run --yes"
assert_contains "cat $ssh_log" "ubuntu@example.test"

: >"$ssh_log"
assert_succeed "pakro bootstrap remote installer --dry-run --yes"
assert_fail "test -e $bootstrap_marker"

mv "$HOME/.local/bin/pakro" "$HOME/.local/bin/pakro.saved"
if test -f "$HOME/.profile"; then
  cp "$HOME/.profile" "$PWD/profile-before-installer"
  touch "$PWD/profile-existed"
else
  : >"$PWD/profile-before-installer"
fi
mkdir -p "$PWD/stale-bin"
cat >"$PWD/stale-bin/pakro" <<'EOF'
#!/bin/sh
if test "${1:-}" = version; then
  echo "0.0.1 linux-x64"
  exit 0
fi
echo "stale pakro was selected" >&2
exit 99
EOF
chmod 700 "$PWD/stale-bin/pakro"
literal_dollar='$'
printf 'export PATH="%sPATH:%s"\n' "$literal_dollar" "$PWD/stale-bin" >>"$HOME/.profile"
assert_succeed "pakro bootstrap remote installer --yes"
mv "$HOME/.local/bin/pakro.saved" "$HOME/.local/bin/pakro"
assert_succeed "test -e $bootstrap_marker"
assert_contains "cat $ssh_log" "sh -lc"
assert_contains "cat $ssh_log" "'$remote_stage/bin with space/pakro' version"
assert_not_contains "cat $ssh_log" "'$PWD/stale-bin/pakro' --cd"
if test -e "$PWD/profile-existed"; then
  cp "$PWD/profile-before-installer" "$HOME/.profile"
else
  rm -f "$HOME/.profile"
fi

cat >>pakro.toml <<'EOF'

[bootstrap.remote.hosts.spaced]
host = "spaced.test"
remote_pakro = "./bin with space/pakro"

[bootstrap.remote.hosts.cross]
host = "cross.test"
EOF

: >"$ssh_log"
assert_succeed "pakro bootstrap remote spaced --dry-run --yes"
assert_contains "cat $ssh_log" "'$remote_stage/project/bin with space/pakro' version"
assert_fail "test -d $remote_stage"

: >"$ssh_log"
assert_fail "pakro bootstrap remote cross --dry-run --yes --skip tools"
assert_contains "cat $ssh_log" "uname -s"
assert_fail "test -d $remote_stage"

# install_pakro keeps the provisioned executable after the staging directory is
# removed. The target lives outside the archived source so the installed binary
# is not sent back to the host on the next run.
install_target="$HOME/installed bin/pakro"

: >"$ssh_log"
assert_contains \
  "pakro bootstrap remote --host install.test --source . --pakro-bin bin/pakro --install-pakro='$install_target' --dry-run --yes 2>&1" \
  "would install pakro to $install_target"
assert_fail "test -e '$install_target'"

: >"$ssh_log"
assert_succeed "pakro bootstrap remote --host install.test --source . --pakro-bin bin/pakro --install-pakro='$install_target' --yes --skip tools"
assert_succeed "test -x '$install_target'"
assert_succeed "'$install_target' version"
assert_contains "cat $ssh_log" "pakro-install"
assert_contains "cat $ssh_log" "'$install_target' --cd"
assert_fail "test -d $remote_stage"

: >"$ssh_log"
assert_succeed "pakro bootstrap remote --host install.test --source . --pakro-bin bin/pakro --install-pakro='$install_target' --yes --skip tools"
assert_not_contains "cat $ssh_log" "pakro-install"
assert_contains "cat $ssh_log" "'$install_target' --cd"

assert_fail "pakro bootstrap remote --host install.test --source . --pakro-bin bin/pakro --install-pakro=relative/pakro --yes"
assert_fail "pakro bootstrap remote --host install.test --source . --install-pakro --remote-pakro pakro --yes"
assert_fail "pakro bootstrap remote --host install.test --source . --pakro-bin bin/pakro --install-pakro='$HOME/installed bin' --yes --skip tools"

# a command-line install replaces the strategy the inventory host declared
: >"$ssh_log"
assert_contains \
  "pakro bootstrap remote cache --pakro-bin bin/pakro --install-pakro='$install_target' --dry-run --yes --skip tools 2>&1" \
  "would install pakro to $install_target"

cat >>pakro.toml <<'EOF'

[bootstrap.remote.hosts.self-install]
host = "self-install.test"
install_pakro = true
pakro_bin = "bin/pakro"
EOF

: >"$ssh_log"
assert_succeed "pakro bootstrap remote self-install --yes --skip tools"
assert_succeed "cmp -s bin/pakro $HOME/.local/bin/pakro"
assert_contains "cat $ssh_log" "$HOME/.local/bin/pakro --cd"

: >"$ssh_log"
assert_succeed "pakro bootstrap remote self-install --no-install-pakro --dry-run --yes"
assert_contains "cat $ssh_log" "$remote_stage/pakro version"

cat >>"$HOME/.config/pakro/config.toml" <<'EOF'

[bootstrap.remote.hosts.stale]
host = "-invalid"
identity_file = "/definitely/missing/identity"
EOF

: >"$ssh_log"
assert_succeed "pakro bootstrap remote cache --dry-run --yes --skip tools"
assert_succeed "pakro bootstrap remote --host ad-hoc.test --source source --remote-pakro $pakro_bin --dry-run --yes"
: >"$ssh_log"
assert_fail "pakro bootstrap remote cache stale --dry-run --yes"
assert_fail "grep example.test $ssh_log"
assert_fail "grep -- -invalid $ssh_log"
