#!/usr/bin/env bash

echo '[settings]
idiomatic_version_file_enable_tools = [
"go", "ruby"
]



[env]
TEST = "Hello World!"
' >pakro.toml
assert_fail "pakro fmt --check" "pakro ERROR Following config files are not properly formatted"

pakro fmt
assert "pakro fmt --check"
assert "cat pakro.toml" '[settings]
idiomatic_version_file_enable_tools = ["go", "ruby"]


[env]
TEST = "Hello World!"'

# Lists whose order carries no meaning are sorted; file patterns sort by reach
# (groups, globs, then literal paths), and a list that excludes with `!` keeps
# its order.
echo 'redactions = ["TOKEN", "API_KEY"]

[task_config]
global_inputs = ["pakro.toml", "@group:lockfiles"]

[task_config.input_groups]
lockfiles = ["pnpm-lock.yaml", "Cargo.lock"]

[tasks.build]
sources = ["src/main.rs", "Cargo.toml", "@group:rust", "src/**/*.rs"]
outputs = ["dist", "!dist/**/*.map"]
' >pakro.toml
assert_fail "pakro fmt --check" "pakro ERROR Following config files are not properly formatted"

pakro fmt
assert "pakro fmt --check"
assert "cat pakro.toml" 'redactions = ["API_KEY", "TOKEN"]

[task_config]
global_inputs = ["@group:lockfiles", "pakro.toml"]

[task_config.input_groups]
lockfiles = ["Cargo.lock", "pnpm-lock.yaml"]

[tasks.build]
sources = ["@group:rust", "src/**/*.rs", "Cargo.toml", "src/main.rs"]
outputs = ["dist", "!dist/**/*.map"]'
