#!/usr/bin/env bash

# Test for cross-platform lockfile generation
# This tests that pakro lock can generate platform-specific URLs for all platforms
# even when running on a different platform (e.g., generating linux URLs from macOS)

export PAKRO_LOCKFILE=1

echo "=== Testing cross-platform URL generation ==="

# Create a pakro.toml with an aqua tool
cat <<EOF >pakro.toml
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

rm -f pakro.lock

# Generate lockfile for all default platforms
pakro lock

echo "Generated lockfile:"
cat pakro.lock

# Verify each platform has correct URLs
# jq uses different filenames for each platform
assert_contains "cat pakro.lock" "jq-linux-amd64"
assert_contains "cat pakro.lock" "jq-linux-arm64"
assert_contains "cat pakro.lock" "jq-macos-amd64"
assert_contains "cat pakro.lock" "jq-macos-arm64"
assert_contains "cat pakro.lock" "jq-windows-amd64.exe"

# Verify all 5 default platforms are present
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_contains "cat pakro.lock" "platforms.linux-arm64"
assert_contains "cat pakro.lock" "platforms.macos-x64"
assert_contains "cat pakro.lock" "platforms.macos-arm64"
assert_contains "cat pakro.lock" "platforms.windows-x64"

echo "=== Testing selective platform generation ==="
rm -f pakro.lock

# Generate only for specific platforms
pakro lock --platform linux-x64,windows-x64

# Should only have the requested platforms
assert_contains "cat pakro.lock" "platforms.linux-x64"
assert_contains "cat pakro.lock" "platforms.windows-x64"
assert_not_contains "cat pakro.lock" "platforms.macos-arm64"
assert_not_contains "cat pakro.lock" "platforms.macos-x64"

echo "=== Testing URL validity ==="
rm -f pakro.lock
pakro lock --platform linux-x64

# URLs should be proper GitHub release URLs
assert_contains "cat pakro.lock" "https://github.com/jqlang/jq/releases/download"

echo "=== Cleanup ==="
rm -f pakro.lock pakro.toml

echo "Cross-platform lockfile tests passed!"
