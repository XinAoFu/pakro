#!/usr/bin/env bash
# e2e:non-root
export PAKRO_EXPERIMENTAL=1
if [[ -z ${PAKRO_TEST_PITCHFORK:-} ]]; then
  pakro install pitchfork@2.27.0 --minimum-release-age 0s
  PAKRO_TEST_PITCHFORK="$(pakro which pitchfork --tool pitchfork@2.27.0)"
fi
export PITCHFORK_STATE_DIR="$TMPDIR/pf"
export PITCHFORK_CONFIG_DIR="$TMPDIR/pf-config"
export PITCHFORK_PROXY_ENABLE=false
cp "$PAKRO_TEST_PITCHFORK" ~/bin/pitchfork
export PATH="$HOME/bin:$PATH"
trap 'pitchfork supervisor stop >/dev/null 2>&1 || true' EXIT
mkdir -p "$PAKRO_CONFIG_DIR" project
pg_port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
cat >"$PAKRO_CONFIG_DIR/config.toml" <<TOML
[daemon_providers.pg]
preset = "postgres"
version = "18"
port = $pg_port
TOML
cd project
cat >pakro.toml <<'TOML'
[tools]
pitchfork = "system"
[env]
PGPORT = "1"
PGDATA = "/nonexistent/consumer-data"
[daemons.local]
run = "exec sleep 600"
ready_delay = 0
TOML
pakro daemons providers start pg
assert_contains 'pakro daemons providers ls --json' '"status": "running"'
# Another project's environment cannot redirect provider management.
mkdir ../elsewhere
printf '[env]\nPITCHFORK_STATE_DIR = "/nonexistent/pf"\n' >../elsewhere/pakro.toml
assert_contains 'cd ../elsewhere && pakro daemons providers ls --json' '"status": "running"'
pid=$(pitchfork status pakro-provider-pg/server --json | jq -r .pid)
assert "test -f '$PAKRO_STATE_DIR/daemon-providers/pg/data/PG_VERSION'"
pakro daemons start
pakro daemons stop
assert "kill -0 '$pid'"
# Starting from a different profile cannot mutate the server's environment.
PAKRO_ENV=other pakro daemons providers start pg
assert "test '$pid' = \"$(pitchfork status pakro-provider-pg/server --json | jq -r .pid)\""
cat >>"$PAKRO_CONFIG_DIR/config.toml" <<'TOML'
options.database = "added"
TOML
assert_contains 'pakro daemons providers start pg 2>&1 || true' 'configuration changed while running'
pakro daemons providers restart pg
assert_contains 'pakro daemons providers ls --json' '"status": "running"'
pid=$(pitchfork status pakro-provider-pg/server --json | jq -r .pid)
# Project Pitchfork settings must not redirect provider management.
cat >pakro.local.toml <<'TOML'
[env]
PITCHFORK_STATE_DIR = "/nonexistent/consumer-supervisor"
TOML
assert_contains 'pakro daemons providers ls --json' '"status": "running"'
# A project-controlled PATH cannot replace the recorded supervisor client.
mkdir fake-bin
printf '#!/bin/sh\nexit 42\n' >fake-bin/pitchfork
chmod +x fake-bin/pitchfork
PATH="$PWD/fake-bin:$PATH" pakro daemons providers start pg
PATH="$PWD/fake-bin:$PATH" assert_contains 'pakro daemons providers ls --json' '"status": "running"'
# Removing a declaration must leave its running server visible and stoppable.
printf '' >"$PAKRO_CONFIG_DIR/config.toml"
assert_contains 'pakro daemons providers ls --json' '"name": "pg"'
assert_fail 'pakro daemons providers start pg'
printf '{invalid' >"$PAKRO_STATE_DIR/daemon-providers/pg/definition.json"
assert_contains 'pakro daemons providers ls --json' '"name": "pg"'
pakro daemons providers stop pg
assert_fail "kill -0 '$pid'"
