#!/usr/bin/env bash

# An unconfigured registry bin is only installed when explicitly enabled.
assert_fail "pakro hook-not-found rtx-tiny"
assert_fail "pakro current tiny"

export PAKRO_NOT_FOUND_AUTO_INSTALL_REGISTRY=1
# Ambiguous bin metadata must not pick a tool arbitrarily.
assert_fail "pakro hook-not-found tsh"
assert_fail "pakro current teleport-community"
assert_fail "pakro current teleport-ent"

export PAKRO_AUTO_INSTALL_DISABLE_TOOLS=tiny
assert_fail "pakro hook-not-found rtx-tiny"
unset PAKRO_AUTO_INSTALL_DISABLE_TOOLS

pakro hook-not-found rtx-tiny
assert "pakro current tiny" "3.1.0"
assert_contains "cat $PAKRO_CONFIG_DIR/config.toml" 'tiny = "latest"'
