#!/usr/bin/env bash

# Test that env-specific tools are NOT installed when PAKRO_ENV is unset.
# Demonstrates that CI running `pakro install --locked` without PAKRO_ENV
# will not pick up dev tools from pakro.dev.toml.

export PAKRO_LOCKFILE=1

echo "=== Setup: create base + dev configs ==="

cat >pakro.toml <<'EOF'
[tools]
tiny = "1"
EOF

cat >pakro.dev.toml <<'EOF'
[tools]
"aqua:jqlang/jq" = "1.7.1"
EOF

rm -f pakro.lock pakro.dev.lock

# Generate lockfile with dev env active
assert "PAKRO_ENV=dev pakro lock --platform linux-x64"

# Verify base tool is in pakro.lock, NOT in pakro.dev.lock
assert_contains "cat pakro.lock" '[[tools.tiny]]'
assert_not_contains "cat pakro.lock" 'jqlang/jq'

# Verify dev tool is in pakro.dev.lock, NOT in pakro.lock
assert_contains "cat pakro.dev.lock" 'jqlang/jq'
assert_not_contains "cat pakro.dev.lock" '[[tools.tiny]]'

# Neither lockfile should have env fields
assert_not_contains "cat pakro.lock" 'env = '
assert_not_contains "cat pakro.dev.lock" 'env = '

echo "=== CI scenario: pakro install --locked without PAKRO_ENV ==="

# Simulate CI: no PAKRO_ENV set, only pakro.toml is loaded
# pakro ls should only show tiny, not jq
output=$(pakro ls 2>&1)
assert_contains "echo '$output'" "tiny"
assert_not_contains "echo '$output'" "jq"

echo "=== Verify: with PAKRO_ENV=dev, both tools are visible ==="

output=$(PAKRO_ENV=dev pakro ls 2>&1)
assert_contains "echo '$output'" "tiny"
assert_contains "echo '$output'" "jq"

echo "=== Cleanup ==="
rm -f pakro.lock pakro.dev.lock pakro.toml pakro.dev.toml

echo "pakro lock env CI isolation test passed!"
