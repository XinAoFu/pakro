#!/usr/bin/env bash

export PAKRO_SHIMS_DIR="$HOME/.local/share/pakro/user-shims"

# A lazy tool must install the first time a task runs one of its commands, the
# same way it does when the command is typed into an activated shell. Neither a
# shim farm on PATH nor a prior `pakro reshim` is required: a hand-edited
# `lazy = true` entry has no shim yet, and a task's shell has no
# command-not-found handler to fall back on (discussion #12678).
case ":$PATH:" in
  *":$PAKRO_SHIMS_DIR:"*) fail "expected user shims to be absent from PATH: $PATH" ;;
esac
pakro use tiny@1.0.0
assert_directory_exists "$PAKRO_DATA_DIR/installs/tiny/1.0.0"
# Edited by hand: nothing rebuilds the shim farm, so no `dummy` shim exists.
cat >pakro.toml <<'EOF'
[tools]
tiny = "1.0.0"
dummy = { version = "1.0.0", lazy = true, lazy_bins = ["dummy"] }

[tasks.check]
run = "dummy --version"
EOF
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/1.0.0'"
assert_fail "test -e '$PAKRO_SHIMS_DIR/dummy'"

# With a lazy declaration, the child PATH keeps the shim farm behind tool paths.
pakro_path="$(pakro env -s bash | sed -n 's/^export PATH=//p' | tr -d "'\"")"
case "$pakro_path" in
  "$PAKRO_DATA_DIR/installs/tiny/1.0.0/bin:$PAKRO_SHIMS_DIR:"*) ;;
  *) fail "expected tool paths, then the shim farm, then the rest: $pakro_path" ;;
esac

assert_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro run check" "This is Dummy 1.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/1.0.0"
assert_succeed "test -e '$PAKRO_SHIMS_DIR/dummy'"

# Once installed, the real bin directory precedes the farm.
pakro_path="$(pakro env -s bash | sed -n 's/^export PATH=//p' | tr -d "'\"")"
case "$pakro_path" in
  *"$PAKRO_DATA_DIR/installs/dummy/1.0.0/bin:"*"$PAKRO_SHIMS_DIR:"*) ;;
  *) fail "expected the tool bin dir ahead of the shim farm: $pakro_path" ;;
esac
assert_contains "pakro run check" "This is Dummy 1.0.0"

# A farm already on PATH keeps its place and is not duplicated.
pakro_path="$(PATH="$PAKRO_SHIMS_DIR:$PATH" pakro env -s bash | sed -n 's/^export PATH=//p' | tr -d "'\"")"
case "$pakro_path" in
  "$PAKRO_DATA_DIR/installs/tiny/1.0.0/bin:$PAKRO_DATA_DIR/installs/dummy/1.0.0/bin:$PAKRO_SHIMS_DIR:"*) ;;
  *) fail "expected tool paths, then the farm from the original PATH: $pakro_path" ;;
esac
assert "printf '%s' \"$pakro_path\" | tr ':' '\\n' | grep -c -x \"$PAKRO_SHIMS_DIR\"" "1"

# `pakro x -- <cmd>` names the lazy command directly and installs its provider.
cat >pakro.toml <<'EOF'
[tools]
tiny = { version = "1.0.0", lazy = true, lazy_bins = ["rtx-tiny"] }
dummy = { version = "1.0.0", lazy = true, lazy_bins = ["dummy"] }
EOF
pakro uninstall --all tiny
pakro uninstall --all dummy
rm -f "$PAKRO_SHIMS_DIR/rtx-tiny" "$PAKRO_SHIMS_DIR/dummy"
output=$(PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro x -- dummy --version 2>&1)
case "$output" in
  *"missing: dummy@1.0.0"*) fail "lazy provider was reported missing after installation: $output" ;;
esac
case "$output" in
  *"This is Dummy 1.0.0"*) ;;
  *) fail "lazy provider did not run: $output" ;;
esac
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/1.0.0"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/tiny/1.0.0'"
assert_succeed "test -e '$PAKRO_SHIMS_DIR/rtx-tiny'"

# A lazy declaration without bin metadata reports its own error without
# preventing bootstrap shims for the remaining valid declarations.
pakro uninstall --all dummy
rm -f "$PAKRO_SHIMS_DIR/dummy"
cat >pakro.toml <<'EOF'
[tools]
"aqua:tinygo-org/tinygo" = { version = "0.39.0", lazy = true }
dummy = { version = "1.0.0", lazy = true, lazy_bins = ["dummy"] }

[tasks.valid-lazy]
run = "dummy --version"
EOF
assert_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro run valid-lazy 2>&1" "This is Dummy 1.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/1.0.0"
assert_succeed "test -e '$PAKRO_SHIMS_DIR/dummy'"

# Commands started by the child reach the tool through its bootstrap shim.
pakro uninstall --all dummy
rm -f "$PAKRO_SHIMS_DIR/dummy"
assert_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro x -- sh -c 'dummy --version'" "This is Dummy 1.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/1.0.0"

# Lazy declarations that exist only in a task also get bootstrap shims after
# task tools are collected, not just those in the project toolset.
pakro uninstall --all dummy
rm -f "$PAKRO_SHIMS_DIR/dummy"
ln -s "$(command -v pakro)" "$PAKRO_SHIMS_DIR/unrelated"
cat >pakro.toml <<'EOF'
[tasks.task-local]
tools = { dummy = { version = "1.0.0", lazy = true, lazy_bins = ["dummy"] } }
run = 'test -e "$PAKRO_SHIMS_DIR/unrelated" && dummy --version'
EOF
assert_contains "PAKRO_NOT_FOUND_AUTO_INSTALL=0 pakro run task-local" "This is Dummy 1.0.0"
assert_directory_exists "$PAKRO_DATA_DIR/installs/dummy/1.0.0"
assert_succeed "test -e '$PAKRO_SHIMS_DIR/dummy'"

# A nested task without runtime tools must not inherit its parent's serialized
# task toolset. The parent's unused lazy tool remains uninstalled.
pakro uninstall --all dummy
cat >pakro.toml <<'EOF'
[tasks.parent]
tools = { dummy = { version = "1.0.0", lazy = true, lazy_bins = ["dummy"] } }
run = "pakro run no-tools"

[tasks.no-tools]
run = 'test -z "${__PAKRO_TASK_TOOL_ARGS-}" && echo cleared'
EOF
assert_contains "pakro run parent" "cleared"
assert_fail "test -d '$PAKRO_DATA_DIR/installs/dummy/1.0.0'"

# Without a lazy declaration the child environment leaves the farm off PATH.
cat >pakro.toml <<'EOF'
[tools]
dummy = "1.0.0"
EOF
assert_not_contains "pakro env -s bash" "$PAKRO_SHIMS_DIR"
