#!/usr/bin/env bash
# Test behavior with nonexistent tools in config

set -euo pipefail

# Disable backtraces for cleaner error messages
export RUST_BACKTRACE=0
export PAKRO_FRIENDLY_ERROR=1

# Create pakro.toml with a nonexistent tool
cat >pakro.toml <<EOF
[tools]
nonexistent-tool-xyz = "1.0.0"
EOF

echo "Test 1: pakro install should error for nonexistent tool in pakro.toml"
status=0
output=$(pakro install 2>&1) || status=$?
if [[ $status -ne 0 ]] && [[ $output == *"nonexistent-tool-xyz not found in pakro tool registry"* ]]; then
  echo "✓ Test 1 passed: pakro install errors for nonexistent tool"
else
  echo "✗ Test 1 failed: Expected error for nonexistent tool"
  echo "  Status: $status"
  echo "  Output: $output"
  exit 1
fi

echo "Test 2: pakro use should error for nonexistent tool"
status=0
output=$(pakro use nonexistent-tool-abc@1.0.0 2>&1) || status=$?
if [[ $status -ne 0 ]] && [[ $output == *"nonexistent-tool-abc not found in pakro tool registry"* ]]; then
  echo "✓ Test 2 passed: pakro use errors for nonexistent tool"
else
  echo "✗ Test 2 failed: Expected error for nonexistent tool"
  echo "  Status: $status"
  echo "  Output: $output"
  exit 1
fi

echo "Test 3: pakro env should warn but not error for nonexistent tool"
status=0
output=$(pakro env 2>&1) || status=$?
# pakro env should warn about the nonexistent tool but still exit successfully
if [[ $status -eq 0 ]]; then
  if [[ $output == *"WARN"* ]] && [[ $output == *"nonexistent-tool-xyz"* ]]; then
    echo "✓ Test 3 passed: pakro env warns but does not error"
  else
    echo "✗ Test 3 failed: Expected warning about nonexistent-tool-xyz"
    echo "  Output: $output"
    exit 1
  fi
else
  echo "✗ Test 3 failed: pakro env should not exit with error"
  echo "  Status: $status"
  echo "  Output: $output"
  exit 1
fi

echo "Test 4: pakro hook-env should not error for nonexistent tool"
status=0
output=$(pakro hook-env 2>&1) || status=$?
# pakro hook-env is designed for shell integration, so it should silently skip nonexistent tools
if [[ $status -eq 0 ]]; then
  echo "✓ Test 4 passed: pakro hook-env does not error"
else
  echo "✗ Test 4 failed: pakro hook-env should not exit with error"
  echo "  Status: $status"
  echo "  Output: $output"
  exit 1
fi

echo "Test 5: pakro install with explicit nonexistent tool should error"
status=0
output=$(pakro install nonexistent-explicit-tool@1.0.0 2>&1) || status=$?
if [[ $status -ne 0 ]] && [[ $output == *"nonexistent-explicit-tool not found in pakro tool registry"* ]]; then
  echo "✓ Test 5 passed: explicit pakro install errors for nonexistent tool"
else
  echo "✗ Test 5 failed: Expected error for nonexistent tool"
  echo "  Status: $status"
  echo "  Output: $output"
  exit 1
fi

echo "Test 6: pakro ls should not list nonexistent tool"
status=0
output=$(pakro ls nonexistent-tool-xyz 2>&1) || status=$?
# pakro ls should either error or show nothing for a nonexistent tool
if [[ $output != *"nonexistent-tool-xyz"*"1.0.0"* ]]; then
  echo "✓ Test 6 passed: pakro ls does not list nonexistent tool as installed"
else
  echo "✗ Test 6 failed: pakro ls should not show nonexistent tool"
  echo "  Output: $output"
  exit 1
fi

# Clean up
rm -f pakro.toml

echo ""
echo "Non-existent tool tests completed!"
echo ""
echo "Summary:"
echo "  - pakro install with config file: ✓ errors as expected"
echo "  - pakro use: ✓ errors as expected"
echo "  - pakro env: ✓ warns but succeeds"
echo "  - pakro hook-env: ✓ silently succeeds"
echo "  - pakro install explicit: ✓ errors as expected"
