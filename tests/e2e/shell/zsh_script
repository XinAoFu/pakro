#!/usr/bin/env zsh
# shellcheck disable=SC1071
set -euo pipefail
orig_path="$PATH"

cat <<EOF >.pakro.toml
[tools]
node = "20.0.0"
EOF

mkdir 18
cat <<EOF >18/.pakro.toml
[tools]
node = "18.0.0"
EOF

assert_path() {
  local expected="${1//$HOME/\~}"
  local actual="${PATH/%$orig_path/}"
  actual="${actual//$HOME/\~}"
  actual="${actual/%:/}"
  if [[ $actual != "$expected" ]]; then
    echo "Invalid PATH:  $actual"
    echo "Expected PATH: $expected"
    exit 1
  fi
}

pakro install node@20.0.0 node@18.0.0
# shellcheck disable=SC1090
eval "$(pakro activate zsh --status)" && _pakro_hook

#pakro install
assert_path "$HOME/.local/share/pakro/installs/node/20.0.0/bin:$HOME/.local/share/pakro/shims"
test "$(pakro exec -- sh -c 'command -v node')" = "$HOME/.local/share/pakro/installs/node/20.0.0/bin/node"
test "$(node -v)" = "v20.0.0"

cd 18 && _pakro_hook
#pakro install
test "$(node -v)" = "v18.0.0"

cd .. && _pakro_hook
test "$(node -v)" = "v20.0.0"

pakro shell node@18.0.0 && _pakro_hook
test "$(node -v)" = "v18.0.0"

pakro deactivate
assert_path ""
