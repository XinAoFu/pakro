#!/usr/bin/env bash

echo "tiny 3.1.0" >.tool-versions
mkdir subdir
echo "tiny 2.0.0" >subdir/.tool-versions

pakro install tiny@3.1.0 tiny@2.0.0

# shellcheck disable=SC1090
eval "$(pakro activate -s bash --status)"

_pakro_hook
assert_contains "rtx-tiny" "v3.1.0"

cd subdir && _pakro_hook
assert_contains "rtx-tiny" "v2.0.0"

cd .. && _pakro_hook
assert_contains "rtx-tiny" "v3.1.0"
