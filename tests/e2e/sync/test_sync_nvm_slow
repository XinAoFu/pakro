#!/usr/bin/env bash
# shellcheck disable=SC1091

export NVM_DIR="$PWD/.nvm"
mkdir -p "$NVM_DIR"
curl -L https://github.com/nvm-sh/nvm/archive/refs/tags/v0.40.0.tar.gz | tar -xz -C "$NVM_DIR" --strip-components=1
. "$NVM_DIR/nvm.sh"

nvm install 22.0.0
pakro sync node --nvm
pakro ls
assert_contains "pakro ls node --json | jq -r '.[] | .symlinked_to | select( . != null)'" "node/22.0.0"

