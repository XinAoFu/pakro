#!/usr/bin/env bash

cat <<EOF >pakro.toml
[env]
_.path = ["bin", "bin2"]
[tools]
dummy = "1.0.0"
jq = "1.7.1"
EOF

mkdir bin subdir subdir/bin
cat <<EOF >subdir/pakro.toml
[env]
_.path = ["bin", "bin2"]
[tools]
dummy = "2.0.0"
pitchfork = "0.1.5"
EOF

cd subdir
pakro i

assert "pakro bin-paths" "$PAKRO_DATA_DIR/installs/dummy/2.0.0/bin
$PAKRO_DATA_DIR/installs/pitchfork/0.1.5
$PAKRO_DATA_DIR/installs/jq/1.7.1"

assert "pakro env | grep PATH" "export PATH='$HOME/workdir/subdir/bin:$HOME/workdir/subdir/bin2:$HOME/workdir/bin:$HOME/workdir/bin2:$PAKRO_DATA_DIR/installs/dummy/2.0.0/bin:$PAKRO_DATA_DIR/installs/pitchfork/0.1.5:$PAKRO_DATA_DIR/installs/jq/1.7.1:$PATH'"
assert "pakro hook-env | grep PATH | tail -n1" "export PATH='$HOME/workdir/subdir/bin:$HOME/workdir/subdir/bin2:$HOME/workdir/bin:$HOME/workdir/bin2:$PAKRO_DATA_DIR/installs/dummy/2.0.0/bin:$PAKRO_DATA_DIR/installs/pitchfork/0.1.5:$PAKRO_DATA_DIR/installs/jq/1.7.1:$PAKRO_DATA_DIR/shims:$PATH'"
