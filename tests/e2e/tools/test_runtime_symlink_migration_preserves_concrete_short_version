#!/usr/bin/env bash

cat <<TOML >pakro.toml
[tools]
node = "20"
TOML

mkdir -p "$PAKRO_DATA_DIR/installs/node/20/bin"
mkdir -p "$PAKRO_DATA_DIR/installs/node/20.0.0/bin"

# Any pakro command triggers startup migrations.
assert "pakro --version >/dev/null"

assert "test -d $PAKRO_DATA_DIR/installs/node/20"
assert "test ! -L $PAKRO_DATA_DIR/installs/node/20"

rm -f pakro.toml
