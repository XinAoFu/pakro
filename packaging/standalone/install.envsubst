#!/bin/sh
set -eu

#region logging setup
if [ "${PAKRO_DEBUG-}" = "true" ] || [ "${PAKRO_DEBUG-}" = "1" ]; then
  debug() {
    echo "$@" >&2
  }
else
  debug() {
    :
  }
fi

if [ "${PAKRO_QUIET-}" = "1" ] || [ "${PAKRO_QUIET-}" = "true" ]; then
  info() {
    :
  }
else
  info() {
    echo "$@" >&2
  }
fi

warn() {
  printf '%s\n' "$*" >&2
}

error() {
  echo "$@" >&2
  exit 1
}

unsupported_arch() {
  arch="$1"
  warn "unsupported architecture: $arch"
  warn ""
  warn "pakro does not provide prebuilt binaries for this platform."
  warn "If Rust/Cargo is available, install from source with:"
  warn "  cargo install --locked pakro"
  exit 1
}
#endregion

#region environment setup
get_os() {
  os="$(uname -s)"
  if [ "$os" = Darwin ]; then
    echo "macos"
  elif [ "$os" = Linux ]; then
    echo "linux"
  else
    error "unsupported OS: $os"
  fi
}

get_arch() {
  musl=""
  if type ldd >/dev/null 2>/dev/null; then
    if [ "${PAKRO_INSTALL_MUSL-}" = "1" ] || [ "${PAKRO_INSTALL_MUSL-}" = "true" ]; then
      musl="-musl"
    elif [ "$(uname -o)" = "Android" ]; then
      # Android (Termux) always uses musl
      musl="-musl"
    else
      libc=$(ldd /bin/ls | grep 'musl' | head -1 | cut -d ' ' -f1)
      if [ -n "$libc" ]; then
        musl="-musl"
      fi
    fi
  fi
  arch="$(uname -m)"
  if [ "$arch" = x86_64 ]; then
    echo "x64$musl"
  elif [ "$arch" = aarch64 ] || [ "$arch" = arm64 ]; then
    echo "arm64$musl"
  elif [ "$arch" = armv7l ]; then
    echo "armv7$musl"
  else
    unsupported_arch "$arch"
  fi
}

get_ext() {
  if [ -n "${PAKRO_INSTALL_EXT:-}" ]; then
    echo "$PAKRO_INSTALL_EXT"
  elif [ -n "${PAKRO_VERSION:-}" ] && echo "$PAKRO_VERSION" | grep -q '^v2024'; then
    # 2024 versions don't have zstd tarballs
    echo "tar.gz"
  elif tar_supports_zstd; then
    echo "tar.zst"
  else
    echo "tar.gz"
  fi
}

tar_supports_zstd() {
  if ! command -v zstd >/dev/null 2>&1; then
    false
  # tar is bsdtar
  elif tar --version | grep -q 'bsdtar'; then
    true
  # busybox tar reports a "1.3x" version that matches the GNU check below, but it
  # cannot decompress .tar.zst itself. Detect it so we fall back to the zstd pipe
  # (or a .tar.gz download) instead of running `tar -xf` on a zstd tarball.
  elif tar --version 2>&1 | grep -qi 'busybox'; then
    false
  # tar version is >= 1.31
  elif tar --version | grep -q '1\.\(3[1-9]\|[4-9][0-9]\)'; then
    true
  else
    false
  fi
}

shasum_bin() {
  if command -v shasum >/dev/null 2>&1; then
    echo "shasum"
  elif command -v sha256sum >/dev/null 2>&1; then
    echo "sha256sum"
  else
    error "pakro install requires shasum or sha256sum but neither is installed. Aborting."
  fi
}

get_checksum() {
  version=$1
  os=$2
  arch=$3
  ext=$4
  if [ -n "$download_base_url" ]; then
    url="$download_base_url/v${version}/SHASUMS256.txt"
  elif [ -n "$release_repository" ]; then
    url="https://github.com/$release_repository/releases/download/v${version}/SHASUMS256.txt"
  else
    url=""
  fi
  current_version="$PAKRO_CURRENT_VERSION"
  current_version="${current_version#v}"

  # For current version use static checksum otherwise
  # use checksum from releases
  if [ "$version" = "$current_version" ]; then
    checksum_linux_x86_64="$PAKRO_CHECKSUM_LINUX_X86_64"
    checksum_linux_x86_64_musl="$PAKRO_CHECKSUM_LINUX_X86_64_MUSL"
    checksum_linux_arm64="$PAKRO_CHECKSUM_LINUX_ARM64"
    checksum_linux_arm64_musl="$PAKRO_CHECKSUM_LINUX_ARM64_MUSL"
    checksum_linux_armv7="$PAKRO_CHECKSUM_LINUX_ARMV7"
    checksum_linux_armv7_musl="$PAKRO_CHECKSUM_LINUX_ARMV7_MUSL"
    checksum_macos_x86_64="$PAKRO_CHECKSUM_MACOS_X86_64"
    checksum_macos_arm64="$PAKRO_CHECKSUM_MACOS_ARM64"
    checksum_linux_x86_64_zstd="$PAKRO_CHECKSUM_LINUX_X86_64_ZSTD"
    checksum_linux_x86_64_musl_zstd="$PAKRO_CHECKSUM_LINUX_X86_64_MUSL_ZSTD"
    checksum_linux_arm64_zstd="$PAKRO_CHECKSUM_LINUX_ARM64_ZSTD"
    checksum_linux_arm64_musl_zstd="$PAKRO_CHECKSUM_LINUX_ARM64_MUSL_ZSTD"
    checksum_linux_armv7_zstd="$PAKRO_CHECKSUM_LINUX_ARMV7_ZSTD"
    checksum_linux_armv7_musl_zstd="$PAKRO_CHECKSUM_LINUX_ARMV7_MUSL_ZSTD"
    checksum_macos_x86_64_zstd="$PAKRO_CHECKSUM_MACOS_X86_64_ZSTD"
    checksum_macos_arm64_zstd="$PAKRO_CHECKSUM_MACOS_ARM64_ZSTD"

    # TODO: refactor this, it's a bit messy
    if [ "$ext" = "tar.zst" ]; then
      if [ "$os" = "linux" ]; then
        if [ "$arch" = "x64" ]; then
          echo "$checksum_linux_x86_64_zstd"
        elif [ "$arch" = "x64-musl" ]; then
          echo "$checksum_linux_x86_64_musl_zstd"
        elif [ "$arch" = "arm64" ]; then
          echo "$checksum_linux_arm64_zstd"
        elif [ "$arch" = "arm64-musl" ]; then
          echo "$checksum_linux_arm64_musl_zstd"
        elif [ "$arch" = "armv7" ]; then
          echo "$checksum_linux_armv7_zstd"
        elif [ "$arch" = "armv7-musl" ]; then
          echo "$checksum_linux_armv7_musl_zstd"
        else
          warn "no checksum for $os-$arch"
        fi
      elif [ "$os" = "macos" ]; then
        if [ "$arch" = "x64" ]; then
          echo "$checksum_macos_x86_64_zstd"
        elif [ "$arch" = "arm64" ]; then
          echo "$checksum_macos_arm64_zstd"
        else
          warn "no checksum for $os-$arch"
        fi
      else
        warn "no checksum for $os-$arch"
      fi
    else
      if [ "$os" = "linux" ]; then
        if [ "$arch" = "x64" ]; then
          echo "$checksum_linux_x86_64"
        elif [ "$arch" = "x64-musl" ]; then
          echo "$checksum_linux_x86_64_musl"
        elif [ "$arch" = "arm64" ]; then
          echo "$checksum_linux_arm64"
        elif [ "$arch" = "arm64-musl" ]; then
          echo "$checksum_linux_arm64_musl"
        elif [ "$arch" = "armv7" ]; then
          echo "$checksum_linux_armv7"
        elif [ "$arch" = "armv7-musl" ]; then
          echo "$checksum_linux_armv7_musl"
        else
          warn "no checksum for $os-$arch"
        fi
      elif [ "$os" = "macos" ]; then
        if [ "$arch" = "x64" ]; then
          echo "$checksum_macos_x86_64"
        elif [ "$arch" = "arm64" ]; then
          echo "$checksum_macos_arm64"
        else
          warn "no checksum for $os-$arch"
        fi
      else
        warn "no checksum for $os-$arch"
      fi
    fi
  else
    [ -n "$url" ] || error "set PAKRO_DOWNLOAD_BASE_URL or PAKRO_RELEASE_REPOSITORY to fetch checksums"
    if command -v curl >/dev/null 2>&1; then
      debug ">" curl -fsSL "$url"
      checksums="$(curl --compressed -fsSL "$url")"
    else
      if command -v wget >/dev/null 2>&1; then
        debug ">" wget -qO - "$url"
        checksums="$(wget -qO - "$url")"
      else
        error "pakro standalone install specific version requires curl or wget but neither is installed. Aborting."
      fi
    fi
    # TODO: verify with minisign or gpg if available

    checksum="$(echo "$checksums" | grep "$os-$arch.$ext")"
    if ! echo "$checksum" | grep -Eq "^([0-9a-f]{32}|[0-9a-f]{64})"; then
      warn "no checksum for pakro $version and $os-$arch"
    else
      echo "$checksum"
    fi
  fi
}

#endregion

download_file() {
  url="$1"
  download_dir="$2"
  filename="$(basename "$url")"
  file="$download_dir/$filename"

  info "pakro: installing pakro..."

  if command -v curl >/dev/null 2>&1; then
    debug ">" curl -#fLo "$file" "$url"
    curl -#fLo "$file" "$url"
  else
    if command -v wget >/dev/null 2>&1; then
      debug ">" wget -qO "$file" "$url"
      stderr=$(mktemp)
      wget -O "$file" "$url" >"$stderr" 2>&1 || error "wget failed: $(cat "$stderr")"
      rm "$stderr"
    else
      error "pakro standalone install requires curl or wget but neither is installed. Aborting."
    fi
  fi

  echo "$file"
}

# Prints the version of an installed pakro binary (the first field of
# `pakro version`, e.g. "2025.6.0"), with any leading "v" stripped. Prints
# nothing if the binary is missing or fails to report a version.
installed_pakro_version() {
  bin="$1"
  if [ -x "$bin" ]; then
    installed_version="$("$bin" version 2>/dev/null | head -n1 | cut -d' ' -f1)"
    echo "${installed_version#v}"
  fi
}

# Keep bootstrap dependencies to POSIX sh/awk and curl or wget. The native CLI
# additionally supports calendar durations and absolute cutoff dates.
release_age_cutoff() {
  awk -v age="$1" -v now="$(date +%s)" 'BEGIN {
    if (age !~ /^[0-9]+[smhdw]$/) exit 1
    unit = substr(age, length(age)); value = substr(age, 1, length(age)-1)
    seconds = (unit == "s" ? 1 : unit == "m" ? 60 : unit == "h" ? 3600 : unit == "d" ? 86400 : 604800)
    printf "%.0f\n", now - value * seconds
  }'
}

select_release() {
  awk -v cutoff="$1" '
    NF != 2 || $1 !~ /^v[0-9]+\.[0-9]+\.[0-9]+$/ || $2 !~ /^[0-9]+$/ { invalid = 1; next }
    $2 <= cutoff {
      split(substr($1, 2), v, ".")
      if (!selected || v[1]+0 > year || (v[1]+0 == year && v[2]+0 > month) || (v[1]+0 == year && v[2]+0 == month && v[3]+0 > patch)) {
        selected = substr($1, 2); year = v[1]+0; month = v[2]+0; patch = v[3]+0
      }
    }
    END { if (invalid || !selected) exit 1; print selected }
  '
}

resolve_release() {
  if [ -n "${PAKRO_VERSION:-}" ]; then
    printf '%s\n' "${PAKRO_VERSION#v}"
    return
  fi
  [ -n "$download_base_url" ] || error "set PAKRO_VERSION explicitly or configure PAKRO_DOWNLOAD_BASE_URL"
  age="${PAKRO_SELF_UPDATE_MINIMUM_RELEASE_AGE-${PAKRO_MINIMUM_RELEASE_AGE-24h}}"
  cutoff=$(release_age_cutoff "$age") || error "invalid minimum release age: $age (use an integer with s, m, h, d, or w)"
  if command -v curl >/dev/null 2>&1; then
    index=$(curl -fsSL "$download_base_url/releases.tsv") || error "could not fetch pakro release index"
  elif command -v wget >/dev/null 2>&1; then
    index=$(wget -qO- "$download_base_url/releases.tsv") || error "could not fetch pakro release index"
  else
    error "pakro install requires curl or wget"
  fi
  selected=$(printf '%s\n' "$index" | select_release "$cutoff") || error "no eligible pakro release or invalid release index; lower PAKRO_SELF_UPDATE_MINIMUM_RELEASE_AGE or set PAKRO_VERSION"
  info "pakro: selected $selected (minimum release age: $age)"
  printf '%s\n' "$selected"
}

install_pakro() {
  download_base_url="${PAKRO_DOWNLOAD_BASE_URL:-$PAKRO_DEFAULT_DOWNLOAD_BASE_URL}"
  download_base_url="${download_base_url%/}"
  release_repository="${PAKRO_RELEASE_REPOSITORY:-$PAKRO_DEFAULT_RELEASE_REPOSITORY}"
  [ "$release_repository" != "jdx/mise" ] || error "PAKRO_RELEASE_REPOSITORY must name the pakro release repository"
  version="$(resolve_release)"
  version="${version#v}"
  current_version="$PAKRO_CURRENT_VERSION"
  current_version="${current_version#v}"
  os="${PAKRO_INSTALL_OS:-$(get_os)}"
  arch="${PAKRO_INSTALL_ARCH:-$(get_arch)}"
  ext="${PAKRO_INSTALL_EXT:-$(get_ext)}"
  install_path="${PAKRO_INSTALL_PATH:-$HOME/.local/bin/pakro}"
  install_dir="$(dirname "$install_path")"
  install_from_github="${PAKRO_INSTALL_FROM_GITHUB:-}"

  # Keep a newer manually installed release when resolving an unpinned install.
  if [ -z "${PAKRO_VERSION:-}" ] && [ -x "$install_path" ]; then
    existing_version="$(installed_pakro_version "$install_path")"
    [ -n "$existing_version" ] || error "cannot compare installed pakro version; set PAKRO_VERSION explicitly"
    if [ -n "$existing_version" ]; then
      compare_version="${existing_version%-DEBUG}"
      newest=$(printf 'v%s 0\nv%s 0\n' "$compare_version" "$version" | select_release 0) || error "cannot compare installed pakro version; set PAKRO_VERSION explicitly"
      if [ "$newest" = "$compare_version" ]; then
        info "pakro: $install_path is already at $existing_version, keeping installed version"
        return 0
      fi
    fi
  fi

  # Opt-in: skip the download/install if the binary already at the install
  # path matches the requested version. Only the install path is checked (not
  # the wider PATH) so that skipping never leaves install_path missing.
  skip_if_exists="${PAKRO_INSTALL_SKIP_IF_EXISTS-}"
  if [ "$skip_if_exists" = "1" ] || [ "$skip_if_exists" = "true" ]; then
    if [ -x "$install_path" ]; then
      existing_version="$(installed_pakro_version "$install_path")"
      if [ -n "$existing_version" ] && [ "$existing_version" = "$version" ]; then
        info "pakro: $install_path is already at version $version, skipping install"
        return 0
      fi
    fi
  fi
  if [ -n "${PAKRO_TARBALL_URL-}" ]; then
    tarball_url="$PAKRO_TARBALL_URL"
  elif [ -n "$release_repository" ] && { [ -z "$download_base_url" ] || [ "$install_from_github" = "1" ] || [ "$install_from_github" = "true" ]; }; then
    tarball_url="https://github.com/$release_repository/releases/download/v${version}/pakro-v${version}-${os}-${arch}.${ext}"
  elif [ -n "$download_base_url" ]; then
    tarball_url="$download_base_url/v${version}/pakro-v${version}-${os}-${arch}.${ext}"
  else
    error "configure PAKRO_DOWNLOAD_BASE_URL, PAKRO_RELEASE_REPOSITORY, or PAKRO_TARBALL_URL before installing pakro"
  fi

  download_dir="$(mktemp -d)"
  cache_file=$(download_file "$tarball_url" "$download_dir")
  debug "pakro-setup: tarball=$cache_file"

  debug "validating checksum"
  cd "$(dirname "$cache_file")" && get_checksum "$version" "$os" "$arch" "$ext" | "$(shasum_bin)" -c >/dev/null

  # extract tarball
  if [ -d "$install_path" ]; then
    error "PAKRO_INSTALL_PATH '$install_path' is a directory. Please set it to a file path, e.g. '$install_path/pakro'."
  fi
  mkdir -p "$install_dir"
  rm -f "$install_path"
  extract_dir="$(mktemp -d)"
  cd "$extract_dir"
  if [ "$ext" = "tar.zst" ] && ! tar_supports_zstd; then
    zstd -d -c "$cache_file" | tar --no-same-owner -xf -
  else
    tar --no-same-owner -xf "$cache_file"
  fi
  if [ "$(id -u)" = "0" ]; then
    chown 0:0 pakro/bin/pakro
    chmod 755 pakro/bin/pakro
  fi
  mv pakro/bin/pakro "$install_path"

  # cleanup
  cd / # Move out of $extract_dir before removing it
  rm -rf "$download_dir"
  rm -rf "$extract_dir"

  info "pakro: installed successfully to $install_path"
}

after_finish_help() {
  case "${SHELL:-}" in
  */zsh)
    info "pakro: run the following to activate pakro in your shell:"
    info "echo \"eval \\\"\\\$($install_path activate zsh)\\\"\" >> \"${ZDOTDIR-$HOME}/.zshrc\""
    info ""
    info "pakro: run \`pakro doctor\` to verify this is set up correctly"
    ;;
  */bash)
    info "pakro: run the following to activate pakro in your shell:"
    info "echo \"eval \\\"\\\$($install_path activate bash)\\\"\" >> ~/.bashrc"
    info ""
    info "pakro: run \`pakro doctor\` to verify this is set up correctly"
    ;;
  */fish)
    info "pakro: run the following to activate pakro in your shell:"
    info "echo \"$install_path activate fish | source\" >> ~/.config/fish/config.fish"
    info ""
    info "pakro: run \`pakro doctor\` to verify this is set up correctly"
    ;;
  *)
    info "pakro: run \`$install_path --help\` to get started"
    ;;
  esac
}

install_pakro
if [ "${PAKRO_INSTALL_HELP-}" != 0 ]; then
  after_finish_help
fi
