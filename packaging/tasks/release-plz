#!/usr/bin/env bash
#PAKRO description="Release with release-plz"
set -euxo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/../scripts/release-env.sh"
pakro_require_release

# Ensure this script is only run in GitHub Actions
if [[ -z ${GITHUB_ACTIONS:-} ]]; then
	echo "Error: This script must be run in GitHub Actions"
	echo "The release-plz script should only be executed in the CI/CD pipeline"
	exit 1
fi

git config user.name pakro-en-dev
git config user.email "${PAKRO_RELEASE_EMAIL:?Set PAKRO_RELEASE_EMAIL}"

# Check if the most recent tag has a matching GitHub Release.
# If not, the previous release workflow likely failed to fire — re-trigger it.
latest_tag="$(git tag --list 'v[0-9]*' --sort=-v:refname | head -1 || true)"
if [[ -n $latest_tag ]]; then
	if ! gh api "repos/$GITHUB_REPOSITORY/releases/tags/$latest_tag" --silent 2>/dev/null; then
		# Don't stack dispatches. release-plz runs on every push to main, so without
		# this guard each merge re-triggers release.yml for the same tag. That trips
		# the workflow's `release-<ref>` concurrency group, which cancels the still
		# -pending prior attempt — so during a busy merge window no run ever survives
		# long enough to finish and the release can never publish (a self-perpetuating
		# loop, since a missing release keeps re-arming this very check). Only
		# re-trigger when nothing is already queued or in progress for this tag.
		#
		# Tag-dispatched runs report the tag as `headBranch`, so filter on that.
		# `gh run list --branch` is documented for branches only and its behavior
		# with tags is unspecified, so match in jq rather than relying on it.
		active_runs="$(gh run list --repo "$GITHUB_REPOSITORY" --workflow release.yml --limit 60 --json status,headBranch 2>/dev/null | jq --arg tag "$latest_tag" '[.[] | select(.headBranch == $tag and .status != "completed")] | length' 2>/dev/null || echo 0)"
		if [[ ${active_runs:-0} -gt 0 ]]; then
			echo "Release workflow already active for $latest_tag ($active_runs queued/running) — not re-triggering"
		else
			echo "Tag $latest_tag has no GitHub Release — triggering release workflow"
			gh workflow run release.yml --ref "$latest_tag"
		fi
	fi
fi

exists_on_crates() {
	crate="$1"
	version="$2"
	if cargo info --registry "crates-io" --color never --quiet "$crate@$version" 2>/dev/null | grep -qE "^version:\s+$version\b"; then
		return 0
	fi
	if curl -fsSL "https://crates.io/api/v1/crates/$crate/$version" >/dev/null 2>&1; then
		return 0
	fi
	return 1
}

# Returns 2 when Cargo's index reports that the version already exists even
# though the registry API checks above have not caught up yet.
publish_crate() {
	local crate_name="$1"
	local publish_log
	publish_log="$(mktemp)"
	if cargo publish --allow-dirty --no-verify -p "$crate_name" 2>&1 | tee "$publish_log"; then
		rm -f "$publish_log"
		return 0
	fi
	if grep -Fq "already exists on crates.io index" "$publish_log"; then
		rm -f "$publish_log"
		return 2
	fi
	rm -f "$publish_log"
	return 1
}

# Include a crate's outside inputs when deciding whether it needs a release.
# Populates the caller-declared `pathspec` array (bash 3.2 compatible).
subcrate_diff_pathspec() {
	local crate_name="$1"
	local crate_dir="$2"
	pathspec=("$crate_dir")
	case "$crate_name" in
	pakro-settings)
		# The crate generates its types from the workspace .config/settings.toml.
		pathspec+=(".config/settings.toml")
		;;
	esac
}

# Check if a subcrate has changes since its last tagged release
# Returns 0 if changes exist (should publish), 1 if no changes
has_crate_changes() {
	local crate_name="$1"
	local crate_dir="$2"

	# Get the latest tag for this crate
	local latest_tag
	latest_tag=$(git tag --list "${crate_name}-v*" --sort=-v:refname | head -1 || true)

	if [[ -z $latest_tag ]]; then
		echo "No previous tag found for $crate_name, will publish"
		return 0
	fi

	# Check if there are changes in the crate directory since the tag,
	# ignoring vendored/generated content (see subcrate_diff_pathspec).
	local pathspec
	subcrate_diff_pathspec "$crate_name" "$crate_dir"
	if git diff --quiet "$latest_tag" -- "${pathspec[@]}"; then
		echo "No source changes in $crate_name since $latest_tag"
		return 1
	else
		echo "Source changes detected in $crate_name since $latest_tag"
		return 0
	fi
}

# Get the latest published version of a crate from crates.io
get_latest_crates_version() {
	local crate="$1"
	cargo info --registry "crates-io" --color never --quiet "$crate" 2>/dev/null | grep "^version:" | cut -d' ' -f2 || echo ""
}

package_version() {
	cargo metadata --offline --no-deps --format-version 1 |
		jq -er --arg name "$1" '
			[.packages[] | select(.name == $name)]
			| if length == 1 then .[0].version else error("package not found or ambiguous: \($name)") end
		'
}

version_relation() {
	jq -ner --arg candidate "$1" --arg current "$2" '
		def parts:
			split(".")
			| map(tonumber)
			| if length == 3 then . else error("expected a numeric three-part version") end;
		if ($candidate | parts) > ($current | parts) then "greater" else "not-greater" end
	'
}

set_path_dependency_version() {
	local manifest="$1"
	local dependency="$2"
	local new_version="$3"

	sed -i.bak -E \
		"/^$dependency = /s/version = \"[^\"]+\"/version = \"$new_version\"/" \
		"$manifest"
	rm -f "$manifest.bak"
	awk -v dependency="$dependency" -v version="$new_version" '
		index($0, dependency " = {") == 1 &&
			index($0, "path = \"") &&
			index($0, "version = \"" version "\"") { found = 1 }
		END { exit !found }
	' "$manifest"
}

# Point every versioned workspace path dependency on $dependency at $new_version.
# Subcrates depend on each other (pakro-util on pakro-settings, pakro-settings on
# pakro-cache-core, ...), and a requirement left behind stops matching once a
# bump crosses it: a calver crate entering a new year, or a 0.x minor bump.
set_workspace_path_dependency_versions() {
	local dependency="$1"
	local new_version="$2"
	local manifest
	for manifest in Cargo.toml src/crates/*/Cargo.toml runtimes/crates/*/Cargo.toml packages/crates/*/Cargo.toml; do
		if grep -E "^$dependency = \{" "$manifest" | grep -q 'path = "' &&
			grep -E "^$dependency = \{" "$manifest" | grep -q 'version = "'; then
			set_path_dependency_version "$manifest" "$dependency" "$new_version"
		fi
	done
}

set_package_version() {
	local crate_name="$1"
	local manifest="$2"
	local new_version="$3"
	local old_version old_pattern relation

	old_version="$(package_version "$crate_name")"
	old_pattern="${old_version//./\\.}"
	relation="$(version_relation "$new_version" "$old_version")"
	if [[ $relation != greater ]]; then
		echo "Cannot downgrade $crate_name from $old_version to $new_version" >&2
		return 1
	fi

	grep -Fqx "version = \"$old_version\"" "$manifest"
	sed -i.bak "s/^version = \"$old_pattern\"$/version = \"$new_version\"/" "$manifest"
	rm -f "$manifest.bak"

	# Keep workspace path dependencies compatible before Cargo resolves the bump.
	set_workspace_path_dependency_versions "$crate_name" "$new_version"

	cargo update --offline -p "$crate_name" --precise "$new_version"
}

bump_package_version() {
	local crate_name="$1"
	local manifest="$2"
	local component="$3"
	local current major minor patch

	current="$(package_version "$crate_name")"
	IFS=. read -r major minor patch <<<"$current"
	[[ $major =~ ^[0-9]+$ && $minor =~ ^[0-9]+$ && $patch =~ ^[0-9]+$ ]]

	case "$component" in
	patch) patch=$((patch + 1)) ;;
	minor)
		minor=$((minor + 1))
		patch=0
		;;
	*)
		echo "Unsupported version component: $component" >&2
		return 1
		;;
	esac

	set_package_version "$crate_name" "$manifest" "$major.$minor.$patch"
}

advance_package_version() {
	local crate_name="$1"
	local manifest="$2"
	local candidate="$3"
	local current relation

	current="$(package_version "$crate_name")"
	relation="$(version_relation "$candidate" "$current")"
	if [[ $relation == greater ]]; then
		set_package_version "$crate_name" "$manifest" "$candidate"
	else
		bump_package_version "$crate_name" "$manifest" patch
	fi
}

use_published_aqua_registry() {
	local version="$1"

	cargo rm aqua-registry
	cargo rm --build aqua-registry
	cargo add "aqua-registry@$version"
	cargo add --build "aqua-registry@$version"
}

# Check if the given git pathspecs have uncommitted changes (staged or unstaged)
has_uncommitted_changes() {
	# Args: one or more git pathspecs (e.g. a crate dir plus `:(exclude)` entries).
	# --porcelain covers staged, unstaged, and untracked changes in one check.
	if [[ -z $(git status --porcelain -- "$@" 2>/dev/null) ]]; then
		return 1 # No changes
	fi
	return 0 # Has changes
}

# Bump subcrate version if it has uncommitted changes (for prep phase)
bump_subcrate_if_changed() {
	local crate_name="$1"
	local crate_dir="$2"

	# Ignore vendored/generated content (see subcrate_diff_pathspec) so refreshed
	# embedded content doesn't force an otherwise-unnecessary version bump.
	local pathspec
	subcrate_diff_pathspec "$crate_name" "$crate_dir"
	if ! has_uncommitted_changes "${pathspec[@]}"; then
		echo "No uncommitted changes in $crate_name, keeping current version"
		return
	fi

	echo "Uncommitted changes detected in $crate_name, bumping version"
	local cur_version
	cur_version="$(cargo pkgid -p "$crate_name" | cut -d# -f2)"

	# Use calver: YYYY.M.PATCH
	local year month
	year="$(date +%Y)"
	month="$(date +%-m)"

	if echo "$cur_version" | grep -qE "^$year\.$month\."; then
		# Same year.month, bump patch (e.g., 2025.12.0 -> 2025.12.1)
		bump_package_version "$crate_name" "$crate_dir/Cargo.toml" patch
	else
		# New month or new year, start fresh at YYYY.MM.0
		advance_package_version "$crate_name" "$crate_dir/Cargo.toml" "$year.$month.0"
	fi

	local new_version
	new_version="$(cargo pkgid -p "$crate_name" | cut -d# -f2)"
	echo "Bumped $crate_name from $cur_version to $new_version"
}

# Bump and publish a subcrate if it has changes
# Sets PUBLISHED_<CRATE>_VERSION variable with the version to use
bump_and_publish_subcrate() {
	local crate_name="$1"
	local crate_dir="$2"
	local var_name="$3" # Variable name to set (e.g., AQUA_REGISTRY_VERSION)

	local cur_version
	cur_version="$(cargo pkgid -p "$crate_name" | cut -d# -f2)"

	if ! has_crate_changes "$crate_name" "$crate_dir"; then
		# No changes - use the current published version
		local published_version
		published_version=$(get_latest_crates_version "$crate_name")
		if [[ -n $published_version ]]; then
			echo "Using existing $crate_name@$published_version (no changes)"
			eval "$var_name=$published_version"
		else
			echo "Warning: $crate_name not found on crates.io, using current version"
			eval "$var_name=$cur_version"
		fi
		return
	fi

	# Has changes - bump version and publish
	# Use calver: YYYY.M.PATCH
	local year month
	year="$(date +%Y)"
	month="$(date +%-m)"

	if echo "$cur_version" | grep -qE "^$year\.$month\."; then
		# Same year.month, bump patch (e.g., 2025.12.0 -> 2025.12.1)
		bump_package_version "$crate_name" "$crate_dir/Cargo.toml" patch
	else
		# New month or new year, start fresh at YYYY.MM.0
		advance_package_version "$crate_name" "$crate_dir/Cargo.toml" "$year.$month.0"
	fi

	local new_version publish_result
	new_version="$(cargo pkgid -p "$crate_name" | cut -d# -f2)"

	# Keep bumping if the version already exists on crates.io. Cargo's index can
	# observe a new version before the API used by exists_on_crates does, so also
	# recover from an authoritative publish-time conflict instead of failing a
	# retry after an earlier release attempt uploaded only some workspace crates.
	while true; do
		if exists_on_crates "$crate_name" "$new_version"; then
			echo "$crate_name@$new_version already on crates.io, bumping again"
		else
			echo "Publishing $crate_name@$new_version"
			publish_result=0
			publish_crate "$crate_name" || publish_result=$?
			if [[ $publish_result -eq 0 ]]; then
				break
			elif [[ $publish_result -ne 2 ]]; then
				return "$publish_result"
			fi
			echo "$crate_name@$new_version reached the crates.io index during publication, bumping again"
		fi
		bump_package_version "$crate_name" "$crate_dir/Cargo.toml" patch
		new_version="$(cargo pkgid -p "$crate_name" | cut -d# -f2)"
	done

	# Create tag for this subcrate release
	local tag_name="${crate_name}-v${new_version}"
	if git rev-parse -q --verify "refs/tags/$tag_name" >/dev/null ||
		git ls-remote --exit-code --tags origin "$tag_name" >/dev/null 2>&1; then
		echo "Tag $tag_name already exists, skipping tag creation"
	else
		git tag "$tag_name" -s -m "Release $crate_name $new_version"
	fi

	eval "$var_name=$new_version"
}

cur_version="$(cargo pkgid pakro | cut -d# -f2)"
latest_version="$(cargo info --registry "crates-io" --color never --quiet pakro | grep "^version:" | cut -d' ' -f2)"
if [[ $cur_version != "$latest_version" ]]; then
	echo "Releasing pakro $cur_version"

	# Handle subcrates with independent versioning
	AQUA_REGISTRY_VERSION=""
	PAKRO_SIGSTORE_VERSION=""
	PAKRO_CACHE_CORE_VERSION=""
	PAKRO_BREW_RELOCATION_VERSION=""
	PAKRO_DOTENV_VERSION=""
	PAKRO_AGENT_ENV_VERSION=""
	PAKRO_SETTINGS_VERSION=""
	PAKRO_UTIL_VERSION=""
	PAKRO_BREW_METADATA_VERSION=""
	PAKRO_BOOTSTRAP_VERSION=""

	# Publish in dependency order: pakro-settings needs pakro-cache-core, and
	# pakro-util needs pakro-agent-env, pakro-cache-core, pakro-settings and
	# pakro-sigstore.
	bump_and_publish_subcrate "pakro-agent-env" "src/crates/pakro-agent-env" "PAKRO_AGENT_ENV_VERSION"
	cargo add -p pakro-util "pakro-agent-env@$PAKRO_AGENT_ENV_VERSION"

	bump_and_publish_subcrate "pakro-cache-core" "src/crates/pakro-cache-core" "PAKRO_CACHE_CORE_VERSION"
	cargo add -p pakro "pakro-cache-core@$PAKRO_CACHE_CORE_VERSION" --no-default-features
	cargo add -p pakro-settings "pakro-cache-core@$PAKRO_CACHE_CORE_VERSION" --no-default-features
	cargo add -p pakro-util "pakro-cache-core@$PAKRO_CACHE_CORE_VERSION" --no-default-features

	bump_and_publish_subcrate "pakro-brew-relocation" "packages/crates/pakro-brew-relocation" "PAKRO_BREW_RELOCATION_VERSION"
	cargo add -p pakro --target 'cfg(unix)' "pakro-brew-relocation@$PAKRO_BREW_RELOCATION_VERSION"

	bump_and_publish_subcrate "pakro-dotenv" "src/crates/pakro-dotenv" "PAKRO_DOTENV_VERSION"
	cargo add -p pakro "pakro-dotenv@$PAKRO_DOTENV_VERSION"

	# Copy the workspace settings definition into the crate directory so the published package includes it.
	cp .config/settings.toml src/crates/pakro-settings/settings.toml
	bump_and_publish_subcrate "pakro-settings" "src/crates/pakro-settings" "PAKRO_SETTINGS_VERSION"
	rm -f src/crates/pakro-settings/settings.toml
	cargo add -p pakro "pakro-settings@$PAKRO_SETTINGS_VERSION"
	cargo add -p pakro-util "pakro-settings@$PAKRO_SETTINGS_VERSION"

	bump_and_publish_subcrate "pakro-sigstore" "src/crates/pakro-sigstore" "PAKRO_SIGSTORE_VERSION"
	cargo add -p pakro-util "pakro-sigstore@$PAKRO_SIGSTORE_VERSION" --no-default-features

	bump_and_publish_subcrate "pakro-util" "src/crates/pakro-util" "PAKRO_UTIL_VERSION"
	cargo add -p pakro "pakro-util@$PAKRO_UTIL_VERSION"
	bump_and_publish_subcrate "pakro-brew-metadata" "packages/crates/pakro-brew-metadata" "PAKRO_BREW_METADATA_VERSION"
	cargo add -p pakro "pakro-brew-metadata@$PAKRO_BREW_METADATA_VERSION"
	bump_and_publish_subcrate "pakro-bootstrap" "src/crates/pakro-bootstrap" "PAKRO_BOOTSTRAP_VERSION"
	cargo add -p pakro "pakro-bootstrap@$PAKRO_BOOTSTRAP_VERSION"

	bump_and_publish_subcrate "aqua-registry" "runtimes/crates/aqua-registry" "AQUA_REGISTRY_VERSION"
	use_published_aqua_registry "$AQUA_REGISTRY_VERSION"

	if exists_on_crates pakro "$cur_version"; then
		echo "pakro@$cur_version already on crates.io, skipping publish"
	else
		publish_result=0
		publish_crate pakro || publish_result=$?
		if [[ $publish_result -eq 2 ]]; then
			echo "pakro@$cur_version reached the crates.io index during publication, continuing"
		elif [[ $publish_result -ne 0 ]]; then
			exit "$publish_result"
		fi
	fi

	pakro_tag="v$cur_version"
	changelog="$(git cliff --config packaging/config/cliff.toml --tag "$pakro_tag" --strip all --unreleased)"
	changelog="$(echo "$changelog" | tail -n +3)"
	if git ls-remote --exit-code --tags origin "$pakro_tag" >/dev/null 2>&1; then
		echo "Tag $pakro_tag already exists, skipping tag creation"
	else
		if ! git rev-parse -q --verify "refs/tags/$pakro_tag" >/dev/null; then
			git tag "$pakro_tag" -s -m "$changelog"
		fi
		git push origin "refs/tags/$pakro_tag"
	fi

	# GitHub does not create push events when more than three tags are pushed at
	# once. Push the pakro tag separately so release workflows always
	# receive the event, then publish any subcrate tags in bulk.
	git push --tags
	exit 0
fi

# Prep stages every workspace manifest (see the `git add` below), so an edit
# already sitting in one would ride along into the release commit. Refuse to
# start rather than guess which hunks belong to this run.
preexisting_manifest_changes="$(git status --porcelain -- Cargo.toml 'src/crates/*/Cargo.toml' 'runtimes/crates/*/Cargo.toml' 'packages/crates/*/Cargo.toml')"
if [[ -n $preexisting_manifest_changes ]]; then
	echo "Workspace manifests have uncommitted changes before release prep:" >&2
	echo "$preexisting_manifest_changes" >&2
	exit 1
fi

year="$(date +%Y)"
month="$(date +%-m)"
if echo "$cur_version" | grep -e "^$year\.$month\."; then
	bump_package_version pakro Cargo.toml patch
elif echo "$cur_version" | grep -e "^$year\."; then
	bump_package_version pakro Cargo.toml minor
else
	advance_package_version pakro Cargo.toml "$year.1.0"
fi

version="$(cargo pkgid pakro | cut -d# -f2)"
sed -i.bak "s/^[0-9]\+\.[0-9]\+\.[0-9]\+\(-rc\.[0-9]\+\)\? macos-arm64 ([0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\})$/$version macos-arm64 ($(date +%Y-%m-%d))/" README.md
sed -i.bak "s/^Version: [0-9]\+\.[0-9]\+\.[0-9]\+\(-rc\.[0-9]\+\)\?$/Version: $version/" packaging/rpm/pakro.spec
sed -i.bak "s/version = \"[0-9]\+\.[0-9]\+\.[0-9]\+\(-rc\.[0-9]\+\)\?\";$/version = \"$version\";/" packaging/nix/default.nix
sed -i.bak "s/version: \"[0-9]\+\.[0-9]\+\.[0-9]\+\(-rc\.[0-9]\+\)\?\"$/version: \"$version\"/" packaging/snap/snapcraft.yaml

# fetch-gpg-keys must run before render (which includes build) since it
# recreates src/crates/pakro-util/src/assets/gpg/ which is read at compile time via include_str!
pakro run fetch-gpg-keys
pakro run render ::: lint-fix

AQUA_REGISTRY_DIR="runtimes/vendor/aqua-registry"
AQUA_REGISTRY_METADATA="$AQUA_REGISTRY_DIR/metadata.json"
AQUA_REGISTRY_FILE="$AQUA_REGISTRY_DIR/registry.yml"
AQUA_REGISTRY_REPO="aquaproj/aqua-registry"

# Capture current aqua-registry ref before updating
OLD_AQUA_REGISTRY_TAG=""
if [[ -f $AQUA_REGISTRY_METADATA ]]; then
	OLD_AQUA_REGISTRY_TAG="$(jq -r '.tag // empty' "$AQUA_REGISTRY_METADATA")"
fi
NEW_AQUA_REGISTRY_TAG="$(gh api "repos/$AQUA_REGISTRY_REPO/commits/main" --jq .sha)"

rm -rf "$AQUA_REGISTRY_DIR"
mkdir -p "$AQUA_REGISTRY_DIR"
curl -fsSL "https://raw.githubusercontent.com/$AQUA_REGISTRY_REPO/$NEW_AQUA_REGISTRY_TAG/registry.yaml" \
	-o "$AQUA_REGISTRY_FILE"
curl -fsSL "https://raw.githubusercontent.com/$AQUA_REGISTRY_REPO/$NEW_AQUA_REGISTRY_TAG/LICENSE" \
	-o "$AQUA_REGISTRY_DIR/LICENSE"
cat >"$AQUA_REGISTRY_METADATA" <<EOF
{
  "repository": "$AQUA_REGISTRY_REPO",
  "tag": "$NEW_AQUA_REGISTRY_TAG"
}
EOF

# Generate aqua-registry changelog section for both packaging/release-notes/CHANGELOG.md and PR body
AQUA_CHANGELOG_MD="$(./packaging/scripts/gen-aqua-changelog.sh "$OLD_AQUA_REGISTRY_TAG" "$NEW_AQUA_REGISTRY_TAG" "###" || true)"
AQUA_CHANGELOG_PR="$(./packaging/scripts/gen-aqua-changelog.sh "$OLD_AQUA_REGISTRY_TAG" "$NEW_AQUA_REGISTRY_TAG" "##" || true)"

# Generate changelog using git-cliff with explicit calver version (not --bump which uses semver)
# LLM editorialization happens in release.yml after merge
# Use --unreleased --prepend to only add the new release entry, preserving existing content
# (including previously injected aqua-registry sections from older releases)
git cliff --config packaging/config/cliff.toml --tag "v$version" --unreleased --prepend packaging/release-notes/CHANGELOG.md

# Get the unreleased notes for PR body (strip version header since PR title has version)
PR_NOTES="$(git cliff --config packaging/config/cliff.toml --tag "v$version" --unreleased --strip all | tail -n +3)"

# Inject aqua-registry updates into packaging/release-notes/CHANGELOG.md if there are any
if [[ -n $AQUA_CHANGELOG_MD ]]; then
	# Find the FIRST release section (the one we just added) and inject aqua section at the end, before the next release
	# Use ENVIRON instead of -v to avoid awk interpreting backslash escape sequences
	export AQUA_CHANGELOG_MD
	awk '
		/^## \[/ {
			if (release_count == 1 && !inserted) {
				# We are at the second release, inject aqua section before it
				print ENVIRON["AQUA_CHANGELOG_MD"]
				print ""
				inserted = 1
			}
			release_count++
		}
		{print}
		END {
			# If we never hit a second release (only one release in file), append at end
			if (release_count == 1 && !inserted) {
				print ""
				print ENVIRON["AQUA_CHANGELOG_MD"]
			}
		}
	' packaging/release-notes/CHANGELOG.md >packaging/release-notes/CHANGELOG.md.tmp && mv packaging/release-notes/CHANGELOG.md.tmp packaging/release-notes/CHANGELOG.md
fi

# TODO: re-enable once fd v10.4.0 asset is fixed (missing fd-v10.4.0-x86_64-unknown-linux-musl.tar.gz)
# pakro up
pakro lock
# Refresh PATH after pakro up, since upgraded tools have new install paths
eval "$(pakro env)"

# Bump subcrate versions if they have changes (including Aqua registry updates)
bump_subcrate_if_changed "aqua-registry" "runtimes/crates/aqua-registry"
bump_subcrate_if_changed "pakro-sigstore" "src/crates/pakro-sigstore"

git status
# cargo update
# Every subcrate manifest: a bump also rewrites the version requirement in each
# workspace crate that path-depends on the bumped one (pakro-util on pakro-sigstore, …).
git add \
	Cargo.lock \
	Cargo.toml \
	packaging/release-notes/CHANGELOG.md \
	README.md \
	runtimes/vendor/aqua-registry \
	src/crates/*/Cargo.toml \
	runtimes/crates/*/Cargo.toml \
	packages/crates/*/Cargo.toml \
	packaging/nix/default.nix \
	packaging/snap/snapcraft.yaml \
	packaging/release-notes/ \
	packaging/rpm/pakro.spec \
	cli/generated/pakro.usage.kdl \
	cli/completions \
	pakro.lock \
	cli/man/ \
	src/crates/pakro-util/src/assets/gpg/
git clean -df
git checkout -B release
git commit -m "chore: release $version"
git push origin release --force

# Append aqua-registry updates to PR body if available
PR_BODY="$PR_NOTES"
if [[ -n $AQUA_CHANGELOG_PR ]]; then
	PR_BODY="$PR_NOTES"$'\n\n'"$AQUA_CHANGELOG_PR"
fi

# Check for existing PR from the release branch specifically (not by label repo-wide)
if [[ "$(gh pr list --head release --state open)" == "" ]]; then
	gh pr create --title "chore: release $version" --body "$PR_BODY" --label "release" --head release
else
	gh pr edit release --title "chore: release $version" --body "$PR_BODY"
fi
